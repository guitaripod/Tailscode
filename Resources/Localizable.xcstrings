        }
      }
    },
    "This Mac is not on the tailnet — %@. Nothing over it answers until that is true.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac ist nicht im Tailnet — %@. Nichts darüber antwortet, bis das stimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac is not on the tailnet — %@. Nothing over it answers until that is true."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no está en el tailnet: %@. Nada a través de él responde hasta que eso sea cierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’est pas sur le tailnet — %@. Rien ne répondra par ce biais tant que ce ne sera pas vrai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non è sul tailnet — %@. Nulla attraverso di esso risponderà finché non sarà vero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac は tailnet 上にありません — %@。それが解決するまで、それ経由では何も応答しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 tailnet에 있지 않습니다 — %@. 그것이 해결되기 전까지는 그 경로로 아무것도 응답하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não está na tailnet — %@. Nada por meio dela responde até que isso seja verdade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 不在 tailnet 上 — %@。在这一点成立之前，经由它的一切都不会有回应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 不在 tailnet 上 — %@。在這一點成立之前，經由它的一切都不會有回應。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie jest w tailnecie — %@. Nic za jego pośrednictwem nie odpowie, dopóki to się nie zmieni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac er ikke i tailnettet – %@. Intet over det svarer, før det er sandt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Mac ei ole tailnetissä – %@. Mikään sen kautta ei vastaa, ennen kuin tämä pätee."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi Mac er ekki í Tailnet-inu – %@. Ekkert þar ofan á svarar fyrr en það er satt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen er ikke i tailnetet: %@. Ingenting som går via den, svarer før dette stemmer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här Macen finns inte i tailnetet, %@. Ingenting där ovanför svarar förrän det stämmer."
          }
        }
