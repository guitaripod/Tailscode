        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "claude-bridge þarf alltaf lykilorð – það sem er í skipuninni hér fyrir ofan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "claude-bridge krever alltid et passord – det i kommandoen over."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "claude-bridge behöver alltid ett lösenord – det i kommandot ovan."
          }
        }
      }
    },
