    "You cannot interrupt while it is looking up what the agent is doing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot interrupt while it is looking up what the agent is doing"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst nicht unterbrechen, während es nachschaut, was der Agent gerade tut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes interrumpir mientras consulta lo que hace el agente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas l’interrompre pendant qu’il consulte ce que fait l’agent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi interrompere mentre controlla che cosa sta facendo l’agente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの状況を確認している間は、割り込めません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 무엇을 하는지 확인하는 동안에는 끼어들 수 없습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można mu przerwać, gdy sprawdza, co robi agent"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode interromper enquanto ele consulta o que o agente está fazendo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它在查询智能体当前状态时，你无法打断它"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它在查詢代理目前狀態時，你無法打斷它"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke afbryde, mens den slår op, hvad agenten laver"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et voi keskeyttää, kun se selvittää, mitä agentti tekee"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú getur ekki truflað meðan það flettir upp hvað agentinn er að gera."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ikke avbryte mens den slår opp hva agenten gjør"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan inte avbryta medan den slår upp vad agenten gör"
          }
        }
      }
    },
    "%@ Starting it fresh.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Starting it fresh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Wird neu gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Se inicia desde cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Démarrage à neuf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Avvio da zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 新しく起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 새로 시작합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Uruchamianie od nowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Iniciando do zero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将重新开始启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 將重新啟動。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Starter forfra."
          }
