          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已附加 %1$@ — 将随你的下一条消息发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已附加 %1$@ — 將隨你的下一則訊息傳送。"
