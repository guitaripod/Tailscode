    "Xcode is not on this Mac yet. It is free from the App Store: about 12 GB, around 40 minutes. You can leave; we will tell you when it is ready.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode is not on this Mac yet. It is free from the App Store: about 12 GB, around 40 minutes. You can leave; we will tell you when it is ready."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode ist auf diesem Mac noch nicht installiert. Es ist kostenlos im App Store erhältlich: etwa 12 GB, rund 40 Minuten. Sie können gehen; wir melden uns, wenn es fertig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode aún no está en este Mac. Es gratuito en la App Store: unos 12 GB, unos 40 minutos. Se puede dejar en curso; avisaremos cuando esté listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode n’est pas encore sur ce Mac. Il est gratuit sur l’App Store : environ 12 Go, une quarantaine de minutes. Vous pouvez vous absenter ; nous vous préviendrons quand il sera prêt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode non è ancora su questo Mac. È gratuito sull’App Store: circa 12 GB, circa 40 minuti. Puoi allontanarti; ti avviseremo quando sarà pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac にはまだ Xcode がありません。App Store から無料で入手できます（約 12 GB、約 40 分）。席を離れて構いません。準備ができたらお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에는 아직 Xcode가 없습니다. App Store에서 무료로 받을 수 있으며 약 12GB, 40분 정도 걸립니다. 자리를 비우셔도 됩니다. 준비되면 알려 드리겠습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode nie jest jeszcze na tym Macu. Jest bezpłatny w App Store: około 12 GB, około 40 minut. Możesz odejść; damy znać, gdy będzie gotowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Xcode ainda não está neste Mac. Ele é gratuito na App Store: cerca de 12 GB, uns 40 minutos. Você pode sair; avisaremos quando estiver pronto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上还没有 Xcode。它可以从 App Store 免费获取：约 12 GB，大约需要 40 分钟。你可以先离开，准备好时我们会通知你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 上還沒有 Xcode。它可從 App Store 免費取得：約 12 GB，大約需要 40 分鐘。你可以先離開，準備好時我們會通知你。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode er ikke på Mac'en endnu. Det er gratis at hente fra App Store: cirka 12 GB, omkring 40 minutter. Du kan godt lade det køre; vi giver besked, når det er klar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcodea ei ole vielä tällä Macilla. Sen saa ilmaiseksi App Storesta: noin 12 Gt, noin 40 minuuttia. Voit lähteä; ilmoitamme, kun se on valmis."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode er ekki á þessari Mac-tölvu ennþá. Það er ókeypis í App Store: um 12 GB, um 40 mínútur. Þú mátt fara; við látum þig vita þegar það er tilbúið."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode er ikke på denne Macen ennå. Det er gratis fra App Store: omtrent 12 GB, rundt 40 minutter. Du kan gjøre noe annet; vi sier fra når det er klart."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode finns inte på Mac:en än. Det är gratis i App Store: cirka 12 GB, runt 40 minuter. Du kan gå därifrån; vi säger till när det är klart."
          }
        }
      }
    },
    "Your app stopped building after the last change.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your app stopped building after the last change."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre App lässt sich nach der letzten Änderung nicht mehr kompilieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app dejó de compilarse tras el último cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre app ne se compile plus après la dernière modification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua app non si compila più dopo l’ultima modifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の変更のあと、アプリがビルドできなくなりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 변경 이후 앱을 빌드할 수 없게 되었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja przestała się kompilować po ostatniej zmianie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu app parou de compilar após a última mudança."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次修改后，你的应用无法再构建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次修改後，你的 App 無法再建置。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din app fejler i build efter den seneste ændring."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksesi ei enää koostu viimeisimmän muutoksen jälkeen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Appið þitt hætti að byggjast eftir síðustu breytingu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen din sluttet å bygges etter den siste endringen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din app slutade bygga efter den senaste ändringen."
          }
        }
      }
    },
