    "The connection to the voice gateway was lost and could not be restored. Check the tailnet and call again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to the voice gateway was lost and could not be restored. Check the tailnet and call again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zum Voice-Gateway ging verloren und konnte nicht wiederhergestellt werden. Prüfe das Tailnet und ruf erneut an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió la conexión con la pasarela de voz y no se pudo restablecer. Revisa la tailnet y vuelve a llamar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à la passerelle vocale a été perdue et n'a pas pu être rétablie. Vérifiez le tailnet et rappelez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione al gateway vocale è caduta e non è stata ripristinata. Controlla la tailnet e richiama."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声ゲートウェイへの接続が切れ、復旧できませんでした。tailnet を確認してから、もう一度通話してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 게이트웨이와의 연결이 끊겨 복구하지 못했어요. tailnet을 확인한 다음 다시 통화하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie z bramą głosową zostało utracone i nie udało się go przywrócić. Sprawdź tailnet i zadzwoń ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão com o gateway de voz foi perdida e não pôde ser restabelecida. Verifique a tailnet e ligue de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与语音网关的连接已断开且无法恢复。请检查 tailnet 后重新通话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與語音閘道的連線已中斷且無法恢復。請檢查 tailnet 後重新通話。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsen til stemmegatewayen gik tabt og kunne ikke genoprettes. Tjek tailnet og ring igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteys äänen yhdyskäytävään katkesi, eikä sitä voitu palauttaa. Tarkista tailnet ja soita uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambandið við raddgáttina rofnaði og tókst ekki að endurheimta það. Athugaðu tailnetið og hringdu aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsen til voice-gatewayen ble brutt og kunne ikke gjenopprettes. Sjekk tailnetet og ring igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslutningen till röstgatewayen bröts och kunde inte återställas. Kontrollera tailnet och ring igen."
          }
        }
      }
    },
    "The gateway did not understand this app. Update voice-bridge and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
