          }
        }
      }
    },
    "The server is configured but its password is not in this device's keychain, so nothing can be sent to it. Open its settings and enter the password it was started with.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist eingerichtet, aber sein Passwort befindet sich nicht im Schlüsselbund dieses Geräts, daher kann nichts an ihn gesendet werden. Öffne seine Einstellungen und gib das Passwort ein, mit dem er gestartet wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is configured but its password is not in this device's keychain, so nothing can be sent to it. Open its settings and enter the password it was started with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor está configurado, pero su contraseña no está en el llavero de este dispositivo, así que no se le puede enviar nada. Abre su configuración e introduce la contraseña con la que se inició."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur est configuré, mais son mot de passe n’est pas dans le trousseau de cet appareil, donc rien ne peut lui être envoyé. Ouvrez ses réglages et saisissez le mot de passe avec lequel il a été démarré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server è configurato, ma la sua password non è nel portachiavi di questo dispositivo, quindi non è possibile inviargli nulla. Apri le sue impostazioni e inserisci la password con cui è stato avviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバは設定済みですが、そのパスワードはこのデバイスのキーチェーンにないため、何も送信できません。設定を開き、起動時に指定したパスワードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버는 설정되어 있지만 이 기기의 키체인에 암호가 없어서 아무것도 보낼 수 없습니다. 설정을 열고 서버를 시작할 때 사용한 암호를 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor está configurado, mas a senha dele não está no chaveiro deste dispositivo, então nada pode ser enviado a ele. Abra as configurações dele e digite a senha com que foi iniciado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该服务器已配置，但它的密码不在此设备的钥匙串中，因此无法向它发送任何内容。请打开它的设置，输入它启动时使用的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該伺服器已設定，但它的密碼不在此裝置的鑰匙圈中，因此無法向它傳送任何內容。請開啟它的設定，輸入它啟動時使用的密碼。"
          }
        }
      }
    },
