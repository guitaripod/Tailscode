            "value": "Þessi iPhone er ekki í Tailnet-inu þínu, svo hann getur ekki náð í tölvuna þína enn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPhonen er ikke i tailnetet ditt, så den kan ikke nå maskinen din ennå."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här iPhonen finns inte i ditt tailnet och kan därför inte nå din dator än."
          }
        }
      }
    },
    "This iPhone is on the tailnet but that machine never replied. It may be asleep, offline, or signed into a different tailnet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone is on the tailnet but that machine never replied. It may be asleep, offline, or signed into a different tailnet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone ist im Tailnet, aber der Rechner hat nie geantwortet. Er schläft vielleicht, ist offline oder in einem anderen Tailnet angemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone está en la tailnet, pero esa máquina nunca respondió. Puede estar en reposo, sin conexión o con la sesión iniciada en otra tailnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone est sur le tailnet, mais cette machine n’a jamais répondu. Elle est peut-être en veille, hors ligne, ou connectée à un autre tailnet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo iPhone è sul tailnet ma quella macchina non ha mai risposto. Potrebbe essere in sospensione, offline o collegata a un altro tailnet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone は tailnet に接続されていますが、そのマシンからは応答がありませんでした。スリープ中かオフライン、または別の tailnet にサインインしている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone은 tailnet에 있지만 그 컴퓨터가 응답하지 않았습니다. 절전 상태이거나 오프라인이거나 다른 tailnet에 로그인되어 있을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone está na tailnet, mas essa máquina não respondeu. Ela pode estar em repouso, off-line ou conectada a outra tailnet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 已在 tailnet 上，但那台机器始终没有回应。它可能处于睡眠、离线，或登录了另一个 tailnet。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 iPhone 在 tailnet 上，但那台電腦始終沒有回覆。它可能在睡眠、離線，或登入了不同的 tailnet。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten iPhone jest w tailnecie, ale ten komputer nigdy nie odpowiedział. Może być uśpiony, offline albo zalogowany do innego tailnetu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPhone er i dit tailnet, men computeren svarede aldrig. Den sover måske, er offline eller logget ind i et andet tailnet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä iPhone on tailnetissä, mutta kyseinen kone ei ole koskaan vastannut. Se saattaa nukkua, olla offline-tilassa tai olla kirjautuneena toiseen tailnetiin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi iPhone er í Tailnet-inu en tölvan svaraði aldrei. Hún gæti verið í svefni, ótengd eða skráð inn í annað Tailnet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPhonen er i tailnetet, men maskinen svarte aldri. Den kan være i dvale, frakoblet eller logget inn i et annet tailnet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här iPhonen är i tailnetet men datorn svarade aldrig. Datorn kan vara i viloläge, offline eller inloggad i ett annat tailnet."
          }
        }
      }
    },
    "This iPhone is on your tailnet at %@, able to reach your machine.": {
