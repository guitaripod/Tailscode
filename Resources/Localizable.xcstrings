    "%@ owns a key that also starts a two-key sequence — the sequence never fires": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belegt eine Taste, die auch eine Zwei-Tasten-Sequenz einleitet — die Sequenz wird nie ausgelöst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ owns a key that also starts a two-key sequence — the sequence never fires"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ocupa una tecla que también inicia una secuencia de dos teclas — la secuencia nunca se activa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ occupe une touche qui démarre aussi une séquence à deux touches — la séquence ne se déclenche jamais"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ occupa un tasto che avvia anche una sequenza a due tasti — la sequenza non scatta mai"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が、2 キーシーケンスの開始キーでもあるキーを占有しています — そのシーケンスは発火しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 두 키 시퀀스를 시작하는 키도 차지하고 있습니다 — 그 시퀀스는 절대 실행되지 않습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ocupa uma tecla que também inicia uma sequência de duas teclas — a sequência nunca é acionada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 占用了一个同时也是双键序列起始键的按键 — 该序列永远不会触发"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 占用了一個同時也是雙鍵序列起始鍵的按鍵 — 該序列永遠不會觸發"
          }
        }
      }
    },
