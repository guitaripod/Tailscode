    "Another call was started, so this one ended.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another call was started, so this one ended."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde ein anderer Anruf gestartet, daher wurde dieser beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se inició otra llamada, así que esta terminó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre appel a été lancé, donc celui-ci s'est terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stata avviata un'altra chiamata, quindi questa è terminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の通話が始まったため、この通話は終了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 통화가 시작되어 이 통화가 종료되었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoczęto inną rozmowę, więc ta została zakończona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra chamada foi iniciada, então esta foi encerrada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开始另一通通话，因此这通通话已结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開始另一通通話，因此這通通話已結束。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et andet opkald blev startet, så dette blev afsluttet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen puhelu aloitettiin, joten tämä päättyi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Annað símtal hófst, þannig að þessu lauk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et annet anrop ble startet, så dette ble avsluttet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett annat samtal startades, så det här avslutades."
          }
        }
      }
    },
    "The voice model starts when you call, which can take a few minutes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice model starts when you call, which can take a few minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sprachmodell startet, wenn du anrufst. Das kann einige Minuten dauern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de voz se inicia cuando llamas, lo que puede tardar unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle vocal démarre quand vous appelez, ce qui peut prendre quelques minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello vocale si avvia quando chiami, e può richiedere qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声モデルは通話を始めると起動します。数分かかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 모델은 통화를 시작할 때 켜지며, 몇 분 걸릴 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model głosowy uruchamia się, gdy zadzwonisz, co może potrwać kilka minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de voz inicia quando você liga, o que pode levar alguns minutos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音模型会在你发起通话时启动，可能需要几分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音模型會在你發起通話時啟動，可能需要幾分鐘。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmemodellen starter, når du ringer op, hvilket kan tage et par minutter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhemalli käynnistyy soitettaessa, mikä voi kestää muutaman minuutin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Raddlíkanið ræsist þegar þú hringir, sem getur tekið nokkrar mínútur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmemodellen starter når du ringer, noe som kan ta noen minutter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Röstmodellen startar när du ringer, vilket kan ta några minuter."
          }
        }
      }
    },
