    "Saved nothing yet. Nothing is kept until you press Connect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved nothing yet. Nothing is kept until you press Connect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts gespeichert. Erst mit „Verbinden“ wird etwas aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se ha guardado nada. No se guarda nada hasta pulsar Conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est encore enregistré. Rien n'est conservé tant que vous n'appuyez pas sur Se connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è ancora stato salvato nulla. Non si conserva nulla finché non si preme Connetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も保存されていません。「接続」を押すまで何も保持されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 아무것도 저장되지 않았어요. 연결을 누르기 전까지는 아무것도 보관되지 않아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nic nie zapisano. Nic nie jest przechowywane, dopóki nie naciśniesz Połącz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi salvo ainda. Nada é guardado até você tocar em Conectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未保存任何内容。点击“连接”之前不会保留任何数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未儲存任何內容。按下「連線」之前不會保留任何資料。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet gemt endnu. Intet gemmes, før du trykker på Opret forbindelse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei ole vielä tallennettu. Tallennus tapahtuu vasta, kun painat ”Yhdistä”."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert vistað ennþá. Ekkert er geymt fyrr en þú ýtir á Tengjast."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting er lagret ennå. Ingenting lagres før du trykker Koble til."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget sparat ännu. Ingenting sparas förrän du trycker på Anslut."
          }
        }
      }
    },
    "The link carries this machine's password. It is kept on this device, and only after you press Connect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link carries this machine's password. It is kept on this device, and only after you press Connect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Link enthält das Passwort des Rechners. Es wird auf diesem Gerät gespeichert, aber erst nach dem Klick auf Verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace incluye la contraseña de este equipo. Se guarda en este dispositivo, y solo después de pulsar Conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien contient le mot de passe de cette machine. Il est conservé sur cet appareil, seulement après que vous avez appuyé sur Se connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il link contiene la password di questo computer. Viene conservata su questo dispositivo, ma solo dopo aver premuto Connetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクにはこのマシンのパスワードが含まれています。このデバイスに保存されるのは、「接続」を押した後だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크에는 이 컴퓨터의 비밀번호가 들어 있어요. 이 기기에는 연결을 누른 후에만 저장돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link zawiera hasło tego komputera. Jest przechowywane na tym urządzeniu, ale dopiero po naciśnięciu Połącz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O link traz a senha deste computador. Ela fica guardada neste dispositivo, mas só depois de você tocar em Conectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接中包含该电脑的密码。只有在点击“连接”后，它才会保存在本设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結中包含該電腦的密碼。只有在按下「連線」後，才會保存在這台裝置上。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linket indeholder computerens adgangskode. Den gemmes på denne enhed, men først når du trykker på Opret forbindelse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkki sisältää tämän tietokoneen salasanan. Se tallennetaan tälle laitteelle vasta, kun painat ”Yhdistä”."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengillinn ber lykilorð þessarar tölvu. Það er geymt á þessu tæki, og aðeins eftir að þú ýtir á Tengjast."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenken inneholder passordet til denne maskinen. Det lagres på denne enheten, og først etter at du trykker Koble til."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Länken innehåller den här datorns lösenord. Det sparas på den här enheten, och först när du trycker på Anslut."
          }
        }
      }
    },
