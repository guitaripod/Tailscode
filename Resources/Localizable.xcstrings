    "%@ tokens on %@%@ ran on a plan — billed by the month, not per token": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Tokens auf %2$@%3$@ liefen über einen Tarif — abgerechnet im Monat, nicht pro Token"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens on %@%@ ran on a plan — billed by the month, not per token"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tokens en %2$@%3$@ se ejecutaron con un plan: facturado por mes, no por token"
