    "Ask every machine on the way for the models it serves": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt jeden erreichbaren Rechner nach den Modellen, die er bereitstellt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask every machine on the way for the models it serves"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a cada máquina en el camino qué modelos ofrece"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interroge chaque machine sur le chemin pour ses modèles disponibles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede a ogni macchina lungo il percorso quali modelli offre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経路上のすべてのマシンに、提供しているモデルを問い合わせます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로상의 모든 컴퓨터에 어떤 모델을 제공하는지 물어봅니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunta a cada máquina no caminho quais modelos ela oferece"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向沿途的每台机器查询它提供的模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向沿途的每台機器查詢它提供的模型"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyta po drodze każdy komputer o modele, które udostępnia"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørg hver computer på vejen om de modeller, den tilbyder"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysy jokaiselta matkan varrella olevalta tietokoneelta, mitä malleja se tarjoaa"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spyr allar tölvur á leiðinni um líkönin sem þær bjóða"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør alle maskiner underveis om modellene de tilbyr"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga varje dator på vägen efter modellerna den erbjuder"
          }
        }
      }
    },
    "Asked the server to pick this back up — waiting for it to say it has.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wurde gebeten, dies wieder aufzunehmen — wir warten auf seine Bestätigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asked the server to pick this back up — waiting for it to say it has."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pidió al servidor que retomara esto — a la espera de su confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a été demandé au serveur de reprendre ceci — en attente de sa confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato chiesto al server di riprendere questo — in attesa della sua conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバにこれを再開するよう依頼しました — 確認待ちです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 이것을 다시 이어가도록 요청했습니다 — 확인을 기다리는 중입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi pedido ao servidor para retomar isto — aguardando a confirmação dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求服务器重新接续此项 — 正在等待它确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已請求伺服器重新接續此項 — 正在等待它確認。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproszono serwer o wznowienie tego — oczekiwanie na potwierdzenie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad serveren om at tage dette op igen – venter på at den bekræfter det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelinta pyydettiin jatkamaan tätä, odotetaan vahvistusta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bað netþjóninn að halda áfram með þetta, bíð eftir að hann staðfesti það."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bedt serveren om å ta dette opp igjen og venter på bekreftelse."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad servern att plocka upp detta igen – väntar på att den ska bekräfta."
          }
        }
      }
    },
    "Asked the server to set this aside — waiting for it to say it has.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wurde gebeten, dies beiseitezulegen — wir warten auf seine Bestätigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asked the server to set this aside — waiting for it to say it has."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pidió al servidor que dejara esto de lado — a la espera de su confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a été demandé au serveur de mettre ceci de côté — en attente de sa confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato chiesto al server di mettere da parte questo — in attesa della sua conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバにこれを保留するよう依頼しました — 確認待ちです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 이것을 보류하도록 요청했습니다 — 확인을 기다리는 중입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi pedido ao servidor para deixar isto de lado — aguardando a confirmação dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求服务器搁置此项 — 正在等待它确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已請求伺服器擱置此項 — 正在等待它確認。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproszono serwer o odłożenie tego — oczekiwanie na potwierdzenie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad serveren om at lægge dette til side – venter på at den bekræfter det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelinta pyydettiin siirtämään tämä sivuun, odotetaan vahvistusta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bað netþjóninn að leggja þetta til hliðar, bíð eftir að hann staðfesti það."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bedt serveren om å legge dette til side og venter på bekreftelse."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bad servern att lägga undan detta – väntar på att den ska bekräfta."
          }
        }
      }
    },
