        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は稼働していますが、アップデートについて時間内に応答がありませんでした — 処理中かもしれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 작동 중이지만 업데이트에 대해 제시간에 응답하지 않았습니다 — 바쁜 상태일 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está ativo, mas não respondeu sobre atualizações a tempo — ele pode estar ocupado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在运行，但未能及时回应关于更新的请求——它可能正忙。"
