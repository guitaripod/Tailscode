    "Tailscode drives coding agents on your other machines. Two things have to be true first — both are checked for you.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode steuert Coding-Agenten auf deinen anderen Rechnern. Zwei Dinge müssen zuerst stimmen — beide werden für dich geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode drives coding agents on your other machines. Two things have to be true first — both are checked for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode controla agentes de programación en tus otras máquinas. Antes, dos cosas deben cumplirse: ambas se comprueban por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode pilote des agents de code sur vos autres machines. Deux conditions doivent d’abord être réunies — toutes deux sont vérifiées pour vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode guida agenti di coding sulle tue altre macchine. Prima devono essere vere due cose — entrambe vengono verificate per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode は、ほかのマシン上のコーディングエージェントを操作します。そのためにはまず 2 つの条件が満たされている必要があります — どちらもここで確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode는 다른 머신에 있는 코딩 에이전트를 조종합니다. 그러려면 먼저 두 가지 조건이 갖춰져 있어야 합니다 — 둘 다 여기서 확인해 드립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode controla agentes de programação nas suas outras máquinas. Duas coisas precisam ser verdade primeiro — as duas são verificadas para você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 会操作你其他机器上的编程智能体。为此需要先满足两个条件 — 这两项都会替你检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 會操作你其他機器上的程式設計代理。為此需要先滿足兩個條件 — 這兩項都會替你檢查。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode steruje agentami kodującymi na twoich innych komputerach. Najpierw muszą być spełnione dwa warunki — oba są sprawdzane za ciebie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode styrer kodeagenter på dine andre computere. To ting skal være på plads først – begge kontrolleres for dig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ohjaa koodausagentteja muilla koneillasi. Kahden asian on ensin oltava kunnossa – molemmat tarkistetaan puolestasi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode stýrir kóðunaragenta á hinum tölvunum þínum. Tvennt þarf að vera í lagi fyrst; bæði er athugað fyrir þig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode styrer kodeagenter på de andre maskinene dine. To ting må være på plass først – begge sjekkes for deg."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode styr kodagenter på dina andra datorer. Två saker måste stämma först – båda kontrolleras åt dig."
          }
        }
      }
    },
