    "Pull down to retry the connection.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh nach unten, um die Verbindung erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull down to retry the connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia abajo para reintentar la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez vers le bas pour retenter la connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina verso il basso per riprovare la connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下に引っ張って接続を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래로 당겨 연결을 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe para baixo para tentar conectar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下拉以重试连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下拉以重試連線。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pociągnij w dół, aby ponowić połączenie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk nedad for at prøve forbindelsen igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä alas yrittääksesi yhteyttä uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragðu niður til að reyna aftur að tengjast."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra ned for å prøve tilkoblingen på nytt."
          }
        },
        "sv": {
