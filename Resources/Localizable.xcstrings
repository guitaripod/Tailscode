            "value": "Store unavailable — tap to retry"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Store no disponible: toca para reintentar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Store indisponible — touchez pour réessayer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Store non disponibile — tocca per riprovare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Store を利用できません — タップして再試行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스토어를 사용할 수 없음 — 탭하여 다시 시도"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Loja indisponível — toque para tentar de novo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商店不可用 — 轻点重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "商店無法使用 — 輕點重試"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sklep niedostępny — dotknij, by spróbować ponownie"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Butikken er ikke tilgængelig – tryk for at prøve igen"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauppa ei ole käytettävissä, napauta yrittääksesi uudelleen"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Verslun ekki tiltæk – bankaðu til að reyna aftur"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Butikken er utilgjengelig. Trykk for å prøve igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Butiken är inte tillgänglig – tryck för att försöka igen"
          }
        }
      }
    },
    "Stored only in the Keychain. Used solely to list your Tailscale devices — connecting to a server never needs it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur im Schlüsselbund gespeichert. Dient allein dazu, deine Tailscale-Geräte aufzulisten – zum Verbinden mit einem Server wird es nie gebraucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored only in the Keychain. Used solely to list your Tailscale devices — connecting to a server never needs it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda solo en el llavero. Se usa únicamente para listar tus dispositivos de Tailscale: conectarse a un servidor nunca lo necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocké uniquement dans le trousseau. Sert seulement à lister vos appareils Tailscale — la connexion à un serveur n’en a jamais besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservato solo nel portachiavi. Serve unicamente a elencare i tuoi dispositivi Tailscale — la connessione a un server non lo richiede mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンにのみ保存されます。Tailscale のデバイス一覧を取得するためだけに使われ、サーバへの接続には不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키체인에만 저장됩니다. Tailscale 기기 목록을 가져올 때만 사용되며, 서버 연결에는 필요하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado apenas nas Chaves. Usado só para listar seus dispositivos Tailscale — conectar a um servidor nunca precisa dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存在钥匙串中。只用于列出你的 Tailscale 设备 — 连接服务器从不需要它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅儲存在鑰匙圈中。只用於列出你的 Tailscale 裝置 — 連線伺服器從不需要它。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowywany wyłącznie w Pęku kluczy. Służy tylko do wyświetlania listy urządzeń Tailscale — połączenie z serwerem nigdy go nie wymaga."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmes kun i nøgleringen. Bruges udelukkende til at vise dine Tailscale-enheder, og forbindelse til en server kræver den aldrig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu vain Avainnippuun. Käytetään vain Tailscale-laitteidesi luetteloimiseen, palvelimeen yhdistäminen ei koskaan tarvitse sitä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Geymt eingöngu í lyklakippunni. Notað eingöngu til að lista upp Tailscale-tækin þín – það þarf aldrei til að tengjast við netþjón."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagres bare i nøkkelringen. Brukes kun til å liste Tailscale-enhetene dine. Å koble til en server krever aldri den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagras bara i nyckelknippan. Används enbart för att lista dina Tailscale-enheter – att ansluta till en server behöver det aldrig."
          }
        }
      }
    },
