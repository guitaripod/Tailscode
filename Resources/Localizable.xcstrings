    "Pick the quota this control watches.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle das Kontingent, das dieses Bedienelement beobachtet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the quota this control watches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la cuota que este control observa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le quota que ce contrôle surveille."
