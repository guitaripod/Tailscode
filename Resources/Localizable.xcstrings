            "state": "translated",
            "value": "Den svarte ikke i tide."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den svarade inte i tid."
          }
        }
      }
    },
    "%@ has no password on this device": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat auf diesem Gerät kein Passwort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no password on this device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene contraseña en este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas de mot de passe sur cet appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha una password su questo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にはこのデバイスでのパスワードがありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이 기기용 암호가 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem senha neste dispositivo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在此设备上没有密码"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在此裝置上沒有密碼"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie ma hasła na tym urządzeniu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen adgangskode på denne enhed"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:lla ei ole salasanaa tällä laitteella"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hefur ekkert lykilorð á þessu tæki"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ikke et passord på denne enheten"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har inget lösenord på den här enheten"
          }
        }
      }
    },
    "The server is configured but its password is not in this device's keychain, so nothing can be sent to it. Open its settings and enter the password it was started with.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist eingerichtet, aber sein Passwort befindet sich nicht im Schlüsselbund dieses Geräts, daher kann nichts an ihn gesendet werden. Öffne seine Einstellungen und gib das Passwort ein, mit dem er gestartet wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is configured but its password is not in this device's keychain, so nothing can be sent to it. Open its settings and enter the password it was started with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor está configurado, pero su contraseña no está en el llavero de este dispositivo, así que no se le puede enviar nada. Abre su configuración e introduce la contraseña con la que se inició."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur est configuré, mais son mot de passe n’est pas dans le trousseau de cet appareil, donc rien ne peut lui être envoyé. Ouvrez ses réglages et saisissez le mot de passe avec lequel il a été démarré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server è configurato, ma la sua password non è nel portachiavi di questo dispositivo, quindi non è possibile inviargli nulla. Apri le sue impostazioni e inserisci la password con cui è stato avviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバは設定済みですが、そのパスワードはこのデバイスのキーチェーンにないため、何も送信できません。設定を開き、起動時に指定したパスワードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버는 설정되어 있지만 이 기기의 키체인에 암호가 없어서 아무것도 보낼 수 없습니다. 설정을 열고 서버를 시작할 때 사용한 암호를 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor está configurado, mas a senha dele não está no chaveiro deste dispositivo, então nada pode ser enviado a ele. Abra as configurações dele e digite a senha com que foi iniciado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该服务器已配置，但它的密码不在此设备的钥匙串中，因此无法向它发送任何内容。请打开它的设置，输入它启动时使用的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該伺服器已設定，但它的密碼不在此裝置的鑰匙圈中，因此無法向它傳送任何內容。請開啟它的設定，輸入它啟動時使用的密碼。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer jest skonfigurowany, ale jego hasła nie ma w pęku kluczy tego urządzenia, więc nic nie można do niego wysłać. Otwórz jego ustawienia i wpisz hasło, z którym został uruchomiony."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren er sat op, men dens adgangskode findes ikke i denne enheds nøglering, så der ikke kan sendes noget til den. Åbn dens indstillinger, og indtast den adgangskode, den blev startet med."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin on määritetty, mutta sen salasana ei ole tämän laitteen avainnipussa, joten sille ei voi lähettää mitään. Avaa sen asetukset ja anna salasana, jolla se käynnistettiin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Netþjónninn er stilltur en lykilorð hans er ekki í lyklakippu þessa tækis, svo ekkert er hægt að senda til hans. Opnaðu stillingar hans og settu inn lykilorðið sem hann var ræstur með."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren er satt opp, men passordet finnes ikke i nøkkelringen på denne enheten, så ingenting kan sendes dit. Åpne innstillingene og skriv inn passordet serveren ble startet med."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern är konfigurerad, men dess lösenord finns inte i den här enhetens nyckelring, så inget kan skickas till den. Öppna dess inställningar och ange lösenordet den startades med."
          }
        }
      }
    },
