    "Agent steps collapse to a slim line — tap to unfold the details": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentenschritte klappen zu einer schmalen Zeile zusammen — zum Aufklappen der Details tippen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent steps collapse to a slim line — tap to unfold the details"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pasos del agente se reducen a una línea delgada — toca para desplegar los detalles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étapes de l’agent se réduisent à une fine ligne — touchez pour déplier les détails"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I passaggi dell’agente si riducono a una riga sottile — tocca per aprire i dettagli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの手順は細い 1 行に折りたたまれます — タップして詳細を展開"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 단계는 얇은 한 줄로 접힙니다 — 탭하면 세부 정보가 펼쳐집니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As etapas do agente recolhem para uma linha fina — toque para expandir os detalhes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体的步骤会收起为一条细线 — 轻点即可展开详情"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理的步驟會收起為一條細線 — 輕點即可展開詳細資訊"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kroki agenta zwijają się do cienkiej linii — stuknij, by rozwinąć szczegóły"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenttrin klappes sammen til en smal linje; tryk for at folde detaljerne ud"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentin vaiheet tiivistyvät ohueksi riviksi – napauta avataksesi tiedot"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skref agentsins falla saman í mjóa línu – banka til að opna nánari upplýsingar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentsteg klappes sammen til en smal linje – trykk for å vise detaljene"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentens steg fälls ihop till en smal rad – tryck för att fälla ut detaljerna"
          }
        }
      }
    },
