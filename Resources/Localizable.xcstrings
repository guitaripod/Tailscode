            "value": "Preparando o ditado, %lld por cento"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备听写，已完成百分之 %lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在準備聽寫，%lld%"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klargør diktering, %lld procent"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanelua valmistellaan, %lld prosenttia"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Raddritun er undirbúin, %lld prósent"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klargjør diktering, %lld prosent"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering förbereds, %lld procent"
          }
        }
      }
    },
    "It listens with a speech model on your own CPU. Nothing you say leaves %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It listens with a speech model on your own CPU. Nothing you say leaves %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es hört mit einem Sprachmodell auf deiner eigenen CPU zu. Nichts, was du sagst, verlässt %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha con un modelo de voz en tu propia CPU. Nada de lo que digas sale de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il écoute avec un modèle vocal sur votre propre CPU. Rien de ce que vous dites ne quitte votre %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta con un modello vocale sulla tua CPU. Nulla di ciò che dici esce da %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声認識モデルで、お使いの CPU 上で聞き取ります。話した内容は%@から外に出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 CPU에서 음성 모델로 듣습니다. 말한 내용은 %@ 밖으로 나가지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słucha modelem mowy na twoim procesorze CPU. Nic, co powiesz, nie opuszcza %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele ouve com um modelo de voz na sua CPU. Nada do que você disser sai do %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它用语音模型在你自己的 CPU 上识别。你说的话不会离开%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它使用你自己 CPU 上的語音模型聆聽。你說的內容都不會離開 %@。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lytter med en talemodel på din egen CPU. Intet, du siger, forlader %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se kuuntelee puhemallilla omalla prosessorillasi. Mikään sanomasi ei poistu tältä laitteelta (%@)."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hún hlustar með talgreiningarlíkani á eigin örgjörva. %@ sendir ekkert sem þú segir frá sér."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den bruker en talemodell på din egen prosessor til å lytte. Ingenting du sier forlater %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lyssnar med en talmodell på din egen processor. Inget du säger lämnar %@."
          }
        }
      }
    },
