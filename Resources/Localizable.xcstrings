    "Add a bit more detail, then hold Send to refine it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergänze etwas mehr Details und halte dann „Senden“ gedrückt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a bit more detail, then hold Send to refine it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade algo más de detalle y luego mantén pulsado Enviar para refinarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un peu plus de détails, puis maintenez Envoyer pour l’affiner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi qualche dettaglio in più, poi tieni premuto Invia per rifinirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう少し詳しく書いてから、送信を長押しして推敲してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조금 더 자세히 쓴 다음 보내기를 길게 눌러 다듬으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione mais detalhes e mantenha Enviar pressionado para refinar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再补充一些细节，然后长按发送以润色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再補充一些細節，然後長按傳送以潤飾。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj trochę więcej szczegółów, a potem przytrzymaj Wyślij, aby to dopracować."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj lidt mere detalje, og hold Send nede for at forfine den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää hieman tarkempi kuvaus ja tarkenna se pitämällä Lähetä-painiketta painettuna."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bættu við aðeins meiri upplýsingum og haltu síðan „Senda“ inni til að betrumbæta það."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til litt mer detalj, og hold inne Send for å forbedre den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till lite mer information och håll sedan in ”Skicka” för att förfina den."
          }
        }
      }
    },
