    "Voice calls need a one-time setup on this server. Press Call to see what is left.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice calls need a one-time setup on this server. Press Call to see what is left."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachanrufe brauchen einmalig eine Einrichtung auf diesem Server. Auf „Anrufen“ tippen, um zu sehen, was noch fehlt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas de voz necesitan una configuración única en este servidor. Pulsa Llamar para ver qué falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels vocaux nécessitent une configuration unique sur ce serveur. Appuyez sur Appeler pour voir ce qui reste à faire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiamate vocali richiedono una configurazione una tantum su questo server. Tocca Chiama per vedere cosa manca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声通話には、このサーバーでの一度きりのセットアップが必要です。「通話」を押すと、残りの作業を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 통화를 사용하려면 이 서버에서 한 번만 설정해야 해요. ‘통화’를 누르면 남은 작업을 볼 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenia głosowe wymagają jednorazowej konfiguracji na tym serwerze. Naciśnij Połącz, aby zobaczyć, co zostało."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas de voz exigem uma configuração única neste servidor. Toque em Ligar para ver o que falta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音通话需要在此服务器上进行一次性设置。点按“通话”查看还需完成的步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音通話需要在此伺服器上進行一次性設定。點按「通話」查看還需完成的步驟。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmeopkald kræver en engangsopsætning på denne server. Tryk på »Ring op« for at se, hvad der mangler."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänipuhelut vaativat tällä palvelimella kertaluonteisen käyttöönoton. Paina Soita nähdäksesi, mitä on vielä jäljellä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Raddsímtöl þurfa einu sinni uppsetningu á þessum netþjóni. Ýttu á „Hringja“ til að sjá hvað er eftir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmeanrop må settes opp én gang på denne serveren. Trykk på «Ring» for å se hva som gjenstår."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Röstsamtal kräver en engångskonfiguration på den här servern. Tryck på Ring för att se vad som återstår."
