    "Runs in the isolated worktree after the worker finishes; exit 0 passes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft im isolierten Worktree, nachdem der Worker fertig ist; exit 0 gilt als bestanden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs in the isolated worktree after the worker finishes; exit 0 passes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta en el worktree aislado cuando el worker termina; exit 0 aprueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’exécute dans le worktree isolé une fois le worker terminé ; exit 0 valide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene eseguito nel worktree isolato dopo che il worker ha finito; exit 0 supera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワーカーが完了した後、隔離された worktree 内で実行されます。exit 0 で合格です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워커가 끝난 후 격리된 worktree에서 실행됩니다. exit 0이면 통과입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa no worktree isolado depois que o worker termina; exit 0 aprova."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在执行者完成后于隔离的 worktree 中运行；退出码为 0 即视为通过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在執行者完成後於隔離的 worktree 中執行；結束碼為 0 即視為通過。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamia się w izolowanym worktree po zakończeniu pracy workera; exit 0 oznacza sukces."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kører i den isolerede worktree, når workeren er færdig; exit 0 betyder bestået."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajetaan eristetyssä worktree-hakemistossa työntekijän valmistuttua; exit 0 tarkoittaa läpäisyä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyrir í einangraðri vinnumöppu þegar vinnuaðilinn lýkur; exit 0 telst standast."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøres i den isolerte worktreen etter at arbeideren er ferdig. Exit 0 betyr bestått."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Körs i den isolerade worktreen efter att workern är klar; exit 0 räknas som godkänt."
          }
        }
      }
    },
