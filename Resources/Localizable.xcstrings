    "Click the mic beside Send to talk, or hold it to talk while held. Dictation runs on this %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the mic beside Send to talk, or hold it to talk while held. Dictation runs on this %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke neben Senden auf das Mikrofon zum Sprechen, oder halte es gedrückt, um beim Halten zu sprechen. Diktat läuft auf diesem %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el micrófono junto a Enviar para hablar, o mantenlo pulsado para hablar mientras lo mantienes. El dictado funciona en este %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le micro à côté d'Envoyer pour parler, ou maintenez-le enfoncé pour parler pendant l'appui. La dictée fonctionne sur votre %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicca il microfono accanto a Invia per parlare, o tienilo premuto per parlare mentre lo tieni. La dettatura funziona su questo %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信ボタンの横のマイクをクリックして話すか、長押しして押している間話します。音声入力はこの%@で動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기 옆 마이크를 클릭해 말하거나 길게 눌러 누르고 있는 동안 말하세요. 받아쓰기는 이 %@에서 실행됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij mikrofon obok Wyślij, by mówić, albo przytrzymaj go, by mówić, dopóki trzymasz. Dyktowanie działa na tym %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no microfone ao lado de Enviar para falar, ou segure-o para falar enquanto segura. O ditado roda neste %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按发送旁的麦克风说话，或按住它边按边说。听写在这台%@上运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按傳送旁的麥克風即可說話，或按住它來持續說話。聽寫在這台 %@ 上執行。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på mikrofonen ved siden af Send for at tale, eller hold den nede for at tale, mens den holdes nede. Diktering kører på denne %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsauta Lähetä-painikkeen vieressä olevaa mikrofonia puhuaksesi, tai pidä sitä painettuna puhuaksesi sen ajan. Sanelu toimii tässä laitteessa (%@)."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Smelltu á hljóðnemann við hliðina á „Senda“ til að tala, eða haltu honum niðri til að tala meðan haldið er. Diktun keyrir á þessu tæki (%@)."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på mikrofonen ved siden av «Send» for å snakke, eller hold den inne for å snakke mens du holder. Diktering kjører på %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på mikrofonen bredvid Skicka för att prata, eller håll in den för att prata medan den hålls in. Diktering körs på den här %@."
          }
        }
      }
    },
