        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 동안 %1$@ 토큰 — 대기 시간 전체에 걸쳐 모델이 생성한 토큰입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens escritos em %@ — os tokens que o modelo produziu, ao longo de toda a espera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %2$@ 内写入了 %1$@ 个词元 — 这是模型在整个等待期间产出的词元数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
