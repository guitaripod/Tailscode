    "%@ updates itself with its own command, run on that machine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aktualisiert sich mit einem eigenen Befehl, der auf dieser Maschine ausgeführt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ updates itself with its own command, run on that machine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se actualiza con su propio comando, ejecutado en esa máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se met à jour avec sa propre commande, exécutée sur cette machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si aggiorna con un proprio comando, eseguito su quella macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は専用のコマンドで自己更新します。そのマシン上で実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 해당 머신에서 실행하는 자체 명령으로 업데이트합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se atualiza com seu próprio comando, executado naquela máquina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 使用自己的命令进行更新，需要在那台机器上运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 使用自己的指令進行更新，需要在那台機器上執行。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aktualizuje się własnym poleceniem, uruchamianym na tym komputerze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opdaterer sig selv med sin egen kommando, som køres på den maskine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ päivittyy itse omalla komennollaan, joka ajetaan sillä koneella."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uppfærir sig með eigin skipun sem keyrð er á þeirri tölvu."
