            "value": "%@ svarede, men afviste adgangskoden. Kontrollér den på serveren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vastasi, mutta hylkäsi salasanan. Tarkista se palvelimelta."
