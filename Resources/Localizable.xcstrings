    "\"%@\" will be removed from the server.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ wird vom Server entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" will be removed from the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» se eliminará del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » sera supprimée du serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» verrà rimossa dal server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」をサーバから削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 \"%1$@\"이(가) 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" será removida do servidor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从服务器上删除“%1$@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將從伺服器上刪除「%1$@」。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” zostanie usunięta z serwera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« fjernes fra serveren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” poistetaan palvelimelta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ verður fjarlægt af netþjóninum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» blir fjernet fra serveren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” tas bort från servern."
          }
        }
      }
    },
