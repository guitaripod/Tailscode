        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejrzyj to i wskaż wszystko, co jest nie tak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemgå dette, og påpeg alt, der er forkert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista tämä ja kerro, mikä siinä on vialla."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Yfirfarðu þetta og bentu á allt sem er rangt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå gjennom dette og påpek alt som er feil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granska det här och peka ut allt som är fel."
          }
        }
      }
