    "The turn ends where it is. What it already did stays done.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The turn ends where it is. What it already did stays done."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zug endet, wo er gerade ist. Was er schon getan hat, bleibt erledigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El turno termina donde está. Lo que ya hizo queda hecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tour s’arrête là où il en est. Ce qu’il a déjà fait reste acquis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il turno si ferma dove si trova. Ciò che ha già fatto resta fatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターンはその場で終わります。すでに行ったことはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴은 지금 자리에서 끝나요. 이미 한 일은 그대로 남아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tura kończy się w tym miejscu. To, co już zrobiła, pozostaje zrobione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A vez para onde está. O que já fez continua feito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮将在当前位置结束，已完成的部分保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一輪會在目前位置結束，已完成的部分保持不變。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Turen stopper, hvor den er. Det den allerede har gjort, forbliver udført."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoro päättyy siihen kohtaan, missä se on. Mitä se on jo tehnyt, pysyy tehtynä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Umferðin endar þar sem hún er. Það sem hún hefur þegar gert stendur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Turen avsluttes der den er. Det den allerede har gjort, beholdes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Turen avslutas där den är. Det som redan är gjort finns kvar."
          }
        }
      }
    },
