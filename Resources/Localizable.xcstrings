    "The voice would not stop talking, so it was stopped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice would not stop talking, so it was stopped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stimme redete ununterbrochen weiter, deshalb wurde sie gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz no paraba de hablar, así que se detuvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix n'arrêtait pas de parler, elle a donc été arrêtée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La voce non smetteva di parlare, quindi è stata interrotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声が話し続けたため、停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성이 계속 말을 이어가서 중지했어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głos mówił bez końca, więc go zatrzymano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz não parava de falar, então foi interrompida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音持续不停地说下去，因此已停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音持續不停地說下去，因此已停止。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmen blev ved med at tale, så den blev stoppet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni ei lakannut puhumasta, joten se pysäytettiin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Röddin hætti ekki að tala, svo henni var hætt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmen ville ikke slutte å snakke, så den ble stoppet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rösten ville inte sluta prata, så den stoppades."
          }
        }
      }
    },
    "This app and voice-bridge speak different versions. Update the older one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app and voice-bridge speak different versions. Update the older one."
          }
        },
        "de": {
          "stringUnit": {
