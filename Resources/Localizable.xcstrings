          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app et chaque serveur avec lequel elle échange : ce que chacun exécute et ce qu'il pourrait exécuter"
          }
        },
        "it": {
          "stringUnit": {
