    "This Mac cannot draw the head, so every turn stays as flat lines.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac cannot draw the head, so every turn stays as flat lines."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac kann den Kopf nicht darstellen, daher bleibt jede Runde eine flache Zeile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no puede dibujar la cabeza, así que cada turno sigue como líneas planas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne peut pas dessiner la tête : chaque tour reste en lignes plates."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non può disegnare la testa, quindi ogni turno resta in righe piatte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac では頭部を描画できないため、すべてのターンは平らな行のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 머리를 그릴 수 없어 모든 턴이 평평한 줄로 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie potrafi narysować głowy, więc każda tura pozostaje płaskimi wierszami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não consegue desenhar a cabeça, então cada turno continua como linhas simples."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 无法绘制头部，因此每个回合都保持为平面行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 無法繪製頭部，因此每個回合都保持為平面行。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac kan ikke tegne hovedet, så hver tur forbliver en flad linje."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Mac ei voi piirtää päätä, joten jokainen vuoro pysyy tasaisina riveinä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi Mac getur ekki teiknað hausinn, svo hver umferð helst sem flatar línur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen kan ikke tegne hodet, så hver tur forblir som flate linjer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här Mac:en kan inte rita huvudet, så varje tur förblir en platt linje."
          }
        }
      }
    },
