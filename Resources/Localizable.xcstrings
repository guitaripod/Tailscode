    "Hand a bounded task to a cheaper tier and get back a verified patch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine begrenzte Aufgabe an eine günstigere Stufe ab und erhalte einen verifizierten Patch zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand a bounded task to a cheaper tier and get back a verified patch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encarga una tarea acotada a un nivel más económico y recibe a cambio un parche verificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confiez une tâche délimitée à un niveau moins cher et récupérez un correctif vérifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affida un compito limitato a un livello più economico e ricevi in cambio una patch verificata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲を絞ったタスクを安い段に渡し、検証済みのパッチを受け取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범위가 정해진 작업을 더 저렴한 단에 맡기고 검증된 패치를 돌려받으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entregue uma tarefa limitada a um nível mais barato e receba de volta um patch verificado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把一个范围明确的任务交给更便宜的一级，换回一个经过验证的补丁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把一個範圍明確的任務交給更便宜的一級，換回一個經過驗證的修補程式。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekaż ograniczone zadanie tańszemu szczeblowi i odbierz zweryfikowaną łatkę."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overdrag en afgrænset opgave til et billigere niveau, og få et verificeret patch tilbage."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna rajattu tehtävä halvemmalle tasolle, ja saat takaisin vahvistetun patchin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Feldu afmarkað verkefni ódýrara þrepi og fáðu staðfestan patch til baka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi en avgrenset oppgave til et billigere nivå og få tilbake en verifisert patch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna en avgränsad uppgift till en billigare nivå och få tillbaka en verifierad patch."
          }
        }
      }
    },
