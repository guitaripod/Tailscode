    "Clear the stage, the reference and the words. Every picture stays on the shelf.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leert die Bühne, die Referenz und die Wörter. Jedes Bild bleibt im Regal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the stage, the reference and the words. Every picture stays on the shelf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacía el escenario, la referencia y las palabras. Cada imagen se queda en la estantería."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide la scène, la référence et les mots. Chaque image reste sur l’étagère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Svuota il palco, il riferimento e le parole. Ogni immagine resta sullo scaffale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージ、参照、言葉を消去します。画像はすべて棚に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무대, 참조, 문구를 지웁니다. 모든 사진은 선반에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa o palco, a referência e as palavras. Cada imagem continua na prateleira."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清空舞台、参考图和文字。每张图片都留在架子上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清空舞台、參考圖和文字。每張圖片都留在架子上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyczyść scenę, referencję i słowa. Każdy obraz zostaje na półce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ryd scenen, referencen og ordene. Alle billeder bliver på hylden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjennä näyttämö, viite ja sanat. Jokainen kuva pysyy hyllyllä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hreinsar sviðið, viðmiðið og orðin. Allar myndir haldast í hillunni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tøm scenen, referansen og ordene. Alle bilder blir liggende i hyllen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensa scenen, referensen och orden. Varje bild finns kvar i hyllan."
          }
        }
      }
    },
