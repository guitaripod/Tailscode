          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é um atalho de edição em todo app nesta máquina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在这台机器上的每个应用里都是一个编辑快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在這台機器上的每個應用程式裡都是一個編輯快速鍵。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
