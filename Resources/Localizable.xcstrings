            "state": "translated",
            "value": "Where is it now?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde está ahora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où est-ce actuellement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove si trova ora?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今どこにありますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 어디에 있나요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde ele está agora?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它现在在哪里？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它現在在哪裡？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdzie to teraz jest?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvor findes den nu?"
          }
        },
