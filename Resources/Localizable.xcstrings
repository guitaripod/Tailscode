    "A picture to edit: choose a file, paste, or take one from the machine's shelf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A picture to edit: choose a file, paste, or take one from the machine's shelf"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bild zum Bearbeiten: Datei wählen, einfügen oder aus dem Regal der Maschine nehmen"
          }
        },
        "es": {
          "stringUnit": {
