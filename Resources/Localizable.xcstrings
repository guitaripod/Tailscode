          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es hat nur geschaut: %lld Dateien gelesen, nichts geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo miró: leyó %lld archivos, no cambió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a seulement regardé : %lld fichiers lus, rien modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha solo guardato: letti %lld file, nulla modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認のみ：%lld 個のファイルを読み、変更はありません。"
