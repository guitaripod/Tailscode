    "The terminal's folders belong to this machine and none of your servers runs on it": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The terminal's folders belong to this machine and none of your servers runs on it"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ordner des Terminals gehören zu diesem Rechner, und keiner deiner Server läuft darauf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas de la terminal pertenecen a este equipo y ninguno de tus servidores se ejecuta en él"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers du terminal appartiennent à cette machine et aucun de vos serveurs n'y tourne"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cartelle del terminale appartengono a questa macchina e nessuno dei tuoi server vi è in esecuzione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルのフォルダはこのマシンのものですが、このマシンで動いているサーバがありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널의 폴더는 이 컴퓨터의 것인데, 이 컴퓨터에서 실행 중인 서버가 없습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Foldery terminala należą do tego komputera, a żaden z Twoich serwerów na nim nie działa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pastas do terminal pertencem a esta máquina e nenhum dos seus servidores roda nela"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端的文件夹属于这台机器，而你的服务器都没有运行在这台机器上"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機的資料夾屬於這台機器，而你的伺服器都沒有執行在這台機器上"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalens mapper hører til denne computer, og ingen af dine servere kører på den"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päätteen kansiot kuuluvat tähän tietokoneeseen, eikä yksikään palvelimistasi toimi sillä"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Möppur Terminal tilheyra þessari tölvu og enginn netþjónanna þinna keyrir á henni"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalens mapper hører til denne maskinen, og ingen av serverne dine kjører på den"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalens mappar hör till den här datorn, och ingen av dina servrar körs på den"
          }
        }
      }
    },
