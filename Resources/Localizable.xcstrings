    "Waiting on the server for this turn, where every device sees it. Click to edit, or press ↑ in an empty composer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting on the server for this turn, where every device sees it. Click to edit, or press ↑ in an empty composer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet auf dem Server auf diesen Zug, wo jedes Gerät es sieht. Zum Bearbeiten klicken oder in einem leeren Eingabefeld ↑ drücken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera en el servidor a que termine este turno, donde todos los dispositivos la ven. Haz clic para editar o pulsa ↑ con el cuadro de texto vacío"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente sur le serveur de la fin de ce tour, visible de tous les appareils. Cliquez pour modifier, ou appuyez sur ↑ dans une zone de saisie vide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa sul server che questo turno finisca, visibile da ogni dispositivo. Fai clic per modificare o premi ↑ con il campo di testo vuoto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターンが終わるのをサーバーで待っています。すべてのデバイスから見えます。クリックで編集、または空の入力欄で↑を押します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 턴이 끝나기를 서버에서 기다리는 중이며 모든 기기에서 보입니다. 클릭하여 편집하거나 빈 입력창에서 ↑를 누르세요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czeka na serwerze na koniec tej tury i jest widoczna na każdym urządzeniu. Kliknij, aby edytować, lub naciśnij ↑ w pustym polu wiadomości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando no servidor o fim deste turno, onde todos os dispositivos a veem. Clique para editar ou pressione ↑ com o campo de texto vazio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在服务器上等待本轮结束，所有设备都能看到。点按可编辑，或在空输入框中按 ↑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在伺服器上等待本輪結束，所有裝置都看得到。點按可編輯，或在空白輸入框中按 ↑"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på serveren på denne tur, hvor alle enheder kan se den. Klik for at redigere, eller tryk ↑ i et tomt inputfelt"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odottaa palvelinta tälle vuorolle, jossa jokainen laite sen näkee. Muokkaa napsauttamalla tai paina ↑ tyhjässä kehotekentässä"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bíður eftir netþjóninum fyrir þessa umferð, þar sem hvert tæki sér hana. Smelltu til að breyta, eða ýttu á ↑ í auðum innsláttarreit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på serveren for denne turen, der alle enheter ser den. Klikk for å redigere, eller trykk ↑ i et tomt felt"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på servern för den här turen, där alla enheter ser den. Klicka för att redigera, eller tryck på ↑ i ett tomt inmatningsfält"
          }
        }
      }
    },
