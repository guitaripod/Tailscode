    "It opens here. Sign in with your Anthropic account and it hands you a code.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie öffnet sich hier. Melde dich mit deinem Anthropic-Konto an, und du bekommst einen Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It opens here. Sign in with your Anthropic account and it hands you a code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre aquí. Inicia sesión con tu cuenta de Anthropic y te dará un código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
