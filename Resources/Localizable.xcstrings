          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold nede på Send for at forbedre dit udkast med modellen på enheden"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä Lähetä-painiketta painettuna, jotta luonnos hiotaan laitteella toimivalla mallilla"
