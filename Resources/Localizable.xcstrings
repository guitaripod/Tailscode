    "Press and slide to change, or swipe up or down": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and slide to change, or swipe up or down"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken und schieben zum Ändern oder nach oben bzw. unten wischen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado y desliza para cambiar, o desliza hacia arriba o abajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez et faites glisser pour changer, ou balayez vers le haut ou le bas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi e trascina per cambiare, oppure scorri verso l’alto o il basso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したままスライドして変更するか、上下にスワイプします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눌러서 밀어 변경하거나 위아래로 쓸어 넘기세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione e deslize para alterar, ou deslize para cima ou para baixo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住并滑动即可更改,或向上、向下轻扫"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住並滑動即可更改,或向上、向下輕掃"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij i przesuń, aby zmienić, lub przesuń w górę albo w dół"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og skub for at ændre, eller stryg op eller ned"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina ja liu’uta muuttaaksesi tai pyyhkäise ylös tai alas"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu og renndu til að breyta, eða strjúktu upp eða niður"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk og skyv for å endre, eller sveip opp eller ned"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck och skjut för att ändra, eller svep uppåt eller nedåt"
          }
        }
