    "This session has no message bus to ask for a key.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session has no message bus to ask for a key."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzung hat keinen Nachrichtenbus, um nach einem Schlüssel zu fragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión no tiene un bus de mensajes para pedir una clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session n'a pas de bus de messages pour demander une clé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa sessione non ha un bus di messaggi per chiedere una chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションにはキーを要求するためのメッセージバスがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션에는 키를 요청할 메시지 버스가 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta sesja nie ma magistrali komunikatów, by poprosić o klucz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sessão não tem barramento de mensagens para pedir uma chave."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话没有消息总线可用于请求密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作階段沒有訊息匯流排可用於請求金鑰。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne session har ingen kanal til at bede om en nøgle."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä istunnossa ei ole viestiväylää avaimen pyytämiseen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi seta hefur engan skilaboðarás til að biðja um lykil."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne økten har ingen meldingsbuss for å be om en nøkkel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här sessionen har ingen meddelandebuss för att begära en nyckel."
          }
        }
      }
    },
    "Without waiting for enter, once its tokens are gathered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without waiting for enter, once its tokens are gathered"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne auf enter zu warten, sobald seine Tokens gesammelt sind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin esperar a enter, en cuanto reúna sus tokens"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans attendre enter, une fois ses jetons rassemblés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza attendere enter, appena raccolti i suoi token"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "enter を待たず、トークンが集まり次第送信"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "enter를 기다리지 않고 토큰이 모이는 대로 보내기"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez czekania na enter, gdy zbierze tokeny"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem esperar enter, assim que reunir seus tokens"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需等待 enter，一旦收齐其 token 即发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需等待 enter，一旦收齊其 token 即送出"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden at vente på enter, når dens tokens er samlet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman enterin odottamista, kun sen tokenit on koottu"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Án þess að bíða eftir enter, þegar tákn þess hafa safnast"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten å vente på enter, når tokenene er samlet"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan att vänta på enter, när dess token har samlats in"
          }
        }
      }
    },
