    "%@ is not set up for %@ — its model files are missing. Choose the other engine or add the files.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht für %@ eingerichtet — seine Modelldateien fehlen. Wähle die andere Engine oder füge die Dateien hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not set up for %@ — its model files are missing. Choose the other engine or add the files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está configurado para %@ — faltan sus archivos de modelo. Elige el otro motor o añade los archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas configuré pour %@ — il lui manque ses fichiers de modèle. Choisissez l’autre moteur ou ajoutez les fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è configurato per %@ — mancano i suoi file del modello. Scegli l’altro motore o aggiungi i file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %@ 用に設定されていません — モデルファイルが不足しています。別のエンジンを選ぶか、ファイルを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) %@에 맞게 설정되지 않았습니다 — 모델 파일이 없습니다. 다른 엔진을 선택하거나 파일을 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não está configurado para %@ — faltam seus arquivos de modelo. Escolha o outro motor ou adicione os arquivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚未针对 %@ 完成设置 — 缺少其模型文件。请选择另一个引擎，或添加所需文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚未針對 %@ 完成設定 — 缺少其模型檔案。請選擇另一個引擎，或新增所需檔案。"
          }
        }
      }
    },
