        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 순서의 첫 키는 이미 단독으로 쓰이고 있어(%@) 이 순서에는 도달할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwszy klawisz tej sekwencji jest już używany samodzielnie (%@), więc sekwencja nigdy nie mogłaby zadziałać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A primeira tecla desta sequência já é usada sozinha (%@), então a sequência nunca poderia ser alcançada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该组合的第一个按键已单独用于其他操作（%@），因此这个组合永远无法触发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此組合的第一個按鍵已單獨用於其他操作（%@），因此這個組合永遠無法觸發。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den første tast i denne sekvens bruges allerede alene (%@), så sekvensen kunne aldrig nås."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän sarjan ensimmäistä näppäintä käytetään jo yksinään (%@), joten sarja ei olisi koskaan saavutettavissa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyrsti takki þessarar runu er þegar notaður einn og sér (%@), svo runan gæti aldrei náðst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den første tasten i denne sekvensen brukes allerede alene (%@), så sekvensen kunne aldri nås."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den första tangenten i den här följden används redan ensam (%@), så följden skulle aldrig kunna nås."
          }
        }
      }
    },
