    "Something answers there, but it does not speak %@. Check the address — this is usually a port belonging to something else on that machine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dort antwortet etwas, aber es spricht kein %@. Prüfe die Adresse – das ist meist ein Port, der zu etwas anderem auf diesem Rechner gehört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something answers there, but it does not speak %@. Check the address — this is usually a port belonging to something else on that machine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo responde ahí, pero no habla %@. Comprueba la dirección: suele ser un puerto que pertenece a otra cosa en esa máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose répond là-bas, mais cela ne parle pas %@. Vérifiez l’adresse — il s’agit généralement d’un port appartenant à autre chose sur cette machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa risponde lì, ma non parla %@. Verifica l’indirizzo — di solito è una porta che appartiene a qualcos’altro su quella macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこでは何かが応答していますが、%@ を話していません。アドレスを確認してください — たいていはそのマシン上の別のものが使っているポートです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그곳에서 무언가 응답하지만 %@ 프로토콜을 사용하지 않습니다. 주소를 확인하세요 — 대개 그 컴퓨터에서 다른 무언가가 쓰고 있는 포트입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo responde lá, mas não fala %@. Verifique o endereço — geralmente é uma porta pertencente a outra coisa naquela máquina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那里有东西在应答，但它不使用 %@ 协议。请检查地址——这通常是那台机器上属于其他程序的端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那裡有東西在回應，但它不使用 %@ 通訊協定。請檢查位址——這通常是那台機器上屬於其他程式的埠號。"
          }
        }
      }
    },
    "%@ rejected this device's password": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat das Passwort dieses Geräts abgelehnt"
          }
        },
        "en": {
