    "This terminal runs one command at a time, so a cd does not carry over to a split": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This terminal runs one command at a time, so a cd does not carry over to a split"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Terminal führt jeweils nur einen Befehl aus, ein cd wirkt sich daher nicht auf eine Teilung aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta terminal ejecuta un comando a la vez, así que un cd no pasa a la división"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce terminal exécute une commande à la fois : un cd ne se transmet donc pas à une division"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo terminale esegue un comando alla volta, quindi un cd non passa alla divisione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターミナルは一度に1つのコマンドしか実行しないため、cd は分割に引き継がれません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 터미널은 한 번에 명령 하나만 실행하므로 cd가 분할로 이어지지 않습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten terminal wykonuje jedno polecenie naraz, więc cd nie przenosi się do podziału"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este terminal executa um comando por vez, então um cd não passa para a divisão"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此终端一次只运行一条命令，因此 cd 不会带入拆分窗格"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此終端機一次只執行一個命令，因此 cd 不會帶入分割窗格"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne terminal kører én kommando ad gangen, så et cd ikke følger med til en opdelt visning"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä pääte suorittaa kerrallaan yhden komennon, joten cd-komento ei siirry jaettuun näkymään"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta Terminal keyrir eina skipun í einu, svo cd berst ekki yfir í skiptan skjá"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
