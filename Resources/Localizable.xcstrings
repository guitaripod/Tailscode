    "Alpha — a GPU-rendered creature over Home that breathes what every conversation is doing; may cost battery": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alpha — ein GPU-gerendertes Wesen über dem Start, das atmet, was jede Unterhaltung gerade tut; kann Akku kosten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alpha — a GPU-rendered creature over Home that breathes what every conversation is doing; may cost battery"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfa — una criatura renderizada por GPU sobre Inicio que respira lo que hace cada conversación; puede costar batería"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alpha — une créature rendue par le GPU au-dessus de l’Accueil, qui respire ce que fait chaque conversation ; peut coûter de la batterie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alpha — una creatura renderizzata dalla GPU sopra Home che respira ciò che sta facendo ogni conversazione; può costare batteria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルファ版 — ホーム画面の上に浮かぶ GPU 描画の生き物で、すべての会話の様子を呼吸のように表します。バッテリーを消費する場合があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알파 — 홈 화면 위에 떠 있는 GPU 렌더링 생물로, 모든 대화가 하는 일을 숨쉬듯 표현합니다. 배터리를 소모할 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfa — uma criatura renderizada por GPU sobre a Início que respira o que cada conversa está fazendo; pode custar bateria"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内测 — 一个在主页上方以 GPU 渲染的生物，会随每段对话的动态呼吸；可能会更耗电"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內測 — 一個在主頁上方以 GPU 渲染的生物，會隨每段對話的動態呼吸；可能會更耗電"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alpha — renderowane przez GPU stworzenie nad ekranem głównym, które oddycha tym, co robi każda rozmowa; może zużywać baterię"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alpha: en GPU-renderet skabning over Hjem, der ånder i takt med, hvad hver samtale gør; kan koste batteri"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfa – GPU:lla piirretty olento Koti-näkymän päällä, joka hengittää sen mukaan, mitä jokainen keskustelu tekee; voi kuluttaa akkua"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfa – GPU-teiknuð skepna yfir Heim-flipanum sem andar í takt við það sem hvert samtal er að gera; getur kostað rafhlöðu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfa – et GPU-tegnet vesen over Hjem som pulserer med hva hver samtale gjør; kan tære på batteriet"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfa – en GPU-renderad varelse över Hem som andas vad varje konversation gör; kan kosta batteri"
          }
        }
      }
    },
