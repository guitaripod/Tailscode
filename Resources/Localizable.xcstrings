    "This app and every server it talks to: what each runs and what it could run": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app and every server it talks to: what each runs and what it could run"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App und jeder Server, mit dem sie spricht: was jeder läuft und was er laufen könnte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
