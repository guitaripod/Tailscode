    "100.x.y.z, a MagicDNS name, host:port — or a whole line pasted out of ComfyUI's terminal. Port %@ is added when you don't name one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "100.x.y.z, ein MagicDNS-Name, host:port — oder eine ganze Zeile, die du aus dem Terminal von ComfyUI eingefügt hast. Port %@ wird ergänzt, wenn du keinen angibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "100.x.y.z, a MagicDNS name, host:port — or a whole line pasted out of ComfyUI's terminal. Port %@ is added when you don't name one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "100.x.y.z, un nombre MagicDNS, host:puerto — o una línea completa pegada de la terminal de ComfyUI. Se añade el puerto %@ si no indicas ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "100.x.y.z, un nom MagicDNS, host:port — ou une ligne entière collée depuis le terminal de ComfyUI. Le port %@ est ajouté si vous n’en indiquez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "100.x.y.z, un nome MagicDNS, host:porta — oppure un’intera riga incollata dal terminale di ComfyUI. Se non ne indichi una, viene aggiunta la porta %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100.x.y.z、MagicDNS 名、host:port — または ComfyUI のターミナルからコピーした行全体でも構いません。ポートを指定しない場合は %@ が付加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "100.x.y.z, MagicDNS 이름, host:port — 또는 ComfyUI 터미널에서 복사한 줄 전체도 가능합니다. 포트를 지정하지 않으면 %@이 추가됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "100.x.y.z, um nome MagicDNS, host:porta — ou uma linha inteira colada do terminal do ComfyUI. A porta %@ é adicionada quando você não especifica uma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "100.x.y.z、MagicDNS 名称、host:port — 或者直接粘贴从 ComfyUI 终端复制的整行内容。如果不指定端口，会自动加上 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "100.x.y.z、MagicDNS 名稱、host:port — 或直接貼上從 ComfyUI 終端機複製的整行內容。如果不指定連接埠，會自動加上 %@。"
          }
        }
      }
    },
