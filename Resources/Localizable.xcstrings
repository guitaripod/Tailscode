    "An approval to give or a question to answer; withdrawn once it is answered": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Freigabe zu erteilen oder eine Frage zu beantworten; entfällt, sobald sie beantwortet ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An approval to give or a question to answer; withdrawn once it is answered"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una aprobación por dar o una pregunta por responder; se retira en cuanto se responde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une approbation à donner ou une question à laquelle répondre ; retirée dès qu’elle a reçu une réponse"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’approvazione da dare o una domanda a cui rispondere; ritirata non appena riceve una risposta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認を求められているか、質問に答える必要がある状態 — 応答すると取り下げられます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인을 내리거나 질문에 답해야 하는 상태 — 응답하면 철회됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma aprovação para dar ou uma pergunta para responder; é retirada assim que é respondida"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你给出批准或回答一个问题 — 一旦被回应就会撤回"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你給出核准或回答一個問題 — 一旦被回應就會撤回"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgoda do wydania lub pytanie do odpowiedzenia; znika, gdy zostanie udzielona odpowiedź"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En godkendelse at give eller et spørgsmål at besvare; fjernes, når det er besvaret"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyväksyntä, jonka annat, tai kysymys, johon vastaat; peruutetaan, kun siihen on vastattu"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Samþykki til að veita eða spurning til að svara; fellur niður þegar henni hefur verið svarað"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En godkjenning å gi eller et spørsmål å svare på. Fjernes når det er besvart."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett godkännande att ge eller en fråga att svara på; försvinner när den har besvarats"
          }
        }
      }
    },
