    "Words the render keeps out. It raises guidance to make them count, so the picture takes longer.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörter, die der Render weglässt. Das erhöht die Guidance, damit sie zählen, wodurch das Bild länger dauert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words the render keeps out. It raises guidance to make them count, so the picture takes longer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Palabras que el render deja fuera. Eso sube la guía para que cuenten, por lo que la imagen tarda más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mots que le rendu exclut. Cela augmente le guidage pour qu’ils comptent, si bien que l’image prend plus de temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parole che il render esclude. Questo alza la guida perché contino, così l’immagine richiede più tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンダリングが除外する言葉です。それらを反映させるためガイダンスを上げるので、画像の生成に時間がかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌더링이 제외하는 문구입니다. 그것들이 반영되도록 가이던스를 높이기 때문에, 그림이 완성되기까지 더 오래 걸립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Palavras que a renderização deixa de fora. Isso aumenta a orientação para que contem, por isso a imagem demora mais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渲染会排除的文字。这会提高引导强度以确保它们生效，因此图片需要更长时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "渲染會排除的文字。這會提高引導強度以確保它們生效，因此圖片需要更長時間。"
          }
        }
      }
    },
