    "%@ answers, but not like an agent server — is something else on this port?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ antwortet, aber nicht wie ein Agent-Server — läuft dort etwas anderes auf diesem Port?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ answers, but not like an agent server — is something else on this port?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ responde, pero no como un servidor de agente: ¿hay algo más en este puerto?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ répond, mais pas comme un serveur d’agent — autre chose tourne-t-il sur ce port ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ risponde, ma non come un server per agenti — c’è qualcos’altro su questa porta?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は応答しますが、エージェントサーバのようではありません — このポートで別の何かが動いていませんか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 응답하지만 에이전트 서버 같지 않습니다 — 이 포트에서 다른 무언가가 실행 중인가요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ responde, mas não como um servidor de agente — será que há outra coisa nessa porta?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 有响应，但不像是智能体服务器 — 是不是有别的东西在用这个端口？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 有回應，但不像是代理伺服器 — 是不是有別的東西在用這個埠？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ odpowiada, ale nie jak serwer agenta — czy na tym porcie działa coś innego?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarer, men ikke som en agentserver – kører der noget andet på denne port?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vastaa, mutta ei kuten agenttipalvelin – onko tässä portissa jotain muuta?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarar, en ekki eins og netþjónn fyrir agenta – er eitthvað annað á þessari gátt?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarer, men ikke som en agentserver. Er det noe annet på denne porten?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarar, men inte som en agentserver. Är det något annat på den porten?"
          }
        }
      }
    },
