    "Not sent yet. It goes to the server when it answers. Click to edit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sent yet. It goes to the server when it answers. Click to edit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht gesendet. Sie geht an den Server, sobald er antwortet. Zum Bearbeiten klicken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no enviado. Se enviará al servidor cuando responda. Haz clic para editar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore envoyé. Il part vers le serveur dès qu'il répond. Cliquez pour modifier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora inviato. Va al server appena risponde. Fai clic per modificare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ送信されていません。サーバーが応答したら送られます。クリックで編集"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 전송되지 않았습니다. 서버가 응답하면 전송됩니다. 클릭하여 편집"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nie wysłano. Trafi na serwer, gdy ten odpowie. Kliknij, aby edytować"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não enviado. Vai para o servidor quando ele responder. Clique para editar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未发送。服务器响应后会发送过去。点按可编辑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未傳送。伺服器回應後會傳送過去。點按可編輯"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke sendt endnu. Den sendes til serveren, når den svarer. Klik for at redigere"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä lähetetty. Se menee palvelimelle, kun agentti vastaa. Muokkaa napsauttamalla"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki sent ennþá. Það fer á netþjóninn þegar hann svarar. Smelltu til að breyta"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke sendt ennå. Den går til serveren når den svarer. Klikk for å redigere"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte skickat ännu. Meddelandet skickas till servern när den svarar. Klicka för att redigera"
          }
        }
      }
    },
