    "Anything OpenAI-shaped will do: Ollama, llama-swap, llama.cpp, LM Studio or vLLM on the machine that paints or on this one": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles im OpenAI-Format funktioniert: Ollama, llama-swap, llama.cpp, LM Studio oder vLLM auf dem malenden Rechner oder auf diesem hier"
          }
        },
        "en": {
          "stringUnit": {
