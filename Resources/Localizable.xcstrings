    "This Mac is on your tailnet. The machine that runs the agent has to be signed into the same account.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac is on your tailnet. The machine that runs the agent has to be signed into the same account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac ist im tailnet. Der Rechner, auf dem der Agent läuft, muss mit demselben Konto angemeldet sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac está en la tailnet. El equipo que ejecuta el agente debe tener la sesión iniciada con la misma cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac est sur le tailnet. La machine qui fait tourner l'agent doit être connectée au même compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac è nel tailnet. Il computer che esegue l'agente deve essere connesso con lo stesso account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac は tailnet に参加しています。エージェントを実行するマシンも、同じアカウントでサインインしている必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 tailnet에 연결되어 있어요. 에이전트를 실행하는 컴퓨터도 같은 계정으로 로그인되어 있어야 해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac jest w tailnecie. Komputer, na którym działa agent, musi być zalogowany na to samo konto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac está na sua tailnet. O computador que executa o agente precisa estar conectado à mesma conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 已加入你的 tailnet。运行代理的电脑必须登录同一个账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 已加入你的 tailnet。執行代理的電腦必須登入同一個帳戶。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac er i dit tailnet. Computeren, der kører agenten, skal være logget ind med den samme konto."
          }
        },
