    "Rendering happens on the machine with the card, not on this one": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Rendern erfolgt auf dem Rechner mit der Grafikkarte, nicht auf diesem hier"
