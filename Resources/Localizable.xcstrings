    "**Tap a name** to rename it, **the model** to replace it, **the button** on a ball to change its level.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tap a name** to rename it, **the model** to replace it, **the button** on a ball to change its level."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tippe auf einen Namen**, um ihn umzubenennen, **auf das Modell**, um es zu ersetzen, **auf den Knopf** auf einer Kugel, um die Stufe zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Toca un nombre** para renombrarlo, **el modelo** para reemplazarlo, **el botón** de una bola para cambiar su nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Touchez un nom** pour le renommer, **le modèle** pour le remplacer, **le bouton** sur une pastille pour changer son niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tocca un nome** per rinominarlo, **il modello** per sostituirlo, **il pulsante** su una pallina per cambiarne il livello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**名前をタップ**して名称を変更、**モデル**をタップして置き換え、球の**ボタンをタップ**するとレベルを変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 **탭하면** 이름을 바꿀 수 있고, **모델을 탭하면** 교체할 수 있으며, 공의 **버튼을 탭하면** 단계를 바꿀 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dotknij nazwy**, by ją zmienić, **modelu**, by go zastąpić, **przycisku** na kulce, by zmienić poziom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Toque em um nome** para renomeá-lo, **no modelo** para substituí-lo, **no botão** de uma bolinha para mudar o nível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**点按名称**即可重命名，**点按模型**即可替换，**点按圆球上的按钮**即可更改等级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**點按名稱**即可重新命名，**點按模型**即可替換，**點按圓球上的按鈕**即可變更等級。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tryk på et navn** for at omdøbe det, **på modellen** for at erstatte den, **på knappen** på en kugle for at ændre niveau."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta **nimeä** nimetäksesi uudelleen, **mallia** vaihtaaksesi sen ja pallon **painiketta** muuttaaksesi tasoa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "**Banka á nafn** til að endurnefna það, **á líkanið** til að skipta um það, **á hnappinn** á kúlu til að breyta stig hennar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Trykk på et navn** for å gi det nytt navn, **på modellen** for å bytte den ut, **på knappen** på en kule for å endre nivået."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tryck på ett namn** för att byta namn, **på modellen** för att ersätta den, **på knappen** på en kula för att ändra nivå."
          }
        }
      }
    },
