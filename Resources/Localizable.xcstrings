    "The zone is full, so the rest gather here. Rows lists every one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The zone is full, so the rest gather here. Rows lists every one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zone ist voll, deshalb sammeln sich die übrigen hier. Reihen listet jeden einzeln auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona está llena, así que el resto se reúne aquí. Filas enumera cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La zone est pleine : les autres se regroupent ici. Rangées les liste toutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La zona è piena, quindi gli altri si raccolgono qui. Righe li elenca tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゾーンは満杯のため、残りはここにまとまります。「行」にすべて表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 영역이 가득 차서 나머지는 여기에 모입니다. 행 목록에서 모두 볼 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strefa jest pełna, więc pozostałe zbierają się tutaj. Lista wierszy pokazuje każdy z nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A zona está cheia, então o restante se reúne aqui. Fileiras lista cada um."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该区域已满，其余步骤汇集在这里。“行”会列出每一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該區域已滿，其餘步驟匯集在這裡。「行」會列出每一步。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonen er fuld, så resten samles her. Rækker viser hver enkelt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alue on täynnä, joten loput kerääntyvät tähän. Rivit-näkymä listaa jokaisen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Svæðið er fullt, svo hin safnast saman hér. Raðir sýnir hvert þeirra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonen er full, så resten samles her. Rader viser hver enkelt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonen är full, så resten samlas här. Rader visar alla."
          }
        }
      }
    },
