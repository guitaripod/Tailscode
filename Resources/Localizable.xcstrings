    "Narrowing to this door lists only what %@ runs through it, and a pick goes through it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einschränkung auf diese Tür listet nur, was %@ über sie betreibt, und eine Auswahl läuft über sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Narrowing to this door lists only what %@ runs through it, and a pick goes through it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducir a esta puerta solo lista lo que %@ ejecuta a través de ella, y una elección pasará por ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se limiter à cette porte ne liste que ce que %@ exécute par son biais, et un choix y passera aussi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Restringere a questa porta elenca solo ciò che %@ esegue attraverso di essa, e una scelta passerà da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この扉に絞り込むと、%@ がこの扉を通じて実行しているものだけが表示され、選択もこの扉を通ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문으로 좁히면 %@이(가) 이 문을 통해 실행하는 것만 표시되며, 선택도 이 문을 통해 나갑니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restringir a esta porta lista apenas o que %@ executa por meio dela, e uma escolha passará por ela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩小到这扇门后，只会列出 %@ 通过它运行的内容，选择也会经由它发出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮小到這扇門後，只會列出 %@ 透過它執行的內容，選擇也會經由它送出。"
          }
        }
      }
    },
