          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as áreas e o zoom da janela voltam ao normal"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有区域和窗口缩放都恢复正常"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
