    },
    "The patch waits for you to read it; nothing touches the tree until you apply it.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Patchen venter på, at du læser den; intet rører arbejdskataloget, før du anvender den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Patch wartet darauf, dass du ihn liest; nichts berührt das Arbeitsverzeichnis, bevor du ihn anwendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The patch waits for you to read it; nothing touches the tree until you apply it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El parche espera a que lo leas; nada toca el árbol de trabajo hasta que lo apliques."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Patch odottaa, että luet sen; mikään ei kosketa työhakemistoa, ennen kuin käytät sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le correctif attend que vous le lisiez ; rien ne touche l’arbre de travail tant que vous ne l’appliquez pas."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Patchið bíður eftir að þú lesir það; ekkert snertir vinnumöppuna fyrr en þú beitir því."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La patch attende che tu la legga; nulla tocca l’albero di lavoro finché non la applichi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッチはあなたが読むまで待機します。適用するまで作業ツリーには何も触れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패치는 읽어 보실 때까지 대기합니다. 적용하기 전에는 작업 트리에 아무것도 닿지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Patchen venter til du har lest den. Ingenting berører arbeidskatalogen før du bruker den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łatka czeka, aż ją przeczytasz; nic nie dotyka drzewa roboczego, dopóki jej nie zastosujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O patch espera você lê-lo; nada toca a árvore de trabalho até você aplicá-lo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Patchen väntar tills du har läst den, och ingenting rör arbetskatalogen förrän du tillämpar den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补丁会等你阅读；在你应用之前，工作树不会有任何改动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修補程式會等你閱讀；在你套用之前，工作樹不會有任何變動。"
          }
        }
      }
    },
