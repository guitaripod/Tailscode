    "A turn is running on it. The restart waits for it to finish.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A turn is running on it. The restart waits for it to finish."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf ihm läuft gerade ein Zug. Der Neustart wartet, bis er fertig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un turno en curso en él. El reinicio espera a que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour est en cours dessus. Le redémarrage attend qu’il se termine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C’è un turno in corso su di esso. Il riavvio attende che finisca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこでは 1 件のターンが実行中です。再起動はそれが終わるまで待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 위에서 턴 1개가 실행 중입니다. 재시동은 끝날 때까지 기다립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa na nim tura. Ponowne uruchomienie poczeka, aż się zakończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um turno em execução nele. O reinício espera que ele termine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上面正在运行一个回合。重新启动会等它结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上面正在執行一個回合。重新開機會等它結束。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En tur kører på den. Genstarten venter, til den er færdig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sillä on käynnissä vuoro. Uudelleenkäynnistys odottaa, että se päättyy."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Umferð er í gangi á honum. Endurræsingin bíður þar til umferðin klárast."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En tur kjører på den. Omstarten venter til den er ferdig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tur körs på den. Omstarten väntar tills den är klar."
          }
        }
      }
    },
