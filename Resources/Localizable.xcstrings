        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten serwer nie udostępnił katalogu poleceń. Wpisane ukośniki nadal są wysyłane jako wiadomości."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne server har ikke leveret et kommandokatalog. Indtastede skråstreger sendes stadig som beskeder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin ei tarjonnut komentoluetteloa. Kirjoitetut kenoviivakomennot lähetetään silti viesteinä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
