    "Closing this leaves the picture rendering on the machine with the card. Come back and it will still be here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du das schließt, läuft das Rendern des Bildes auf dem Rechner mit der Grafikkarte weiter. Komm zurück, und es ist noch da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing this leaves the picture rendering on the machine with the card. Come back and it will still be here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar esto no detiene el renderizado de la imagen en la máquina con la tarjeta gráfica. Vuelve y seguirá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer ceci laisse l’image continuer son rendu sur la machine équipée de la carte graphique. Revenez et elle sera toujours là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudendo questa schermata, il rendering dell’immagine continua sulla macchina con la scheda grafica. Torna e la troverai ancora qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを閉じても、グラフィックカードを積んだマシン上で画像のレンダリングは続きます。戻ってくれば、まだここにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면을 닫아도 그래픽 카드가 있는 컴퓨터에서 이미지 렌더링은 계속됩니다. 다시 돌아오면 그대로 남아 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar isto não interrompe a renderização da imagem na máquina com a placa de vídeo. Volte depois e ela ainda estará aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭这个不会中断在那台显卡机器上进行的图片渲染。回来时它还会在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉這個不會中斷在那台顯示卡機器上進行的圖片算圖。回來時它還會在這裡。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięcie tego nie przerywa renderowania obrazu na komputerze z kartą graficzną. Wróć, a nadal tu będzie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du lukker dette, fortsætter renderingen af billedet på computeren med grafikkortet. Kom tilbage, så er det stadig her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun suljet tämän, kuvan renderöinti jatkuu tietokoneella, jossa on näytönohjain. Palaa myöhemmin, ja kuva on yhä tallella."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ef þú lokar þessu heldur myndin áfram að vera í vinnslu á tölvunni með skjákortinu. Komdu aftur og hún verður enn þar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukker du dette, fortsetter bildet å rendres på maskinen med grafikkortet. Kom tilbake, så er det fortsatt her."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du stänger detta fortsätter bilden att renderas på datorn med grafikkortet. Kom tillbaka så finns den kvar."
          }
        }
      }
    },
