    "The agent reads the surface as it is now, then draws each alternative as a mock you can look at — no source is changed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent liest die Oberfläche so, wie sie jetzt ist, und zeichnet dann jede Alternative als Mock-up, das du dir ansehen kannst – am Quellcode ändert sich nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent reads the surface as it is now, then draws each alternative as a mock you can look at — no source is changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente lee la interfaz tal como está ahora, y luego dibuja cada alternativa como una maqueta que puedes revisar — no se cambia ningún código fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent lit l’interface telle qu’elle est actuellement, puis dessine chaque alternative sous forme de maquette que vous pouvez consulter — aucun code source n’est modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agente legge l’interfaccia così com’è ora, poi disegna ogni alternativa come un mock-up che puoi guardare — nessun codice sorgente viene modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは今の画面をそのまま読み取り、それぞれの案を見て確認できるモックとして描きます。ソースコードは一切変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 지금 화면을 그대로 읽은 다음, 각 대안을 살펴볼 수 있는 목업으로 그립니다 — 소스 코드는 전혀 바뀌지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente lê a interface como ela está agora e desenha cada alternativa como um mock-up que você pode conferir — nenhum código-fonte é alterado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体会按当前样子读取界面，然后把每个方案都画成可供查看的设计稿 — 不会更改任何源代码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理會按目前的樣子讀取介面，然後把每個方案都畫成可供查看的設計稿 — 不會更改任何原始碼。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent odczytuje interfejs w obecnym stanie, a następnie rysuje każdą alternatywę jako makietę, którą możesz obejrzeć — kod źródłowy pozostaje bez zmian."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten læser overfladen, som den er nu, og tegner derefter hvert alternativ som en mockup, du kan kigge på – ingen kildekode ændres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentti lukee käyttöliittymän sellaisena kuin se nyt on, ja piirtää sitten jokaisen vaihtoehdon mallina, jota voit katsella. Lähdekoodia ei muuteta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentinn les yfirborðið eins og það er núna og teiknar síðan hvern valkost sem frumgerð sem þú getur skoðað. Engum frumkóða er breytt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten leser overflaten slik den er nå, og tegner deretter hvert alternativ som en mock-up du kan se på – ingen kildekode endres."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten läser ytan som den är nu och ritar sedan varje alternativ som en mockup du kan titta på. Ingen källkod ändras."
          }
        }
      }
    },
    "Pick one here, say what to change about it, and only then have it built for real.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle hier eine aus, sag, was daran geändert werden soll, und lass es erst dann wirklich bauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick one here, say what to change about it, and only then have it built for real."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una aquí, di qué cambiar en ella, y solo entonces haz que se construya de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez-en une ici, dites ce qu’il faut y changer, et ensuite seulement faites-la construire pour de vrai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegline una qui, di' cosa cambiare, e solo allora falla costruire per davvero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで一つ選び、何を変えるか伝えたうえで、そのときはじめて本当に作らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 하나를 고르고, 무엇을 바꿀지 말한 다음, 그때 비로소 실제로 만들게 하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma aqui, diga o que mudar nela, e só então mande construir de verdade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里选一个，说出要改什么，然后才让它真正被实现出来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這裡選一個，說出要改什麼，然後才讓它真正被實作出來。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz jedną tutaj, powiedz, co w niej zmienić, i dopiero wtedy zleć jej prawdziwe zbudowanie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en her, sig, hvad der skal ændres ved den, og lad den først derefter bygges for alvor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse yksi tästä, kerro, mitä siinä pitää muuttaa, ja vasta sen jälkeen se rakennetaan oikeasti."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Veldu einn hér, segðu hvað þurfi að breyta við hann, og láttu smíða hann fyrir alvöru."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg ett her, si hva som skal endres, og få det bygget for ekte først da."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett här, säg vad som ska ändras på det och låt det sedan byggas på riktigt."
          }
        }
      }
    },
    "What should it design?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was soll gestaltet werden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should it design?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué debe diseñar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que doit-il concevoir ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa deve progettare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何をデザインしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 디자인할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que ele deve projetar?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要设计什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要設計什麼？"
          }
        },
        "pl": {
