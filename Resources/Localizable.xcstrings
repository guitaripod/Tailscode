            "value": "Parlez par-dessus la voix à tout moment et elle s’arrête pour écouter"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla sopra la voce in qualsiasi momento e si ferma per ascoltare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも声にかぶせて話すと、音声は止まって聞き取ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든 음성 위에 말하면 멈추고 듣습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerwij głos w dowolnym momencie, a przestanie mówić i zacznie słuchać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale por cima da voz a qualquer momento e ela para para ouvir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时都可以打断语音，它会停下来听你说"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時都可以打斷語音，它會停下來聽你說"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbryd stemmen når som helst, så holder den op og lytter"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhu päälle milloin tahansa, niin ääni lopettaa ja kuuntelee"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Talaðu yfir röddina hvenær sem er og hún hættir og hlustar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snakk over stemmen når som helst, så stopper den og lytter"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prata över rösten när som helst så slutar den och lyssnar"
          }
        }
      }
    },
    "Talk to this chat out loud and hear what the agent is doing while it keeps working.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to this chat out loud and hear what the agent is doing while it keeps working."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich laut mit diesem Chat und hör, was der Agent gerade tut, während er weiterarbeitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla en voz alta con este chat y escucha lo que hace el agente mientras sigue trabajando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez à ce chat à voix haute et écoutez ce que fait l’agent pendant qu’il continue de travailler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla a voce con questa chat e ascolta che cosa sta facendo l’agente mentre continua a lavorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットに声で話しかけ、エージェントが作業を続けている間の様子を音声で聞けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅에 소리 내어 말하고, 에이전트가 계속 작업하는 동안 무엇을 하는지 들어보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmawiaj z tym czatem na głos i słuchaj, co robi agent, gdy dalej pracuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale em voz alta com este chat e ouça o que o agente está fazendo enquanto ele continua trabalhando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用语音和这个聊天对话，并在智能体继续工作的同时听到它在做什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用語音和這個聊天對話，並在代理繼續工作的同時聽到它在做什麼。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal højt til denne chat, og hør, hvad agenten laver, mens den arbejder videre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhu tälle keskustelulle ääneen ja kuule, mitä agentti tekee, kun se jatkaa työtään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Talaðu upphátt við þessu spjalli og heyrðu hvað agentinn er að gera á meðan hann heldur áfram að vinna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snakk høyt med denne chatten, og hør hva agenten gjør mens den jobber videre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prata med den här chatten högt och hör vad agenten gör medan den fortsätter arbeta."
          }
        }
      }
    },
