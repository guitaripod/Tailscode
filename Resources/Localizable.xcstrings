    "That time was not understood. Try “weekdays 7:30” or “in 20 min”.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That time was not understood. Try “weekdays 7:30” or “in 20 min”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeit wurde nicht verstanden. Versuche „Werktags 7:30“ oder „in 20 Min“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se entendió la hora. Prueba «entre semana 7:30» o «en 20 min»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette heure n'a pas été comprise. Essayez « en semaine 7:30 » ou « dans 20 min »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Orario non riconosciuto. Prova «nei giorni feriali 7:30» o «tra 20 min»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間を理解できませんでした。「平日 7:30」や「20分後」と入力してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 이해하지 못했습니다. “평일 7:30” 또는 “20분 뒤”라고 해 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zrozumiano godziny. Spróbuj „dni robocze 7:30” albo „za 20 min”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não entendi o horário. Tente “dias úteis 7:30” ou “em 20 min”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有听懂这个时间。试试“工作日 7:30”或“20 分钟后”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有聽懂這個時間。試試「平日 7:30」或「20 分鐘後」。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidspunktet blev ikke forstået. Prøv »hverdage 7:30« eller »om 20 min«."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aikaa ei tunnistettu. Kokeile esimerkiksi ”arkisin 7:30” tai ”20 min päästä”."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tímasetningin skildist ekki. Prófaðu „virka daga 7:30“ eða „eftir 20 mín.“"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidspunktet ble ikke forstått. Prøv «hverdager 7:30» eller «om 20 min»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiden gick inte att tolka. Prova ”vardagar 7:30” eller ”om 20 min”."
          }
        }
      }
    },
    "The machine did not answer. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The machine did not answer. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rechner hat nicht geantwortet. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El equipo no respondió. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine n'a pas répondu. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il computer non ha risposto. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンが応答しませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 응답하지 않았습니다. 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komputer nie odpowiedział. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A máquina não respondeu. Tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台机器没有响应，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台機器沒有回應，請再試一次。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Computeren svarede ikke. Prøv igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietokone ei vastannut. Yritä uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tölvan svaraði ekki. Reyndu aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Maskinen svarte ikke. Prøv igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Datorn svarade inte. Försök igen."
          }
        }
      }
    },
