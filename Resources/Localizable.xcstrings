    "The clip stays on the machine. This only takes it off the stage and the shelf.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clip stays on the machine. This only takes it off the stage and the shelf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Clip bleibt auf dem Rechner. Dies nimmt ihn nur von der Bühne und aus dem Regal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El clip se queda en la máquina. Esto solo lo quita del escenario y del estante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clip reste sur la machine. Cela le retire seulement de la scène et de l'étagère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il clip resta sulla macchina. Questo lo toglie solo dalla scena e dallo scaffale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップはマシンに残ります。ステージと棚から外すだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립은 기기에 그대로 남습니다. 무대와 보관함에서만 내립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klip zostaje na maszynie. To tylko zdejmuje go ze sceny i z półki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O clipe continua na máquina. Isto apenas o tira do palco e da prateleira."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短片仍保留在机器上。这只会把它从舞台和图库中移开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短片仍保留在機器上。這只會把它從舞台和圖庫中移開。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klippet bliver på maskinen. Det fjerner kun klippet fra scenen og hylden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Klippi pysyy koneella. Tämä poistaa sen vain näyttämöltä ja hyllyltä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Klippan verður áfram á tölvunni. Þetta tekur hana aðeins af sviðinu og úr hillunni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klippet blir på maskinen. Dette fjerner det bare fra scenen og hyllen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klippet stannar på datorn. Det här tar bara bort det från scenen och hyllan."
          }
        }
      }
    },
