    "Game Center is off, so nothing is reported to Apple — the trophies below are counted on this device either way.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center is off, so nothing is reported to Apple — the trophies below are counted on this device either way."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ist aus, daher wird nichts an Apple gemeldet — die Trophäen unten werden trotzdem auf diesem Gerät gezählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center está desactivado, así que no se informa nada a Apple — de todos modos, los trofeos de abajo se cuentan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center est désactivé, donc rien n’est signalé à Apple — les trophées ci-dessous sont malgré tout comptabilisés sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center è disattivato, quindi nulla viene segnalato ad Apple — i trofei qui sotto vengono comunque conteggiati su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center はオフのため、Apple には何も報告されません — ただし下記のトロフィーは、いずれにせよこのデバイス上でカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center가 꺼져 있어 Apple에 아무것도 보고되지 않습니다 — 그래도 아래 트로피는 이 기기에서 집계됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Game Center está desativado, então nada é informado à Apple — de qualquer forma, os troféus abaixo são contados neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center 已关闭，因此不会向 Apple 报告任何内容 — 无论如何，下面的奖杯都会在这台设备上计数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center 已關閉，因此不會向 Apple 回報任何內容 — 無論如何，下面的獎盃都會在這台裝置上計數。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center jest wyłączone, więc nic nie jest zgłaszane do Apple — trofea poniżej i tak są liczone na tym urządzeniu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center er slået fra, så intet rapporteres til Apple: trofæerne nedenfor tælles stadig på denne enhed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center on pois käytöstä, joten Applelle ei raportoida mitään. Alla olevat palkinnot lasketaan silti tällä laitteella."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center er slökkt, svo ekkert er tilkynnt til Apple. Afrekin hér að neðan eru talin á þessu tæki hvort sem er."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center er av, så ingenting rapporteres til Apple. Trofeene nedenfor telles uansett på denne enheten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center är avstängt, så ingenting rapporteras till Apple. Troféerna nedan räknas ändå på den här enheten."
          }
        }
      }
    },
    "This isn't available in your country or region.": {
