    "Click to talk until you click again. Hold to talk while held.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to talk until you click again. Hold to talk while held."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, um bis zum nächsten Klick zu sprechen. Gedrückt halten, um beim Halten zu sprechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para hablar hasta que vuelvas a hacer clic. Mantén pulsado para hablar mientras lo mantienes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour parler jusqu'au prochain clic. Maintenez enfoncé pour parler pendant l'appui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicca per parlare finché non clicchi di nuovo. Tieni premuto per parlare mentre lo tieni premuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度クリックするまで話せます。長押しすると押している間話せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 클릭할 때까지 말합니다. 길게 누르면 누르고 있는 동안만 말합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij, by mówić, aż kliknisz ponownie. Przytrzymaj, by mówić, dopóki trzymasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para falar até clicar de novo. Segure para falar enquanto segura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按说话，再点按一次结束。按住则边按边说。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按後持續說話，直到你再次點按。按住則只在按住時說話。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik for at tale, indtil du klikker igen. Hold nede for at tale, mens du holder nede."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsauta puhuaksesi, kunnes napsautat uudelleen. Pidä painettuna puhuaksesi sen ajan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Smelltu til að tala þar til þú smellir aftur. Haltu niðri til að tala meðan haldið er."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk for å snakke til du klikker igjen. Hold inne for å snakke mens du holder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka för att prata tills du klickar igen. Håll in för att prata medan den hålls in."
          }
        }
      }
    },
