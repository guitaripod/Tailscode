    "This device has no tailnet address, so none of your servers can be reached. Open Tailscale and connect.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat keine Tailnet-Adresse, daher ist keiner deiner Server erreichbar. Öffne Tailscale und verbinde dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no tailnet address, so none of your servers can be reached. Open Tailscale and connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene dirección de tailnet, así que no se puede acceder a ninguno de tus servidores. Abre Tailscale y conéctate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas d’adresse tailnet, aucun de vos serveurs n’est donc joignable. Ouvrez Tailscale et connectez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha un indirizzo tailnet, quindi nessuno dei tuoi server è raggiungibile. Apri Tailscale e connettiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスには tailnet アドレスがないため、どのサーバにも到達できません。Tailscale を開いて接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 tailnet 주소가 없어 어떤 서버에도 연결할 수 없습니다. Tailscale을 열어 연결하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem endereço tailnet, então nenhum dos seus servidores pode ser alcançado. Abra o Tailscale e conecte-se."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备没有 tailnet 地址，因此无法访问你的任何服务器。请打开 Tailscale 并连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置沒有 tailnet 位址，因此無法連線到你的任何伺服器。請開啟 Tailscale 並連線。"
          }
        }
      }
    },
