            "value": "Crea tu propia app de YouTube"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez votre propre app YouTube"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una tua app YouTube"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分専用の YouTube アプリを作成"
          }
        },
        "ko": {
          "stringUnit": {
