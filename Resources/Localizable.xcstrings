    "Type these on the computer, not on this phone. The build needs a Swift toolchain and takes a few minutes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type these on the computer, not on this phone. The build needs a Swift toolchain and takes a few minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe das auf dem Rechner ein, nicht auf diesem iPhone. Der Build braucht eine Swift-Toolchain und dauert einige Minuten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe esto en el ordenador, no en este teléfono. La compilación necesita una cadena de herramientas de Swift y tarda unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapez ces commandes sur l’ordinateur, pas sur ce téléphone. La compilation nécessite une chaîne d’outils Swift et prend quelques minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita questi comandi sul computer, non su questo telefono. La compilazione richiede una toolchain Swift e alcuni minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらはこの iPhone ではなくコンピュータで入力します。ビルドには Swift ツールチェーンが必要で、数分かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 휴대폰이 아니라 컴퓨터에서 입력하세요. 빌드에는 Swift 툴체인이 필요하고 몇 분이 걸립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite estes comandos no computador, não neste telefone. A compilação requer um toolchain Swift e leva alguns minutos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上输入这些命令，而不是在这台手机上。构建需要 Swift 工具链，耗时几分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在電腦上輸入這些命令，不是在這台手機上。建置需要 Swift 工具鏈，會花上幾分鐘。"
          }
        }
      }
