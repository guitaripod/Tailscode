    "Run it on the machine the server runs on. It updates in place and keeps your password.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Rechner ausführen, auf dem der Server läuft. Es aktualisiert an Ort und Stelle und behält dein Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run it on the machine the server runs on. It updates in place and keeps your password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecútalo en la máquina donde corre el servidor. Actualiza en el sitio y conserva tu contraseña."
