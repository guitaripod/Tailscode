          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用及其连接的每台服务器：各自运行的版本与可更新的版本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
