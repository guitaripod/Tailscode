    "This Mac would not run %@. Copy it and run it yourself, then this step turns green on its own.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac würde %@ nicht ausführen. Kopiere es und führe es selbst aus, dann wird dieser Schritt von selbst grün."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac would not run %@. Copy it and run it yourself, then this step turns green on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac no pudo ejecutar %@. Cópialo y ejecútalo tú mismo; luego este paso se pondrá verde por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac n’exécuterait pas %@. Copiez-le et exécutez-le vous-même, puis cette étape passe au vert d’elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non eseguirebbe %@. Copialo ed eseguilo tu stesso, poi questo passaggio diventa verde da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac では %@ を実行できませんでした。コピーして自分で実行すると、このステップは自動的に緑になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서는 %@을(를) 실행할 수 없었습니다. 복사해서 직접 실행하면 이 단계가 저절로 초록색으로 바뀝니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac não conseguiu rodar %@. Copie-o e rode-o você mesmo; depois esta etapa fica verde sozinha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 无法运行 %@。请复制后自行运行，这一步就会自动变绿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 無法執行 %@。請複製後自行執行，這一步就會自動變綠。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac nie uruchomi %@ automatycznie. Skopiuj to i uruchom samodzielnie, a ten krok sam zmieni się na zielony."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Mac ville ikke køre %@. Kopiér det og kør det selv, så bliver dette trin grønt af sig selv."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Mac ei ajaisi kohdetta %@. Kopioi se ja aja itse, niin tämä vaihe muuttuu vihreäksi itsestään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi Mac myndi ekki keyra %@. Afritaðu það og keyrðu það sjálf(ur), þá verður þetta skref grænt af sjálfu sér."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne Macen ville ikke kjøre %@. Kopier den og kjør den selv, så blir dette steget grønt av seg selv."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här Macen skulle inte köra %@. Kopiera det och kör det själv, så blir det här steget grönt av sig självt."
          }
        }
      }
    },
    "This machine's dispatcher applies a passing patch as it lands. delegate 0.4 can hold it for review.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne computers dispatcher anvender en bestået patch, så snart den ankommer. delegate 0.4 kan holde den tilbage til gennemgang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dispatcher dieses Rechners wendet einen bestandenen Patch sofort an. delegate 0.4 kann ihn zur Prüfung zurückhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This machine's dispatcher applies a passing patch as it lands. delegate 0.4 can hold it for review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispatcher de esta máquina aplica un parche aprobado en cuanto llega. delegate 0.4 puede retenerlo para su revisión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän tietokoneen dispatcher soveltaa läpäisseen patchin heti, kun se saapuu. delegate 0.4 voi pidättää sen tarkistettavaksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dispatcher de cette machine applique un correctif réussi dès qu’il arrive. delegate 0.4 peut le retenir pour relecture."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispatcher þessarar tölvu beitir patch um leið og hann stenst prófanir. delegate 0.4 getur haldið honum eftir til yfirferðar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispatcher di questa macchina applica subito una patch che ha superato la verifica. delegate 0.4 può trattenerla per la revisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンのディスパッチャーは、合格したパッチを届いた時点で適用します。delegate 0.4 ならレビューのために保留できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터의 디스패처는 통과한 패치를 도착하는 즉시 적용합니다. delegate 0.4는 검토를 위해 보류할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispatcheren på denne maskinen tar i bruk en patch som består, så snart den er klar. delegate 0.4 kan holde den tilbake til gjennomgang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
