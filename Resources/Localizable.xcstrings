          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 Claude 已登出"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude er logget ud på %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude on kirjautunut ulos tietokoneella %@"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki skráð inn í Claude á %@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude er logget av på %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude är utloggad på %@"
          }
        }
      }
    },
    "%@ is connected, but Claude is signed out there. Every turn would be refused until it signs in.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is connected, but Claude is signed out there. Every turn would be refused until it signs in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist verbunden, aber Claude ist dort abgemeldet. Jede Anfrage würde abgelehnt, bis sich Claude anmeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está conectado, pero Claude tiene la sesión cerrada allí. Cada turno sería rechazado hasta que inicie sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est connecté, mais Claude y est déconnecté. Chaque tour serait refusé tant que la connexion n'est pas rétablie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è connesso, ma Claude è disconnesso lì. Ogni turno verrebbe rifiutato finché non effettua l'accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ には接続されていますが、そこでは Claude がサインアウトしています。サインインするまで、すべてのターンが拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 연결되어 있지만 그곳에서 Claude가 로그아웃되어 있어요. 로그인하기 전까지 모든 요청이 거부돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest połączony, ale Claude jest tam wylogowany. Każda tura zostanie odrzucona, dopóki się nie zaloguje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está conectado, mas o Claude está desconectado lá. Cada turno será recusado até que ele entre na conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已连接，但那里的 Claude 已退出登录。在其登录之前，每一轮请求都会被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已連線，但那裡的 Claude 已登出。在它登入之前，每一輪請求都會被拒絕。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er forbundet, men Claude er logget ud der. Hver tur afvises, indtil Claude logger ind."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on yhdistetty, mutta Claude on kirjautunut ulos siellä. Jokainen vuoro hylätään, kunnes Claude kirjautuu sisään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er tengt, en Claude er ekki skráð inn þar. Hver umferð yrði hafnað þar til skráð er inn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er tilkoblet, men Claude er logget av der. Hver tur blir avvist til Claude logger på."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är ansluten, men Claude är utloggad där. Varje tur skulle nekas tills den loggar in."
          }
        }
      }
    },
