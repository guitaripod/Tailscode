    "Compare needs two pictures of the screen. One is kept each time your app changes, so change something, or press Rebuild on Look, and come back.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare needs two pictures of the screen. One is kept each time your app changes, so change something, or press Rebuild on Look, and come back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vergleich braucht zwei Bilder des Bildschirms. Bei jeder Änderung an Ihrer App wird eines davon aufbewahrt. Ändern Sie also etwas oder drücken Sie bei Aussehen auf Neu erstellen und kommen Sie dann zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparar necesita dos imágenes de la pantalla. Se guarda una cada vez que cambia tu app, así que cambia algo o pulsa Reconstruir en Aspecto y vuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparer nécessite deux images de l’écran. Une est conservée à chaque modification de votre app ; modifiez donc quelque chose, ou appuyez sur Reconstruire dans Aspect, puis revenez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta richiede due immagini dello schermo. Una viene conservata ogni volta che l’app cambia, quindi modifica qualcosa o tocca Ricostruisci in Aspetto e torna qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較には画面の画像が2枚必要です。アプリを変更するたびに1枚保存されるので、何か変更するか、「見た目」の「再構築」を押してから戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비교하려면 화면 이미지가 두 장 필요합니다. 앱이 바뀔 때마다 한 장씩 보관되니, 무언가를 바꾸거나 모양 탭에서 다시 빌드를 누른 뒤 돌아오세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównanie wymaga dwóch obrazów ekranu. Przy każdej zmianie aplikacji jeden jest zachowywany, więc zmień coś albo naciśnij Przebuduj w Wyglądzie i wróć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparar precisa de duas imagens da tela. Uma é guardada cada vez que seu app muda, então mude algo, ou toque em Recompilar em Aparência e volte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对比需要屏幕的两张画面。每次应用改动时会保留一张，因此请改动点什么，或在“外观”中按“重新构建”后再回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比較需要螢幕的兩張畫面。每次應用程式變動時會保留一張，因此請改動點什麼，或在「外觀」中按「重新建置」後再回來。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenligning kræver to billeder af skærmen. Et gemmes, hver gang din app ændrer sig, så ændr noget, eller tryk på Build igen under Udseende, og kom tilbage."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertailu tarvitsee kaksi kuvaa näytöstä. Yksi säilytetään aina, kun sovellustasi muutetaan, joten muuta jotain tai paina Ulkoasussa Koosta uudelleen ja palaa sitten takaisin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Samanburður þarf tvær myndir af skjánum. Ein er geymd í hvert sinn sem appið breytist, svo breyttu einhverju eða ýttu á Endurbyggja í Útliti og komdu svo aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenligning trenger to bilder av skjermen. Ett beholdes hver gang appen endres, så endre noe, eller trykk Bygg på nytt under Utseende, og kom tilbake."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämförelse kräver två bilder av skärmen. En sparas varje gång din app ändras, så ändra något eller tryck på Bygg om under Utseende, och kom tillbaka."
          }
        }
      }
    },
