        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一小時顯示的是這台 Mac 在面板開啟期間看到的內容。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Timen viser, hvad denne Mac så, mens tavlen var åben."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunti näyttää, mitä tämä Mac näki taulun ollessa auki."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
