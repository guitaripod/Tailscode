    "Say what the worker must achieve.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe, was der Worker erreichen muss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say what the worker must achieve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica qué debe lograr el worker."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez ce que le worker doit accomplir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica cosa deve ottenere il worker."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワーカーが達成すべきことを記入してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워커가 달성해야 할 목표를 적으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga o que o worker precisa alcançar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明执行者必须达成的目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說明執行者必須達成的目標。"
          }
        }
      }
    },
