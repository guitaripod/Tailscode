    "Tap to talk until you tap again. Touch and hold to talk while held.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to talk until you tap again. Touch and hold to talk while held."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen, um bis zum nächsten Tippen zu sprechen. Gedrückt halten, um beim Halten zu sprechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para hablar hasta que vuelvas a tocar. Mantén pulsado para hablar mientras lo mantienes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour parler jusqu'au prochain toucher. Touchez et maintenez pour parler pendant l'appui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per parlare finché non tocchi di nuovo. Tieni premuto per parlare mentre lo tieni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度タップするまで話せます。タッチして押さえると押している間話せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 탭할 때까지 말합니다. 터치해서 길게 누르면 누르고 있는 동안만 말합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, by mówić, aż stukniesz ponownie. Dotknij i przytrzymaj, by mówić, dopóki trzymasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para falar até tocar de novo. Toque e segure para falar enquanto segura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点开始说话，再轻点结束。按住则边按边说。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按後持續說話，直到你再次點按。觸碰並按住則只在按住時說話。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at tale, indtil du trykker igen. Hold den nede, mens du taler."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta puhuaksesi, kunnes napautat uudelleen. Kosketa ja pidä painettuna, jotta puhut vain niin kauan kuin pidät sormea paikallaan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikkaðu til að tala þar til þú pikkar aftur. Haltu inni til að tala meðan haldið er."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å snakke til du trykker igjen. Trykk og hold for å snakke så lenge du holder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att prata tills du trycker igen. Tryck och håll för att prata medan du håller kvar fingret."
          }
        }
      }
    },
