    "The default server is where a new chat starts when you haven't aimed the composer somewhere else.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standardserver ist der Ort, an dem ein neuer Chat beginnt, wenn du das Eingabefeld nicht anders ausgerichtet hast."
          }
        },
        "en": {
