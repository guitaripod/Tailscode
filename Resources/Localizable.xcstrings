    "This is running straight out of a build directory — install it before asking it to update itself.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies läuft direkt aus einem Build-Verzeichnis – vor der Aufforderung zur Selbstaktualisierung installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is running straight out of a build directory — install it before asking it to update itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se ejecuta directamente desde un directorio de compilación: instálalo antes de pedirle que se actualice solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci s'exécute directement depuis un dossier de build — installez-la avant de lui demander de se mettre à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo viene eseguito direttamente da una cartella di build: installalo prima di chiedergli di aggiornarsi da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはビルドディレクトリから直接実行されています — 自己更新を依頼する前にインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 빌드 디렉터리에서 직접 실행 중입니다 — 자체 업데이트를 요청하기 전에 설치하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso está sendo executado direto de um diretório de build — instale antes de pedir para se atualizar sozinho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是直接从构建目录运行的——请先安装，再让它自我更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是直接從建置目錄執行的——請先安裝，再讓它自我更新。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa to bezpośrednio z katalogu builda — zainstaluj to, zanim poprosisz o samodzielną aktualizację."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kører direkte fra en build-mappe – installer det, før du beder det om at opdatere sig selv."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä ajetaan suoraan build-hakemistosta – asenna se ennen kuin pyydät sitä päivittämään itsensä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta keyrir beint úr smíðamöppu – settu það upp áður en þú biður það um að uppfæra sig sjálft."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kjører rett fra en byggmappe. Installer den før du ber den oppdatere seg selv."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här körs direkt från en byggmapp. Installera det innan du ber det uppdatera sig själv."
          }
        }
      }
    },
