    "Tailscode didn't close normally last time, so this chat waits.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode didn't close normally last time, so this chat waits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode wurde beim letzten Mal nicht ordnungsgemäß beendet, deshalb wartet dieser Chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode no se cerró correctamente la última vez, así que este chat espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ne s'est pas fermé normalement la dernière fois, ce chat attend donc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode non si è chiuso correttamente l'ultima volta, quindi questa chat attende."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回 Tailscode は正常に終了しなかったため、このチャットは待機しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번 Tailscode가 정상적으로 종료되지 않아 이 대화는 대기합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode nie zamknął się poprawnie ostatnio, więc ten czat czeka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode não fechou normalmente da última vez, então este chat aguarda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 上次没有正常退出，所以这个聊天会先等待。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 上次沒有正常結束，所以這個聊天會先等待。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode lukkede ikke ordentligt sidst, så denne chat venter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ei sulkeutunut viimeksi kunnolla, joten tämä keskustelu odottaa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode lokaðist ekki eðlilega síðast, svo þetta spjall bíður."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ble ikke avsluttet normalt sist, så denne chatten venter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode avslutades inte normalt förra gången, så den här chatten väntar."
          }
        }
      }
    },
