        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tokens em %2$@%3$@ rodaram em um plano — cobrado por mês, não por token"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@%3$@ 上的 %1$@ 个词元通过套餐运行 — 按月计费，而非按词元计费"
