        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン上でバックグラウンドタスクが実行中です。完了するとエージェントが続行します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에서 백그라운드 작업이 실행 중입니다. 작업이 끝나면 에이전트가 이어서 진행합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa em segundo plano está em execução na máquina; o agente continua quando ela terminar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个后台任务正在这台机器上运行；完成后智能体会继续"
