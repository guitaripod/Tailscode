    "A chat is minted on the other machine; this takes a moment over a tailnet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Chat wird auf dem anderen Rechner erzeugt; das dauert über ein Tailnet einen Moment."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chat is minted on the other machine; this takes a moment over a tailnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crea un chat en la otra máquina; esto tarda un momento a través de un tailnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une discussion est créée sur l’autre machine ; cela prend un instant via un tailnet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chat viene coniata sull’altra macchina; questo richiede un momento su un tailnet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットはもう一方のマシン上で新規作成されます。tailnet 経由のため少し時間がかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅은 다른 컴퓨터에서 새로 만들어집니다. tailnet을 통하므로 잠시 시간이 걸립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um chat é criado na outra máquina; isso leva um momento pela tailnet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话是在另一台机器上新建的；通过 tailnet 完成这一步需要一点时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話是在另一台機器上新建的；透過 tailnet 完成這一步需要一點時間。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmowa jest tworzona na drugim komputerze; to chwilę trwa przez tailnet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En chat oprettes på den anden computer; det tager et øjeblik over et tailnet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskustelu luodaan toisella koneella; tämä vie hetken tailnetin yli."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spjall er búið til á hinni tölvunni; þetta tekur smá stund yfir tailnet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En chat opprettes på den andre maskinen. Dette tar et øyeblikk over et tailnet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En chatt skapas på den andra datorn; det tar en stund över ett tailnet."
          }
        }
      }
    },
    "A message carries %lld attachments — the rest were left out.": {
