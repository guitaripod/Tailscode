    "Add a bit more detail, then hold Send to refine it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergänze etwas mehr Details und halte dann „Senden“ gedrückt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a bit more detail, then hold Send to refine it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade algo más de detalle y luego mantén pulsado Enviar para refinarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un peu plus de détails, puis maintenez Envoyer pour l’affiner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi qualche dettaglio in più, poi tieni premuto Invia per rifinirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう少し詳しく書いてから、送信を長押しして推敲してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조금 더 자세히 쓴 다음 보내기를 길게 눌러 다듬으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione mais detalhes e mantenha Enviar pressionado para refinar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再补充一些细节，然后长按发送以润色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再補充一些細節，然後長按傳送以潤飾。"
          }
        }
      }
    },
