          "stringUnit": {
            "state": "translated",
            "value": "Die Unterhaltung wird erneut gelesen, um sie zusammenzufassen. Deine Nachricht wartet dahinter in der Warteschlange."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-reading the conversation to summarize it. Your message is queued behind it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Releyendo la conversación para resumirla. Tu mensaje está en cola detrás de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relecture de la conversation pour la résumer. Votre message est en file derrière elle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilettura della conversazione per riassumerla. Il tuo messaggio è in coda dietro di essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話を要約するために読み直しています。メッセージはその後ろで待機しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화를 요약하기 위해 다시 읽는 중입니다. 메시지는 그 뒤에 대기 중입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
