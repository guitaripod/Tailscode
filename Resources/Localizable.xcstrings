      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnellfrage aktiv. Senden fragt den genannten Rechner ohne Projekt, mit dem Modell, das sich diese Schnellfrage merkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick ask on. Sending asks the named machine with no project, on the model this ask remembers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta rápida activada. Enviar pregunta a la máquina indicada sin proyecto, con el modelo que recuerda esta pregunta rápida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Question rapide activée. Envoyer interroge la machine indiquée sans projet, avec le modèle que retient cette question rapide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Domanda rapida attiva. Inviare interroga la macchina indicata senza progetto, con il modello che questa domanda rapida ricorda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイック質問モード。送信すると、このクイック質問が記憶しているモデルで、プロジェクトなしに指定のマシンへ質問します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 질문 모드. 전송하면 프로젝트 없이, 이 빠른 질문이 기억하는 모델로 지정된 컴퓨터에 질문합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunta rápida ativada. Enviar pergunta à máquina indicada sem projeto, com o modelo que esta pergunta rápida memoriza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速提问已开启。发送会在没有项目的情况下，用这次提问记住的模型向指定的机器提问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速提問已開啟。傳送會在沒有專案的情況下，用這次提問記住的模型向指定的機器提問。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybkie pytanie włączone. Wysłanie pyta wskazany komputer bez projektu, przy użyciu modelu zapamiętanego przez to szybkie pytanie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigspørgsmål til. Afsendelse spørger den navngivne computer uden projekt, med den model, som dette hurtigspørgsmål husker."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikakysymys päällä. Lähettäminen kysyy nimetyltä tietokoneelta ilman projektia sillä mallilla, jonka pikakysymys muistaa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyndispurning á. Að senda spyr tilgreinda tölvu án verkefnis, með líkaninu sem þessi skyndispurning man."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigspørsmål på. Å sende spør den oppgitte maskinen uten prosjekt, med modellen dette hurtigspørsmålet husker."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabbfråga på. Att skicka frågar den namngivna datorn utan projekt, med den modell den här frågan minns."
          }
        }
      }
    },
    "Image lane. Sending paints a picture on the machine with the card, with the settings named under this box.": {
