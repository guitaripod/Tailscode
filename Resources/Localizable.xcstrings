        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jetons sur %2$@%3$@ ont tourné via un forfait — facturé au mois, pas au jeton"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ token su %2$@%3$@ sono stati eseguiti con un piano — fatturato al mese, non per token"
