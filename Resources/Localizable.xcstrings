    "voice-bridge is not installed on this machine yet. Voice calls need an NVIDIA GPU with %1$@ of memory and about %2$@ of downloads.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge is not installed on this machine yet. Voice calls need an NVIDIA GPU with %1$@ of memory and about %2$@ of downloads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge ist auf diesem Rechner noch nicht installiert. Sprachanrufe brauchen eine NVIDIA-GPU mit %1$@ Speicher und etwa %2$@ Downloads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge aún no está instalado en este equipo. Las llamadas de voz necesitan una GPU NVIDIA con %1$@ de memoria y unos %2$@ de descargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge n'est pas encore installé sur cette machine. Les appels vocaux nécessitent un GPU NVIDIA avec %1$@ de mémoire et environ %2$@ de téléchargements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge non è ancora installato su questo computer. Le chiamate vocali richiedono una GPU NVIDIA con %1$@ di memoria e circa %2$@ di download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンにはまだ voice-bridge がインストールされていません。音声通話には、%1$@ のメモリを搭載した NVIDIA GPU と、約 %2$@ のダウンロード容量が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터에는 아직 voice-bridge가 설치되지 않았어요. 음성 통화에는 메모리 %1$@의 NVIDIA GPU와 약 %2$@의 다운로드 공간이 필요해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge nie jest jeszcze zainstalowany na tym komputerze. Połączenia głosowe wymagają karty NVIDIA z %1$@ pamięci i około %2$@ pobrań."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O voice-bridge ainda não está instalado neste computador. As chamadas de voz exigem uma GPU NVIDIA com %1$@ de memória e cerca de %2$@ de downloads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此机器尚未安装 voice-bridge。语音通话需要显存为 %1$@ 的 NVIDIA GPU，以及约 %2$@ 的下载空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此機器尚未安裝 voice-bridge。語音通話需要記憶體為 %1$@ 的 NVIDIA GPU，以及約 %2$@ 的下載空間。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge er endnu ikke installeret på denne computer. Stemmeopkald kræver en NVIDIA-GPU med %1$@ hukommelse og ca. %2$@ til download."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridgea ei ole vielä asennettu tälle tietokoneelle. Äänipuhelut vaativat NVIDIA-GPU:n, jossa on %1$@ muistia, ja latauksiin kuluu noin %2$@."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge er ekki uppsett á þessari tölvu enn. Raddsímtöl þurfa NVIDIA-GPU með %1$@ af minni og um %2$@ til niðurhals."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge er ikke installert på denne maskinen ennå. Stemmeanrop krever en NVIDIA-GPU med %1$@ minne og omtrent %2$@ nedlastinger."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge är inte installerad på den här datorn än. Röstsamtal kräver en NVIDIA-GPU med %1$@ minne och ungefär %2$@ att hämta."
          }
        }
      }
    },
