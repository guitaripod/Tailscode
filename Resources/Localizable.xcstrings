    "Stored only in the Keychain, on this device. Read once per refresh to api.deepseek.com — the key never touches your servers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur im Schlüsselbund gespeichert, auf diesem Gerät. Wird bei jeder Aktualisierung einmal bei api.deepseek.com abgerufen — der Schlüssel berührt nie deine Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored only in the Keychain, on this device. Read once per refresh to api.deepseek.com — the key never touches your servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada solo en el llavero, en este dispositivo. Se lee una vez por actualización en api.deepseek.com — la clave nunca toca tus servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockée uniquement dans le Trousseau, sur cet appareil. Lue une fois par actualisation sur api.deepseek.com — la clé ne touche jamais vos serveurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvata solo nel Portachiavi, su questo dispositivo. Letta una volta per aggiornamento su api.deepseek.com — la chiave non tocca mai i tuoi server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末のキーチェーンにのみ保存されます。更新のたびに 1 回、api.deepseek.com から読み込まれます — キーがあなたのサーバに触れることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 키체인에만 저장됩니다. 새로고침할 때마다 한 번씩 api.deepseek.com에서 읽어옵니다 — 이 키는 당신의 서버에는 절대 닿지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazenada apenas no Chaveiro, neste dispositivo. Lida uma vez por atualização em api.deepseek.com — a chave nunca toca seus servidores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存在这台设备的钥匙串中。每次刷新会向 api.deepseek.com 读取一次 — 该密钥绝不会接触到你的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅保存在這台裝置的鑰匙圈中。每次重新整理會向 api.deepseek.com 讀取一次 — 該金鑰絕不會接觸到你的伺服器。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowywane tylko w Pęku kluczy, na tym urządzeniu. Odczytywane raz na odświeżenie do api.deepseek.com — klucz nigdy nie dotyka twoich serwerów."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun gemt i nøgleringen på denne enhed. Læses én gang pr. opdatering fra api.deepseek.com – nøglen rører aldrig dine servere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu vain avainnippuun tälle laitteelle. Käytetään kerran jokaisen päivityksen yhteydessä osoitteeseen api.deepseek.com – avain ei koskaan kulje palvelimiesi kautta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Geymt eingöngu í lyklakippunni, á þessu tæki. Lesið einu sinni við hverja uppfærslu af api.deepseek.com – lykillinn fer aldrei um netþjónana þína."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagres bare i nøkkelringen, på denne enheten. Leses én gang per oppdatering fra api.deepseek.com – nøkkelen berører aldri serverne dine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparas bara i nyckelringen, på den här enheten. Läses en gång per uppdatering från api.deepseek.com – nyckeln når aldrig dina servrar."
          }
        }
      }
    },
