    "“%@” does not read as an address.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ sieht nicht wie eine Adresse aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” does not read as an address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no parece una dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne ressemble pas à une adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» non sembra un indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はアドレスとして認識できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"은(는) 주소로 인식되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não parece um endereço."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”看起来不像是一个地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」看起來不像是一個位址。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie wygląda jak adres."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ser ikke ud som en adresse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ei näytä osoitteelta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ lítur ekki út eins og vistfang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ser ikke ut som en adresse."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” går inte att tolka som en adress."
          }
        }
      }
    },
    "“%@” does not resolve — is MagicDNS on, or use the 100.x address.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ lässt sich nicht auflösen — ist MagicDNS aktiv, oder nutze die 100.x-Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” does not resolve — is MagicDNS on, or use the 100.x address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no se resuelve: ¿tienes MagicDNS activado? Si no, usa la dirección 100.x."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » ne se résout pas — MagicDNS est-il activé, ou utilisez l’adresse 100.x."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» non si risolve — MagicDNS è attivo, oppure usa l’indirizzo 100.x."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は解決できません — MagicDNS はオンですか？ それとも 100.x アドレスを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"을(를) 확인할 수 없습니다 — MagicDNS가 켜져 있나요? 아니면 100.x 주소를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” não resolve — o MagicDNS está ativado? Senão, use o endereço 100.x."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”无法解析 — MagicDNS 开启了吗？或者改用 100.x 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」無法解析 — MagicDNS 開啟了嗎？或者改用 100.x 位址。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” nie rozwiązuje się — sprawdź, czy MagicDNS jest włączony, albo użyj adresu 100.x."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ kan ikke slås op – er MagicDNS slået til, eller brug 100.x-adressen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ei ratkea. Tarkista, onko MagicDNS päällä, tai käytä 100.x-osoitetta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ finnst ekki – er MagicDNS kveikt, eða notaðu 100.x vistfangið."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» kan ikke løses opp – er MagicDNS på, eller bruk 100.x-adressen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” går inte att slå upp – är MagicDNS på, eller använd 100.x-adressen."
          }
        }
      }
    },
    "“%@” is working in this repository right now, and applying lands files under it.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ arbejder i dette repository lige nu, og anvendelse lægger filer derunder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ arbeitet gerade in diesem Repository, und das Anwenden legt Dateien darunter ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is working in this repository right now, and applying lands files under it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» está trabajando en este repositorio ahora mismo, y al aplicar se escriben archivos debajo de él."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” työstää parhaillaan tätä repositoriota, ja kun muutokset käytetään, tiedostoja tulee sen alle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » travaille dans ce dépôt en ce moment, et l’application dépose des fichiers sous lui."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ vinnur í þessari geymslu núna og ef beitt er breytingum breytast skrár í henni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» sta lavorando in questo repository in questo momento, e l’applicazione scrive file sotto di esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は今このリポジトリで作業中で、適用するとその下にファイルが反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”이(가) 지금 이 저장소에서 작업 중이며, 적용하면 그 아래에 파일이 반영됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» jobber i dette repositoriet nå, og å bruke endringene legger filer under det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” pracuje teraz w tym repozytorium, a zastosowanie zmian wprowadzi pliki pod nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” está trabalhando neste repositório agora, e aplicar coloca arquivos sob ele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” arbetar i det här repositoriet just nu, och tillämpning skriver filer där."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”正在此仓库中工作，应用补丁会把文件写到它的工作目录下。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」正在此儲存庫中工作，套用修補程式會把檔案寫到它的工作目錄下。"
          }
        }
      }
