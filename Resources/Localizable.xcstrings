    "Dictation runs on this %@. Nothing you say leaves it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation runs on this %@. Nothing you say leaves it."
