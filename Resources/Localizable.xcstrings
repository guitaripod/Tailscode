    "Ask your agent a question. Tailscode opens with it already on its way.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask your agent a question. Tailscode opens with it already on its way."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stell deinem Agenten eine Frage. Tailscode öffnet sich, und die Frage ist schon unterwegs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazle una pregunta a tu agente. Tailscode se abre con la pregunta ya en camino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question à votre agent. Tailscode s’ouvre avec la question déjà en route."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una domanda al tuo agente. Tailscode si apre e la domanda è già in viaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントに質問します。Tailscodeは質問を送信した状態で開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트에게 질문하세요. Tailscode가 질문을 이미 전달한 상태로 열립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj swojemu agentowi pytanie. Tailscode otworzy się z już wysłanym pytaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pergunta ao seu agente. O Tailscode abre com a pergunta já a caminho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向你的智能体提问。Tailscode 打开时，问题已经发出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向你的代理提問。Tailscode 開啟時，問題已經送出。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stil din agent et spørgsmål. Tailscode åbner, og spørgsmålet er allerede på vej."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esitä agentille kysymys. Tailscode avautuu, ja kysymys on jo matkalla."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spyrðu agentinn þinn spurningar. Tailscode opnast og spurningin er þegar á leiðinni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør agenten din om noe.Tailscode åpnes med spørsmålet allerede på vei."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
