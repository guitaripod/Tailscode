          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行にはあなたの承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 승인이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente precisa da sua aprovação para continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体需要你的批准才能继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理需要你的核准才能繼續。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent potrzebuje twojej zgody, aby kontynuować."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten skal have din godkendelse for at fortsætte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentti tarvitsee hyväksyntäsi jatkaakseen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentinn þarf samþykki þitt til að halda áfram."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten trenger godkjenningen din for å fortsette."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten behöver ditt godkännande för att fortsätta."
          }
        }
      }
    },
    "The agent pursues the goal across turns and reports when it is met.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent verfolgt das Ziel über mehrere Züge hinweg und meldet sich, wenn es erreicht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent pursues the goal across turns and reports when it is met."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente persigue el objetivo a través de los turnos y avisa cuando se cumple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent poursuit l’objectif à travers les tours et fait son rapport une fois qu’il est atteint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agente persegue l’obiettivo attraverso i turni e riferisce quando viene raggiunto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは複数のターンにわたって目標を追い続け、達成したときに報告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트는 여러 턴에 걸쳐 목표를 추구하며, 달성되면 알려 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente persegue o objetivo ao longo dos turnos e avisa quando ele é alcançado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体会跨越多个回合持续追求这个目标，达成时会报告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理會跨越多個回合持續追求這個目標，達成時會回報。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent dąży do celu przez kolejne tury i zgłasza się, gdy zostanie on osiągnięty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten forfølger målet på tværs af ture og melder tilbage, når det er nået."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentti pyrkii tavoitteeseen vuorojen yli ja ilmoittaa, kun tavoite on saavutettu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentinn vinnur að markmiðinu yfir margar umferðir og lætur vita þegar því er náð."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten jobber mot målet over flere turer og melder fra når det er nådd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten arbetar mot målet över flera turer och meddelar när det är uppnått."
          }
        }
      }
    },
    "The agent re-reads this conversation, writes a summary of it, and carries the summary forward instead of the whole transcript.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent liest diese Unterhaltung erneut, schreibt eine Zusammenfassung und nimmt statt des vollständigen Transkripts nur diese mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent re-reads this conversation, writes a summary of it, and carries the summary forward instead of the whole transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente relee esta conversación, escribe un resumen y sigue con el resumen en lugar de con toda la transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent relit cette conversation, en écrit un résumé et poursuit avec ce résumé plutôt qu’avec toute la transcription."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agente rilegge questa conversazione, ne scrive un riepilogo e prosegue con quello invece che con l’intera trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはこの会話を読み直して要約を書き、全文の代わりにその要約を持ち越します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 이 대화를 다시 읽고 요약을 작성한 뒤, 전체 기록 대신 그 요약을 이어서 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente relê esta conversa, escreve um resumo e segue com ele em vez de toda a transcrição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体会重读这段对话、写出摘要，并带着摘要继续，而不是整段记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理會重讀這段對話、寫出摘要，並帶著摘要繼續，而不是整段紀錄。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent odczytuje tę rozmowę ponownie, tworzy jej podsumowanie i przenosi dalej to podsumowanie zamiast całej transkrypcji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten læser denne samtale igen, skriver et resumé af den og fører resuméet videre i stedet for hele udskriften."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentti lukee keskustelun uudelleen, kirjoittaa siitä yhteenvedon ja kantaa eteenpäin vain yhteenvedon koko keskusteluhistorian sijaan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentinn les þetta samtal aftur, skrifar samantekt af því og ber samantektina áfram í stað allrar uppskriftarinnar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten leser samtalen på nytt, skriver et sammendrag av den og tar med sammendraget videre i stedet for hele transkriptet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten läser om konversationen, skriver en sammanfattning och tar med den framåt i stället för hela transkriptet."
          }
        }
      }
    },
    "The App Store installs it — this app cannot update itself.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store installiert es – diese App kann sich nicht selbst aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store installs it — this app cannot update itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La App Store la instala: esta app no puede actualizarse a sí misma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store l'installe — cette app ne peut pas se mettre à jour elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È l'App Store a installarlo: questa app non può aggiornarsi da sola."
          }
        },
        "ja": {
          "stringUnit": {
