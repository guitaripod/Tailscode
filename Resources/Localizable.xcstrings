    "A background task is stuck on the machine: nothing has moved for a long time. Stop it, or wait": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Hintergrundaufgabe hängt auf dem Rechner fest: Seit Langem tut sich nichts. Stoppe sie oder warte"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A background task is stuck on the machine: nothing has moved for a long time. Stop it, or wait"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarea en segundo plano está bloqueada en la máquina: no ha habido movimiento en mucho tiempo. Detenla o espera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche en arrière-plan est bloquée sur la machine : rien n’a bougé depuis longtemps. Arrêtez-la, ou attendez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’attività in background è bloccata sulla macchina: non si muove nulla da molto tempo. Fermala, oppure aspetta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン上でバックグラウンドタスクが停滞しています。長時間動きがありません。停止するか、待ってください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에서 백그라운드 작업이 멈췄습니다. 오랫동안 진행이 없었습니다. 중지하거나 기다리세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa em segundo plano está travada na máquina: nada se move há muito tempo. Interrompa-a ou aguarde"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个后台任务在这台机器上卡住了：长时间没有任何进展。停止它，或者继续等待"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個背景任務在這台機器上卡住了：長時間沒有任何進展。停止它，或繼續等待"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na komputerze utknęło zadanie w tle: od dłuższego czasu nic się nie dzieje. Zatrzymaj je albo poczekaj"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En baggrundsopgave er hængt fast på maskinen: intet er sket i lang tid. Stop den, eller vent"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustatehtävä on jumissa tietokoneella: mikään ei ole edennyt pitkään aikaan. Pysäytä se tai odota"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunnsverk er fast á tölvunni: ekkert hefur hreyfst í langan tíma. Stöðvaðu það eða bíddu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En bakgrunnsoppgave har hengt seg på maskinen: ingenting har skjedd på lang tid. Stopp den, eller vent"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En bakgrundsuppgift har hängt sig på datorn: inget har rört sig på länge. Stoppa den eller vänta"
          }
        }
      }
    },
