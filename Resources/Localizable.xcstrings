            "state": "translated",
            "value": "Las claves desconocidas y los conflictos se informan en vez de adivinarse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés inconnues et les conflits sont signalés plutôt que devinés"
          }
        },
        "it": {
