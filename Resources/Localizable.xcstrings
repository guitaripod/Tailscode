    "Another call is already using the voice model. Try again when it ends.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another call is already using the voice model. Try again when it ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Anruf nutzt bereits das Sprachmodell. Versuche es erneut, wenn er beendet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra llamada ya está usando el modelo de voz. Inténtalo de nuevo cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre appel utilise déjà le modèle vocal. Réessayez quand il sera terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'altra chiamata sta già usando il modello vocale. Riprova quando finisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の通話がすでに音声モデルを使用中です。終わってから再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 통화가 이미 음성 모델을 사용 중입니다. 그 통화가 끝나면 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne połączenie już korzysta z modelu głosowego. Spróbuj ponownie, gdy się zakończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra chamada já está usando o modelo de voz. Tente de novo quando ela terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一通通话正在使用语音模型。请等它结束后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一通通話正在使用語音模型。請等它結束後再試。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et andet opkald bruger allerede stemmemodellen. Prøv igen, når det er afsluttet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen puhelu käyttää jo puhemallia. Yritä uudelleen, kun se päättyy."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Annað símtal notar þegar raddlíkanið. Reyndu aftur þegar það lýkur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et annet anrop bruker allerede stemmemodellen. Prøv igjen når det er avsluttet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett annat samtal använder redan röstmodellen. Försök igen när det är slut."
          }
        }
      }
    },
