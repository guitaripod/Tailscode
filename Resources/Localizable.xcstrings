    "Optional. Without paths the worker may change any file, and the composer says so.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit. Uden stier må agenten ændre enhver fil, og inputfeltet siger det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Ohne Pfade darf der Worker jede Datei ändern, und der Editor weist darauf hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Without paths the worker may change any file, and the composer says so."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Sin rutas, el worker puede modificar cualquier archivo, y el editor lo indica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen. Ilman polkuja työntekijä voi muuttaa mitä tahansa tiedostoa, ja kehotekenttä kertoo tämän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Sans chemins, le worker peut modifier n’importe quel fichier, et le composeur le signale."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfrjálst. Án slóða getur vinnuaðilinn breytt hvaða skrá sem er og innsláttarreiturinn segir frá því."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Senza percorsi il worker può modificare qualsiasi file, e il compositore lo segnala."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意。パスを指定しない場合、ワーカーはどのファイルでも変更でき、コンポーザーにもその旨が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항. 경로가 없으면 워커가 어떤 파일이든 변경할 수 있으며, 작성 화면에도 그렇게 표시됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt. Uten baner kan arbeideren endre hvilken som helst fil, og inntastingsfeltet sier det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Bez ścieżek worker może zmienić dowolny plik, o czym informuje kreator."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Sem caminhos, o worker pode alterar qualquer arquivo, e o editor avisa isso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frivilligt. Utan sökvägar kan arbetaren ändra vilken fil som helst, och inmatningsfältet säger det."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。不填路径时，执行者可以修改任意文件，编辑界面也会如此提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選填。不填路徑時，執行者可以修改任意檔案，編輯介面也會如此提示。"
          }
        }
      }
    },
