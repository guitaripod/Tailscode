    "Comma-separated, like x.com, youtube.com; empty for any link": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comma-separated, like x.com, youtube.com; empty for any link"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommagetrennt, z. B. x.com, youtube.com; leer für jeden Link"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separados por comas, como x.com, youtube.com; vacío para cualquier enlace"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séparés par des virgules, comme x.com, youtube.com ; vide pour tout lien"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Separati da virgola, come x.com, youtube.com; vuoto per qualsiasi link"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンマ区切り (例: x.com, youtube.com)。空欄なら任意のリンク"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉼표로 구분 (예: x.com, youtube.com). 비워 두면 모든 링크"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oddzielone przecinkami, np. x.com, youtube.com; puste dla dowolnego linku"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Separados por vírgula, como x.com, youtube.com; vazio para qualquer link"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用逗号分隔，如 x.com, youtube.com；留空表示任何链接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以逗號分隔，如 x.com, youtube.com；留空表示任何連結"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommasepareret, f.eks. x.com, youtube.com; tom for alle links"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilkulla erotettuna, esim. x.com, youtube.com; tyhjä tarkoittaa mitä tahansa linkkiä"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðskilið með kommum, t.d. x.com, youtube.com; autt fyrir hvaða hlekk sem er"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommaseparert, f.eks. x.com, youtube.com; tom for alle lenker"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Separera med kommatecken, till exempel x.com, youtube.com; lämna tomt för alla länkar"
