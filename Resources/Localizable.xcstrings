    "Camera access is off, so the code cannot be read. You can paste the link instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off, so the code cannot be read. You can paste the link instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff ist aus, daher lässt sich der QR-Code nicht lesen. Stattdessen lässt sich der Link einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara está desactivado, así que no se puede leer el código QR. Se puede pegar el enlace en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à la caméra est désactivé, le code QR ne peut donc pas être lu. Vous pouvez coller le lien à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla fotocamera è disattivato, quindi il codice QR non può essere letto. In alternativa si può incollare il link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスがオフのため、QRコードを読み取れません。代わりにリンクを貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근이 꺼져 있어 QR 코드를 읽을 수 없어요. 대신 링크를 붙여 넣을 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do aparatu jest wyłączony, więc kodu QR nie da się odczytać. Zamiast tego można wkleić link."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera está desativado, então o código QR não pode ser lido. Você pode colar o link no lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机权限已关闭，无法读取二维码。也可以直接粘贴链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機權限已關閉，無法讀取 QR Code。也可以直接貼上連結。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraadgang er slået fra, så koden kan ikke læses. Du kan indsætte linket i stedet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameran käyttö on pois päältä, joten koodia ei voi lukea. Voit liittää linkin sen sijaan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Myndavélaraðgangur er slökktur, svo ekki er hægt að lesa kóðann. Þú getur límt tengilinn inn í staðinn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameratilgang er av, så koden kan ikke leses. Du kan lime inn lenken i stedet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraåtkomst är avstängd, så koden kan inte läsas. Du kan klistra in länken i stället."
          }
        }
      }
    },
