    "%@ answered but refused the password. Check it on the server.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat geantwortet, aber das Passwort abgelehnt. Prüfe es auf dem Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ answered but refused the password. Check it on the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ respondió, pero rechazó la contraseña. Compruébala en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a répondu mais a refusé le mot de passe. Vérifiez-le sur le serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha risposto ma ha rifiutato la password. Controllala sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が応答しましたが、パスワードが拒否されました。サーバ側で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 응답했지만 암호가 거부되었습니다. 서버에서 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ respondeu, mas recusou a senha. Confira no servidor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已响应，但密码被拒绝。请在服务器上检查。"
