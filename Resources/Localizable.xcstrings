    "Stopped working — tap to replace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped working — tap to replace"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert nicht mehr – zum Ersetzen tippen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejó de funcionar: toca para reemplazar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A cessé de fonctionner — touchez pour remplacer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
