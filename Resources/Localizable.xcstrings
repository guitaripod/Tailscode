    "%@ tokens on %@%@ ran on a plan — billed by the month, not per token": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Tokens auf %2$@%3$@ liefen über einen Tarif — abgerechnet im Monat, nicht pro Token"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens on %@%@ ran on a plan — billed by the month, not per token"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tokens en %2$@%3$@ se ejecutaron con un plan: facturado por mes, no por token"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ jetons sur %2$@%3$@ ont tourné via un forfait — facturé au mois, pas au jeton"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ token su %2$@%3$@ sono stati eseguiti con un piano — fatturato al mese, non per token"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@%3$@上の%1$@トークンはプランで実行されました — 月単位の課金で、トークン単位ではありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@%3$@에서 실행된 %1$@ 토큰은 요금제로 처리되었습니다 — 토큰 단위가 아니라 월 단위로 청구됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tokens em %2$@%3$@ rodaram em um plano — cobrado por mês, não por token"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@%3$@ 上的 %1$@ 个词元通过套餐运行 — 按月计费，而非按词元计费"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@%3$@ 上的 %1$@ 個詞元透過方案執行 — 按月計費，而非按詞元計費"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tokenów na %2$@%3$@ działało w ramach taryfy — rozliczanej miesięcznie, a nie za token"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens på %@%@ kørte på en pakke – faktureret pr. måned, ikke pr. token"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokenia mallilla %@%@ käytettiin paketin kautta, laskutus kuukausittain eikä tokenikohtaisesti"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tákn á %@%@ keyrðu í pakka sem er innheimtur mánaðarlega, en ekki eftir tákni"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ token på %@%@ kjørte på en pakke, fakturert per måned, ikke per token"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens på %@%@ kördes i ett paket, faktureras per månad och inte per token"
          }
        }
      }
    },
