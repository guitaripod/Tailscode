    "Tailscode does not need to be running.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode muss dafür nicht laufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode does not need to be running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode no necesita estar en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode n’a pas besoin d’être en cours d’exécution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è necessario che Tailscode sia in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode が起動している必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode가 실행 중일 필요는 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode não precisa estar em execução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 不需要处于运行状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 不需要處於執行狀態。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode nie musi być uruchomiony."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode behøver ikke at køre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscoden ei tarvitse olla käynnissä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode þarf ekki að vera í gangi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode trenger ikke å kjøre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode behöver inte vara igång."
          }
        }
      }
    },
    "The desktop holds this key only while Tailscode is running.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Desktop hält diese Taste nur, solange Tailscode läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The desktop holds this key only while Tailscode is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escritorio reserva esta tecla solo mientras Tailscode está en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bureau réserve cette touche uniquement pendant que Tailscode est en cours d’exécution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il desktop riserva questo tasto solo mentre Tailscode è in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップがこのキーを確保しているのは、Tailscode が起動している間だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데스크톱은 Tailscode가 실행 중일 때만 이 키를 확보합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desktop reserva esta tecla apenas enquanto o Tailscode está em execução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在 Tailscode 运行时，桌面环境才会保留这个按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在 Tailscode 執行時，桌面環境才會保留這個按鍵。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulpit trzyma ten klawisz tylko wtedy, gdy Tailscode jest uruchomiony."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivebordet holder kun denne tast, mens Tailscode kører."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työpöytä pitää tätä näppäintä vain niin kauan kuin Tailscode on käynnissä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjáborðið heldur þessum takka aðeins á meðan Tailscode er í gangi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivebordet holder denne tasten bare så lenge Tailscode kjører."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivbordet håller tangenten bara medan Tailscode är igång."
          }
        }
      }
    },
    "%@ only grants a key to an app it launched itself, and this Tailscode was started another way. Open it from its launcher entry, or bind the command below.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vergibt eine Taste nur an eine App, die es selbst gestartet hat, und dieses Tailscode wurde anders gestartet. Öffne es über seinen Starter-Eintrag, oder binde den Befehl unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ only grants a key to an app it launched itself, and this Tailscode was started another way. Open it from its launcher entry, or bind the command below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solo concede una tecla a una app que él mismo ha iniciado, y este Tailscode se inició de otra forma. Ábrelo desde su entrada en el lanzador, o asigna el comando de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’accorde une touche qu’à une app qu’il a lui-même lancée, or ce Tailscode a été démarré autrement. Ouvrez-le depuis son entrée dans le lanceur, ou associez la commande ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ concede un tasto solo a un’app che ha avviato lui stesso, e questo Tailscode è stato avviato in altro modo. Aprilo dalla sua voce nel launcher, oppure assegna il comando qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は自分自身が起動したアプリにしかキーを与えません。この Tailscode は別の方法で起動されています。ランチャーの項目から開くか、下のコマンドを割り当ててください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 자신이 직접 실행한 앱에만 키를 부여하는데, 이 Tailscode는 다른 방식으로 시작되었습니다. 런처 항목에서 열거나, 아래 명령어를 지정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ só concede uma tecla a um app que ele mesmo iniciou, e este Tailscode foi iniciado de outra forma. Abra-o pela entrada dele no launcher, ou vincule o comando abaixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只会把按键授权给自己启动的应用，而这个 Tailscode 是以别的方式启动的。请从启动器条目打开它，或者绑定下面的命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只會把按鍵授權給自己啟動的應用程式，而這個 Tailscode 是以別的方式啟動的。請從啟動器項目開啟它，或是繫結下面的指令。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ przyznaje klawisz tylko aplikacji, którą sam uruchomił, a ten Tailscode został uruchomiony inaczej. Otwórz go z jego wpisu w launcherze albo przypisz poniższe polecenie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ giver kun en tast til en app, den selv har startet, og Tailscode blev startet på en anden måde. Åbn Tailscode fra starterposten, eller bind kommandoen nedenfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ antaa näppäimen vain sovellukselle, jonka se on itse käynnistänyt, ja tämä Tailscode on käynnistetty toisella tavalla. Avaa se käynnistysmerkinnästään tai määritä alla oleva komento."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ úthlutar takka aðeins til forrits sem það ræsti sjálft, og þetta Tailscode var ræst á annan hátt. Opnaðu það úr ræsifærslunni þess, eða úthlutaðu skipuninni hér fyrir neðan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gir bare en tast til en app den har startet selv, og denne Tailscode ble startet på en annen måte. Åpne den fra starteroppføringen, eller knytt kommandoen nedenfor til en tast."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ger bara en tangent till en app som den startade själv, och den här Tailscode startades på ett annat sätt. Öppna den från dess post i programmenyn, eller koppla kommandot nedan."
          }
        }
      }
    },
    "%@ has no global-shortcuts portal, so no app on it can be granted a key. Bind the command below instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat kein Portal für globale Tastenkürzel, daher kann keiner App darauf eine Taste zugewiesen werden. Binde stattdessen den Befehl unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no global-shortcuts portal, so no app on it can be granted a key. Bind the command below instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene portal de atajos globales, así que ninguna app en él puede recibir una tecla. Asigna en su lugar el comando de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas de portail de raccourcis globaux, donc aucune app dessus ne peut se voir accorder une touche. Associez plutôt la commande ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha un portale per le scorciatoie globali, quindi nessuna app al suo interno può ricevere un tasto. Assegna invece il comando qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にはグローバルショートカット用のポータルがないため、その上のどのアプリにもキーを付与できません。代わりに下のコマンドを割り当ててください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에는 전역 단축키 포털이 없어서, 그 위의 어떤 앱에도 키를 부여할 수 없습니다. 대신 아래 명령어를 지정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem portal de atalhos globais, então nenhum app nele pode receber uma tecla. Em vez disso, vincule o comando abaixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有全局快捷键的 portal，因此上面的任何应用都无法获得按键授权。请改为绑定下面的命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有全域快速鍵的 portal，因此上面的任何應用程式都無法取得按鍵授權。請改為繫結下面的指令。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie ma portalu globalnych skrótów, więc żadna aplikacja na nim nie może otrzymać klawisza. Zamiast tego przypisz poniższe polecenie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen portal til globale genveje, så ingen app på det kan få tildelt en tast. Bind i stedet kommandoen nedenfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:llä ei ole globaalien pikanäppäinten portaalia, joten siinä ei voi antaa sovellukselle näppäintä. Määritä sen sijaan alla oleva komento."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hefur enga gátt fyrir altæka flýtilykla, svo ekki er hægt að veita neinu forriti þar takka. Úthlutaðu skipuninni hér fyrir neðan í staðinn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen portal for globale snarveier, så ingen app på det kan få tildelt en tast. Knytt kommandoen nedenfor i stedet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen portal för globala kortkommandon, så ingen app där kan få en tangent. Koppla kommandot nedan i stället."
          }
        }
      }
    },
