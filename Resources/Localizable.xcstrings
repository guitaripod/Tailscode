    "An interrupted download resumes when the command is run again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An interrupted download resumes when the command is run again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein unterbrochener Download wird fortgesetzt, wenn der Befehl erneut ausgeführt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una descarga interrumpida se reanuda al volver a ejecutar el comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un téléchargement interrompu reprend quand la commande est relancée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un download interrotto riprende quando il comando viene eseguito di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断したダウンロードは、コマンドをもう一度実行すると再開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단된 다운로드는 명령을 다시 실행하면 이어서 받아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerwane pobieranie jest wznawiane po ponownym uruchomieniu polecenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um download interrompido continua quando o comando é executado de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中断的下载会在再次运行该命令时继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷的下載會在再次執行該指令時繼續。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et afbrudt download genoptages, når kommandoen køres igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskeytynyt lataus jatkuu, kun komento suoritetaan uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Niðurhal sem rofnar heldur áfram þegar skipunin er keyrð aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En avbrutt nedlasting fortsetter når kommandoen kjøres på nytt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En avbruten hämtning återupptas när kommandot körs igen."
          }
        }
      }
    },
