    "Every server in Tailscode is reached over your tailnet. The API token is only used to list your devices during discovery.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Server in Tailscode wird über dein Tailnet erreicht. Das API-Token dient nur dazu, beim Suchen deine Geräte aufzulisten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every server in Tailscode is reached over your tailnet. The API token is only used to list your devices during discovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A todos los servidores de Tailscode se accede por tu tailnet. El token de la API solo se usa para listar tus dispositivos durante el descubrimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque serveur dans Tailscode est joint via votre tailnet. Le jeton API sert uniquement à lister vos appareils pendant la découverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni server in Tailscode viene raggiunto tramite il tuo tailnet. Il token API serve solo a elencare i tuoi dispositivi durante il rilevamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode のすべてのサーバには tailnet 経由で接続します。API トークンは検出時にデバイス一覧を取得するためだけに使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode의 모든 서버는 tailnet을 통해 연결됩니다. API 토큰은 검색 중 기기 목록을 가져올 때만 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os servidores no Tailscode são acessados pela sua tailnet. O token de API só é usado para listar seus dispositivos durante a descoberta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 中的每台服务器都通过你的 tailnet 访问。API 令牌仅用于在发现过程中列出你的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 中的每台伺服器都透過你的 tailnet 連線。API 權杖僅用於探索時列出你的裝置。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy serwer w Tailscode jest osiągany przez twój tailnet. Token API służy jedynie do wylistowania twoich urządzeń podczas wykrywania."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle servere i Tailscode nås via dit tailnet. API-tokenet bruges kun til at hente dine enheder under søgningen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode tavoittaa jokaisen palvelimen tailnetin kautta. API-tokenia käytetään vain laitteidesi listaamiseen etsinnän aikana."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode nær í hvern netþjón í gegnum tailnetið þitt. API-aðgangstáknið er aðeins notað til að lista upp tækin þín við leit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle servere i Tailscode nås over tailnetet ditt. API-tokenet brukes bare til å liste opp enhetene dine under søket."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje server i Tailscode nås via ditt tailnet. API-token används bara för att lista dina enheter vid sökning."
          }
        }
      }
    },
    "Everything awake on your tailnet is a phone or a tablet, and neither can run an agent.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was in deinem Tailnet gerade wach ist, ist ein Telefon oder ein Tablet — keines davon kann einen Agenten ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything awake on your tailnet is a phone or a tablet, and neither can run an agent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que está despierto en tu tailnet es un teléfono o una tablet, y ninguno de los dos puede ejecutar un agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est éveillé sur votre tailnet est un téléphone ou une tablette, et aucun des deux ne peut exécuter un agent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che è attivo sul tuo tailnet è un telefono o un tablet, e nessuno dei due può eseguire un agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tailnet 上で起動しているものはすべてスマートフォンかタブレットで、どちらもエージェントを実行できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 tailnet에서 깨어 있는 것은 모두 휴대폰이나 태블릿이며, 둘 다 에이전트를 실행할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que está ativo na sua tailnet é um telefone ou um tablet, e nenhum dos dois pode rodar um agente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你 tailnet 上目前唤醒的都是手机或平板电脑，两者都无法运行智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你 tailnet 上目前喚醒的都是手機或平板電腦，兩者都無法執行代理。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co jest teraz aktywne w twoim tailnet, to telefon albo tablet — żadne z nich nie może uruchomić agenta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, der er vågent på dit tailnet, er en telefon eller en tablet, og ingen af dem kan køre en agent."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tailnetissäsi hereillä oleva on puhelin tai tabletti, eikä kumpikaan voi ajaa agenttia."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt sem er vakandi á tailnetinu þínu er sími eða spjaldtölva, og hvorugt getur keyrt agent."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt som er våkent på tailnetet ditt, er en telefon eller et nettbrett, og ingen av dem kan kjøre en agent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt som är uppkopplat i ditt tailnet är en telefon eller surfplatta, och ingen av dem kan köra en agent."
          }
        }
      }
    },
    "Everything in it goes away, on the server, for every device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles darin verschwindet, auf dem Server, für jedes Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in it goes away, on the server, for every device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina todo, en el servidor, para todos los dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout son contenu disparaît, sur le serveur, pour chaque appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto il suo contenuto sparisce, sul server, per ogni dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中身はすべて、サーバ上から、すべてのデバイスで消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 안의 모든 것이 서버에서, 모든 기기에서 사라집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que ela contém desaparece, no servidor, para todos os dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中的一切都会从服务器上消失，所有设备皆然。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中的一切都會從伺服器上消失，所有裝置皆然。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko w niej znika, na serwerze, dla każdego urządzenia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt i den forsvinder, på serveren, for alle enheder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki siinä poistetaan palvelimelta kaikilta laitteilta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt í því hverfur, á netþjóninum, fyrir hvert tæki."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt i den forsvinner, på serveren, for alle enheter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt i den försvinner, på servern, för varje enhet."
          }
        }
      }
    },
