        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mikrofon er tilgjengelig på %@. Koble en til, eller velg en i lydinnstillingene, og prøv igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mikrofon på den här %@ är tillgänglig. Anslut en eller välj en i ljudinställningarna och försök sedan igen."
          }
        }
      }
    },
