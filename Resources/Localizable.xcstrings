    "The file is not valid JSON. Its text is kept beside it as keybindings.json.broken, and a fresh file takes its place.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is not valid JSON. Its text is kept beside it as keybindings.json.broken, and a fresh file takes its place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei ist kein gültiges JSON. Ihr Text wird als keybindings.json.broken daneben aufbewahrt, und eine neue Datei tritt an ihre Stelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no es JSON válido. Su texto se guarda junto a él como keybindings.json.broken, y un archivo nuevo ocupa su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n’est pas du JSON valide. Son contenu est conservé à côté sous le nom keybindings.json.broken, et un nouveau fichier prend sa place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file non è JSON valido. Il suo testo viene conservato accanto come keybindings.json.broken, e un file nuovo ne prende il posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは有効な JSON ではありません。内容は keybindings.json.broken として横に保存され、新しいファイルが置かれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 올바른 JSON이 아닙니다. 내용은 keybindings.json.broken으로 옆에 보관되고, 새 파일이 그 자리를 대신합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik nie jest prawidłowym JSON-em. Jego treść zostaje zachowana obok jako keybindings.json.broken, a na jego miejscu pojawia się nowy plik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não é um JSON válido. O texto dele é mantido ao lado como keybindings.json.broken, e um arquivo novo ocupa o lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件不是有效的 JSON。其内容会以 keybindings.json.broken 的名称保留在旁边，并生成一个新文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案不是有效的 JSON。其內容會以 keybindings.json.broken 的名稱保留在旁邊，並產生一個新檔案。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen er ikke gyldig JSON. Dens tekst gemmes ved siden af den som keybindings.json.broken, og en ny fil tager dens plads."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedosto ei ole kelvollinen JSON. Sen sisältö säilytetään samassa kansiossa nimellä keybindings.json.broken, ja tilalle luodaan uusi tiedosto."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skráin er ekki gilt JSON. Textinn hennar er geymdur við hliðina sem keybindings.json.broken og ný skrá tekur sæti hennar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen er ikke gyldig JSON. Teksten lagres ved siden av filen som keybindings.json.broken, og en ny fil tar plassen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen är inte giltig JSON. Dess text sparas bredvid som keybindings.json.broken, och en ny fil tar dess plats."
          }
        }
      }
    },
    "The first key of this sequence is already used on its own (%@), so the sequence could never be reached.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first key of this sequence is already used on its own (%@), so the sequence could never be reached."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Taste dieser Folge wird allein schon verwendet (%@), daher wäre die Folge nie erreichbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera tecla de esta secuencia ya se usa sola (%@), así que la secuencia nunca podría activarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La première touche de cette séquence est déjà utilisée seule (%@) : la séquence ne pourrait donc jamais être atteinte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo tasto di questa sequenza è già usato da solo (%@), quindi la sequenza non potrebbe mai essere raggiunta."
          }
