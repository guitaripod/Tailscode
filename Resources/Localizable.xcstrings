    "The focused chat and a few others stay whole; the rest show as glance tiles, so many panes never slow this computer down.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The focused chat and a few others stay whole; the rest show as glance tiles, so many panes never slow this computer down."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der fokussierte Chat und einige weitere bleiben vollständig; die übrigen erscheinen als Überblick-Kacheln, damit viele Bereiche diesen Computer nie ausbremsen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chat enfocado y unos pocos más se mantienen completos; el resto se muestra como mosaicos de vistazo, para que muchos paneles nunca ralenticen este equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversation active et quelques autres restent entières ; les autres s’affichent en tuiles d’aperçu, pour que de nombreux volets ne ralentissent jamais cet ordinateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chat in primo piano e poche altre restano intere; le altre appaiono come riquadri a colpo d'occhio, così molti riquadri non rallentano mai questo computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のチャットといくつかのチャットはそのまま表示され、残りは一覧タイルで表示されます。ペインが多くてもこのコンピュータが重くなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 대화와 몇 개의 대화는 전체로 유지되고 나머지는 요약 타일로 표시되므로, 패인이 많아도 이 컴퓨터가 느려지지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywny czat i kilka innych pozostają w pełnej postaci, a reszta pokazuje się jako kafelki podglądu, dzięki czemu wiele paneli nigdy nie spowolni tego komputera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversa em foco e algumas outras ficam completas; as demais aparecem como blocos de resumo, para que muitos painéis nunca deixem este computador lento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获得焦点的对话和少数几个对话保持完整显示，其余以概览磁贴呈现，这样窗格再多也不会拖慢这台电脑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取得焦點的對話和少數幾個對話保持完整顯示，其餘以概覽磚塊呈現，這樣窗格再多也不會拖慢這台電腦。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valgte chat og nogle få andre forbliver hele; resten vises som overblikskort, så mange ruder aldrig gør denne computer langsom."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohdistettu keskustelu ja muutama muu pysyvät kokonaisina; muut näkyvät silmäyskortteina, joten monet ruudut eivät koskaan hidasta tätä konetta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Valda spjallið og nokkur önnur haldast heil; hin birtast sem yfirlitsflísar, svo margar rúður hægi aldrei á þessari tölvu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fokuserte chatten og noen få andre forblir hele; resten vises som oversiktsfliser, så mange paneler aldri bremser denne maskinen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fokuserade chatten och några till hålls hela; resten visas som överblickskort, så att många rutor aldrig bromsar den här datorn."
          }
        }
      }
    },
    "Ignored while this computer is strained: keeping it responsive comes first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignored while this computer is strained: keeping it responsive comes first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird ignoriert, solange dieser Computer unter Last steht: Reaktionsfähigkeit hat Vorrang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ignora mientras este equipo está sobrecargado: mantenerlo ágil es lo primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoré tant que cet ordinateur est sous tension : rester réactif passe avant tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorato finché questo computer è sotto pressione: la reattività viene prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータの負荷が高い間は無視されます。応答性の維持が最優先です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터에 부하가 클 때는 무시됩니다. 반응성을 유지하는 것이 우선입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomijane, gdy ten komputer jest przeciążony: responsywność jest ważniejsza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorado enquanto este computador está sobrecarregado: manter a resposta rápida vem primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台电脑负载过高时会被忽略：保持响应流畅优先。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台電腦負載過高時會被忽略：保持回應流暢優先。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoreret mens denne computer er belastet: at holde den responsiv har forrang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohitetaan, kun tämä kone on kuormitettu: reagointikyky on etusijalla."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hunsað meðan þessi tölva er undir álagi: að halda henni snöggri hefur forgang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoreres mens denne maskinen er belastet: respons kommer først."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoreras medan den här datorn är ansträngd: att hålla den snabb har företräde."
          }
        }
      }
    },
