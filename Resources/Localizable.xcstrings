        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Nefndu geymsluna á þessari tölvu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi repositoriet på den maskinen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange repositoriet på den datorn."
          }
        }
      }
    },
    "No paths: the worker may change any file in the repository.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Pfade: Der Worker darf jede Datei im Repository ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No paths: the worker may change any file in the repository."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin rutas: el worker puede modificar cualquier archivo del repositorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun chemin : le worker peut modifier n’importe quel fichier du dépôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun percorso: il worker può modificare qualsiasi file nel repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスが指定されていません。ワーカーはリポジトリ内のどのファイルでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로가 없습니다. 워커가 저장소 내 어떤 파일이든 변경할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem caminhos: o worker pode alterar qualquer arquivo no repositório."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有指定路径：执行者可以修改仓库中的任意文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有指定路徑：執行者可以修改儲存庫中的任意檔案。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak ścieżek: worker może zmienić dowolny plik w repozytorium."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen stier: workeren må ændre enhver fil i repositoryet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei polkuja: työntekijä saa muuttaa mitä tahansa tiedostoa repositoriossa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engar slóðir: vinnuaðilinn má breyta hvaða skrá sem er í geymslunni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen stier: arbeideren kan endre alle filer i repositoriet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga sökvägar: workern får ändra vilken fil som helst i repositoriet."
          }
        }
      }
    },
    "No verify command: the packet passes as soon as the worker changes a file.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Verifizierungsbefehl: Das Paket gilt als bestanden, sobald der Worker eine Datei ändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No verify command: the packet passes as soon as the worker changes a file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin comando de verificación: el paquete se aprueba en cuanto el worker modifica un archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune commande de vérification : le paquet réussit dès que le worker modifie un fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun comando di verifica: il pacchetto passa non appena il worker modifica un file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証コマンドが指定されていません。ワーカーがファイルを変更した時点でパケットは合格扱いになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증 명령이 없습니다. 워커가 파일을 하나라도 변경하면 즉시 패킷이 통과됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem comando de verificação: o pacote passa assim que o worker altera um arquivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有验证命令：只要执行者修改了一个文件，任务包就算通过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有驗證命令：只要執行者修改了一個檔案，任務包就算通過。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak polecenia weryfikacji: pakiet zostaje zaliczony, gdy tylko worker zmieni plik."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen verifikationskommando: pakken består, så snart workeren ændrer en fil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei verifiointikomentoa: paketti läpäistään heti, kun työntekijä muuttaa tiedoston."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin sannprófunarskipun: pakkinn telst standast um leið og vinnuaðilinn breytir skrá."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen verifiseringskommando: pakken er bestått så snart arbeideren endrer en fil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget verifieringskommando: paketet godkänns så snart workern ändrar en fil."
          }
        }
      }
    },
    "The ladder is read from the machine once it answers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leiter wird vom Rechner gelesen, sobald er antwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ladder is read from the machine once it answers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escalera se obtiene de la máquina en cuanto responde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’échelle est lue depuis la machine dès qu’elle répond."
          }
        },
        "it": {
