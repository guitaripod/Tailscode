    "Live agent spend and rate-limit quotas across your coding servers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Ausgaben und Rate-Limit-Kontingente deiner Agenten über alle Coding-Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live agent spend and rate-limit quotas across your coding servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasto en vivo de los agentes y cuotas de límite de tasa en tus servidores de programación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépenses en direct et quotas de limitation de débit sur vos serveurs de code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spesa in tempo reale degli agenti e quote di rate limit sui tuoi server di sviluppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングサーバ全体のエージェント支出とレート制限のリアルタイム表示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코딩 서버 전반의 에이전트 지출과 속도 제한 할당량을 실시간으로."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasto ao vivo dos agentes e cotas de limite de taxa nos seus servidores de programação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跨编程服务器的智能体实时花费与速率限制配额。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跨程式設計伺服器的代理即時花費與速率限制配額。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżące wydatki agentów i limity zapytań na wszystkich twoich serwerach kodu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenternes forbrug og hastighedsgrænser i realtid på tværs af dine kodeservere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenttien reaaliaikaiset kulut ja nopeusrajoituskiintiöt koodauspalvelimillasi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostnaður agenta og hraðakvótar í rauntíma á kóðunarnetþjónunum þínum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostnader for agenter og kvoter for hastighetsgrenser i sanntid på tvers av kodeserverne dine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostnader och hastighetsgränser för agenter i realtid på dina kodservrar."
          }
        }
      }
    },
