    "A bridge set up with a push key also sends its own alert, which travels through Apple like any push.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bridge mit eingerichtetem Push-Schlüssel sendet zusätzlich eine eigene Benachrichtigung, die wie jeder Push über Apple läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bridge set up with a push key also sends its own alert, which travels through Apple like any push."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bridge configurado con una clave de push también envía su propia alerta, que pasa por Apple como cualquier push."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bridge configuré avec une clé de push envoie aussi sa propre alerte, qui transite par Apple comme tout push."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bridge configurato con una chiave push invia anche un proprio avviso, che passa da Apple come qualsiasi push."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プッシュキーを設定したブリッジは独自の通知も送信し、これは他のプッシュと同様に Apple を経由します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "푸시 키가 설정된 브리지는 자체 알림도 보내며, 이 알림은 다른 푸시와 마찬가지로 Apple을 거칩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um bridge configurado com uma chave de push também envia seu próprio alerta, que passa pela Apple como qualquer push."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置了推送密钥的 bridge 还会发送自己的提醒，它和其他推送一样经过 Apple。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定了推播金鑰的 bridge 也會傳送自己的提醒，它和其他推播一樣經過 Apple。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge z ustawionym kluczem push wysyła też własny alert, który jak każdy push przechodzi przez Apple."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En bridge med en push-nøgle sender også sin egen notifikation, som går via Apple ligesom enhver push."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge, jossa on push-avain, lähettää myös oman ilmoituksensa, joka kulkee Applen kautta kuten mikä tahansa push."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge sett upp með push-lykli sendir líka sína eigin tilkynningu, sem fer í gegnum Apple eins og hver önnur push-tilkynning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En Bridge satt opp med en push-nøkkel sender også sitt eget varsel, som går via Apple som alle push-varsler."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En bridge med en push-nyckel skickar också en egen avisering, som går via Apple precis som andra push-meddelanden."
          }
        }
      }
    },
    "A build made here, past anything published. Nothing to install.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein hier erstellter Build, neuer als alles Veröffentlichte. Nichts zu installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A build made here, past anything published. Nothing to install."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un build creado aquí, más reciente que cualquier versión publicada. No hay nada que instalar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un build créé ici, plus récent que tout ce qui est publié. Rien à installer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un build creato qui, più recente di qualsiasi versione pubblicata. Niente da installare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでビルドされたもので、公開済みのどれよりも新しい状態です。インストールするものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 직접 만든 빌드로, 공개된 어떤 버전보다도 최신입니다. 설치할 것이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um build feito aqui, à frente de tudo o que foi publicado. Não há nada para instalar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机构建的版本，比任何已发布的版本都新。没有可安装的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機建置的版本，比任何已發布的版本都新。沒有可安裝的內容。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Build zbudowany tutaj, nowszy niż cokolwiek opublikowanego. Nie ma nic do zainstalowania."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En build lavet her, nyere end alt, der er udgivet. Intet at installere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä tehty build, uudempi kuin mikään julkaistu. Ei asennettavaa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Smíð gerð hér, nýrri en allt sem hefur verið birt. Ekkert til að setja upp."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et bygg laget her, nyere enn alt som er publisert. Ingenting å installere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En build som byggts här, nyare än allt som publicerats. Inget att installera."
          }
        }
      }
    },
