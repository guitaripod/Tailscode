    "Paste the link your machine printed, or install the agent on a computer. Tailscode checks each step.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the link your machine printed, or install the agent on a computer. Tailscode checks each step."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge den Link ein, den dein Rechner ausgegeben hat, oder installiere den Agenten auf einem Rechner. Tailscode prüft jeden Schritt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega el enlace que mostró tu equipo, o instala el agente en un equipo. Tailscode comprueba cada paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colle le lien affiché par ta machine, ou installe l'agent sur une machine. Tailscode vérifie chaque étape."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla il link stampato dal tuo computer, oppure installa l'agente su un computer. Tailscode verifica ogni passaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンが表示したリンクを貼り付けるか、マシンにエージェントをインストールしてください。各ステップは Tailscode が確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에 출력된 링크를 붙여 넣거나, 컴퓨터에 에이전트를 설치해 주세요. 각 단계는 Tailscode가 확인해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej link wyświetlony przez komputer albo zainstaluj agenta na komputerze. Tailscode sprawdza każdy krok."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole o link que o seu computador mostrou, ou instale o agente em um computador. O Tailscode verifica cada etapa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴你的电脑打印出的链接，或在一台电脑上安装代理。Tailscode 会检查每一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上你的電腦印出的連結，或在一台電腦上安裝代理。Tailscode 會檢查每一步。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt linket ind, som din computer skrev ud, eller installer agenten på en computer. Tailscode tjekker hvert trin."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä tietokoneen tulostama linkki tai asenna agentti tietokoneeseen. Tailscode tarkistaa jokaisen vaiheen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Límdu inn hlekkinn sem tölvan birti, eða settu agentinn upp á tölvu. Tailscode athugar hvert skref."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn lenken maskinen skrev ut, eller installer agenten på en maskin. Tailscode sjekker hvert steg."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in länken som din dator skrev ut, eller installera agenten på en dator. Tailscode kontrollerar varje steg."
          }
        }
      }
    },
