        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 미리보기를 빌드할 수 없습니다. 첫 번째 문제: %@. 수정해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podglądu %@ nie udało się skompilować. Pierwszy problem: %@. Napraw go, proszę."
