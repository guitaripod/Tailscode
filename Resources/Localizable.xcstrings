    "Every clip comes with sound. Say what is heard, or let the model decide": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Clip hat Ton. Sag, was zu hören ist, oder überlass es dem Modell"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every clip comes with sound. Say what is heard, or let the model decide"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los clips llevan sonido. Di qué se escucha, o deja que lo decida el modelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque clip a du son. Dites ce qu’on entend, ou laissez le modèle décider"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni clip ha l’audio. Di' cosa si sente, oppure lascia decidere al modello"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのクリップにも音がつきます。何が聞こえるかを伝えるか、モデルに任せてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 클립에는 소리가 들어갑니다. 무엇이 들리는지 말하거나, 모델이 정하도록 두세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo clipe vem com som. Diga o que se ouve, ou deixe o modelo decidir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个片段都自带音效。说出你想听到的声音，或者交给模型决定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個片段都自帶音效。說出你想聽到的聲音，或者交給模型決定"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy klip ma dźwięk. Powiedz, co słychać, albo zostaw to modelowi"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert klip har lyd. Beskriv, hvad der høres, eller lad modellen bestemme"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaiseen klippiin tulee ääni. Kerro, mitä kuullaan, tai anna mallin päättää"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert myndskeið fylgir með hljóði. Segðu hvað heyrist, eða láttu líkanið ákveða"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert klipp har lyd. Si hva som høres, eller la modellen bestemme"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje klipp har ljud. Säg vad som hörs eller låt modellen bestämma"
          }
        }
      }
    },
    "What is heard: rain on a tin roof, a distant train…": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was zu hören ist: Regen auf einem Blechdach, ein entfernter Zug …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is heard: rain on a tin roof, a distant train…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se escucha: lluvia en un tejado de chapa, un tren a lo lejos…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu’on entend : pluie sur un toit de tôle, un train au loin…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa si sente: pioggia su un tetto di lamiera, un treno lontano…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞こえるもの：ブリキ屋根に降る雨、遠くを走る列車…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들리는 소리: 양철 지붕에 떨어지는 빗소리, 멀리서 들리는 기차 소리…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que se ouve: chuva num telhado de zinco, um trem ao longe…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听到的声音：雨点打在铁皮屋顶上，远处的火车声…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽到的聲音：雨點打在鐵皮屋頂上，遠處的火車聲…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co słychać: deszcz na blaszanym dachu, odległy pociąg…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad der høres: regn på et blikktag, et fjernt tog…"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä kuullaan: sadetta peltikatolla, kaukainen juna…"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það sem heyrist: rigning á blikkþaki, fjarlæg lest…"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva som høres: regn på et blikktak, et fjernt tog…"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad som hörs: regn mot ett plåttak, ett avlägset tåg…"
          }
        }
      }
    },
    "%@ runs without guidance, so this changes nothing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft ohne Guidance, daher ändert das nichts"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ runs without guidance, so this changes nothing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funciona sin guía, así que esto no cambia nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fonctionne sans guidage, donc cela ne change rien"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funziona senza guida, quindi questo non cambia nulla"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はガイダンスなしで動作するため、これは何も変わりません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 가이던스 없이 동작하므로 이 설정은 아무 효과가 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ funciona sem orientação, então isso não muda nada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不使用引导机制运行，因此这项设置不会有任何效果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不使用引導機制運行，因此這項設定不會有任何效果"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ działa bez guidance, więc to niczego nie zmienia"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kører uden vejledning, så det ændrer intet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ toimii ilman ohjausta, joten tämä ei muuta mitään"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ keyrir án leiðsagnar, svo þetta breytir engu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kjører uten Guidance, så dette endrer ingenting"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ körs utan vägledning, så detta ändrar ingenting"
          }
        }
      }
    },
