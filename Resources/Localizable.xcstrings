    "The preview of %@ would not build. The first problem is: %@. Please fix it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preview of %@ would not build. The first problem is: %@. Please fix it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau von %@ ließ sich nicht kompilieren. Das erste Problem ist: %@. Bitte beheben Sie es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa de %@ no se pudo compilar. El primer problema es: %@. Hace falta corregirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aperçu de %@ n’a pas pu être compilé. Le premier problème : %@. Veuillez le corriger."
