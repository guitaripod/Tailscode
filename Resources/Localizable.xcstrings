    "%@ refused that password. Check it on the server.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat dieses Passwort abgelehnt. Prüfe es auf dem Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ refused that password. Check it on the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rechazó esa contraseña. Compruébala en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé ce mot de passe. Vérifiez-le sur le serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha rifiutato questa password. Controllala sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がそのパスワードを拒否しました。サーバ側で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 해당 암호를 거부했습니다. 서버에서 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
