    "%@ attached — it'll be sent with your next message.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ angehängt – wird mit deiner nächsten Nachricht gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ attached — it'll be sent with your next message."
