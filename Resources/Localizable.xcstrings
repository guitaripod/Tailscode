    "This copy of Tailscode can't look at your tailnet for machines. Paste the link your machine printed, or its address.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy of Tailscode can't look at your tailnet for machines. Paste the link your machine printed, or its address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kopie von Tailscode kann dein Tailnet nicht nach Rechnern durchsuchen. Füge den Link ein, den dein Rechner ausgegeben hat, oder seine Adresse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de Tailscode no puede buscar equipos en tu tailnet. Pega el enlace que mostró tu equipo, o su dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie de Tailscode ne peut pas chercher de machines sur ton tailnet. Colle le lien affiché par ta machine, ou son adresse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa copia di Tailscode non può cercare computer nella tua tailnet. Incolla il link stampato dal tuo computer, oppure il suo indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンの Tailscode は、tailnet 上のマシンを探すことができません。マシンが表示したリンク、またはそのアドレスを貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전의 Tailscode는 tailnet에서 컴퓨터를 찾을 수 없어요. 컴퓨터에 출력된 링크나 주소를 붙여 넣어 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja Tailscode nie może wyszukiwać komputerów w Twojej sieci tailnet. Wklej link wyświetlony przez komputer albo jego adres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia do Tailscode não consegue procurar computadores na sua tailnet. Cole o link que o seu computador mostrou, ou o endereço dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 Tailscode 无法在你的 tailnet 中查找电脑。请粘贴你的电脑打印出的链接，或它的地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 Tailscode 無法在你的 tailnet 中尋找電腦。請貼上你的電腦印出的連結，或它的位址。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kopi af Tailscode kan ikke søge efter computere i dit tailnet. Sæt linket ind, som din computer skrev ud, eller dens adresse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä Tailscoden versio ei voi etsiä tietokoneita tailnetistasi. Liitä tietokoneen tulostama linkki tai sen osoite."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta eintak af Tailscode getur ekki leitað að tölvum á tailnetinu þínu. Límdu inn hlekkinn sem tölvan birti, eða vistfang hennar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kopien av Tailscode kan ikke se etter maskiner i tailnettet ditt. Lim inn lenken maskinen skrev ut, eller adressen til den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här versionen av Tailscode kan inte söka efter datorer i ditt tailnet. Klistra in länken som din dator skrev ut, eller dess adress."
          }
        }
      }
    },
