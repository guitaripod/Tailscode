    "Builds need about 8 GB free. Free some space on the Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Builds need about 8 GB free. Free some space on the Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kompilieren braucht etwa 8 GB freien Speicher. Schaffen Sie auf dem Mac etwas Platz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilar necesita unos 8 GB libres; conviene liberar espacio en el Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La compilation demande environ 8 Go libres. Libérez de l’espace sur le Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La compilazione richiede circa 8 GB liberi. Liberare un po’ di spazio sul Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルドには約 8 GB の空き容量が必要です。Mac の空き容量を確保してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드에는 약 8GB의 여유 공간이 필요합니다. Mac에서 공간을 확보해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompilacja potrzebuje około 8 GB wolnego miejsca. Zwolnij trochę miejsca na Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compilação precisa de cerca de 8 GB livres. Libere um pouco de espaço no Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建需要约 8 GB 可用空间，请在 Mac 上腾出一些空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建置需要約 8 GB 可用空間，請在 Mac 上騰出一些空間。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Builds kræver cirka 8 GB ledig plads. Frigør noget plads på Mac'en."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koostaminen vaatii noin 8 Gt vapaata tilaa. Vapauta tilaa Macilla."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Byggingar þurfa um 8 GB laust. Losaðu um pláss á Mac-tölvunni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bygging trenger omtrent 8 GB ledig plass. Frigjør litt plass på Macen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byggen behöver cirka 8 GB ledigt utrymme. Frigör lite utrymme på Mac:en."
          }
        }
      }
    },
