    "System Settings is open at Privacy & Security → Full Disk Access.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemeinstellungen ist bei Datenschutz & Sicherheit → Festplattenvollzugriff geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Settings is open at Privacy & Security → Full Disk Access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes del Sistema está abierto en Privacidad y seguridad → Acceso total al disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages Système est ouvert sur Confidentialité et sécurité → Accès complet au disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni di Sistema è aperto su Privacy e sicurezza → Accesso completo al disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定はプライバシーとセキュリティ → フルディスクアクセスで開いています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정이 개인정보 보호 및 보안 → 전체 디스크 접근 권한에서 열려 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Ajustes do Sistema estão abertos em Privacidade e segurança → Acesso Total ao Disco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置已打开，位于隐私与安全性 → 完全磁盘访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設定已打開，位於隱私權與安全性 → 完整磁碟取用權。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia systemowe są otwarte na Prywatność i bezpieczeństwo → Pełny dostęp do dysku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemindstillinger er åbnet ved Privatliv og sikkerhed → Fuld diskadgang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestelmäasetukset on auki kohdassa Tietosuoja ja turvallisuus → Täysi levykäyttöoikeus."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerfisstillingar eru opnaðar við Friðhelgi og öryggi → Fullur aðgangur að diski."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeminnstillinger er åpnet på Personvern og sikkerhet → Full tilgang til disk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeminställningar är öppna under Integritet och säkerhet → Full diskåtkomst."
          }
        }
      }
    },
