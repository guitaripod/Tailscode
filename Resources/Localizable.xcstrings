        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventetiden meldes til din hånd: sendt, i gang, færdig"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odotus ilmoitetaan kädellesi: lähetetty, edistyy, valmis"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Biðin finnst í hendinni: sent, í vinnslu, lokið"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventetiden kjennes i hånden: sendt, fremdrift, ferdig"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntetiden känns i handen: skickad, pågående, klar"
          }
        }
      }
