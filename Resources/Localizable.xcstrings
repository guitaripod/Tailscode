    "Checks Tailscale, then finds or installs the agent on your computer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks Tailscale, then finds or installs the agent on your computer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft Tailscale und findet den Agenten auf deinem Rechner oder installiert ihn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba Tailscale y luego encuentra o instala el agente en tu equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie Tailscale, puis trouve ou installe l'agent sur ta machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla Tailscale, poi trova o installa l'agente sul tuo computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale を確認し、マシン上のエージェントを見つけるかインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale을 확인한 다음 컴퓨터에서 에이전트를 찾거나 설치해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
