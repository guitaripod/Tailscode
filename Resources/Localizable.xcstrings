    "The server pulls the new code, rebuilds it, and restarts. It stops answering for a moment while it does.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server holt den neuen Code, baut ihn neu und startet neu. Dabei antwortet er kurz nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server pulls the new code, rebuilds it, and restarts. It stops answering for a moment while it does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor descarga el código nuevo, lo recompila y se reinicia. Durante ese rato deja de responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur récupère le nouveau code, le recompile et redémarre. Il cesse de répondre le temps de le faire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server scarica il nuovo codice, lo ricompila e si riavvia. Nel frattempo smette di rispondere per un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバは新しいコードを取得してビルドし直し、再起動します。その間しばらく応答しなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 새 코드를 받아 다시 빌드하고 재시작합니다. 그동안 잠시 응답하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor baixa o código novo, recompila e reinicia. Nesse meio-tempo ele para de responder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器会拉取新代码、重新构建并重启，其间会短暂无法响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器會拉取新程式碼、重新建置並重新啟動，其間會短暫無法回應。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer pobiera nowy kod, buduje go ponownie i uruchamia się od nowa. Na chwilę przestaje wtedy odpowiadać."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren henter den nye kode, laver en ny build og genstarter. Den svarer ikke et øjeblik, mens den gør det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin hakee uuden koodin, rakentaa sen uudelleen ja käynnistyy uudelleen. Sinä aikana se ei vastaa hetkeksi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Netþjónninn sækir nýja kóðann, endurbyggir hann og endurræsir sig. Hann svarar ekki í smá stund á meðan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren henter den nye koden, bygger den på nytt og starter på nytt. Den svarer ikke et øyeblikk mens den gjør det."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern hämtar den nya koden, bygger om den och startar om. Den svarar inte en kort stund medan det pågår."
          }
        }
      }
    },
