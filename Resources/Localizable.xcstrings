          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica o Tailscale e depois encontra ou instala o agente no seu computador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先检查 Tailscale，再在你的电脑上找到或安装代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先檢查 Tailscale，再在你的電腦上找到或安裝代理。"
          }
        },
        "da": {
