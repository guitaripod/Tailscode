          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkłada łatkę na bok; drzewo robocze nigdy jej nie zobaczy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
