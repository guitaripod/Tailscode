        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバは一覧にないモデル ID も実行できます — 検索欄に入力すれば、そのまま提示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 목록에 없던 모델 ID도 실행할 수 있습니다 — 검색창에 입력하면 그대로 제시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor também executa ids de modelo que nunca listou — digite um na busca e ele será oferecido como está."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器也能运行它从未列出过的模型 id——在搜索框中输入一个，就会按原样提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器也能執行它從未列出過的模型 id——在搜尋欄中輸入一個，就會按原樣提供。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten serwer uruchamia też identyfikatory modeli, których nigdy nie wymienił — wpisz jeden w wyszukiwarce, a zostanie zaoferowany bez zmian."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne server kører også model-ID'er, den aldrig har angivet. Skriv ID'et ind i søgningen, så tilbydes det uændret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä palvelin ajaa myös mallitunnuksia, joita se ei koskaan listannut – kirjoita yksi hakuun, ja se tarjotaan sellaisenaan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi netþjónn keyrir líka líkanakenni sem hann listaði aldrei – sláðu eitt inn í leitina og það er boðið óbreytt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne serveren kjører også modell-ID-er den aldri listet opp. Skriv inn en i søket, så tilbys den uendret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här servern kör också modell-ID:n den aldrig listade – skriv in ett i sökningen, så erbjuds det som det är."
