    "A long press holds the microphone open until you let go": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et langt tryk holder mikrofonen åben, indtil du slipper"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langes Drücken hält das Mikrofon offen, bis du loslässt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A long press holds the microphone open until you let go"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pulsación larga mantiene el micrófono abierto hasta que lo sueltas"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitkä painallus pitää mikrofonin auki, kunnes päästät irti"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appui long garde le micro ouvert jusqu'à ce que vous relâchiez"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Löng ýting heldur hljóðnemanum opnum þar til þú sleppir takinu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pressione prolungata tiene aperto il microfono finché non lasci"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しすると、指を離すまでマイクが開いたままになります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 누르면 손을 뗄 때까지 마이크가 켜져 있습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et langt trykk holder mikrofonen åpen helt til du slipper"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Długie naciśnięcie trzyma mikrofon włączony, dopóki nie puścisz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque longo mantém o microfone aberto até você soltar"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett långt tryck håller mikrofonen öppen tills du släpper"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按会让麦克风保持开启，直到你松开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按會讓麥克風保持開啟，直到你放開"
          }
        }
      }
    },
