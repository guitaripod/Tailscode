        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ takes a single key, not a sequence"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ admite una sola tecla, no una secuencia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’accepte qu’une seule touche, pas une séquence"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ accetta un solo tasto, non una sequenza"
          }
        },
