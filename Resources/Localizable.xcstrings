          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode가 실행 중일 필요는 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode não precisa estar em execução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
