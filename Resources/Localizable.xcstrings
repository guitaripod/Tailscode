    "This iPhone can't turn %@ into an address. MagicDNS may be off — use the machine's 100.x address instead.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone can't turn %@ into an address. MagicDNS may be off — use the machine's 100.x address instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone kann %@ nicht in eine Adresse auflösen. Vielleicht ist MagicDNS aus – nutze stattdessen die 100.x-Adresse des Rechners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone no puede convertir %@ en una dirección. MagicDNS puede estar desactivado: usa la dirección 100.x de la máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone ne peut pas transformer %@ en adresse. MagicDNS est peut-être désactivé — utilisez plutôt l’adresse 100.x de la machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo iPhone non riesce a tradurre %@ in un indirizzo. MagicDNS potrebbe essere disattivato — usa l’indirizzo 100.x della macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone は %@ をアドレスに変換できません。MagicDNS がオフの可能性があります。マシンの 100.x のアドレスを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone은 %@에 해당하는 주소를 찾지 못했습니다. MagicDNS가 꺼져 있을 수 있습니다 — 대신 컴퓨터의 100.x 주소를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone não consegue transformar %@ em um endereço. O MagicDNS pode estar desativado — use o endereço 100.x da máquina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 无法把 %@ 变成地址。可能是 MagicDNS 已关闭 — 请改用那台机器的 100.x 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 iPhone 無法將 %@ 解析成位址。MagicDNS 可能已關閉 — 請改用那台電腦的 100.x 位址。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten iPhone nie może zamienić %@ w adres. MagicDNS może być wyłączony — użyj zamiast tego adresu 100.x tego komputera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPhone kan ikke finde adressen på %@. MagicDNS er måske slået fra – brug i stedet computerens 100.x-adresse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä iPhone ei voi selvittää osoitetta nimelle %@. MagicDNS voi olla pois päältä – käytä sen sijaan koneen 100.x-osoitetta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi iPhone getur ekki breytt %@ í vistfang. Hugsanlega er MagicDNS slökkt – notaðu 100.x-vistfang tölvunnar í staðinn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne iPhonen kan ikke gjøre %@ om til en adresse. MagicDNS er kanskje av. Bruk maskinens 100.x-adresse i stedet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här iPhonen kan inte översätta %@ till en adress. MagicDNS kan vara avstängt, använd datorns 100.x-adress i stället."
          }
        }
      }
    },
    "This iPhone is not on your tailnet, so it cannot reach your machine yet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone is not on your tailnet, so it cannot reach your machine yet."
          }
        },
        "de": {
