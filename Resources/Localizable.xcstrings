        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten serwer nie może przekazać plików, więc tablica nie może się otworzyć."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne server kan ikke udlevere filer, så tavlen kan ikke åbnes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä palvelin ei voi lähettää tiedostoja, joten taulua ei voi avata."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi netþjónn getur ekki afhent skrár, svo ekki er hægt að opna töfluna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne serveren kan ikke levere filer, så en tavle kan ikke åpnes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här servern kan inte skicka filer, så tavlan kan inte öppnas."
          }
