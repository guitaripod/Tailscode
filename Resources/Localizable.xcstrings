    "The question carried a picture, and a model that will not be handed one answers exactly like this.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Frage enthielt ein Bild, und ein Modell, dem keines übergeben wird, antwortet genau so."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The question carried a picture, and a model that will not be handed one answers exactly like this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pregunta incluía una imagen, y un modelo al que no se le entrega ninguna responde exactamente así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La question comportait une image, et un modèle à qui l’on n’en transmet pas répond exactement ainsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La domanda conteneva un’immagine, e un modello a cui non ne viene passata una risponde esattamente così."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問には画像が含まれていましたが、画像を渡されないモデルはまさにこのように答えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문에 이미지가 포함되어 있었는데, 이미지를 전달받지 못하는 모델은 정확히 이렇게 답합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pergunta trazia uma imagem, e um modelo que não recebe uma responde exatamente assim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个问题带了一张图片，而不会收到图片的模型正是这样回答的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個問題帶了一張圖片，而不會收到圖片的模型正是這樣回答的。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytanie zawierało obraz, a model, któremu się go nie przekazuje, odpowiada dokładnie tak."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørgsmålet havde et billede med, og en model, som ikke får et billede, svarer netop sådan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysymyksessä oli kuva, ja malli, jolle kuvaa ei anneta, vastaa juuri näin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spurningin innihélt mynd, og líkan sem fær ekki mynd svarar nákvæmlega svona."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørsmålet hadde et bilde, og en modell som ikke får se bilder, svarer akkurat slik."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frågan innehöll en bild, och en modell som inte får se den svarar precis så här."
          }
        }
      }
    },
