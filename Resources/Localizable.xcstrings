    "A usage window is on course to run out before it resets. Account-wide windows only, once per window": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A usage window is on course to run out before it resets. Account-wide windows only, once per window"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Nutzungsfenster droht vor dem Zurücksetzen auszulaufen. Nur kontoweite Fenster, einmal pro Fenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ventana de uso va a agotarse antes de reiniciarse. Solo ventanas de toda la cuenta, una vez por ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fenêtre d’usage risque de s’épuiser avant sa réinitialisation. Fenêtres du compte uniquement, une fois par fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una finestra di utilizzo sta per esaurirsi prima del ripristino. Solo finestre dell’intero account, una volta per finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用量の枠がリセット前に上限に達しそうです。アカウント全体の枠のみ、枠ごとに 1 回。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용량 기간이 초기화 전에 소진될 것으로 보입니다. 계정 전체 기간만 해당하며, 기간마다 한 번입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okno użycia wyczerpie się przed resetem. Tylko okna dla całego konta, raz na okno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma janela de uso está prestes a acabar antes de ser redefinida. Somente janelas da conta, uma vez por janela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "某个用量窗口会在重置前用完。仅限账户级窗口，每个窗口一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "某個用量視窗會在重設前用完。僅限帳戶級視窗，每個視窗一次。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et brugsvindue er på vej til at løbe tør, før det nulstilles. Kun vinduer for hele kontoen, én gang pr. vindue"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttöjakso on uhkaamassa loppua ennen nollautumistaan. Vain tilikohtaiset jaksot, kerran jaksoa kohden."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Notkunargluggi stefnir í að klárast áður en hann endurstillist. Aðeins gluggar fyrir allan aðganginn, einu sinni fyrir hvern glugga."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et bruksvindu er på vei til å gå tom før det tilbakestilles. Bare kontovindu, én gang per vindu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett användningsfönster håller på att ta slut innan det återställs. Endast kontoomfattande fönster, en gång per fönster"
          }
        }
      }
    },
