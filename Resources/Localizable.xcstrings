    "Come back here. Tap Discover to scan your tailnet, or enter the machine's Tailscale address — like %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komm hierher zurück. Tippe auf „Suchen“, um dein Tailnet zu scannen, oder gib die Tailscale-Adresse des Rechners ein – etwa %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come back here. Tap Discover to scan your tailnet, or enter the machine's Tailscale address — like %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve aquí. Toca Descubrir para escanear tu tailnet o introduce la dirección Tailscale del equipo, por ejemplo %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez ici. Touchez Découvrir pour scanner votre tailnet, ou saisissez l’adresse Tailscale de la machine — par exemple %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna qui. Tocca Rileva per scansionare il tuo tailnet, oppure inserisci l’indirizzo Tailscale della macchina — ad esempio %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに戻ってきてください。「検出」をタップして tailnet をスキャンするか、マシンの Tailscale アドレス（例: %@）を入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기로 돌아오세요. 검색을 탭해 tailnet을 스캔하거나, 컴퓨터의 Tailscale 주소(예: %@)를 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Volte aqui. Toque em Descobrir para varrer sua tailnet ou digite o endereço Tailscale da máquina — como %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到这里。轻点“发现”扫描你的 tailnet，或输入这台机器的 Tailscale 地址 — 例如 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到這裡。輕點「探索」掃描你的 tailnet，或輸入這台電腦的 Tailscale 位址 — 例如 %@。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wróć tutaj. Dotknij „Wykryj”, aby zeskanować swój tailnet, albo wpisz adres Tailscale tego komputera — na przykład %@."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom tilbage hertil. Tryk på Find for at scanne dit tailnet, eller indtast computerens Tailscale-adresse – som %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palaa tänne. Napauta Etsi skannataksesi tailnetisi tai syötä tietokoneen Tailscale-osoite, esimerkiksi %@."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Komdu aftur hingað. Ýttu á „Finna“ til að skanna tailnetið þitt, eða settu inn Tailscale-vistfang tölvunnar – eins og %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom tilbake hit. Trykk på «Finn» for å skanne tailnettet ditt, eller skriv inn maskinens Tailscale-adresse – for eksempel %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom tillbaka hit. Tryck på Hitta för att skanna ditt tailnet, eller ange datorns Tailnet-adress, till exempel %@."
          }
        }
      }
    },
