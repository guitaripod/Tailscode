          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Moment bleiben weniger Chats vollständig (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora se mantienen completos menos chats (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de conversations restent entières pour le moment (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento restano interi meno chat (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
