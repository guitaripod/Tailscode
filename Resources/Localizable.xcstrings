    "Which variants of this model fit my GPU, and how fast would they run?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which variants of this model fit my GPU, and how fast would they run?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Varianten dieses Modells passen in meine GPU, und wie schnell liefen sie?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué variantes de este modelo caben en mi GPU y qué velocidad tendrían?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelles variantes de ce modèle tiennent dans mon GPU, et à quelle vitesse tourneraient-elles ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quali varianti di questo modello stanno nella mia GPU, e quanto veloci sarebbero?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルのどのバリアントが私のGPUに収まり、どれくらいの速度で動くか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델의 어떤 변형이 내 GPU에 들어가며, 얼마나 빨리 돌아갈까?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Które warianty tego modelu mieszczą się w moim GPU i jak szybko by działały?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quais variantes deste modelo cabem na minha GPU, e com que velocidade rodariam?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个模型的哪些版本能放进我的 GPU，运行速度如何？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個模型的哪些版本能放進我的 GPU，執行速度如何？"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilke varianter af denne model passer i min GPU, og hvor hurtigt ville de køre?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitkä tämän mallin versiot mahtuvat näytönohjaimeeni ja kuinka nopeasti ne toimisivat?"
