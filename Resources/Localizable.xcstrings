    "Generate an API access token with Devices read access on the Tailscale keys page. One paste is all you need.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle auf der Tailscale-Schlüsselseite ein API-Zugriffstoken mit Lesezugriff auf Geräte. Ein Einsetzen genügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate an API access token with Devices read access on the Tailscale keys page. One paste is all you need."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un token de acceso a la API con permiso de lectura de Devices en la página de claves de Tailscale. Solo hay que pegarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Générez un jeton d’accès API avec le droit de lecture Devices sur la page des clés Tailscale. Un simple collage suffit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un token di accesso API con permesso di lettura Devices nella pagina delle chiavi di Tailscale. Basta incollarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale のキーのページで Devices の読み取り権限を持つ API アクセストークンを作成してください。貼り付けるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 키 페이지에서 Devices 읽기 권한이 있는 API 접근 토큰을 만드세요. 붙여넣기만 하면 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gere um token de acesso à API com permissão de leitura de Devices na página de chaves do Tailscale. Basta colar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Tailscale 密钥页面生成具有 Devices 读取权限的 API 访问令牌，粘贴一次即可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Tailscale 金鑰頁面產生具備 Devices 讀取權限的 API 存取權杖，貼上一次即可。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygeneruj token dostępu API z uprawnieniem odczytu Devices na stronie kluczy Tailscale. Wystarczy go wkleić."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret et API-adgangstoken med læseadgang til Devices på Tailscales nøgleside. Det er nok at indsætte det én gang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luo Tailscalen avainsivulla API-pääsytunnus, jolla on Devices-sivun lukuoikeus. Yksi liittäminen riittää."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Búðu til API-aðgangstákn með lesaðgangi að tækjum á lyklasíðu Tailscale. Það þarf aðeins að líma það inn einu sinni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lag et API-tilgangstoken med lesetilgang til Devices på Tailscale-nøkkelsiden. Du trenger bare å lime det inn én gang."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en API-åtkomsttoken med läsbehörighet för Devices på Tailscales nyckelsida. Du behöver bara klistra in den en gång."
          }
        }
      }
    },
