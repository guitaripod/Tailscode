    "The iPhone simulator has to be downloaded once. It is a large download.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone simulator has to be downloaded once. It is a large download."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der iPhone-Simulator muss einmal heruntergeladen werden. Der Download ist groß."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El simulador de iPhone hay que descargarlo una vez. Es una descarga grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le simulateur d’iPhone doit être téléchargé une fois. Le téléchargement est volumineux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il simulatore di iPhone va scaricato una volta. È un download grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone シミュレータは一度ダウンロードする必要があります。サイズが大きいです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 시뮬레이터는 한 번 내려받아야 합니다. 용량이 큽니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Symulator iPhone'a trzeba pobrać raz. To duże pobieranie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O simulador do iPhone precisa ser baixado uma vez. É um download grande."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 模拟器需要下载一次，文件较大。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 模擬器需要下載一次，檔案很大。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-simulatoren skal hentes én gang. Det er en stor download."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-simulaattori on ladattava kerran. Lataus on suuri."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermir fyrir iPhone þarf að sækja einu sinni. Þetta er stórt niðurhal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-simulatoren må lastes ned én gang. Det er en stor nedlasting."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-simulatorn måste laddas ner en gång. Nedladdningen är stor."
          }
        }
      }
    },
