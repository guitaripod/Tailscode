    "It is removed from %@ for every device. A saved copy on this machine survives.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird für jedes Gerät aus %@ entfernt. Eine gesicherte Kopie auf diesem Rechner bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is removed from %@ for every device. A saved copy on this machine survives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina de %@ para todos los dispositivos. Una copia guardada en esta máquina sobrevive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est supprimée de %@ pour chaque appareil. Une copie enregistrée sur cette machine survit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene rimossa da %@ per ogni dispositivo. Una copia salvata su questa macchina sopravvive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ からはすべてのデバイスで削除されます。この Mac に保存したコピーは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서는 모든 기기에서 삭제됩니다. 이 Mac에 저장된 사본은 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É removida de %@ para todos os dispositivos. Uma cópia salva nesta máquina sobrevive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将在所有设备上从 %@ 中移除。这台机器上保存的副本仍会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將在所有裝置上從 %@ 中移除。這台機器上儲存的副本仍會保留。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaje usunięte z %@ dla każdego urządzenia. Zapisana kopia na tym komputerze pozostaje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fjernes fra %@ på alle enheder. En gemt kopi på denne computer bevares."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se poistetaan %@:stä kaikilta laitteilta. Tämän tietokoneen tallennettu kopio säilyy."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það er fjarlægt úr %@ á öllum tækjum. Vistað afrit á þessari tölvu helst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fjernes fra %@ for alle enheter. En lagret kopi på denne maskinen beholdes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den tas bort från %@ på alla enheter. En sparad kopia på den här datorn finns kvar."
          }
        }
      }
    },
