    "The canvas the glass floats over, and every signal on it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fläche, über der das Glas schwebt, und jedes Signal darauf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The canvas the glass floats over, and every signal on it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lienzo sobre el que flota el cristal, y cada señal que hay en él"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La toile sur laquelle flotte le verre, et chaque signal qui s’y trouve"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La superficie su cui galleggia il vetro, e ogni segnale su di essa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガラスが浮かぶキャンバスと、そこに映るすべての合図"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유리가 떠 있는 캔버스와, 그 위의 모든 신호"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela sobre a qual o vidro flutua, e cada sinal nela"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "玻璃漂浮其上的画布，以及画布上的每一个信号"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "玻璃漂浮其上的畫布，以及畫布上的每一個訊號"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Płótno, nad którym unosi się szkło, oraz każdy sygnał na nim"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fladen, som glasset svæver over, og hvert signal på den"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pohja, jonka päällä lasi kelluu, ja kaikki sen signaalit"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flöturinn sem glerið svífur yfir, og hvert merki á honum"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegneflaten som glasset svever over, og hvert signal på den"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ytan som glaset svävar över, och varje signal på den"
          }
        }
      }
    },
    "The checkout at %@ could not reach its remote, so nothing here knows whether a newer build exists.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Checkout unter %@ konnte seinen Remote nicht erreichen, daher weiß hier niemand, ob ein neuerer Build existiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The checkout at %@ could not reach its remote, so nothing here knows whether a newer build exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El checkout en %@ no pudo contactar con su remoto, así que nada aquí sabe si existe un build más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le checkout à %@ n'a pas pu joindre son dépôt distant, donc rien ici ne sait s'il existe un build plus récent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il checkout in %@ non è riuscito a raggiungere il proprio remoto, quindi qui non si sa se esiste un build più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のチェックアウトはリモートに接続できなかったため、より新しいビルドが存在するかどうかは、ここでは分かりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 체크아웃이 원격 저장소에 연결하지 못해, 더 최신 빌드가 있는지 여기서는 알 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O checkout em %@ não conseguiu contatar seu remoto, então nada aqui sabe se existe um build mais recente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 %@ 的检出代码无法连接到其远程仓库，因此这里无法得知是否存在更新的版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位於 %@ 的簽出程式碼無法連線到其遠端版本庫，因此這裡無法得知是否存在更新的版本。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkout w %@ nie mógł połączyć się ze swoim zdalnym repozytorium, więc nic tutaj nie wie, czy istnieje nowszy build."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkout'et på %@ kunne ikke nå sin remote, så ingen her ved, om der findes en nyere build."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkopio %@ ei saanut yhteyttä etävarastoonsa, joten täällä ei tiedetä, onko uudempi build olemassa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinnueintakið í %@ náði ekki sambandi við fjarlægu geymsluna sína, svo ekki er vitað hvort nýrri smíð sé til."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkouten på %@ kunne ikke nå fjernlageret, så her vet ingen om en nyere build finnes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkouten på %@ kunde inte nå sin fjärr, så ingenting här vet om en nyare build finns."
          }
        }
      }
    },
    "The checkout at %@ has %@ commits of its own, so it cannot be fast-forwarded.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Checkout unter %1$@ hat %2$@ eigene Commits, daher kann er nicht per Fast-Forward aktualisiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The checkout at %@ has %@ commits of its own, so it cannot be fast-forwarded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El checkout en %1$@ tiene %2$@ commits propios, así que no se puede avanzar en modo fast-forward."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le checkout à %1$@ a %2$@ commits qui lui sont propres, donc il ne peut pas être mis à jour en fast-forward."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il checkout in %1$@ ha %2$@ commit propri, quindi non può essere aggiornato con un fast-forward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のチェックアウトには独自のコミットが%2$@件あるため、早送り(fast-forward)更新ができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 체크아웃에는 자체 커밋이 %2$@개 있어, 패스트포워드(fast-forward)로 업데이트할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O checkout em %1$@ tem %2$@ commits próprios, então não é possível avançar em fast-forward."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 %1$@ 的检出代码有 %2$@ 个自己的提交，因此无法进行快进(fast-forward)更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位於 %1$@ 的簽出程式碼有 %2$@ 個自己的提交，因此無法進行快轉(fast-forward)更新。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkout w %1$@ ma %2$@ własnych commitów, więc nie można go zaktualizować przez fast-forward."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkout'et på %@ har %@ egne commits, så det kan ikke opdateres med fast-forward."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työkopio %@ on %@ omaa committia, joten sitä ei voi päivittää pikasiirrolla."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinnueintakið í %@ hefur %@ eigin commit, svo ekki er hægt að uppfæra það með fast-forward."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkouten på %@ har %@ egne commits, så den kan ikke oppdateres med fast-forward."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkouten på %1$@ har %2$@ egna commits, så den kan inte uppdateras med fast-forward."
          }
        }
      }
    },
    "The checkout at %@ has uncommitted changes, so nothing here will touch it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Checkout unter %@ enthält nicht committete Änderungen, daher wird hier nichts daran verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The checkout at %@ has uncommitted changes, so nothing here will touch it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El checkout en %@ tiene cambios sin confirmar, así que nada aquí lo tocará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le checkout à %@ contient des modifications non validées, donc rien ici n'y touchera."
          }
        },
