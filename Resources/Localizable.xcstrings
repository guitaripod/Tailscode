        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute na máquina onde o servidor roda. Ele atualiza no lugar e mantém sua senha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
