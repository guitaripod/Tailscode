    "Or say when: weekdays 7:30, every 2 hours, fri 17:00": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or say when: weekdays 7:30, every 2 hours, fri 17:00"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder sag, wann: werktags 7:30, alle 2 Stunden, Fr 17:00"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O di cuándo: entre semana 7:30, cada 2 horas, vie 17:00"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou dites quand : en semaine 7:30, toutes les 2 heures, ven. 17:00"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure di quando: nei giorni feriali 7:30, ogni 2 ore, ven 17:00"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "または時間を入力: 平日 7:30、2時間ごと、金 17:00"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 시간을 말하세요: 평일 7:30, 2시간마다, 금 17:00"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Albo podaj kiedy: dni robocze 7:30, co 2 godziny, pt 17:00"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou diga quando: dias úteis 7:30, a cada 2 horas, sex 17:00"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或直接说时间：工作日 7:30、每 2 小时、周五 17:00"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "或直接說時間：平日 7:30、每 2 小時、週五 17:00"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller sig hvornår: hverdage 7:30, hver 2. time, fre 17:00"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai sano milloin: arkisin 7:30, 2 tunnin välein, pe 17:00"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eða segðu hvenær: virka daga 7:30, á 2 klukkustunda fresti, fös 17:00"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller si når: hverdager 7:30, hver 2. time, fre 17:00"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Eller säg när: vardagar 7:30, var 2:e timme, fre 17:00"
