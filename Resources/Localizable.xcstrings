    "Use headphones so the voice does not hear itself and answer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use headphones so the voice does not hear itself and answer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende Kopfhörer, damit die Stimme sich nicht selbst hört und antwortet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa auriculares para que la voz no se oiga a sí misma y responda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un casque pour que la voix ne s'entende pas et ne réponde pas à elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa le cuffie, così la voce non sente se stessa e non risponde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッドフォンを使うと、音声が自分の声を拾って応答してしまうのを防げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성이 자기 목소리를 듣고 응답하지 않도록 헤드폰을 사용하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj słuchawek, aby głos nie słyszał samego siebie i nie odpowiadał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use fones de ouvido para que a voz não ouça a si mesma e responda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用耳机，避免语音听到自己的声音并作出回应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用耳機，避免語音聽到自己的聲音並作出回應。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug hovedtelefoner, så stemmen ikke hører sig selv og svarer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä kuulokkeita, jotta ääni ei kuule itseään ja vastaa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Notaðu heyrnartól svo röddin heyri ekki í sjálfri sér og svari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk hodetelefoner, så stemmen ikke hører seg selv og svarer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd hörlurar så att rösten inte hör sig själv och svarar."
          }
        }
      }
    },
