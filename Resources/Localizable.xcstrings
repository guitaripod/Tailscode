    "config init writes ~/.config/delegate/config.yml and host.yml; install-service starts it as a user service on port 4100, trusting the tailnet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "config init schreibt ~/.config/delegate/config.yml und host.yml; install-service startet es als Benutzerdienst auf Port 4100, der dem Tailnet vertraut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "config init writes ~/.config/delegate/config.yml and host.yml; install-service starts it as a user service on port 4100, trusting the tailnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "config init escribe ~/.config/delegate/config.yml y host.yml; install-service lo inicia como servicio de usuario en el puerto 4100, confiando en el tailnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "config init écrit ~/.config/delegate/config.yml et host.yml ; install-service le démarre comme service utilisateur sur le port 4100, en faisant confiance au tailnet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "config init scrive ~/.config/delegate/config.yml e host.yml; install-service lo avvia come servizio utente sulla porta 4100, fidandosi del tailnet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "config init が ~/.config/delegate/config.yml と host.yml を書き出します。install-service はそれをポート 4100 のユーザサービスとして起動し、tailnet を信頼します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "config init이 ~/.config/delegate/config.yml과 host.yml을 작성합니다. install-service는 이를 포트 4100의 사용자 서비스로 시작하며, tailnet을 신뢰합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "config init grava ~/.config/delegate/config.yml e host.yml; install-service o inicia como serviço de usuário na porta 4100, confiando na tailnet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "config init 会写入 ~/.config/delegate/config.yml 和 host.yml；install-service 会将它作为用户服务在端口 4100 上启动，并信任该 tailnet。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "config init 會寫入 ~/.config/delegate/config.yml 和 host.yml；install-service 會將它做為使用者服務在連接埠 4100 上啟動，並信任該 tailnet。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "config init zapisuje ~/.config/delegate/config.yml i host.yml; install-service uruchamia go jako usługę użytkownika na porcie 4100, ufając tailnetowi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "config init skriver ~/.config/delegate/config.yml og host.yml; install-service starter den som en brugertjeneste på port 4100, der stoler på tailnettet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "config init kirjoittaa tiedostot ~/.config/delegate/config.yml ja host.yml; install-service käynnistää sen käyttäjäpalveluna porttiin 4100 ja luottaa tailnetiin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "config init skrifar ~/.config/delegate/config.yml og host.yml; install-service byrjar það sem notendaþjónustu á gátt 4100 og treystir tailnetinu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "config init skriver ~/.config/delegate/config.yml og host.yml. install-service starter den som en brukertjeneste på port 4100, som stoler på tailnetet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "config init skriver ~/.config/delegate/config.yml och host.yml; install-service startar den som en användartjänst på port 4100 och litar på tailnet."
