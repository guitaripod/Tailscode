    "A renderer nothing has asked for a while stops itself. Save it anyway and the first render wakes it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Renderer, den längere Zeit niemand angefragt hat, stoppt sich selbst. Speichere ihn trotzdem — der erste Render weckt ihn wieder auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A renderer nothing has asked for a while stops itself. Save it anyway and the first render wakes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un renderizador al que nadie ha pedido nada durante un tiempo se detiene solo. Guárdala de todos modos: el primer renderizado la despertará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une machine de rendu que rien n’a sollicitée depuis un moment s’arrête d’elle-même. Enregistrez-la quand même — le premier rendu la réveillera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una macchina di rendering che non riceve richieste per un po' si arresta da sola. Salvala comunque: il primo rendering la risveglierà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらく誰も使わなかったレンダラーは自動的に停止します。それでも保存すれば、最初のレンダリングでまた起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한동안 아무 요청도 받지 않은 렌더러는 스스로 멈춥니다. 그래도 저장해 두면 첫 렌더링이 다시 깨웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma máquina de renderização que ninguém usa por um tempo se desliga sozinha. Salve-a mesmo assim — a primeira renderização vai acordá-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长时间没人使用的渲染机会自行停止。仍然保存它也没关系 — 第一次渲染会把它唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長時間沒人使用的算圖機會自行停止。仍然儲存它也沒關係 — 第一次算圖會把它喚醒。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderer, o który długo nikt nie zapytał, zatrzymuje się sam. Zapisz go mimo to — pierwszy render go obudzi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En renderer, som ingen har bedt om i et stykke tid, stopper sig selv. Gem den alligevel, og den første rendering vækker den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderöijä, jota kukaan ei ole pitkään aikaan käyttänyt, pysähtyy itsekseen. Tallenna se silti: ensimmäinen renderöinti herättää sen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Myndvinnsla sem enginn hefur beðið um í smá stund stöðvar sig sjálf. Vistaðu hana samt og fyrsta vinnslan vekur hana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En renderer som ingen har bedt om på en stund, stopper seg selv. Lagre den likevel – den første renderingen vekker den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En renderare som ingen har efterfrågat på ett tag stoppar sig själv. Spara ändå, så väcker den första renderingen den."
          }
        }
      }
    },
