    "Archive a chat from its row menu to set it aside without deleting it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiviere einen Chat über sein Zeilenmenü, um ihn beiseitezulegen, ohne ihn zu löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive a chat from its row menu to set it aside without deleting it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiva un chat desde su menú de fila para apartarlo sin eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivez une discussion depuis son menu de ligne pour la mettre de côté sans la supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivia una chat dal suo menu di riga per metterla da parte senza eliminarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行のメニューからチャットをアーカイブすると、削除せずに脇へ置いておけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행 메뉴에서 채팅을 보관하면 삭제하지 않고 한쪽으로 치워둘 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquive um chat pelo menu da linha para deixá-lo de lado sem excluí-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在行菜单中归档一段对话，可以把它搁置一旁而不删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在列選單中封存一段對話，可以把它擱置一旁而不刪除。"
          }
        }
      }
    },
    "Archived chats stay on their server — archiving only hides them from this device's lists. One that goes live again resurfaces by itself.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivierte Chats bleiben auf ihrem Server — das Archivieren blendet sie nur aus den Listen dieses Geräts aus. Wird einer wieder aktiv, taucht er von selbst wieder auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived chats stay on their server — archiving only hides them from this device's lists. One that goes live again resurfaces by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los chats archivados permanecen en su servidor — archivarlos solo los oculta de las listas de este dispositivo. Uno que vuelva a estar activo reaparece por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les discussions archivées restent sur leur serveur — l’archivage ne fait que les masquer des listes de cet appareil. Une discussion qui redevient active réapparaît d’elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat archiviate restano sul loro server — l’archiviazione le nasconde solo dagli elenchi di questo dispositivo. Una che torna attiva riemerge da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブされたチャットはサーバ上に残ります。アーカイブは、このデバイスの一覧から隠すだけです。再び動き出したチャットは自動的に再表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관한 채팅은 서버에 그대로 남아 있습니다 — 보관은 이 기기의 목록에서만 숨길 뿐입니다. 다시 활동하는 채팅은 저절로 다시 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os chats arquivados permanecem no servidor deles — arquivar apenas os oculta das listas deste dispositivo. Um que volte a ficar ativo ressurge sozinho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已归档的对话仍保留在它们的服务器上 — 归档只是把它们从这台设备的列表中隐藏。一旦重新活跃，就会自动重新出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已封存的對話仍保留在它們的伺服器上 — 封存只是把它們從這台裝置的清單中隱藏。一旦重新活躍，就會自動重新出現。"
          }
        }
      }
    },
    "As much as the size can hold": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So viel, wie die Größe fasst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As much as the size can hold"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que el tamaño permita"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autant que la taille peut contenir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che la dimensione può contenere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズが許す限りすべて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기가 허용하는 만큼 모두"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quanto o tamanho permitir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在尺寸允许范围内尽量多显示"
          }
        },
        "zh-Hant": {
