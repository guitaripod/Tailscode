        }
      }
    },
    "Nothing is listening on %@ on %@. If ComfyUI is running there, start it with --listen so other machines can reach it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is listening on %@ on %@. If ComfyUI is running there, start it with --listen so other machines can reach it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf %@ lauscht nichts auf %@. Läuft dort ComfyUI, starte es mit --listen, damit andere Rechner es erreichen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada escucha en %@ en %@. Si ComfyUI se ejecuta allí, inícialo con --listen para que otros equipos puedan acceder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'écoute à l'adresse %@ sur %@. Si ComfyUI tourne là-bas, lancez-le avec --listen pour que les autres machines puissent s'y connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun servizio è in ascolto su %@ su %@. Se ComfyUI è in esecuzione lì, avvialo con --listen così che anche le altre macchine possano raggiungerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の %@ では何も待ち受けていません。そこで ComfyUI が動いている場合は、他のマシンから接続できるよう --listen を付けて起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 %@에서 수신 중인 프로그램이 없습니다. 그곳에서 ComfyUI가 실행 중이라면 다른 기기가 접속할 수 있도록 --listen 옵션으로 시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na %@ na %@ nic nie nasłuchuje. Jeśli ComfyUI działa tam, uruchom je z opcją --listen, aby inne komputery mogły się połączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada está escutando em %@ em %@. Se o ComfyUI estiver rodando aí, inicie-o com --listen para que outras máquinas possam acessá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 %@ 没有任何服务在监听。如果 ComfyUI 运行在那里，请使用 --listen 启动，以便其他设备访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 %@ 沒有任何服務在監聽。若 ComfyUI 運行於該處，請使用 --listen 啟動，以便其他裝置連線。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet lytter på %@ på %@. Hvis ComfyUI kører der, så start det med --listen, så andre computere kan nå det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään ei kuuntele osoitteessa %@ portissa %@. Jos ComfyUI on siellä käynnissä, käynnistä se --listen-asetuksella, jotta muut tietokoneet voivat tavoittaa sen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert hlustar á %@ á %@. Ef ComfyUI keyrir þar, byrjaðu það með --listen svo aðrar tölvur nái í það."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lytter på %@ på %@. Hvis ComfyUI kjører der, start den med --listen, så andre maskiner kan nå den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting lyssnar på %@ på %@. Om ComfyUI körs där, starta det med --listen så att andra datorer kan nå det."
          }
        }
      }
    },
