    "Crossfades, and nothing breathes or drifts. Also on when the desk reduces motion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crossfades, and nothing breathes or drifts. Also on when the desk reduces motion"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überblendungen, nichts atmet oder driftet. Auch an, wenn der Schreibtisch Bewegung reduziert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fundidos cruzados; nada respira ni deriva. También activo cuando el escritorio reduce el movimiento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fondus enchaînés, rien ne respire ni ne dérive. Aussi activé quand le bureau réduit les animations"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissolvenze incrociate, niente respira o deriva. Attivo anche quando la scrivania riduce il movimento"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クロスフェードのみで、呼吸や揺れはなし。デスクが動きを減らすときも有効"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교차 페이드만 적용, 아무것도 숨쉬거나 떠다니지 않음. 데스크가 동작을 줄일 때도 적용"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenikanie bez oddychania i dryfowania. Włącza się też, gdy biurko ogranicza ruch"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transições suaves, sem respiração nem deriva. Também ativo quando a mesa reduz o movimento"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只做淡入淡出，不呼吸也不漂移。桌面减少动态效果时也会开启"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只做淡入淡出，不呼吸也不飄移。桌面減少動態效果時也會開啟"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Krydsblænding, og intet ånder eller driver. Også til, når Reducer bevægelse er slået til"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihtuu pehmeästi, eikä mikään hengitä tai leiju. Päällä myös, kun Vähennä liikettä on päällä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Krossblöndun, og ekkert andar eða rekur. Kveikt líka þegar skjáborðið dregur úr hreyfingu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Toner over, og ingenting pulserer eller driver. Også på når skrivebordet reduserer bevegelse"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonar mellan bilder, och inget andas eller driver. Även på när Minska rörelse är på"
          }
        }
      }
    },
