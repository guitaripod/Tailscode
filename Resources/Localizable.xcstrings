    "Asked the server to pick this back up — waiting for it to say it has.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wurde gebeten, dies wieder aufzunehmen — wir warten auf seine Bestätigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asked the server to pick this back up — waiting for it to say it has."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pidió al servidor que retomara esto — a la espera de su confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a été demandé au serveur de reprendre ceci — en attente de sa confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato chiesto al server di riprendere questo — in attesa della sua conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバにこれを再開するよう依頼しました — 確認待ちです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 이것을 다시 이어가도록 요청했습니다 — 확인을 기다리는 중입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi pedido ao servidor para retomar isto — aguardando a confirmação dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求服务器重新接续此项 — 正在等待它确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已請求伺服器重新接續此項 — 正在等待它確認。"
          }
        }
      }
    },
    "Asked the server to set this aside — waiting for it to say it has.": {
