        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これをレビューして、問題のある点を指摘して。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것을 검토하고 잘못된 부분을 짚어줘."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise isto e aponte qualquer coisa errada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审阅这个，并指出任何有问题的地方。"
