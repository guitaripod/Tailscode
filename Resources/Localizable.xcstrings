          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Live fra %@. Procenterne er kontoens faktiske forbrug, ikke et skøn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suorat tiedot palvelusta %@. Prosentit ovat tilin todellista kulutusta, eivät arvioita."
