    "Tailscode Pro is a one-time purchase that lifts the one-server limit. Your first server keeps working either way.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro is a one-time purchase that lifts the one-server limit. Your first server keeps working either way."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro ist ein einmaliger Kauf, der die Grenze von einem Server aufhebt. Dein erster Server funktioniert in jedem Fall weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro es una compra única que elimina el límite de un servidor. Tu primer servidor seguirá funcionando en cualquier caso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro est un achat unique qui lève la limite d’un seul serveur. Votre premier serveur continue de fonctionner dans tous les cas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro è un acquisto una tantum che rimuove il limite di un solo server. Il tuo primo server continua a funzionare in ogni caso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro は買い切りで、サーバ 1 台の上限を解除します。どちらの場合も 1 台目のサーバはそのまま使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro는 서버 한 대 제한을 해제하는 일회성 구매입니다. 어느 쪽이든 첫 번째 서버는 계속 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode Pro é uma compra única que remove o limite de um servidor. Seu primeiro servidor continua funcionando de qualquer forma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro 是一次性购买，可解除单台服务器的限制。无论怎样，你的第一台服务器都会继续可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro 是一次性購買，可解除單一伺服器的限制。無論如何，你的第一台伺服器都會繼續運作。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro to jednorazowy zakup, który znosi limit jednego serwera. Twój pierwszy serwer działa tak czy inaczej."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro er et engangskøb, der ophæver grænsen på én server. Din første server virker, uanset hvad."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro on kertaluonteinen osto, joka poistaa yhden palvelimen rajoituksen. Ensimmäinen palvelimesi toimii joka tapauksessa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro er einskiptiskaup sem afnemur takmörkunina á einum netþjóni. Fyrsti netþjónninn þinn virkar áfram hvort sem er."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro er et engangskjøp som fjerner grensen på én server. Den første serveren fungerer uansett fortsatt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode Pro är ett engångsköp som tar bort begränsningen till en server. Din första server fortsätter fungera ändå."
          }
        }
      }
    },
    "Tailscode is free software under the GNU General Public License v3. You are entitled to the complete source, which is linked above.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ist freie Software unter der GNU General Public License v3. Du hast Anspruch auf den vollständigen Quellcode, der oben verlinkt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode is free software under the GNU General Public License v3. You are entitled to the complete source, which is linked above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode es software libre bajo la Licencia Pública General de GNU v3. Tienes derecho al código fuente completo, enlazado más arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode est un logiciel libre sous licence GNU General Public License v3. Vous avez droit au code source complet, dont le lien figure ci-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode è software libero sotto licenza GNU General Public License v3. Hai diritto al codice sorgente completo, collegato qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode は GNU General Public License v3 に基づくフリーソフトウェアです。上にリンクされた完全なソースコードを入手する権利があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode는 GNU General Public License v3에 따른 자유 소프트웨어입니다. 위에 링크된 전체 소스 코드를 받을 권리가 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode é software livre sob a GNU General Public License v3. Você tem direito ao código-fonte completo, com link acima."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 是遵循 GNU 通用公共许可证 v3 的自由软件。你有权获取完整源代码，链接见上方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 是遵循 GNU 通用公共授權條款 v3 的自由軟體。你有權取得完整原始碼，連結見上方。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode to wolne oprogramowanie na licencji GNU General Public License v3. Masz prawo do pełnego kodu źródłowego, do którego link znajduje się powyżej."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode er fri software under GNU General Public License v3. Du har ret til den komplette kildekode, som er linket ovenfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode on vapaa ohjelmisto GNU General Public License v3 -lisenssin alaisena. Sinulla on oikeus täyteen lähdekoodiin, joka on linkitetty yllä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode er frjáls hugbúnaður undir GNU General Public License v3. Þú átt rétt á fullum frumkóða, sem er tengdur hér fyrir ofan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode er fri programvare under GNU General Public License v3. Du har rett til hele kildekoden, som er lenket ovenfor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode är fri programvara under GNU General Public License v3. Du har rätt till hela källkoden, som är länkad ovan."
          }
        }
      }
    },
    "Tailscode is the remote. Send a prompt from anywhere on your tailnet and watch the turn land — thinking, tool runs, approvals.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode is the remote. Send a prompt from anywhere on your tailnet and watch the turn land — thinking, tool runs, approvals."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ist die Fernbedienung. Sende von überall in deinem Tailnet einen Prompt und verfolge, wie der Zug ankommt – Denken, Werkzeugläufe, Freigaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode es el mando. Envía un prompt desde cualquier punto de tu tailnet y observa cómo llega el turno: razonamiento, ejecuciones de herramientas, aprobaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode est la télécommande. Envoyez une invite depuis n’importe où sur votre tailnet et regardez le tour se dérouler — raisonnement, exécutions d’outils, approbations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode è il telecomando. Invia un prompt da qualsiasi punto del tuo tailnet e guarda il turno arrivare — ragionamento, esecuzioni di strumenti, approvazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode はリモコンです。tailnet のどこからでもプロンプトを送り、ターンが届くまでを見られます。思考、ツールの実行、承認まで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode는 리모컨입니다. tailnet 어디서든 프롬프트를 보내고 턴이 도착하는 것을 지켜보세요 — 추론, 도구 실행, 승인."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode é o controle remoto. Envie um prompt de qualquer ponto da sua tailnet e acompanhe o turno chegar — raciocínio, execuções de ferramentas, aprovações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 就是遥控器。在你 tailnet 上的任何地方发送提示词，看着这一回合落地 — 思考、工具运行、批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 就是那支遙控器。從 tailnet 上的任何地方送出提示詞，看著這個回合落地 — 思考過程、工具執行、核准。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode to pilot. Wyślij prompt z dowolnego miejsca w swoim tailnecie i obserwuj, jak dobiega tura — myślenie, uruchamianie narzędzi, zgody."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode er fjernbetjeningen. Send en prompt fra hvor som helst i dit tailnet og følg, hvordan turen lander – tænkning, værktøjskørsler, godkendelser."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode on etäohjain. Lähetä kehote mistä tahansa tailnetistasi ja seuraa vuoron etenemistä: päättelyä, työkalujen ajoja ja hyväksyntöjä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode er fjarstýringin. Sendu fyrirmæli hvar sem er á tailnetinu þínu og fylgstu með þegar umferðin lendir – hugsun, keyrslur verkfæra, samþykki."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode er fjernkontrollen. Send en prompt fra hvor som helst i tailnettet ditt, og følg med mens turen pågår: tenkning, verktøykjøringer og godkjenninger."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode är fjärrkontrollen. Skicka en prompt var som helst i ditt tailnet och följ hur turen landar – tänkande, verktygskörningar, godkännanden."
          }
        }
      }
    },
    "Tailscode needs permission to add pictures to your photo library.": {
      "extractionState": "manual",
      "localizations": {
