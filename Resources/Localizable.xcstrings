    },
    "This one has a password. It is in the command, and this device fills it in when you copy or send the command.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one has a password. It is in the command, and this device fills it in when you copy or send the command."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser hat ein Passwort. Es steht im Befehl, und dieses Gerät trägt es beim Kopieren oder Senden des Befehls automatisch ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tiene contraseña. Va incluida en el comando, y este dispositivo la rellena al copiar o enviar el comando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui-ci a un mot de passe. Il figure dans la commande, et cet appareil le remplit lorsque vous copiez ou envoyez la commande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo ha una password. È nel comando, e questo dispositivo la inserisce quando si copia o si invia il comando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こちらにはパスワードがあります。パスワードはコマンドに含まれており、コマンドをコピーまたは送信すると、このデバイスが自動で入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 명령에는 비밀번호가 있어요. 비밀번호는 명령어에 들어 있고, 명령어를 복사하거나 보낼 때 이 기기가 자동으로 채워 넣어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten ma hasło. Znajduje się ono w poleceniu, a to urządzenie wypełnia je podczas kopiowania lub wysyłania polecenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tem senha. Ela está no comando, e este dispositivo a preenche quando você copia ou envia o comando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个命令有密码。密码包含在命令中，复制或发送命令时本设备会自动填入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個指令有密碼。密碼包含在指令中，複製或傳送指令時本裝置會自動填入。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne har en adgangskode. Den står i kommandoen, og denne enhed udfylder den, når du kopierer eller sender kommandoen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä komennossa on salasana. Tämä laite täyttää sen automaattisesti, kun kopioit tai lähetät komennon."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi er með lykilorð. Það er í skipuninni, og þetta tæki fyllir það inn þegar þú afritar eða sendir skipunina."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne har et passord. Det står i kommandoen, og denne enheten fyller det inn når du kopierer eller sender kommandoen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här har ett lösenord. Det står i kommandot, och den här enheten fyller i det när du kopierar eller skickar kommandot."
          }
        }
      }
    },
    "Waiting for your machine. It shows up here when the install finishes, or paste the link it prints.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for your machine. It shows up here when the install finishes, or paste the link it prints."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf den Rechner. Er erscheint hier, sobald die Installation fertig ist, oder den ausgegebenen Link einfügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando al equipo. Aparecerá aquí cuando termine la instalación, o pegar el enlace que muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de la machine. Elle apparaît ici une fois l'installation terminée, ou coller le lien affiché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa del computer. Comparirà qui al termine dell'installazione, oppure incollare il link stampato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンを待っています。インストールが完了するとここに表示されます。または、表示されたリンクを貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터를 기다리는 중이에요. 설치가 끝나면 여기에 나타나요. 또는 출력된 링크를 붙여 넣어 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwanie na komputer. Pojawi się tutaj po zakończeniu instalacji, a można też wkleić wyświetlony link."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando o computador. Ele aparece aqui quando a instalação termina, ou cole o link que ele mostra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待电脑。安装完成后它会出现在这里，或者粘贴它打印的链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待電腦。安裝完成後它會出現在這裡，或貼上它印出的連結。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på din computer. Den vises her, når installationen er færdig, eller indsæt det link, den udskriver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odotetaan tietokonetta. Se ilmestyy tähän, kun asennus on valmis, tai liitä sen tulostama linkki."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bíð eftir tölvunni þinni. Hún birtist hér þegar uppsetningunni lýkur, eða límdu inn tengilinn sem hún prentar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på maskinen din. Den dukker opp her når installasjonen er ferdig, eller lim inn lenken den skriver ut."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på din dator. Den visas här när installationen är klar, eller klistra in länken den skriver ut."
          }
        }
      }
    },
    "Waiting for your machine. When the install finishes, scan the code it prints or open its link.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for your machine. When the install finishes, scan the code it prints or open its link."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf den Rechner. Wenn die Installation fertig ist, den ausgegebenen QR-Code scannen oder den Link öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando al equipo. Cuando termine la instalación, escanear el código QR que muestra o abrir su enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de la machine. Une fois l'installation terminée, scanner le code QR affiché ou ouvrir son lien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa del computer. Al termine dell'installazione, scansionare il codice QR stampato o aprire il suo link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンを待っています。インストールが完了したら、表示される QR コードを読み取るか、リンクを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터를 기다리는 중이에요. 설치가 끝나면 출력된 QR 코드를 스캔하거나 링크를 여세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwanie na komputer. Po zakończeniu instalacji zeskanuj wyświetlony kod QR lub otwórz link."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando o computador. Quando a instalação terminar, escaneie o código QR que ele mostra ou abra o link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待电脑。安装完成后，扫描它打印的二维码或打开其链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待電腦。安裝完成後，掃描它印出的 QR Code 或開啟其連結。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på din computer. Når installationen er færdig, scan koden, den udskriver, eller åbn linket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odotetaan tietokonetta. Kun asennus on valmis, skannaa sen tulostama koodi tai avaa sen linkki."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bíð eftir tölvunni þinni. Þegar uppsetningunni lýkur skaltu skanna kóðann sem hún prentar eða opna tengilinn hennar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på maskinen din. Når installasjonen er ferdig, skann koden den skriver ut, eller åpne lenken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väntar på din dator. När installationen är klar, skanna koden den skriver ut eller öppna dess länk."
          }
        }
      }
    },
    "%@ answered and wants a password. The link brought it, and it is used when you press Connect.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ answered and wants a password. The link brought it, and it is used when you press Connect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat geantwortet und verlangt ein Passwort. Der Link hat es mitgebracht, und es wird beim Klick auf Verbinden verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ respondió y pide una contraseña. La trajo el enlace, y se usa al pulsar Conectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a répondu et demande un mot de passe. Le lien l'a fourni, et il est utilisé lorsque vous appuyez sur Se connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha risposto e chiede una password. Il link l'ha fornita, e viene usata quando si preme Connetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が応答し、パスワードを求めています。パスワードはリンクから渡され、「接続」を押したときに使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@가 응답했고 비밀번호를 요구해요. 비밀번호는 링크에서 가져왔고, 연결을 누르면 사용돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ odpowiedziało i chce hasła. Przekazał je link, a zostanie użyte po naciśnięciu Połącz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ respondeu e quer uma senha. O link a trouxe, e ela é usada quando você toca em Conectar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已响应并要求密码。密码来自链接，在你点击“连接”时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已回應並要求密碼。密碼來自連結，在你按下「連線」時使用。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har svaret og vil have en adgangskode. Linket medbragte den, og den bruges, når du trykker på Opret forbindelse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vastasi ja pyytää salasanaa. Linkki toi sen mukanaan, ja sitä käytetään, kun painat ”Yhdistä”."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svaraði og vill lykilorð. Tengillinn kom með það og það er notað þegar þú ýtir á Tengjast."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarte og vil ha et passord. Lenken tok det med seg, og det brukes når du trykker Koble til."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarade och vill ha ett lösenord. Länken tog med det, och det används när du trycker på Anslut."
          }
        }
      }
    },
