    "Switch to one of the six models you carry. Tailscode opens on it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to one of the six models you carry. Tailscode opens on it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle zu einem der sechs Modelle in deinem Team. Tailscode öffnet dann dieses Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia a uno de los seis modelos que llevas. Tailscode se abre con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe à l'un des six modèles de ton équipe. Tailscode s'ouvre dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa a uno dei sei modelli della tua squadra. Tailscode si apre su di esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パーティにある6つのモデルのいずれかに切り替えます。Tailscodeはそのモデルで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파티에 있는 여섯 모델 중 하나로 전환합니다. Tailscode가 그 모델로 열립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełącza na jeden z sześciu modeli w Twojej drużynie. Tailscode otworzy się na nim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda para um dos seis modelos que você tem no time. O Tailscode abre nele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到你携带的六个模型之一。Tailscode 将以该模型打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換到你帶著的六個模型之一。Tailscode 將以該模型開啟。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift til en af de seks modeller, du har. Tailscode åbner på den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda johonkin kuudesta ryhmääsi kuuluvasta mallista. Tailscode avautuu siihen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skiptu yfir í eitt af sex líkönum sem þú berð. Tailscode opnast á því."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt til en av de seks modellene du har. Tailscode starter med den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt till en av de sex modeller som du har i ditt team. Tailscode öppnar med den."
          }
        }
      }
    },
