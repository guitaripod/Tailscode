    "Takes a few minutes. It restarts only once nothing is running on it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauert ein paar Minuten. Es startet erst neu, sobald nichts mehr darauf läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes a few minutes. It restarts only once nothing is running on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarda unos minutos. Solo se reinicia cuando no queda nada en ejecución en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela prend quelques minutes. Elle ne redémarre qu'une fois que plus rien n'y tourne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede pochi minuti. Si riavvia solo quando non c'è più nulla in esecuzione su di essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数分かかります。何も実行されなくなってから再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 분 정도 걸립니다. 아무것도 실행되지 않을 때만 재시동됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leva alguns minutos. Ela só reinicia quando nada mais está em execução nela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要几分钟。只有在没有任何内容运行时，它才会重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要幾分鐘。只有在沒有任何內容執行時，它才會重新開機。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zajmuje kilka minut. Uruchamia się ponownie dopiero, gdy nic już na nim nie działa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tager et par minutter. Den genstarter først, når intet kører på den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestää muutaman minuutin. Käynnistyy uudelleen vasta, kun siinä ei ole mitään käynnissä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekur nokkrar mínútur. Tölvan endurræsist ekki fyrr en ekkert er í gangi á henni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar noen minutter. Den starter først på nytt når ingenting kjører på den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar några minuter. Den startar bara om när inget körs på den."
          }
        }
      }
    },
    "Takes a minute or two, and the conversation is busy until it finishes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauert ein bis zwei Minuten; die Unterhaltung ist bis zum Ende belegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes a minute or two, and the conversation is busy until it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarda un par de minutos y la conversación estará ocupada hasta que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend une ou deux minutes, et la conversation reste occupée jusqu’à la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede un minuto o due e la conversazione resta occupata fino al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1〜2 分かかり、その間は会話がビジー状態になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1~2분 걸리며, 끝날 때까지 대화는 사용 중 상태입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leva um ou dois minutos, e a conversa fica ocupada até terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要一两分钟，期间对话处于忙碌状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要一兩分鐘，期間對話處於忙碌狀態。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zajmuje minutę lub dwie, a rozmowa jest zajęta, dopóki się to nie skończy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tager et minut eller to, og samtalen er optaget, indtil det er færdigt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestää minuutin tai kaksi, ja keskustelu on varattu, kunnes se on valmis."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekur eina til tvær mínútur, og samtalið er upptekið þar til því er lokið."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar et minutt eller to, og samtalen er opptatt til den er ferdig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar en minut eller två, och konversationen är upptagen tills det är klart."
          }
        }
      }
    },
