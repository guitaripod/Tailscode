    "%@ is full. The next request has to compact first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist voll. Die nächste Anfrage muss zuerst verdichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is full. The next request has to compact first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está lleno. La próxima solicitud debe compactar primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est plein. La prochaine requête doit d’abord compacter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è pieno. La prossima richiesta deve prima compattare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が満杯です。次のリクエストは先に圧縮する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 가득 찼습니다. 다음 요청은 먼저 압축해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está cheio. A próxima solicitação precisa compactar primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已满。下一次请求必须先压缩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已滿。下一次請求必須先壓縮。"
          }
        }
      }
    },
    "%d%% of %@ is in use, with room for about %@ more.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% von %@ sind belegt, mit Platz für etwa %@ mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% of %@ is in use, with room for about %@ more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El %d%% de %@ está en uso, con espacio para unos %@ más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d %% de %@ sont utilisés, avec de la place pour environ %@ de plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il %d%% di %@ è in uso, con spazio per altri %@ circa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ のうち %1$d%% を使用中で、あと約 %3$@ の余裕があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 중 %1$d%%를 사용 중이며, 약 %3$@만큼 더 여유가 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% de %@ está em uso, com espaço para mais cerca de %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 中已使用 %1$d%%，还剩约 %3$@ 的空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 中已使用 %1$d%%，還剩約 %3$@ 的空間。"
          }
        }
      }
    },
    "Getting fuller. Compacting trades the transcript for a summary and frees most of it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird voller. Verdichten tauscht das Transkript gegen eine Zusammenfassung und gibt das meiste davon frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting fuller. Compacting trades the transcript for a summary and frees most of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está llenando. Compactar cambia la transcripción por un resumen y libera la mayor parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça se remplit. Le compactage échange la transcription contre un résumé et en libère la majeure partie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sta riempiendo. La compattazione scambia la trascrizione con un riepilogo e ne libera la maggior parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "埋まってきています。圧縮するとトランスクリプトが要約に置き換わり、その大部分が解放されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점점 차오르고 있습니다. 압축하면 대화록이 요약으로 바뀌면서 대부분의 공간이 확보됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está ficando mais cheio. Compactar troca a transcrição por um resumo e libera a maior parte dela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间越来越满。压缩会用摘要替换记录，从而释放其中的大部分空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空間越來越滿。壓縮會用摘要取代紀錄，從而釋出其中的大部分空間。"
          }
        }
      }
    },
    "Close to full. A long answer or a big file read may not fit; compacting now frees the room on your terms rather than mid-turn.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast voll. Eine lange Antwort oder das Lesen einer großen Datei passt womöglich nicht mehr hinein; jetzt zu verdichten schafft Platz nach deinen Bedingungen statt mitten im Zug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close to full. A long answer or a big file read may not fit; compacting now frees the room on your terms rather than mid-turn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Casi lleno. Puede que no quepa una respuesta larga o la lectura de un archivo grande; compactar ahora libera espacio en tus términos en lugar de a mitad de turno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Presque plein. Une longue réponse ou la lecture d’un gros fichier pourrait ne pas tenir ; compacter maintenant libère de la place selon vos conditions plutôt qu’en plein tour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quasi pieno. Una risposta lunga o la lettura di un file grande potrebbero non entrarci; compattare ora libera spazio alle tue condizioni invece che a metà turno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほぼ満杯です。長い回答や大きなファイルの読み込みは収まらないかもしれません。今のうちに圧縮すれば、ターンの途中でではなく、あなたの都合で空きを作れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거의 가득 찼습니다. 긴 답변이나 큰 파일 읽기는 들어가지 않을 수 있습니다. 지금 압축하면 턴 도중이 아니라 원하는 시점에 공간을 확보할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quase cheio. Uma resposta longa ou a leitura de um arquivo grande pode não caber; compactar agora libera espaço nos seus termos, em vez de no meio do turno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快满了。一段长回答或读取一个大文件可能会放不下；现在就压缩可以按你的节奏腾出空间，而不是在回合中途被迫处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快滿了。一段長回答或讀取一個大檔案可能會放不下；現在就壓縮可以按你的節奏騰出空間，而不是在回合中途被迫處理。"
          }
        }
      }
    },
    "Reported by the server from the last request the model was sent": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom Server anhand der letzten an das Modell gesendeten Anfrage gemeldet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reported by the server from the last request the model was sent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informado por el servidor a partir de la última solicitud enviada al modelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Communiqué par le serveur d’après la dernière requête envoyée au modèle"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comunicato dal server in base all’ultima richiesta inviata al modello"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルに送信された最後のリクエストに基づき、サーバから報告された値です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델에 전송된 마지막 요청을 기준으로 서버가 보고한 값입니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informado pelo servidor com base na última solicitação enviada ao modelo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据发送给模型的最后一次请求，由服务器报告得出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據傳送給模型的最後一次請求，由伺服器回報得出"
          }
        }
      }
    },
    "Read from the compaction: only the summary is still in the window": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der Verdichtung übernommen: Nur die Zusammenfassung befindet sich noch im Fenster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read from the compaction: only the summary is still in the window"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenido de la compactación: solo el resumen sigue en la ventana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu depuis le compactage : seul le résumé reste dans la fenêtre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Letto dalla compattazione: nella finestra resta solo il riepilogo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮結果から読み取った値です。ウインドウに残っているのは要約のみです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축 결과에서 가져온 값입니다. 창에는 요약만 남아 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtido a partir da compactação: apenas o resumo ainda está na janela"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取自压缩结果：窗口中现在只保留了摘要"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取自壓縮結果：視窗中現在只保留了摘要"
          }
        }
      }
    },
    "Estimated from the transcript itself; the server did not say": {
