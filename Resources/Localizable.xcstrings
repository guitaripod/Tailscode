    "This machine is the one asked, so the files go by their paths.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This machine is the one asked, so the files go by their paths."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Rechner wird gefragt, daher werden die Dateien über ihre Pfade übergeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta máquina es la consultada, así que los archivos se envían por sus rutas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette machine est celle interrogée, donc les fichiers passent par leurs chemins."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa macchina è quella interrogata, quindi i file passano per i loro percorsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この質問先はこのマシンなので、ファイルはパスで渡されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문 대상이 이 머신이므로 파일은 경로로 전달됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ta maszyna jest pytana, więc pliki idą ścieżkami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a máquina consultada, então os arquivos vão pelos caminhos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被询问的正是本机，因此文件按路径传递。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被詢問的正是本機，因此檔案按路徑傳遞。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne computer er den, der bliver spurgt, så filerne sendes via deres stier."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysymys osoitetaan tälle tietokoneelle, joten tiedostot kulkevat polkujensa mukaan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi tölva er sú sem er spurð, svo skrárnar eru gefnar upp með slóðum sínum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne maskinen er den som spørres, så filene sendes via banene sine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här datorn är den som frågas, så filerna skickas med sina sökvägar."
          }
        }
      }
    },
