        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードが中断されました。もう一度試すと、中断した場所から再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드가 중단됐어요. 다시 시도하면 중단된 지점부터 이어서 받아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie zostało przerwane. Ponowna próba wznowi od miejsca przerwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download foi interrompido. Tentar novamente continua de onde parou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载已中断。重试会从中断处继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載已中斷。重試會從中斷處繼續。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaden blev afbrudt. Når du prøver igen, fortsætter den, hvor den stoppede."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataus keskeytyi. Uusi yritys jatkuu siitä, mihin jäätiin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Niðurhalið var truflað. Ef þú reynir aftur heldur það áfram þar sem það stöðvaðist."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nedlastingen ble avbrutt. Prøv igjen, så fortsetter den der den stoppet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtningen avbröts. Om du försöker igen fortsätter den där den stannade."
          }
        }
      }
    },
    "The vendor's download site refused access, so nothing was downloaded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vendor's download site refused access, so nothing was downloaded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Download-Seite des Anbieters hat den Zugriff verweigert, daher wurde nichts heruntergeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sitio de descargas del proveedor rechazó el acceso, así que no se descargó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
