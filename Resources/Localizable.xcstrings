    "Closing this leaves the render running on the machine with the card. Come back and it will still be here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du das schließt, läuft der Render auf dem Rechner mit der Grafikkarte weiter. Komm zurück, und er ist noch da."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing this leaves the render running on the machine with the card. Come back and it will still be here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar esto no detiene el renderizado en la máquina con la tarjeta gráfica. Vuelve y seguirá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer ceci laisse le rendu se poursuivre sur la machine équipée de la carte graphique. Revenez et il sera toujours là."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudendo questa schermata, il rendering continua sulla macchina con la scheda grafica. Torna e lo troverai ancora qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを閉じても、グラフィックカードを積んだマシン上でレンダリングは続きます。戻ってくれば、まだここにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면을 닫아도 그래픽 카드가 있는 컴퓨터에서 렌더링은 계속됩니다. 다시 돌아오면 그대로 남아 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar isto não interrompe a renderização na máquina com a placa de vídeo. Volte depois e ela ainda estará aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭这个不会中断在那台显卡机器上进行的渲染。回来时它还会在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉這個不會中斷在那台顯示卡機器上進行的算圖。回來時它還會在這裡。"
          }
        }
      }
    },
    "Not signed in to Game Center, so nothing is reported to Apple — the trophies below are counted on this device either way.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht bei Game Center angemeldet, daher wird nichts an Apple gemeldet — die Trophäen unten werden trotzdem auf diesem Gerät gezählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not signed in to Game Center, so nothing is reported to Apple — the trophies below are counted on this device either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has iniciado sesión en Game Center, así que no se informa nada a Apple — de todos modos, los trofeos de abajo se cuentan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non connecté à Game Center, donc rien n’est signalé à Apple — les trophées ci-dessous sont malgré tout comptabilisés sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai eseguito l’accesso a Game Center, quindi nulla viene segnalato ad Apple — i trofei qui sotto vengono comunque conteggiati su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center にサインインしていないため、Apple には何も報告されません — ただし下記のトロフィーは、いずれにせよこのデバイス上でカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center에 로그인하지 않아 Apple에 아무것도 보고되지 않습니다 — 그래도 아래 트로피는 이 기기에서 집계됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não está conectado ao Game Center, então nada é informado à Apple — de qualquer forma, os troféus abaixo são contados neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未登录 Game Center，因此不会向 Apple 报告任何内容 — 无论如何，下面的奖杯都会在这台设备上计数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未登入 Game Center，因此不會向 Apple 回報任何內容 — 無論如何，下面的獎盃都會在這台裝置上計數。"
          }
        }
      }
    },
    "This copy of the app cannot sign in to Game Center, so the trophies below are counted on this device and go no further.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kopie der App kann sich nicht bei Game Center anmelden, daher werden die Trophäen unten nur auf diesem Gerät gezählt und gehen nicht weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy of the app cannot sign in to Game Center, so the trophies below are counted on this device and go no further."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de la app no puede iniciar sesión en Game Center, así que los trofeos de abajo se cuentan en este dispositivo y no van más allá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet exemplaire de l’app ne peut pas se connecter à Game Center, donc les trophées ci-dessous sont comptabilisés sur cet appareil et n’en sortent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa copia dell’app non può accedere a Game Center, quindi i trofei qui sotto vengono conteggiati solo su questo dispositivo e non vanno oltre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのコピーは Game Center にサインインできないため、下記のトロフィーはこのデバイス上でのみカウントされ、それより先には送られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱 사본은 Game Center에 로그인할 수 없어, 아래 트로피는 이 기기에서만 집계되고 더 이상 전달되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia do app não consegue entrar no Game Center, então os troféus abaixo são contados apenas neste dispositivo e não vão além disso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用副本无法登录 Game Center，因此下面的奖杯只会在这台设备上计数，不会再传到别处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式副本無法登入 Game Center，因此下面的獎盃只會在這台裝置上計數，不會再傳到別處。"
          }
        }
      }
    },
    "Game Center is turned off for this account, so the trophies below are counted on this device and go no further.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ist für dieses Konto deaktiviert, daher werden die Trophäen unten nur auf diesem Gerät gezählt und gehen nicht weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center is turned off for this account, so the trophies below are counted on this device and go no further."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center está desactivado para esta cuenta, así que los trofeos de abajo se cuentan en este dispositivo y no van más allá."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center est désactivé pour ce compte, donc les trophées ci-dessous sont comptabilisés sur cet appareil et n’en sortent pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center è disattivato per questo account, quindi i trofei qui sotto vengono conteggiati solo su questo dispositivo e non vanno oltre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントでは Game Center がオフになっているため、下記のトロフィーはこのデバイス上でのみカウントされ、それより先には送られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 Game Center가 꺼져 있어, 아래 트로피는 이 기기에서만 집계되고 더 이상 전달되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Game Center está desativado para esta conta, então os troféus abaixo são contados apenas neste dispositivo e não vão além disso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户已关闭 Game Center，因此下面的奖杯只会在这台设备上计数，不会再传到别处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號已關閉 Game Center，因此下面的獎盃只會在這台裝置上計數，不會再傳到別處。"
          }
        }
      }
    },
    "Game Center is not answering, so the trophies below are counted on this device until it does.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center antwortet nicht, daher werden die Trophäen unten so lange auf diesem Gerät gezählt, bis es wieder antwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center is not answering, so the trophies below are counted on this device until it does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center no responde, así que los trofeos de abajo se cuentan en este dispositivo hasta que vuelva a hacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ne répond pas, donc les trophées ci-dessous sont comptabilisés sur cet appareil en attendant qu’il réponde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center non risponde, quindi i trofei qui sotto vengono conteggiati su questo dispositivo finché non tornerà a rispondere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center が応答していないため、応答するまで下記のトロフィーはこのデバイス上でカウントされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center가 응답하지 않아, 응답할 때까지 아래 트로피는 이 기기에서 집계됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Game Center não está respondendo, então os troféus abaixo são contados neste dispositivo até que volte a responder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center 没有响应，因此下面的奖杯会先在这台设备上计数，直到它恢复响应为止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
