          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokenów wygenerowanych w %@ — tokeny, które wyprodukował model, w ciągu całego oczekiwania."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ token skrevet på %@ – de token modellen producerede i hele ventetiden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokenia kirjoitettu %@ aikana: kaikki mallin tuottamat tokenit koko odotuksen ajalta."
          }
