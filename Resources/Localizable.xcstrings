    "Tailscode can only open a link that connects a machine. Print a fresh one on your machine.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode can only open a link that connects a machine. Print a fresh one on your machine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode kann nur einen Link öffnen, der einen Rechner verbindet. Einen neuen Link auf dem Rechner ausgeben lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode solo puede abrir un enlace que conecte un equipo. Generar uno nuevo en ese equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ne peut ouvrir qu'un lien qui connecte une machine. Afficher un nouveau lien sur la machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode può aprire solo un link che collega un computer. Farne stampare uno nuovo sul computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode で開けるのは、マシンを接続するリンクだけです。マシンで新しいリンクを表示させてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode는 컴퓨터를 연결하는 링크만 열 수 있어요. 컴퓨터에서 새 링크를 출력해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode może otworzyć tylko link łączący komputer. Wyświetl nowy link na komputerze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode só consegue abrir um link que conecta um computador. Gere um novo no computador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 只能打开用于连接电脑的链接。请在电脑上重新打印一个新的链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 只能開啟用來連接電腦的連結。請在電腦上重新印出一個新的連結。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode kan kun åbne et link, der forbinder en computer. Få udskrevet et nyt link på computeren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode voi avata vain linkin, joka yhdistää tietokoneen. Tulosta uusi linkki tietokoneellasi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
