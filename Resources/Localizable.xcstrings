    "Edits to Swift code appear in the running app in under a second. A small library will be fetched once.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edits to Swift code appear in the running app in under a second. A small library will be fetched once."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen am Swift-Code erscheinen in der laufenden App in unter einer Sekunde. Eine kleine Bibliothek wird einmal heruntergeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios en el código Swift aparecen en la app en ejecución en menos de un segundo. Una pequeña biblioteca se descargará una sola vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications du code Swift apparaissent dans l’app en cours en moins d’une seconde. Une petite bibliothèque sera téléchargée une seule fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche al codice Swift compaiono nell’app in esecuzione in meno di un secondo. Una piccola libreria verrà scaricata una sola volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift コードへの変更は、実行中のアプリに1秒以内に反映されます。小さなライブラリは最初に一度だけ取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift 코드 변경은 1초 안에 실행 중인 앱에 나타납니다. 작은 라이브러리는 한 번만 내려받습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany w kodzie Swift pojawiają się w działającej aplikacji w mniej niż sekundę. Mała biblioteka zostanie pobrana jeden raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As edições no código Swift aparecem no app em execução em menos de um segundo. Uma pequena biblioteca será baixada uma vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift 代码的修改会在运行中的 App 里不到一秒就显示出来。一个小型库只会下载一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift 程式碼的修改會在執行中的 App 裡不到一秒就顯示出來。一個小型程式庫只會下載一次。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringer i Swift-kode vises i den kørende app på under et sekund. Et lille bibliotek hentes én gang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Swift-koodin muutokset näkyvät käynnissä olevassa sovelluksessa alle sekunnissa. Pieni kirjasto ladataan kerran."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Breytingar á Swift-kóða birtast í keyrandi appinu innan sekúndu. Lítið safn verður sótt einu sinni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringer i Swift-kode vises i den kjørende appen på under ett sekund. Et lite bibliotek hentes én gang."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringar i Swift-kod syns i den körande appen inom en sekund. Ett litet bibliotek hämtas en gång."
          }
        }
      }
    },
