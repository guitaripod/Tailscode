    "Get a nudge when your agent is done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a nudge when your agent is done"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfahre sofort, wenn dein Agent fertig ist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe un aviso cuando tu agente termine"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois prévenu dès que votre agent a terminé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi un avviso quando il tuo agente ha finito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの完了をお知らせします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 끝나면 알려 드릴게요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba um aviso quando seu agente terminar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在智能体完成时提醒你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在代理程式完成時提醒你"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daj sobie znać, gdy agent skończy"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få besked, når din agent er færdig"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saa muistutus, kun agenttisi on valmis"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fáðu tilkynningu þegar agentinn lýkur störfum"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få et lite varsel når agenten er ferdig"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få en påminnelse när agenten är klar"
          }
        }
      }
    },
    "Tailscode can alert you on the Lock Screen and in a Live Activity when the agent finishes or has a question, so you can leave it working.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode can alert you on the Lock Screen and in a Live Activity when the agent finishes or has a question, so you can leave it working."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode kann dich auf dem Sperrbildschirm und in einer Live-Aktivität benachrichtigen, wenn der Agent fertig ist oder eine Frage hat. So kannst du ihn einfach arbeiten lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode puede avisarte en la pantalla de bloqueo y en una Live Activity cuando el agente termine o tenga una pregunta, así puedes dejarlo trabajando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode peut vous prévenir sur l’écran verrouillé et dans une Live Activity quand l’agent a terminé ou a une question, pour que vous le laissiez travailler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode può avvisarti nella schermata di blocco e in una Live Activity quando l’agente ha finito o ha una domanda, così puoi lasciarlo lavorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが完了したときや質問があるときに、ロック画面とライブアクティビティでお知らせします。作業はそのまま任せられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 작업을 마치거나 질문이 있을 때 잠금 화면과 Live Activity로 알려 드리니, 안심하고 맡겨 두세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode pode avisar você na Tela Bloqueada e em uma Live Activity quando o agente terminar ou tiver uma pergunta, para você deixá-lo trabalhando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体完成任务或有问题要问你时，Tailscode 会通过锁定屏幕和实时活动提醒你，你可以放心让它继续工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式完成工作或有問題要問你時，Tailscode 會透過鎖定畫面與即時動態提醒你，你可以放心讓它繼續工作。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode może powiadomić Cię na ekranie blokady i w Live Activity, gdy agent skończy lub będzie miał pytanie, więc możesz zostawić go przy pracy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode kan give dig besked på låseskærmen og i en Live Activity, når agenten er færdig, eller når den har et spørgsmål, så du kan lade den arbejde videre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode voi ilmoittaa sinulle lukitusnäytöllä ja Live Activityssä, kun agentti on valmis tai sillä on kysymys, niin voit jättää sen työskentelemään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode getur látið þig vita á lásskjánum og í Live Activity þegar agentinn lýkur störfum eða hefur spurningu, svo þú getir látið hann vinna áfram."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode kan varsle deg på låseskjermen og i en Live Activity når agenten er ferdig eller har et spørsmål, så du kan la den jobbe videre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode kan visa notiser på låsskärmen och i en Live Activity när agenten är klar eller har en fråga, så att du kan låta den arbeta vidare."
          }
        }
      }
    },
