          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no puede entregar archivos, así que no se puede abrir un tablero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur ne peut pas transmettre de fichiers, un tableau ne peut donc pas s’ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server non può consegnare file, quindi non è possibile aprire una bacheca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバはファイルを引き渡せないため、ボードを開けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 파일을 전달할 수 없어 보드를 열 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor não pode entregar arquivos, então um quadro não pode abrir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器无法交出文件，因此看板无法打开。"
