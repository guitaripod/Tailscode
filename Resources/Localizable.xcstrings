          }
        }
      }
    },
    "Tailscale would not accept the key this device holds. Keys expire and can be revoked — replace it and the scan runs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale hat den Schlüssel, den dieses Gerät hat, nicht akzeptiert. Schlüssel laufen ab und können widerrufen werden — ersetze ihn, dann läuft der Scan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale would not accept the key this device holds. Keys expire and can be revoked — replace it and the scan runs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale no aceptó la clave que tiene este dispositivo. Las claves caducan y se pueden revocar — reemplázala y el escaneo se ejecutará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale n’a pas accepté la clé détenue par cet appareil. Les clés expirent et peuvent être révoquées — remplacez-la et le scan s’exécutera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale non ha accettato la chiave in possesso di questo dispositivo. Le chiavi scadono e possono essere revocate — sostituiscila e la scansione verrà eseguita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスが持つキーを Tailscale が受け付けませんでした。キーには期限があり、取り消されることもあります — 更新すればスキャンが実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기가 가진 키를 Tailscale이 받아들이지 않았습니다. 키는 만료되거나 취소될 수 있습니다 — 키를 교체하면 스캔이 실행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscale não aceitou a chave que este dispositivo possui. Chaves expiram e podem ser revogadas — substitua-a e o escaneamento será executado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 没有接受此设备持有的密钥。密钥会过期，也可能被吊销 — 更换它，扫描就会运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 沒有接受此裝置持有的金鑰。金鑰會過期，也可能被撤銷 — 更換它，掃描就會執行。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale nie zaakceptował klucza, który ma to urządzenie. Klucze wygasają i mogą zostać cofnięte — zastąp go, a skanowanie zadziała."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale vil ikke acceptere den nøgle, denne enhed har. Nøgler udløber og kan tilbagekaldes – udskift den, så kører scanningen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale ei hyväksynyt tämän laitteen avainta. Avaimet vanhenevat ja niitä voi peruuttaa: vaihda se, niin skannaus toimii."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale hafnaði lyklinum sem þetta tæki geymir. Lyklar renna út og hægt er að afturkalla þá – skiptu um hann og skönnunin keyrir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale godtok ikke nøkkelen denne enheten har. Nøkler utløper og kan trekkes tilbake. Bytt den ut, så kjører søket."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale godtog inte nyckeln den här enheten har. Nycklar går ut och kan återkallas. Ersätt den, så körs skanningen."
          }
        }
      }
    },
