    "You held it before it spent that rung. Run it again there to let it climb.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du holdt den tilbage, før den brugte det trin. Kør den igen dér, så den kan stige."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast es zurückgestellt, bevor es diese Stufe nutzen konnte. Führe es dort erneut aus, damit es aufsteigen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You held it before it spent that rung. Run it again there to let it climb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo retuviste antes de que gastara ese escalón. Ejecútalo de nuevo ahí para dejarlo subir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidätit sen ennen kuin se ehti käyttää tämän portaan. Suorita se siellä uudelleen, jotta se pääsee nousemaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous l’avez suspendu avant qu’il ne dépense cet échelon. Relancez-le là pour le laisser monter."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú stöðvaðir það áður en það notaði þetta þrep. Keyrðu það aftur á þessu þrepi svo það geti stigið upp."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’hai sospeso prima che usasse quel gradino. Eseguilo di nuovo lì per lasciarlo salire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その段を使う前に保留しました。そこでもう一度実行すると上がっていけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 단을 쓰기 전에 보류하셨습니다. 거기서 다시 실행하면 올라갈 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du holdt den tilbake før den rakk å bruke det trinnet. Kjør den igjen der for at den skal kunne stige."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymano to, zanim wykorzystało ten szczebel. Uruchom ponownie na nim, aby mogło się wspiąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você a reteve antes que gastasse esse degrau. Execute novamente ali para deixá-la subir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du stoppade den innan den använde det steget. Kör den igen där så att den kan klättra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在它用掉那一级之前将其保留了。在那里再运行一次，让它继续往上升。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在它用掉那一級之前將其保留了。在那裡再執行一次，讓它繼續往上升。"
          }
        }
      }
    },
