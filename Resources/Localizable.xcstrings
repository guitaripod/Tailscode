          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證這筆購買。沒有產生任何扣款。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zweryfikować tego zakupu. Nie pobrano żadnej opłaty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købet kunne ikke verificeres. Der blev ikke opkrævet noget."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostosta ei voitu vahvistaa. Mitään ei veloitettu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að staðfesta kaupin. Ekkert var rukkað."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet kunne ikke bekreftes. Ingenting ble belastet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpet kunde inte verifieras. Ingenting debiterades."
          }
        }
      }
    },
