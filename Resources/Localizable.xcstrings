        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva uma imagem abaixo. Ela é pintada na máquina com a placa de vídeo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方描述一幅画面，它会在配有显卡的那台机器上绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方描述一幅畫面，它會在配有顯示卡的那台機器上繪製。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz obraz poniżej. Jest malowany na komputerze z kartą graficzną."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv et billede nedenfor. Det males på computeren med grafikkortet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvaile kuva alla. Se maalataan tietokoneella, jossa on näytönohjain."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lýstu mynd hér að neðan. Hún er máluð á tölvunni með skjákortinu."
          }
        },
        "nb": {
