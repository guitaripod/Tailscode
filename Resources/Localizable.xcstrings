    "Nothing is listening at %@. The agent is probably not running on that machine — or it is, on a different port. Check the address, or start it there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter %@ hört nichts. Der Agent läuft wahrscheinlich nicht auf diesem Rechner – oder doch, aber auf einem anderen Port. Prüfe die Adresse oder starte ihn dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is listening at %@. The agent is probably not running on that machine — or it is, on a different port. Check the address, or start it there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada escucha en %@. Es probable que el agente no se esté ejecutando en esa máquina, o sí, pero en otro puerto. Comprueba la dirección, o inícialo allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’écoute à %@. L’agent ne tourne probablement pas sur cette machine — ou alors si, mais sur un autre port. Vérifiez l’adresse, ou démarrez-le là-bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla è in ascolto su %@. L’agente probabilmente non è in esecuzione su quella macchina — oppure lo è, ma su una porta diversa. Verifica l’indirizzo, oppure avvialo lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ では何も待ち受けていません。おそらくそのマシンでエージェントが動作していないか、動作していても別のポートです。アドレスを確認するか、そこでエージェントを起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서는 아무것도 대기하고 있지 않습니다. 그 컴퓨터에서 에이전트가 실행되고 있지 않거나, 실행 중이라도 다른 포트일 수 있습니다. 주소를 확인하거나 그곳에서 에이전트를 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada está escutando em %@. O agente provavelmente não está rodando naquela máquina — ou está, mas em outra porta. Verifique o endereço, ou inicie-o lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上没有任何东西在监听。该机器上可能没有运行智能体——或者运行了，但端口不同。请检查地址，或在那里启动它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上沒有任何東西在監聽。該機器上可能沒有執行代理——或者執行了，但埠號不同。請檢查位址，或在那裡啟動它。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pod adresem %@ nic nie nasłuchuje. Agent najprawdopodobniej nie działa na tym komputerze — albo działa, ale na innym porcie. Sprawdź adres albo uruchom go tam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lytter ingen på %@. Agenten kører sandsynligvis ikke på den computer, eller også kører den på en anden port. Kontrollér adressen, eller start den dér."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoitteessa %@ ei kuunnella mitään. Agentti ei todennäköisesti ole käynnissä tällä tietokoneella, tai se on käynnissä eri portissa. Tarkista osoite tai käynnistä agentti siellä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert hlustar á %@. Agentinn er líklega ekki í gangi á þessari tölvu, eða þá er hann á annarri gátt. Athugaðu vistfangið eða byrjaðu hann þar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting svarer på %@. Agenten kjører sannsynligvis ikke på den maskinen, eller så kjører den på en annen port. Sjekk adressen, eller start den der."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting lyssnar på %@. Agenten körs troligen inte på den datorn, eller så körs den på en annan port. Kontrollera adressen eller starta den där."
          }
        }
      }
    },
