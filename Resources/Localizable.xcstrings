          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo objetivo, rutas y verificador, abiertos para editar antes de que se envíe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même objectif, les mêmes chemins et le même vérificateur, ouverts à la modification avant l’envoi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stesso obiettivo, gli stessi percorsi e lo stesso verificatore, aperti per la modifica prima che parta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ目標・パス・検証を、送信前に編集できる状態で。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
