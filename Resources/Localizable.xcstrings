    "Live rolling rate limits straight from %@. Percentages are your actual plan consumption, not an estimate.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufende Rate-Limits direkt von %@. Die Prozentwerte sind dein tatsächlicher Tarifverbrauch, keine Schätzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live rolling rate limits straight from %@. Percentages are your actual plan consumption, not an estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límites de tasa continuos directamente desde %@. Los porcentajes son tu consumo real del plan, no una estimación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limites de débit glissantes en direct depuis %@. Les pourcentages correspondent à votre consommation réelle, pas à une estimation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiti di frequenza aggiornati direttamente da %@. Le percentuali sono il consumo reale del tuo piano, non una stima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から直接取得したローリングのレート制限です。パーセンテージは推定ではなく実際のプラン消費量です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 직접 가져온 롤링 속도 제한입니다. 백분율은 추정치가 아니라 실제 요금제 소비량입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limites de taxa contínuos direto de %@. As porcentagens são o consumo real do seu plano, não uma estimativa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接来自 %@ 的滚动速率限制。百分比是你套餐的实际消耗，而非估算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接來自 %@ 的滾動速率限制。百分比是你方案的實際消耗，而非估算。"
          }
        }
      }
    },
