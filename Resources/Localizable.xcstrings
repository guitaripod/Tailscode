    "Tailscode drives the coding agent on your computer. Each step below is checked for you.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode drives the coding agent on your computer. Each step below is checked for you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode steuert den Coding-Agenten auf dem Rechner. Jeder Schritt unten wird automatisch geprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode controla el agente de programación del equipo. Cada paso de abajo se comprueba automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode pilote l'agent de code sur la machine. Chaque étape ci-dessous est vérifiée automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode controlla l'agente di coding sul computer. Ogni passaggio qui sotto viene verificato automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode は、マシン上のコーディングエージェントを操作します。以下の各ステップは自動で確認されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode는 컴퓨터에서 코딩 에이전트를 제어해요. 아래 각 단계는 자동으로 확인돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode steruje agentem kodowania na komputerze. Każdy poniższy krok jest sprawdzany automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode controla o agente de programação no computador. Cada etapa abaixo é verificada automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 控制电脑上的编程代理。下方每个步骤都会自动检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 會控制電腦上的程式設計代理。下方每個步驟都會自動檢查。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode styrer coding-agenten på din computer. Hvert trin nedenfor kontrolleres for dig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ohjaa koodausagenttia tietokoneellasi. Jokainen alla oleva vaihe tarkistetaan puolestasi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode stjórnar kóðaagentinum á tölvunni þinni. Hvert skref hér fyrir neðan er athugað fyrir þig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode styrer kodeagenten på datamaskinen din. Hvert steg nedenfor kontrolleres for deg."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode styr kodagenten på din dator. Varje steg nedan kontrolleras åt dig."
          }
        }
      }
    },
