    "Re-reading the conversation to summarize it. This can take a minute or two.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Unterhaltung wird zum Zusammenfassen erneut gelesen. Das kann ein bis zwei Minuten dauern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-reading the conversation to summarize it. This can take a minute or two."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Releyendo la conversación para resumirla. Puede tardar uno o dos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relecture de la conversation pour la résumer. Cela peut prendre une ou deux minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilettura della conversazione per riassumerla. Può richiedere un minuto o due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話を読み直して要約しています。1〜2 分かかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화를 다시 읽어 요약하는 중입니다. 1~2분 걸릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Relendo a conversa para resumi-la. Isso pode levar um ou dois minutos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重读对话以生成摘要，可能需要一两分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重讀對話以產生摘要，可能需要一兩分鐘。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponowne odczytywanie rozmowy w celu jej podsumowania. Może to potrwać minutę lub dwie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtalen læses igen for at opsummere den. Det kan tage et til to minutter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luetaan keskustelu uudelleen yhteenvetoa varten. Tähän voi mennä minuutti tai pari."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Les samtalið aftur til að draga það saman. Þetta getur tekið eina til tvær mínútur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leser samtalen på nytt for å oppsummere den. Dette kan ta ett eller to minutter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser om konversationen för att sammanfatta den. Det kan ta en eller två minuter."
          }
        }
      }
    },
