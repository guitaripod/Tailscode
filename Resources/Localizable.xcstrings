          }
        }
      }
    },
    "e.g. the composer, for what people actually use it for": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. das Eingabefeld, für das, wofür Leute es wirklich benutzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. the composer, for what people actually use it for"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej., el compositor, para lo que la gente realmente lo usa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "par ex. la zone de saisie, pour ce à quoi les gens l’utilisent vraiment"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. il compositore, per quello per cui le persone lo usano davvero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：入力欄を、実際の使われ方に合わせて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 작성창을, 사람들이 실제로 사용하는 목적에 맞게"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: o campo de texto, para o que as pessoas realmente usam"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：输入框，按人们实际使用它的方式来设计"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：輸入框，按人們實際使用它的方式來設計"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "np. edytor wiadomości, pod kątem tego, do czego ludzie naprawdę go używają"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks. inputfeltet, til det folk faktisk bruger det til"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "esim. kehotekenttä sen mukaan, mihin ihmiset sitä oikeasti käyttävät"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "t.d. innsláttarreitinn, eftir því hvað fólk notar hann raunverulega í"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "f.eks. inntastingsfeltet, for det folk faktisk bruker det til"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "t.ex. skrivfältet, för det folk faktiskt använder det till"
          }
        }
      }
    },
    "Where is it now?": {
      "extractionState": "manual",
