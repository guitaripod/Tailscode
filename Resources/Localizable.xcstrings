    "Your iPad reaches your machine over an encrypted Tailscale link.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein iPad erreicht deinen Rechner über eine verschlüsselte Tailscale-Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPad reaches your machine over an encrypted Tailscale link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu iPad llega a tu máquina a través de un enlace Tailscale cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre iPad atteint votre machine via une liaison Tailscale chiffrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo iPad raggiunge la tua macchina tramite un collegamento Tailscale cifrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの iPad は、暗号化された Tailscale 経由でマシンに接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad는 암호화된 Tailscale 연결을 통해 컴퓨터에 연결됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu iPad alcança sua máquina por um link Tailscale criptografado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iPad 通过加密的 Tailscale 链路连接到你的机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 iPad 透過加密的 Tailscale 連線連上你的機器。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój iPad łączy się z twoim komputerem przez zaszyfrowane połączenie Tailscale."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din iPad når din computer via en krypteret Tailscale-forbindelse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadisi tavoittaa tietokoneesi salatun Tailscale-yhteyden kautta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad-inn þinn nær sambandi við tölvuna þína um dulkóðaða Tailscale-tengingu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iPaden din når maskinen din over en kryptert Tailscale-forbindelse."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din iPad når din dator via en krypterad Tailscale-länk."
          }
        }
      }
    },
