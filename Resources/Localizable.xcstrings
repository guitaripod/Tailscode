    "This server is too old to sign in from here. Update it, or run claude auth login on the machine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server ist zu alt, um sich von hier anzumelden. Aktualisiere ihn oder führe auf dem Rechner claude auth login aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server is too old to sign in from here. Update it, or run claude auth login on the machine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor es demasiado antiguo para iniciar sesión desde aquí. Actualízalo o ejecuta claude auth login en la máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur est trop ancien pour se connecter depuis ici. Mettez-le à jour, ou lancez claude auth login sur la machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server è troppo vecchio per accedere da qui. Aggiornalo, oppure esegui claude auth login sulla macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは古すぎて、ここからはサインインできません。更新するか、マシン上で claude auth login を実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 너무 오래되어 여기서 로그인할 수 없습니다. 서버를 업데이트하거나 컴퓨터에서 claude auth login을 실행하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor é antigo demais para entrar daqui. Atualize-o, ou execute claude auth login na máquina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器版本过旧，无法从这里登录。请更新它，或在那台机器上运行 claude auth login。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器版本過舊，無法從這裡登入。請更新它，或在那台機器上執行 claude auth login。"
          }
        }
      }
    },
