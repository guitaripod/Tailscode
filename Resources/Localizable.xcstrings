    "The same goal, paths and verifier, open to edit before it goes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe Ziel, dieselben Pfade und derselbe Verifizierer, offen zur Bearbeitung, bevor es losgeht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
