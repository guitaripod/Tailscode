    "The pointer operates the app. Press to only watch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pointer operates the app. Press to only watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zeiger bedient die App. Klicken Sie, um nur zuzusehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puntero maneja la app. Haz clic para solo observar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pointeur pilote l’app. Cliquez pour seulement observer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il puntatore controlla l’app. Clicca per solo guardare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインターでアプリを操作します。クリックすると見るだけになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터로 앱을 조작합니다. 클릭하면 보기만 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskaźnik steruje aplikacją. Kliknij, aby tylko obserwować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ponteiro opera o app. Clique para apenas observar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针操作应用。点击即可仅观看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指標操作應用程式。點擊即可僅觀看。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointeren styrer appen. Tryk for kun at se på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoitin ohjaa sovellusta. Paina, jos haluat vain katsella."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bendillinn stýrir appinu. Ýttu til að fylgjast aðeins með."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pekeren styrer appen. Klikk for bare å se på."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pekaren styr appen. Klicka för att bara titta."
          }
        }
      }
    },
    "The pointer only watches. Press to operate the app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pointer only watches. Press to operate the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zeiger sieht nur zu. Klicken Sie, um die App zu bedienen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puntero solo observa. Haz clic para operar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pointeur observe seulement. Cliquez pour piloter l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il puntatore osserva soltanto. Clicca per controllare l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインターは見るだけです。クリックするとアプリを操作できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
