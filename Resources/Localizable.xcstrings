          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供应商的下载站点拒绝访问，因此未下载任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商的下載網站拒絕存取，因此沒有下載任何內容。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandørens downloadside nægtede adgang, så intet blev downloadet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmistajan latauspalvelu esti pääsyn, joten mitään ei ladattu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Niðurhalssíða framleiðandans hafnaði aðganginum, þannig að ekkert var sótt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandørens nedlastingsside nektet tilgang, så ingenting ble lastet ned."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverantörens hämtningssida nekade åtkomst, så ingenting hämtades."
          }
        }
      }
    },
    "The voice model is not running on the server (%@). Press Call to see how to start it.": {
