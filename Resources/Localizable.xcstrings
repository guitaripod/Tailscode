    "Chat lane. Sending starts a chat in the project named beside this switch.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat-Modus. Senden startet einen Chat in dem Projekt, das neben diesem Schalter genannt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat lane. Sending starts a chat in the project named beside this switch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo chat. Enviar inicia un chat en el proyecto que aparece junto a este interruptor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode discussion. Envoyer démarre une discussion dans le projet indiqué à côté de ce commutateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità chat. Inviare avvia una chat nel progetto indicato accanto a questo interruttore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットモード。送信すると、このスイッチの横に表示されたプロジェクトでチャットが始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 모드. 전송하면 이 스위치 옆에 표시된 프로젝트에서 채팅이 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo chat. Enviar inicia uma conversa no projeto indicado ao lado deste botão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话模式。发送会在这个开关旁标注的项目中开始一段对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話模式。傳送會在這個開關旁標示的專案中開始一段對話。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb rozmowy. Wysłanie rozpoczyna rozmowę w projekcie nazwanym obok tego przełącznika."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatbane. Afsendelse starter en chat i projektet ved siden af denne kontakt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskustelutila. Lähettäminen aloittaa keskustelun projektissa, joka on nimetty tämän kytkimen vieressä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spjallhamur. Að senda byrjar spjall í verkefninu sem er nefnt við hliðina á þessum rofa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatmodus. Å sende starter en chat i prosjektet som står ved siden av denne bryteren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Chattläge. Att skicka startar en chatt i projektet som anges bredvid den här växeln."
          }
        }
      }
    },
