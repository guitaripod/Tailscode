    "Signing in lets the board list the channels you already follow. Everything else works signed out.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch die Anmeldung kann die Übersicht die Kanäle auflisten, denen du bereits folgst. Alles andere funktioniert auch ohne Anmeldung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in lets the board list the channels you already follow. Everything else works signed out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión permite que el panel liste los canales que ya sigues. Todo lo demás funciona sin haber iniciado sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter permet au tableau de lister les chaînes que vous suivez déjà. Tout le reste fonctionne sans connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedere permette alla bacheca di elencare i canali che segui già. Tutto il resto funziona anche da disconnesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインすると、ボードはあなたがすでにフォローしているチャンネルを一覧表示できます。それ以外はサインアウトの状態でも動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하면 보드가 당신이 이미 팔로우하는 채널을 표시할 수 있습니다. 그 외에는 로그아웃 상태에서도 모두 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar permite que o painel liste os canais que você já segue. Todo o resto funciona sem estar conectado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后，看板就能列出你已关注的频道。其他一切在未登录时也能正常使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入後，看板就能列出你已關注的頻道。其他一切在未登入時也能正常使用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie pozwala tablicy wyświetlić kanały, które już obserwujesz. Wszystko inne działa też bez logowania."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved at logge ind kan oversigten vise de kanaler, du allerede følger. Alt andet virker også, når du er logget ud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautuneena näkymä voi listata jo seuraamasi kanavat. Kaikki muu toimii ilman kirjautumista."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Með innskráningu getur yfirlitið birt rásirnar sem þú fylgist þegar með. Allt annað virkar án innskráningar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du logger på, kan oversikten vise kanalene du allerede følger. Alt annet fungerer uten pålogging."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du loggar in kan tavlan visa de kanaler du redan följer. Allt annat fungerar utan inloggning."
          }
        }
      }
    },
