    "No account, no sign-in, no telemetry. App, engine, and bridge are GPL-3.0.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no sign-in, no telemetry. App, engine, and bridge are GPL-3.0."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Account, keine Anmeldung, keine Telemetrie. App, Engine und Bridge sind GPL-3.0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin inicio de sesión, sin telemetría. La app, el motor y el bridge son GPL-3.0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte, aucune connexion, aucune télémétrie. L’app, le moteur et le bridge sont en GPL-3.0."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account, nessun accesso, nessuna telemetria. App, motore e bridge sono GPL-3.0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントもサインインもテレメトリもありません。App、エンジン、ブリッジはすべて GPL-3.0 です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정도, 로그인도, 텔레메트리도 없습니다. 앱과 엔진, 브리지는 모두 GPL-3.0입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem login, sem telemetria. App, motor e bridge são GPL-3.0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有账户、无需登录、没有遥测。App、引擎和 bridge 均为 GPL-3.0。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有帳號、無需登入、沒有遙測。App、引擎與 bridge 皆為 GPL-3.0。"
          }
        }
      }
    },
