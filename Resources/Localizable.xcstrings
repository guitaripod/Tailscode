    "What the worker must achieve, written for a reader with no other context. Name the files.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was der Worker erreichen muss, geschrieben für eine Leserin ohne weiteren Kontext. Nenne die Dateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the worker must achieve, written for a reader with no other context. Name the files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que el worker debe lograr, redactado para alguien sin más contexto. Indica los archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que le worker doit accomplir, rédigé pour un lecteur sans autre contexte. Nommez les fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che il worker deve ottenere, scritto per chi legge senza altro contesto. Indica i file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワーカーが達成すべきことを、他に文脈を持たない読み手にも伝わるように書いてください。ファイル名も明記してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 맥락이 없는 사람이 읽어도 이해할 수 있도록, 워커가 달성해야 할 목표를 적으세요. 파일명을 명시하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o worker precisa alcançar, escrito para um leitor sem nenhum outro contexto. Nomeie os arquivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写明执行者必须达成的目标，措辞要让没有其他背景信息的读者也能看懂。请指出具体文件名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫明執行者必須達成的目標，措辭要讓沒有其他背景資訊的讀者也能看懂。請指出具體檔案名稱。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co worker musi osiągnąć, napisane dla czytelnika bez żadnego innego kontekstu. Podaj nazwy plików."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad workeren skal opnå, skrevet til en læser uden anden kontekst. Nævn filerne."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä työntekijän on saavutettava, kirjoitettuna lukijalle, jolla ei ole muuta kontekstia. Nimeä tiedostot."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það sem vinnuaðilinn verður að ná fram, skrifað fyrir lesanda án annars samhengis. Nefndu skrárnar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva arbeideren må oppnå, skrevet for en leser uten annen kontekst. Nevn filene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad workern måste uppnå, skrivet för en läsare utan annan kontext. Nämn filerna."
          }
        }
      }
    },
