    "It installs this on its own the next time nothing is running.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es installiert das von selbst, sobald als Nächstes nichts mehr läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It installs this on its own the next time nothing is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo instalará por su cuenta la próxima vez que no haya nada en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle l'installera d'elle-même la prochaine fois que plus rien ne tournera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo installerà da sola alla prossima occasione in cui non ci sarà nulla in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に何も実行されていない状態になったとき、自動でインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음번에 아무것도 실행되고 있지 않을 때 자동으로 설치합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele instala isso sozinho na próxima vez que nada estiver em execução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次没有任何内容运行时，它会自动安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次沒有任何內容執行時，它會自動安裝。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstaluje to samodzielnie, gdy następnym razem nic nie będzie działać."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den installerer det selv næste gang, intet kører."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se asentaa tämän itse, kun mikään ei ole käynnissä seuraavan kerran."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það setur þetta upp sjálfkrafa næst þegar ekkert er í gangi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den installerer dette av seg selv neste gang ingenting kjører."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den installerar detta av sig själv nästa gång ingenting körs."
          }
        }
      }
    },
