    "Asking whether anything is listening before saving it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird geprüft, ob dort etwas lauscht, bevor gespeichert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asking whether anything is listening before saving it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando si algo está escuchando antes de guardarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
