    "This build has no in-app web engine, so a mock opens in your browser instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build hat keine In-App-Web-Engine, daher öffnet sich ein Mock-up stattdessen im Browser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build has no in-app web engine, so a mock opens in your browser instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este build no tiene motor web integrado, así que una maqueta se abre en tu navegador en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce build n’a pas de moteur web intégré, donc une maquette s’ouvre dans votre navigateur à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo build non ha un motore web integrato, quindi un mock-up si apre nel browser al suo posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドにはアプリ内 Web エンジンがないため、代わりにモックがブラウザで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에는 앱 내 웹 엔진이 없어서, 대신 목업이 브라우저에서 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este build não tem motor web integrado, então um mock-up abre no seu navegador em vez disso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个版本没有内置的网页引擎，因此会改为在浏览器中打开设计稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個版本沒有內建的網頁引擎，因此會改為在瀏覽器中開啟設計稿。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten build nie ma wbudowanej przeglądarki, więc makieta otworzy się zamiast tego w twojej przeglądarce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne build har ingen webmotor i appen, så en mockup åbnes i din browser i stedet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä versiossa ei ole sovelluksen sisäistä verkkomoottoria, joten malli avautuu selaimessasi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi útgáfa hefur enga innbyggða vefvél, svo frumgerð opnast í vafranum þínum í staðinn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne versjonen har ingen innebygd nettmotor, så en mock-up åpnes i nettleseren i stedet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här versionen har ingen inbyggd webbmotor, så en mockup öppnas i webbläsaren i stället."
          }
        }
      }
    },
