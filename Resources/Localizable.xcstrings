    "Some machines never answered — a peer that is asleep holds the port open and says nothing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Rechner haben nie geantwortet — ein schlafender Peer hält den Port offen und sagt nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some machines never answered — a peer that is asleep holds the port open and says nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas máquinas nunca respondieron: un par que está dormido mantiene el puerto abierto y no dice nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines machines n’ont jamais répondu — un pair endormi garde le port ouvert et ne dit rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune macchine non hanno mai risposto — un peer addormentato tiene aperta la porta e non dice nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答しなかったマシンもあります — スリープ中のピアはポートを開いたまま何も返しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답하지 않은 머신도 있습니다 — 잠들어 있는 피어는 포트를 열어 둔 채 아무 말도 하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas máquinas nunca responderam — um par adormecido mantém a porta aberta e não diz nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些机器一直没有回应 — 处于睡眠状态的对端会让端口保持开启，却什么也不说。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些機器一直沒有回應 — 處於睡眠狀態的對端會讓埠保持開啟，卻什麼也不說。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre komputery nigdy nie odpowiedziały — uśpiony peer trzyma port otwarty i nic nie mówi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle computere svarede aldrig – en peer, der sover, holder porten åben og siger ingenting."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jotkin koneet eivät koskaan vastanneet – nukkuva vertaiskone pitää portin auki eikä sano mitään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumar tölvur svöruðu aldrei. Tæki sem er í svefni heldur gáttinni opinni og segir ekkert."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen maskiner svarte aldri – en maskin som sover holder porten åpen og sier ingenting."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa datorer svarade aldrig – en nod som sover håller porten öppen utan att svara."
          }
        }
      }
    },
    "Something is running on that machine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dieser Maschine läuft gerade etwas."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something is running on that machine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay algo en ejecución en esa máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose tourne sur cette machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C'è qualcosa in esecuzione su quella macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのマシンでは何かが実行中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 머신에서 무언가 실행 중입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há algo em execução naquela máquina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那台机器上正有内容在运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那台機器上正有內容在執行。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś działa na tym komputerze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kører noget på computeren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä koneella on jotain käynnissä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eitthvað keyrir á þeirri tölvu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe kjører allerede på maskinen."
          }
        },
        "sv": {
