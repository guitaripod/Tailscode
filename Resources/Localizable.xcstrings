    "Resting now: %@. Pro keeps every server connected, in one session list across your tailnet.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resting now: %@. Pro keeps every server connected, in one session list across your tailnet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruht gerade: %@. Pro hält jeden Server verbunden, in einer Sitzungsliste über dein ganzes Tailnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En reposo ahora: %@. Pro mantiene todos los servidores conectados, en una sola lista de sesiones para toda tu tailnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En veille actuellement : %@. Pro garde chaque serveur connecté, dans une seule liste de sessions pour tout votre tailnet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A riposo ora: %@. Pro tiene collegato ogni server, in un unico elenco di sessioni per tutto il tuo tailnet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休止中：%@。Pro ならすべてのサーバを接続したまま、tailnet 全体を 1 つのセッションリストにまとめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 휴면 중: %@. Pro는 모든 서버를 연결된 상태로 유지하고, tailnet 전체를 하나의 세션 목록으로 보여 줍니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpoczywa teraz: %@. Pro utrzymuje połączenie z każdym serwerem, na jednej liście sesji dla całego twojego tailnet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em repouso agora: %@. O Pro mantém todos os servidores conectados, em uma só lista de sessões para toda a sua tailnet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在休眠：%@。Pro 让每台服务器保持连接，并将整个 tailnet 汇总为一份会话列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在休眠：%@。Pro 讓每台伺服器保持連線，並將整個 tailnet 彙整為一份工作階段清單。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilar nu: %@. Pro håller varje server ansluten, i en sessionslista för hela ditt tailnet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hviler nu: %@. Pro holder alle servere forbundet i én sessionsliste på tværs af dit tailnet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På pause nå: %@. Pro holder alle servere tilkoblet, i én øktliste på tvers av tailnettet ditt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepotilassa nyt: %@. Pro pitää jokaisen palvelimen yhdistettynä yhdessä istuntoluettelossa koko tailnetissäsi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvílir núna: %@. Pro heldur öllum netþjónum tengdum, í einum setulista yfir allt tailnetið þitt."
          }
        }
      }
    },
    "You connect to %@. Pro adds every other machine on your tailnet to the same session list.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You connect to %@. Pro adds every other machine on your tailnet to the same session list."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verbindest dich mit %@. Pro nimmt jeden weiteren Rechner in deinem Tailnet in dieselbe Sitzungsliste auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te conectas a %@. Pro añade todas las demás máquinas de tu tailnet a la misma lista de sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous connectez à %@. Pro ajoute toutes les autres machines de votre tailnet à la même liste de sessions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti colleghi a %@. Pro aggiunge tutte le altre macchine del tuo tailnet allo stesso elenco di sessioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続先は %@ です。Pro なら tailnet 上のほかのすべてのマシンも同じセッションリストに加わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 %@에 연결합니다. Pro는 tailnet의 다른 모든 컴퓨터를 같은 세션 목록에 더합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączysz się z %@. Pro dodaje wszystkie pozostałe komputery w twoim tailnet do tej samej listy sesji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você se conecta a %@. O Pro adiciona todas as outras máquinas da sua tailnet à mesma lista de sessões."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你连接的是 %@。Pro 会把 tailnet 上的其他所有机器加入同一份会话列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你連線的是 %@。Pro 會把 tailnet 上的其他所有電腦加入同一份工作階段清單。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ansluter till %@. Pro lägger till alla andra datorer i ditt tailnet i samma sessionslista."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du forbinder til %@. Pro føjer alle andre computere i dit tailnet til den samme sessionsliste."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kobler til %@. Pro legger alle andre maskiner i tailnettet ditt til i den samme øktlisten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistät palvelimeen %@. Pro lisää tailnetisi kaikki muut tietokoneet samaan istuntoluetteloon."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú tengist %@. Pro bætir öllum öðrum tölvum á tailnetinu þínu við sama setulistann."
          }
        }
      }
    },
    "Every machine on your tailnet, in one session list": {
