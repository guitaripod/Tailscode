          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på denne tur – klik for at redigere, eller tryk på ↑ i et tomt inputfelt"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Odottaa tätä vuoroa: napsauta muokataksesi tai paina ↑ tyhjässä kehotekentässä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bíður eftir þessari umferð – smelltu til að breyta eða ýttu á ↑ í tómum innsláttarreit"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Venter på denne turen: klikk for å redigere, eller trykk ↑ i et tomt inntastingsfelt"
