    "The class's own start and ceiling": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eigene Start und die eigene Obergrenze der Klasse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The class's own start and ceiling"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El propio inicio y tope de la clase"
