    "This device has no tailnet address, so none of your servers can be reached. Open Tailscale and connect.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat keine Tailnet-Adresse, daher ist keiner deiner Server erreichbar. Öffne Tailscale und verbinde dich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no tailnet address, so none of your servers can be reached. Open Tailscale and connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene dirección de tailnet, así que no se puede acceder a ninguno de tus servidores. Abre Tailscale y conéctate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas d’adresse tailnet, aucun de vos serveurs n’est donc joignable. Ouvrez Tailscale et connectez-vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha un indirizzo tailnet, quindi nessuno dei tuoi server è raggiungibile. Apri Tailscale e connettiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスには tailnet アドレスがないため、どのサーバにも到達できません。Tailscale を開いて接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 tailnet 주소가 없어 어떤 서버에도 연결할 수 없습니다. Tailscale을 열어 연결하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem endereço tailnet, então nenhum dos seus servidores pode ser alcançado. Abra o Tailscale e conecte-se."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备没有 tailnet 地址，因此无法访问你的任何服务器。请打开 Tailscale 并连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置沒有 tailnet 位址，因此無法連線到你的任何伺服器。請開啟 Tailscale 並連線。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie ma adresu tailnet, więc żaden z twoich serwerów nie jest osiągalny. Otwórz Tailscale i połącz się."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed har ingen Tailnet-adresse, så ingen af dine servere kan nås. Åbn Tailscale og opret forbindelse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä laitteella ei ole tailnet-osoitetta, joten mikään palvelimistasi ei ole tavoitettavissa. Avaa Tailscale ja yhdistä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta tæki er ekki með Tailnet-vistfang, svo ekki næst í neinn netþjóninn þinn. Opnaðu Tailscale og tengdu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enheten har ingen Tailnet-adresse, så ingen av serverne dine kan nås. Åpne Tailscale og koble til."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här enheten har ingen tailnet-adress, så ingen av dina servrar kan nås. Öppna Tailscale och anslut."
          }
        }
      }
    },
