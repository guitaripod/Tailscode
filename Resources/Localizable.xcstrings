    "Ask every machine on your tailnet which agent it runs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frage jeden Rechner in deinem Tailnet, welchen Agenten er ausführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask every machine on your tailnet which agent it runs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a cada máquina de tu tailnet qué agente ejecuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à chaque machine de votre tailnet quel agent elle exécute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi a ogni macchina del tuo tailnet quale agente esegue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tailnet 上のすべてのマシンに、どのエージェントを実行しているか尋ねます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신의 tailnet에 있는 모든 머신에 어떤 에이전트를 실행하는지 물어봅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte a cada máquina da sua tailnet qual agente ela roda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向你 tailnet 上的每台机器询问它运行的是哪个智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向你 tailnet 上的每台機器詢問它執行的是哪個代理。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj każdy komputer w swoim tailnet, jakiego agenta uruchamia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørg hver computer i dit tailnet, hvilken agent den kører."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysy jokaiselta tailnetisi tietokoneelta, mitä agenttia se ajaa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spurðu hverja tölvu á tailnetinu þínu hvaða agent hún keyrir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør alle maskiner i tailnettet ditt hvilken agent de kjører."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga varje dator i ditt tailnet vilken agent den kör."
          }
        }
      }
    },
