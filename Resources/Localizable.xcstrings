    "Describe a clip, or drop a picture to start it from": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe a clip, or drop a picture to start it from"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe einen Clip oder lege ein Bild ab, mit dem er beginnt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe un clip o suelta una imagen para empezar desde ella"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez un clip, ou déposez une image pour le commencer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi un clip, oppure trascina un’immagine da cui partire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップを言葉で説明するか、開始フレームにする画像をドロップします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 설명하거나, 시작할 그림을 여기에 놓으세요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz klip albo upuść obraz, od którego ma się zacząć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva um clipe ou solte uma imagem para começar a partir dela"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述一段短片，或拖入一张图片作为起点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "描述一段短片，或拖入一張圖片作為起點"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv et klip, eller slip et billede for at starte fra det"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvaile klippi tai pudota kuva, josta se alkaa"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lýstu klippu eða slepptu mynd til að byrja út frá henni"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv et klipp, eller slipp et bilde her som utgangspunkt"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv ett clip, eller släpp en bild för att starta det från"
          }
        }
      }
    },
