    "Balance is empty — top up to keep DeepSeek models running": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo ist leer — lade auf, damit DeepSeek-Modelle weiterlaufen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance is empty — top up to keep DeepSeek models running"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo está vacío: recarga para que los modelos de DeepSeek sigan funcionando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde est épuisé — rechargez pour que les modèles DeepSeek continuent de fonctionner"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo è esaurito — ricarica per continuare a usare i modelli DeepSeek"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高が空です — チャージすると DeepSeek モデルを使い続けられます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액이 없습니다 — 충전하면 DeepSeek 모델을 계속 사용할 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo está zerado — recarregue para manter os modelos DeepSeek funcionando"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "余额已用完 — 充值即可继续使用 DeepSeek 模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘額已用完 — 儲值即可繼續使用 DeepSeek 模型"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo jest puste — doładuj, by modele DeepSeek nadal działały"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldoen er tom. Læg penge på for at holde DeepSeek-modellerne i gang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo on tyhjä. Lataa saldoa, jotta DeepSeek-mallit toimivat"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Staðan er tóm: fylltu á til að DeepSeek-líkönin haldi áfram að keyra"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldoen er tom, fyll på for at DeepSeek-modellene skal fortsette å kjøre"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldot är slut: fyll på för att DeepSeek-modellerna ska fortsätta köra"
          }
        }
      }
