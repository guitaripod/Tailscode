          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En simulator kører altid det, der sidst blev bygget til den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulaattori ajaa aina sille viimeksi rakennetun version."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermir keyrir alltaf það sem síðast var smíðað fyrir hann."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En simulator kjører alltid det som sist ble bygget for den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En simulator kör det som senast byggdes för den."
          }
        }
      }
    },
    "A tailnet address can't present a certificate for itself, so TLS fails before the agent is reached. Tailscale already encrypts the link.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tailnet address can't present a certificate for itself, so TLS fails before the agent is reached. Tailscale already encrypts the link."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tailnet-Adresse kann kein Zertifikat für sich selbst vorweisen, daher scheitert TLS, bevor der Agent erreicht wird. Tailscale verschlüsselt die Verbindung bereits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una dirección de tailnet no puede presentar un certificado propio, así que TLS falla antes de llegar al agente. Tailscale ya cifra el enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une adresse tailnet ne peut pas présenter de certificat pour elle-même : TLS échoue donc avant d’atteindre l’agent. Tailscale chiffre déjà la liaison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un indirizzo tailnet non può presentare un certificato per sé stesso, quindi TLS fallisce prima di raggiungere l’agente. Tailscale cifra già il collegamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "tailnet アドレスは自身の証明書を提示できないため、エージェントに届く前に TLS が失敗します。通信は Tailscale がすでに暗号化しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "tailnet 주소는 자체 인증서를 제시할 수 없어 에이전트에 닿기 전에 TLS가 실패합니다. Tailscale이 이미 연결을 암호화합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um endereço tailnet não pode apresentar um certificado para si mesmo, então o TLS falha antes de chegar ao agente. O Tailscale já criptografa a conexão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "tailnet 地址无法为自己出示证书，因此在到达智能体之前 TLS 就会失败。Tailscale 本身已经加密了链路。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "tailnet 位址無法為自己提供憑證，因此在連上代理之前 TLS 就會失敗。Tailscale 已經為這條連線加密。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres tailnet nie może przedstawić certyfikatu dla samego siebie, więc TLS zawodzi, zanim dotrze do agenta. Tailscale i tak szyfruje to połączenie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En tailnet-adresse kan ikke vise et certifikat for sig selv, så TLS fejler, før agenten nås. Tailscale krypterer forbindelsen allerede."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailnet-osoite ei voi esittää omaa varmennettaan, joten TLS epäonnistuu ennen kuin agenttiin päästään. Tailscale salaa yhteyden jo."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailnet-vistfang getur ekki lagt fram vottorð fyrir sjálft sig, þannig að TLS mistekst áður en náð er í agentinn. Tailscale dulkóðar tenginguna nú þegar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En Tailnet-adresse kan ikke vise et sertifikat for seg selv, så TLS feiler før agenten nås. Tailscale krypterer forbindelsen allerede."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tailnet-adress kan inte uppvisa ett certifikat för sig själv, så TLS misslyckas innan agenten nås. Tailscale krypterar redan länken."
          }
        }
      }
    },
