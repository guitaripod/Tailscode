        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskettu keskustelukohtaisesti: %@ näyttävät, mitä kukin keskustelu kulutti, ei sen sisällä olevia vuoroja, käytettyjä työkaluja eikä ajankohtaa, jolloin ne ajettiin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Talið eftir samtali: %@ sýnir hvað hvert spjall kostaði, ekki umferðirnar í því, verkfærin sem þau kölluðu á né klukkustundina sem þau keyrðu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt per samtale: %@ viser hva hver chat brukte, ikke turene i den, verktøykallene de gjorde eller klokkeslettet de kjørte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räknat per konversation: %@ redovisar vad varje chatt kostade, inte turerna i den, verktygen den anropade eller när den kördes."
          }
        }
      }
    },
    "Turn, tool and clock counts cover %d of %d servers — %@ reports per-conversation totals only.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zug-, Werkzeug- und Uhrzeit-Zählungen decken %1$d von %2$d Servern ab — %3$@ meldet nur Summen pro Unterhaltung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn, tool and clock counts cover %d of %d servers — %@ reports per-conversation totals only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recuentos de turnos, herramientas y horario cubren %1$d de %2$d servidores — %3$@ solo informa totales por conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les décomptes de tours, d’outils et d’horaires couvrent %1$d serveur(s) sur %2$d — %3$@ n’indique que des totaux par conversation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I conteggi di turni, strumenti e orari coprono %1$d server su %2$d — %3$@ riporta solo i totali per conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターン数・ツール数・時間帯の集計は %2$d 台中 %1$d 台のサーバに対応しています — %3$@ は会話ごとの合計のみを報告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴, 도구, 시간대 집계는 서버 %2$d대 중 %1$d대에서만 지원됩니다 — %3$@는 대화별 합계만 보고합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As contagens de turnos, ferramentas e horário cobrem %1$d de %2$d servidores — %3$@ informa apenas totais por conversa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回合、工具和时间统计覆盖了 %2$d 台服务器中的 %1$d 台 — %3$@ 只报告按对话计的总量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回合、工具和時間統計涵蓋了 %2$d 台伺服器中的 %1$d 台 — %3$@ 只回報按對話計的總量。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczby tur, narzędzi i czasu obejmują %1$d z %2$d serwerów — %3$@ podaje tylko sumy na rozmowę."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optællinger af ture, værktøjskald og tidspunkter dækker %d af %d servere – %@ viser kun totaler pr. samtale."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuorojen, työkalujen ja kellonaikojen laskenta kattaa %d / %d palvelinta: %@ näyttää vain keskustelukohtaiset summat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Umferða-, verkfæra- og tímateljarar ná yfir %d af %d netþjónum, %@ sýnir aðeins heildarsummur fyrir hvert samtal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tall for turer, verktøy og klokkeslett dekker %d av %d servere, %@ viser bare samletotaler per samtale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räkningarna av turer, verktyg och klockslag täcker %d av %d servrar – %@ redovisar bara summor per konversation."
          }
        }
      }
    },
