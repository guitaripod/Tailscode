    "That is the address a server binds to, not one you can reach": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist die Adresse, an die sich ein Server bindet, nicht eine, die du erreichen kannst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is the address a server binds to, not one you can reach"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa es la dirección en la que escucha un servidor, no una a la que puedas acceder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est l’adresse d’écoute d’un serveur, pas une que vous pouvez joindre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è l’indirizzo su cui un server si mette in ascolto, non uno che puoi raggiungere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それはサーバがバインドするアドレスであり、あなたが到達できるものではありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그것은 서버가 바인딩하는 주소이지, 당신이 접속할 수 있는 주소가 아닙니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse é o endereço em que um servidor escuta, não um que você possa acessar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那是服务器绑定的地址，而不是你可以访问的地址"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
