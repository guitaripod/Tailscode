    "Only its own agent so far. More agents… adds one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only its own agent so far. More agents… adds one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher nur der eigene Agent. „Weitere Agenten…“ fügt einen hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora, solo su propio agente. «Más agentes…» añade uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour l'instant, seulement son propre agent. « Plus d'agents… » en ajoute un."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora solo il suo agente. «Altri agenti…» ne aggiunge uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はこのマシンのエージェントだけです。「その他のエージェント…」で追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 이 기기의 에이전트만 있습니다. “더 많은 에이전트…”로 추가하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie tylko własny agent. „Więcej agentów…” dodaje kolejnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por enquanto, só o próprio agente. “Mais agentes…” adiciona outro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有它自己的代理。“更多代理…”可以添加一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有它自己的代理程式。「更多代理程式…」可以新增一個。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtil nu kun dens egen agent. »Flere agenter…« tilføjer en."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toistaiseksi vain oma agentti. ”Lisää agentteja…” lisää yhden."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingöngu eigin agent hingað til. „Fleiri agentar…“ bætir einum við."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare dens egen agent så langt. Flere agenter… legger til en."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hittills bara dess egen agent. Fler agenter… lägger till en."
          }
        }
      }
    },
