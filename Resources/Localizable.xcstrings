    "From the prompt going out to the first token the model wrote — the queue and the prompt being read, before any generating began.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von dem Moment, in dem der Prompt abgeschickt wurde, bis zum ersten Token, das das Modell geschrieben hat — die Warteschlange und das Einlesen des Prompts, bevor die Generierung begann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the prompt going out to the first token the model wrote — the queue and the prompt being read, before any generating began."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde que se envía el prompt hasta el primer token que escribe el modelo — la cola y la lectura del prompt, antes de que empezara a generar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De l’envoi de l’invite jusqu’au premier jeton écrit par le modèle — la file d’attente et la lecture de l’invite, avant que la génération ne commence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dall’invio del prompt fino al primo token scritto dal modello — la coda e la lettura del prompt, prima che iniziasse la generazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプトが送信されてから、モデルが最初のトークンを書き出すまで — 生成が始まる前の、キュー待ちとプロンプトの読み込みにあたります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프트가 전송된 시점부터 모델이 첫 토큰을 작성할 때까지입니다 — 생성이 시작되기 전의 대기열과 프롬프트 읽기 시간입니다。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Do envio do prompt até o primeiro token escrito pelo modelo — a fila e a leitura do prompt, antes que a geração começasse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从提示词发出到模型写出第一个词元为止 — 也就是生成开始之前的排队和提示词读取时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從提示詞發出到模型寫出第一個詞元為止 — 也就是產生開始之前的排隊和提示詞讀取時間。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od wysłania promptu do pierwszego tokena napisanego przez model — kolejka i odczytywanie promptu, zanim zaczęło się generowanie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra prompten blev sendt, til det første token modellen skrev – køen og den læste prompt, før nogen generering begyndte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehotteen lähtöhetkestä ensimmäiseen tokeniin, jonka malli kirjoitti: jono ja kehotteen lukeminen ennen kuin generointi alkoi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Frá því að fyrirmælin eru send þar til fyrsta táknið sem líkanið skrifaði – biðröðin og lestur fyrirmælanna, áður en framleiðsla hófst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra prompten sendes til modellen skriver første token: køen og lesingen av prompten, før genereringen startet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från det att prompten skickades till den första token modellen skrev – kön och läsningen av prompten, innan genereringen började."
          }
        }
      }
    },
