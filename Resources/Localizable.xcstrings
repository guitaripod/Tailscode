    "This server cannot hand over files, so a board cannot open.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server kann keine Dateien herausgeben, daher kann kein Board geöffnet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server cannot hand over files, so a board cannot open."
          }
        },
