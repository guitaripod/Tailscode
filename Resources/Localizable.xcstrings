    "Diagnostics are on the clipboard.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Diagnose liegt in der Zwischenablage."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics are on the clipboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diagnóstico está en el portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le diagnostic est dans le presse-papiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La diagnostica è negli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断情報をクリップボードにコピーしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단 정보가 클립보드에 복사되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O diagnóstico está na área de transferência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断信息已复制到剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "診斷資訊已複製到剪貼板。"
          }
        }
      }
    },
    "Diagnostics from connections, chats, and syncs show up here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnosedaten zu Verbindungen, Chats und Synchronisierungen erscheinen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics from connections, chats, and syncs show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen los diagnósticos de conexiones, chats y sincronizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les diagnostics des connexions, discussions et synchronisations apparaissent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui compaiono le diagnostiche di connessioni, chat e sincronizzazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続・チャット・同期の診断情報がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결, 대화, 동기화 진단 정보가 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnósticos de conexões, conversas e sincronizações aparecem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接、对话和同步的诊断信息会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線、對話與同步的診斷資訊會顯示在這裡。"
          }
        }
      }
    },
    "Diagnostics were copied to the clipboard instead. Send them to %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Diagnose wurde stattdessen in die Zwischenablage kopiert. Sende sie an %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics were copied to the clipboard instead. Send them to %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diagnóstico se copió al portapapeles. Envíalo a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le diagnostic a été copié dans le presse-papiers. Envoyez-le à %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La diagnostica è stata copiata negli appunti. Inviala a %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりに診断情報をクリップボードにコピーしました。%@ に送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대신 진단 정보를 클립보드에 복사했습니다. %@(으)로 보내 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O diagnóstico foi copiado para a área de transferência. Envie para %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断信息已改为复制到剪贴板。请发送到 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "診斷資訊已改為複製到剪貼板。請寄送至 %@。"
          }
        }
      }
    },
