    "The model the next prompt runs on and how hard it thinks — scroll to step the effort": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell, auf dem der nächste Prompt läuft, und wie stark es nachdenkt — scrollen, um den Aufwand zu stufen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model the next prompt runs on and how hard it thinks — scroll to step the effort"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo en el que se ejecuta el próximo prompt y cuánto se esfuerza: desplázate para ajustar el esfuerzo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle sur lequel s’exécute la prochaine invite et l’intensité de sa réflexion — faites défiler pour ajuster l’effort"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello su cui gira il prossimo prompt e quanto intensamente ragiona — scorri per regolare lo sforzo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のプロンプトが動くモデルと、その思考の強さ — スクロールで強度を調整"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 프롬프트가 실행될 모델과 얼마나 깊이 생각할지 — 스크롤로 강도를 조절"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo em que o próximo prompt roda e o quanto ele se esforça — role para ajustar o esforço"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一条提示词将运行的模型，以及它思考的强度 — 滚动可调整强度"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一條提示詞將執行的模型，以及它思考的強度 — 滾動可調整強度"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model, na którym uruchomi się następny prompt, i to, jak intensywnie myśli — przewiń, aby ustawić poziom wysiłku"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen, den næste prompt kører på, og hvor hårdt den tænker – rul for at justere indsatsen"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Malli, jolla seuraava kehote ajetaan ja kuinka paljon se pohtii – vieritä säätääksesi panostusta"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Líkanið sem næstu fyrirmæli keyra á og hversu mikið það hugsar – skrunaðu til að stilla átakið"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen den neste prompten kjører på, og hvor hardt den tenker. Rull for å justere innsatsen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen som nästa prompt körs på och hur mycket den tänker. Rulla för att justera ansträngningen."
          }
        }
      }
    },
