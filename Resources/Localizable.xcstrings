    "It failed here (%1$@) and passed at step %2$lld.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It failed here (%1$@) and passed at step %2$lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier fehlgeschlagen (%1$@), bei Schritt %2$lld bestanden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló aquí (%1$@) y pasó en el paso %2$lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec ici (%1$@), réussi à l'étape %2$lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui è fallito (%1$@) e ha superato il passaggio %2$lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで失敗（%1$@）、ステップ%2$lldで成功。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 실패(%1$@)했고 %2$lld단계에서 통과함."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nie powiodło się (%1$@), a przeszło w kroku %2$lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falhou aqui (%1$@) e passou no passo %2$lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处失败（%1$@），在第 %2$lld 步通过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處失敗（%1$@），在第 %2$lld 步通過。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fejlede her (%1$@) og bestod ved trin %2$lld."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Epäonnistui tässä (%1$@), ja meni läpi vaiheessa %2$lld."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Mistókst hér (%1$@) og stóðst á skrefi %2$lld."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Feilet her (%1$@) og passerte i steg %2$lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Misslyckades här (%1$@) och godkändes i steg %2$lld."
          }
        }
      }
    },
