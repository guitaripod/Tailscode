          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger patchen åt sidan; arbetskatalogen ser den aldrig."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
