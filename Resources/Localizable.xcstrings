    "Raised only while the window is not focused, and withdrawn once a request is answered.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raised only while the window is not focused, and withdrawn once a request is answered."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur angehoben, solange das Fenster nicht im Fokus ist, und zurückgezogen, sobald eine Anfrage beantwortet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eleva solo mientras la ventana no tiene el foco y se retira cuando se responde a una solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relevé seulement lorsque la fenêtre n’a pas le focus, et retiré dès qu’une demande reçoit une réponse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollevato solo mentre la finestra non ha il focus, e ritirato appena una richiesta riceve risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウにフォーカスがないときだけ前面に出し、リクエストに応答すると引っ込めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창에 포커스가 없을 때만 올라오고, 요청에 응답하면 내려갑니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podnoszone tylko wtedy, gdy okno nie ma fokusu, i chowane po udzieleniu odpowiedzi na żądanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibido somente enquanto a janela não está em foco, e recolhido assim que uma solicitação é respondida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在窗口未获得焦点时提升显示，请求得到回应后即收起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在視窗未取得焦點時提升顯示，請求獲得回應後即收起。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hæves kun, mens vinduet ikke har fokus, og trækkes tilbage, når en anmodning er besvaret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nostetaan vain, kun ikkuna ei ole aktiivinen, ja poistetaan, kun pyyntöön on vastattu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hækkað aðeins meðan glugginn er ekki í fókus, og dregið til baka um leið og beiðni hefur verið svarað."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vises bare mens vinduet ikke har fokus, og skjules igjen når en forespørsel er besvart."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas bara när fönstret inte är i fokus och döljs när en begäran har besvarats."
          }
        }
      }
    },
