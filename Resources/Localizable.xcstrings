    "The worker stops where it is and nothing it changed reaches the tree.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Workeren standser, hvor den er, og intet af dens ændringer når arbejdskataloget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Worker hält an der aktuellen Stelle an, und nichts von seinen Änderungen erreicht das Arbeitsverzeichnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The worker stops where it is and nothing it changed reaches the tree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El worker se detiene donde está y nada de lo que cambió llega al árbol de trabajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työntekijä pysähtyy nykyiseen kohtaansa, eikä mikään sen muutos tavoita työhakemistoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le worker s’arrête là où il en est et rien de ce qu’il a modifié n’atteint l’arbre de travail."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinnuferlið stöðvast þar sem það er og ekkert af breytingum þess berst í vinnumöppuna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il worker si ferma dove si trova e nulla di ciò che ha modificato arriva nell’albero di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワーカーはその場で停止し、変更内容は作業ツリーに一切届きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워커가 지금 위치에서 멈추며, 변경한 내용은 작업 트리에 반영되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Workeren stopper der den er, og ingen av endringene den har gjort, kommer inn i arbeidskatalogen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Worker zatrzymuje się tam, gdzie jest, a nic z tego, co zmienił, nie trafi do drzewa roboczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O worker para onde está e nada do que ele alterou chega à árvore de trabalho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Workern stannar där den är, och inget av det den ändrade når arbetskatalogen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行者会就地停止，它所做的修改都不会进入工作树。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行者會就地停止，它所做的修改都不會進入工作樹。"
          }
        }
      }
    },
