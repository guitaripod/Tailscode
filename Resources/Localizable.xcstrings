        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 직접 가져온 롤링 속도 제한입니다. 백분율은 추정치가 아니라 실제 요금제 소비량입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limites de taxa contínuos direto de %@. As porcentagens são o consumo real do seu plano, não uma estimativa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接来自 %@ 的滚动速率限制。百分比是你套餐的实际消耗，而非估算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接來自 %@ 的滾動速率限制。百分比是你方案的實際消耗，而非估算。"
          }
        }
      }
    },
