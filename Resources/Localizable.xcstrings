            "state": "translated",
            "value": "Ses conversations restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue conversazioni restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화는 그대로 남습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego rozmowy zostają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas conversas continuam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其对话保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其對話保留。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dens samtaler bevares."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen keskustelut säilyvät."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtölin þess haldast."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtalene beholdes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dess konversationer finns kvar."
          }
        }
      }
    },
    "Its conversations stay. It leaves the model pill until it is added again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its conversations stay. It leaves the model pill until it is added again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Unterhaltungen bleiben. Er verschwindet aus der Modellauswahl, bis er wieder hinzugefügt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus conversaciones se conservan. Deja el selector de modelo hasta que se vuelva a añadir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses conversations restent. Il quitte le sélecteur de modèle jusqu'à ce qu'il soit de nouveau ajouté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sue conversazioni restano. Esce dal selettore del modello finché non viene aggiunto di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話はそのまま残ります。再び追加するまでモデル選択から消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화는 그대로 남습니다. 다시 추가하기 전까지 모델 선택기에서 빠집니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmowy zostają. Znika z wyboru modelu, dopóki nie zostanie dodany ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As conversas dele continuam. Ele sai do seletor de modelo até ser adicionado de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的对话会保留。在重新添加之前，它会从模型选择器中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的對話會保留。在重新加入之前，它會從模型選擇器中移除。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dens samtaler bevares. Den forsvinder fra modelvælgeren, indtil den tilføjes igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen keskustelut säilyvät. Se poistuu mallivalinnasta, kunnes se lisätään uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtölin þess haldast. Það hverfur úr líkanavalinu þangað til það er bætt við aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtalene beholdes. Den forsvinner fra modellvelgeren til den legges til igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dess konversationer finns kvar. Den försvinner från modellväljaren tills den läggs till igen."
          }
        }
      }
    },
