    "The gateway stopped hearing from this device and ended the call.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gateway stopped hearing from this device and ended the call."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gateway hat von diesem Gerät nichts mehr empfangen und den Anruf beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gateway dejó de recibir audio de este dispositivo y terminó la llamada."
          }
        },
        "fr": {
