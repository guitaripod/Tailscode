        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新阅读对话以生成摘要。你的消息正排在它后面等待。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新閱讀對話以產生摘要。你的訊息正排在它後面等待。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponowne odczytywanie rozmowy w celu jej podsumowania. Twoja wiadomość czeka w kolejce za nim."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læser samtalen igen for at opsummere den. Din besked står i kø bagved."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luetaan keskustelu uudelleen sen tiivistämiseksi. Viestisi odottaa jonossa sen jälkeen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Les samtalið aftur til að taka það saman. Skilaboðin þín bíða í biðröð þar til lestrinum lýkur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtalen leses på nytt for å oppsummere den. Meldingen din venter i køen etter den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
