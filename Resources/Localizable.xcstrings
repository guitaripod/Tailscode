    "Every area and the window zoom back to normal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every area and the window zoom back to normal"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Bereiche und das Fenster-Zoom werden auf normal zurückgesetzt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las áreas y el zoom de la ventana vuelven a lo normal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les zones et le zoom de la fenêtre reviennent à la normale"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le aree e lo zoom della finestra tornano alla normalità"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての領域とウインドウのズームが通常に戻ります"
