    "Answering, set to ask for its password": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwortet, verlangt aber sein Passwort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answering, set to ask for its password"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde, pero está configurado para pedir su contraseña"
