    "Finished work here ends quietly. Approvals and questions still reach you": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished work here ends quietly. Approvals and questions still reach you"
          }
        },
        "de": {
