    "Delegate and more than one Live Activity at a time are part of Tailscode Pro again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delegate and more than one Live Activity at a time are part of Tailscode Pro again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Delegate und mehr als eine Live-Aktivität gleichzeitig gehören wieder zu Tailscode Pro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Delegate y más de una actividad en vivo a la vez vuelven a ser parte de Tailscode Pro."
          }
        },
        "fr": {
