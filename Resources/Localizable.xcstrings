    "Under Credentials, create an OAuth client ID of type TV and Limited Input device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle unter Anmeldedaten eine OAuth-Client-ID vom Typ „TV und Gerät mit eingeschränkter Eingabe“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under Credentials, create an OAuth client ID of type TV and Limited Input device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Credenciales, crea un ID de cliente de OAuth de tipo «TV y dispositivo de entrada limitada»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Identifiants, créez un ID client OAuth de type « Téléviseurs et appareils à saisie limitée »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Credenziali, crea un ID client OAuth di tipo «TV e dispositivo con input limitato»."
