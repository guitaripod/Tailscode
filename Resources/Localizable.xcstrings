    "Every clip comes with sound. Say what is heard, or let the model decide": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Clip hat Ton. Sag, was zu hören ist, oder überlass es dem Modell"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every clip comes with sound. Say what is heard, or let the model decide"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los clips llevan sonido. Di qué se escucha, o deja que lo decida el modelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque clip a du son. Dites ce qu’on entend, ou laissez le modèle décider"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni clip ha l’audio. Di' cosa si sente, oppure lascia decidere al modello"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのクリップにも音がつきます。何が聞こえるかを伝えるか、モデルに任せてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 클립에는 소리가 들어갑니다. 무엇이 들리는지 말하거나, 모델이 정하도록 두세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo clipe vem com som. Diga o que se ouve, ou deixe o modelo decidir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个片段都自带音效。说出你想听到的声音，或者交给模型决定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個片段都自帶音效。說出你想聽到的聲音，或者交給模型決定"
          }
