    "Your Pro week runs until %@. Get Pro to keep every server connected after that.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Pro week runs until %@. Get Pro to keep every server connected after that."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pro-Woche läuft bis %@. Hol dir Pro, damit danach alle Server verbunden bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu semana Pro dura hasta el %@. Consigue Pro para mantener todos los servidores conectados después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre semaine Pro dure jusqu’au %@. Prenez Pro pour garder tous les serveurs connectés ensuite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua settimana Pro dura fino a %@. Prendi Pro per tenere collegati tutti i server anche dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro ウィークは %@ までです。その後もすべてのサーバを接続しておくには Pro を入手してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro 위크는 %@까지입니다. 그 후에도 모든 서버를 연결해 두려면 Pro를 구입하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój tydzień Pro trwa do %@. Kup Pro, aby potem wszystkie serwery pozostały połączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua semana Pro vai até %@. Tenha o Pro para manter todos os servidores conectados depois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Pro 周持续到 %@。获得 Pro 即可在之后保持所有服务器连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Pro 週持續到 %@。取得 Pro 即可在之後保持所有伺服器連線。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Pro-uge løber til %@. Få Pro for at holde alle servere forbundet derefter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro-viikkosi kestää %@ asti. Hanki Pro, jotta kaikki palvelimet pysyvät yhdistettyinä sen jälkeenkin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro-vikan þín gildir til %@. Fáðu Pro til að halda alla netþjóna tengda eftir það."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro-uka di varer til %@. Skaff deg Pro for å holde alle servere tilkoblet etterpå."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din Pro-vecka varar till %@. Skaffa Pro för att hålla alla servrar anslutna efter det."
          }
        }
