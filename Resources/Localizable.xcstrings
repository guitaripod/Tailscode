    "Run it on the machine the server runs on. It updates in place and keeps your password.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Rechner ausführen, auf dem der Server läuft. Es aktualisiert an Ort und Stelle und behält dein Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run it on the machine the server runs on. It updates in place and keeps your password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecútalo en la máquina donde corre el servidor. Actualiza en el sitio y conserva tu contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À exécuter sur la machine où tourne le serveur. La mise à jour se fait sur place et conserve votre mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eseguilo sulla macchina su cui gira il server. Aggiorna sul posto e mantiene la tua password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバが動いているマシンで実行してください。その場で更新され、パスワードはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 실행 중인 컴퓨터에서 실행하세요. 그 자리에서 업데이트되며 비밀번호는 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute na máquina onde o servidor roda. Ele atualiza no lugar e mantém sua senha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在运行服务器的机器上执行。它会就地更新并保留你的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在執行伺服器的機器上執行。它會就地更新並保留你的密碼。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom to na komputerze, na którym działa serwer. Aktualizuje się w miejscu i zachowuje twoje hasło."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kør den på computeren, hvor serveren kører. Den opdateres på stedet og beholder din adgangskode."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suorita se koneella, jolla palvelin toimii. Se päivittyy paikallaan ja säilyttää salasanasi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyrðu það á tölvunni sem netþjónninn keyrir á. Uppfærslan fer fram á sínum stað og lykilorðið þitt helst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjør den på maskinen serveren kjører på. Den oppdateres på stedet og beholder passordet ditt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kör den på datorn där servern körs. Den uppdateras på plats och behåller ditt lösenord."
          }
        }
      }
    },
