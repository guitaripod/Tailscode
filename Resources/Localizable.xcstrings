    "You are looking at sample data. Link a computer that runs your agent and this becomes your own.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are looking at sample data. Link a computer that runs your agent and this becomes your own."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind Beispieldaten. Verknüpfe einen Rechner, auf dem dein Agent läuft, und das hier wird zu deinem eigenen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás viendo datos de ejemplo. Vincula un ordenador que ejecute tu agente y esto pasará a ser tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont des données d’exemple. Associez un ordinateur qui exécute votre agent et tout cela devient le vôtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai vedendo dati di esempio. Collega un computer che esegue il tuo agente e tutto questo diventa tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはサンプルデータです。エージェントが動くコンピュータをリンクすると、ここがあなた自身の画面になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 데이터를 보고 있어요. 에이전트가 실행되는 컴퓨터를 연결하면 이 화면이 내 것이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está vendo dados de exemplo. Conecte um computador que execute seu agente e isto passa a ser seu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你看到的是示例数据。关联一台运行智能体的电脑，这里就会变成你自己的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你看到的是範例資料。連結一台執行代理程式的電腦，這裡就會變成你自己的。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To przykładowe dane. Połącz komputer, na którym działa Twój agent, a to stanie się Twoje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ser eksempeldata. Forbind en computer, der kører din agent, og det her bliver dit eget."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näet esimerkkidataa. Yhdistä tietokone, jolla agenttisi toimii, niin tämä muuttuu omaksesi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú ert að skoða sýnishornsgögn. Tengdu tölvu sem keyrir agentinn þinn og þetta verður þitt eigið."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du ser eksempeldata. Koble til en maskin som kjører agenten din, så blir dette ditt eget."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du tittar på exempeldata. Anslut en dator som kör din agent, så blir det här ditt eget."
          }
        }
      }
