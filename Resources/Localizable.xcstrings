    "Held on this device. It goes when this turn ends. Click to edit, or press ↑ in an empty composer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held on this device. It goes when this turn ends. Click to edit, or press ↑ in an empty composer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät gehalten. Sie geht, wenn dieser Zug endet. Zum Bearbeiten klicken oder in einem leeren Eingabefeld ↑ drücken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retenido en este dispositivo. Se envía cuando termine este turno. Haz clic para editar o pulsa ↑ con el cuadro de texto vacío"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservé sur cet appareil. Il part à la fin de ce tour. Cliquez pour modifier, ou appuyez sur ↑ dans une zone de saisie vide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trattenuto su questo dispositivo. Parte quando questo turno finisce. Fai clic per modificare o premi ↑ con il campo di testo vuoto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで保留中です。このターンが終わると送られます。クリックで編集、または空の入力欄で↑を押します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 보관 중입니다. 이 턴이 끝나면 전송됩니다. 클릭하여 편집하거나 빈 입력창에서 ↑를 누르세요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowywana na tym urządzeniu. Zostanie wysłana po zakończeniu tej tury. Kliknij, aby edytować, lub naciśnij ↑ w pustym polu wiadomości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantido neste dispositivo. Vai quando este turno terminar. Clique para editar ou pressione ↑ com o campo de texto vazio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在此设备上。本轮结束后发送。点按可编辑，或在空输入框中按 ↑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在此裝置上。本輪結束後傳送。點按可編輯，或在空白輸入框中按 ↑"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Holdt på denne enhed. Den sendes, når turen slutter. Klik for at redigere, eller tryk ↑ i et tomt inputfelt"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidetty tällä laitteella. Se lähtee, kun tämä vuoro päättyy. Muokkaa napsauttamalla tai paina ↑ tyhjässä kehotekentässä"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Geymt á þessu tæki. Það fer þegar þessi umferð lýkur. Smelltu til að breyta, eða ýttu á ↑ í auðum innsláttarreit."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Holdt tilbake på denne enheten. Den sendes når denne turen er ferdig. Klikk for å redigere, eller trykk ↑ i et tomt felt"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hålls på den här enheten. Meddelandet skickas när turen är slut. Klicka för att redigera, eller tryck på ↑ i ett tomt inmatningsfält"
          }
        }
      }
    },
