          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu keskustelu näkyy listassa, vaikka sen palvelin ei ole tavoitettavissa"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vistað spjall birtist á listanum jafnvel þegar ekki er hægt að ná sambandi við netþjóninn hans"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En lagret chat vises selv når serveren ikke kan nås"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En sparad chatt visas även när dess server inte är nåbar"
          }
        }
      }
    },
