          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gestor de paquetes que instaló esto avisa cuando hay una versión más nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
