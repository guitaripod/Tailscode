    "%@ stays installed; the machine stops offering it and it leaves the model pill. Conversations with it stay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stays installed; the machine stops offering it and it leaves the model pill. Conversations with it stay."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bleibt installiert; der Rechner bietet es nicht mehr an, und es verschwindet aus der Modellauswahl. Gespräche damit bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sigue instalado; la máquina deja de ofrecerlo y sale del selector de modelo. Las conversaciones con él se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reste installé ; la machine ne le propose plus et il quitte le sélecteur de modèle. Les conversations avec lui restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ resta installato; la macchina smette di offrirlo ed esce dal selettore del modello. Le conversazioni con lui restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はインストールされたままです。マシンは提供を止め、モデル選択からも外れます。その会話は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 계속 설치되어 있습니다. 기기는 더 이상 제공하지 않으며 모델 선택에서도 빠집니다. 대화는 그대로 남습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pozostaje zainstalowany; komputer przestaje go oferować i znika z wyboru modelu. Rozmowy z nim zostają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ continua instalado; a máquina para de oferecê-lo e ele sai do seletor de modelo. As conversas com ele continuam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 保持安装；机器不再提供它，它也会从模型选择器中移除。与它的对话保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 保持安裝；機器不再提供它，它也會從模型選擇器移除。與它的對話保留。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ forbliver installeret; computeren tilbyder den ikke længere, og den forsvinder fra modelvælgeren. Samtaler med den bevares."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pysyy asennettuna; tietokone lopettaa sen tarjoamisen ja se poistuu mallivalinnasta. Keskustelut sen kanssa säilyvät."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verður áfram uppsett; tölvan hættir að bjóða það og það hverfur úr líkanavalinu. Samtölin við það haldast."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ forblir installert; maskinen slutter å tilby den, og den forsvinner fra modellvelgeren. Samtalene med den beholdes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ förblir installerad; datorn erbjuder den inte längre och den försvinner från modellväljaren. Konversationer med den finns kvar."
          }
        }
      }
    },
