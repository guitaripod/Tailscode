            "value": "Hentet fra komprimeringen: kun resuméet er stadig i vinduet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiivistyksestä saatu: kontekstiikkunassa on enää vain yhteenveto"
