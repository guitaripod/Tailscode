    "Nothing is listening on %@ on %@. If ComfyUI is running there, start it listening on its Tailscale address so other machines can reach it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is listening on %@ on %@. If ComfyUI is running there, start it listening on its Tailscale address so other machines can reach it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf %2$@ lauscht auf Port %1$@ nichts. Falls ComfyUI dort läuft, starte es mit Zuhören auf seiner Tailscale-Adresse, damit andere Rechner es erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada escucha en el puerto %1$@ de %2$@. Si ComfyUI se está ejecutando allí, inícialo escuchando en su dirección de Tailscale para que otras máquinas lo alcancen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’écoute sur le port %1$@ de %2$@. Si ComfyUI tourne là-bas, lancez-le en l’écoutant sur son adresse Tailscale pour que les autres machines puissent l’atteindre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla è in ascolto sulla porta %1$@ di %2$@. Se ComfyUI è in esecuzione lì, avvialo in ascolto sul suo indirizzo Tailscale così gli altri computer possono raggiungerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ の %1$@ で待ち受けているものはありません。そこで ComfyUI が動いている場合は、他のマシンから届くように Tailscale アドレスで待ち受けて起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@의 %1$@ 포트에서 연결을 받는 것이 없어요. 거기서 ComfyUI가 실행 중이라면 다른 컴퓨터가 접속할 수 있게 Tailscale 주소에서 연결을 받도록 시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie nasłuchuje na porcie %1$@ na %2$@. Jeśli ComfyUI tam działa, uruchom go tak, by nasłuchiwał na swoim adresie Tailscale, aby inne komputery mogły się z nim połączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada está escutando na porta %1$@ de %2$@. Se o ComfyUI estiver em execução lá, inicie-o escutando no endereço dele no Tailscale para que outros computadores o alcancem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上的 %1$@ 端口没有任何程序在监听。如果 ComfyUI 正在那里运行，请让它监听其 Tailscale 地址来启动，其他机器才能连到它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 上的 %1$@ 連接埠沒有任何程式在監聽。如果 ComfyUI 正在那裡執行，請讓它監聽其 Tailscale 位址來啟動，其他機器才能連到它。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet lytter på port %@ på %@. Hvis ComfyUI kører der, så start det igen, så det lytter på dens Tailscale-adresse, og andre computere kan nå det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään ei kuuntele portissa %1$@ kohteessa %2$@. Jos ComfyUI on käynnissä siellä, käynnistä se kuuntelemaan sen Tailscale-osoitteessa, jotta muut tietokoneet voivat tavoittaa sen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert hlustar á porti %@ á %@. Ef ComfyUI keyrir þar, byrjaðu það þannig að það hlusti á Tailscale-vistfangi sínu svo aðrar tölvur nái til þess."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting lytter på port %@ på %@. Hvis ComfyUI kjører der, start det slik at det lytter på Tailscale-adressen, så andre maskiner kan nå det."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting lyssnar på port %@ på %@. Om ComfyUI körs där, starta det så att det lyssnar på dess Tailscale-adress så att andra datorer kan nå det."
          }
        }
      }
    },
