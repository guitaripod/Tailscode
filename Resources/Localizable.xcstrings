    "%@:%@ answers, but not like a %@ server — is the other agent on this port?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ antwortet, aber nicht wie ein %@-Server — läuft der andere Agent auf diesem Port?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ answers, but not like a %@ server — is the other agent on this port?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ responde, pero no como un servidor %@: ¿el otro agente está en este puerto?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ répond, mais pas comme un serveur %@ — l’autre agent est-il sur ce port ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ risponde, ma non come un server %@ — l’altro agente è su questa porta?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ は応答しますが、%@ サーバのようではありません — 別のエージェントがこのポートにいませんか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@이(가) 응답하지만 %@ 서버 같지 않습니다 — 다른 에이전트가 이 포트에 있나요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ responde, mas não como um servidor %@ — será que o outro agente está nessa porta?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ 有响应，但不像是 %@ 服务器 — 是不是另一个智能体在这个端口上？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ 有回應，但不像是 %@ 伺服器 — 是不是另一個代理在這個埠上？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ odpowiada, ale nie jak serwer %@ — czy na tym porcie jest inny agent?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ svarer, men ikke som en %@-server – kører den anden agent på denne port?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ vastaa, mutta ei kuten %@-palvelin – onko toinen agentti tässä portissa?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ svarar, en ekki eins og %@-netþjónn – er hinn agentinn á þessari gátt?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@:%@ svarer, men ikke som en %@-server. Er det den andre agenten på denne porten?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$@ svarar, men inte som en %3$@-server. Är det någon annan agent på den porten?"
          }
        }
      }
    },
