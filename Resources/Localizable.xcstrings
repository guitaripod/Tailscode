    "It stopped before it finished. Trying again picks up where it left off.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stopped before it finished. Trying again picks up where it left off."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde vor dem Ende abgebrochen. Ein erneuter Versuch setzt dort fort, wo es aufgehört hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo antes de terminar. Al intentarlo de nuevo, continúa donde se quedó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s'est arrêté avant la fin. Une nouvelle tentative reprend là où il s'était arrêté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è fermato prima della fine. Riprovando riprende da dove si era interrotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了前に停止しました。もう一度試すと、中断した場所から再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료되기 전에 중단됐어요. 다시 시도하면 중단된 지점부터 이어서 진행해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymano przed końcem. Ponowna próba wznowi od miejsca przerwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parou antes de terminar. Tentar novamente continua de onde parou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在完成前停止了。重试会从中断处继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在完成前停止了。重試會從中斷處繼續。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det stoppede, før det var færdigt. Når du prøver igen, fortsætter det, hvor det slap."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pysähtyi kesken. Uusi yritys jatkuu siitä, mihin jäätiin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Því lauk áður en það kláraðist. Ef þú reynir aftur heldur það áfram þar sem það hætti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det stoppet før det var ferdig. Prøv igjen, så fortsetter det der det slapp."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det avbröts innan det var klart. Om du försöker igen fortsätter det där det slutade."
          }
        }
      }
    },
