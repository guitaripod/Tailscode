    "The preview of %@ was checked and %@ need attention:\n%@\nPlease fix them in the code.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preview of %@ was checked and %@ need attention:\n%@\nPlease fix them in the code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau von %@ wurde geprüft, und %@ brauchen Aufmerksamkeit:\n%@\nBitte beheben Sie sie im Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se revisó la vista previa de %@ y %@ necesitan atención:\n%@\nCorrígelos en el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aperçu de %@ a été vérifié et %@ demandent de l’attention :\n%@\nVeuillez les corriger dans le code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anteprima di %@ è stata controllata e %@ richiedono attenzione:\n%@\nCorreggili nel codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のプレビューを確認したところ、%@ 件に注意が必要です:\n%@\nコードで修正してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 미리보기를 확인한 결과 %@개에 주의가 필요합니다:\n%@\n코드에서 수정해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podgląd %@ został sprawdzony, a %@ wymagają uwagi:\n%@\nNapraw je w kodzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A prévia de %@ foi verificada e %@ precisam de atenção:\n%@\nCorrija-os no código."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已检查 %@ 的预览，%@ 需要注意：\n%@\n请在代码中修复它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已檢查 %@ 的預覽，%@ 需要注意：\n%@\n請在程式碼中修正它們。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhåndsvisningen af %@ er tjekket, og %@ kræver opmærksomhed:\n%@\nRet dem i koden."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohteen %@ esikatselu tarkistettiin ja %@ tarvitsevat huomiota:\n%@\nKorjaa ne koodissa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Forskoðun á %@ var athuguð og %@ þurfa athygli:\n%@\nLagaðu þau í kóðanum, takk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forhåndsvisningen av %@ ble sjekket, og %@ trenger oppmerksomhet:\n%@\nFiks dem i koden."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förhandsvisningen av %@ kontrollerades och %@ behöver uppmärksamhet:\n%@\nÅtgärda dem i koden."
          }
        }
      }
    },
    "The screen changed size, so the pictures cannot be laid over each other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen changed size, so the pictures cannot be laid over each other"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm hat seine Größe geändert, daher können die Bilder nicht übereinandergelegt werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla cambió de tamaño, así que las imágenes no se pueden superponer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran a changé de taille, les images ne peuvent donc pas être superposées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo ha cambiato dimensione, quindi le immagini non possono essere sovrapposte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のサイズが変わったため、画像を重ね合わせることはできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 크기가 바뀌어 이미지를 겹쳐 놓을 수 없습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran zmienił rozmiar, więc obrazów nie da się nałożyć na siebie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela mudou de tamanho, então as imagens não podem ser sobrepostas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕尺寸已变，因此无法将画面叠放对比"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫面尺寸已變，因此無法將畫面疊放對比"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmen har ændret størrelse, så billederne kan ikke lægges oven på hinanden"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytön koko muuttui, joten kuvia ei voi asettaa päällekkäin"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjárinn breytti um stærð, svo ekki er hægt að leggja myndirnar yfir hvor aðra"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermen endret størrelse, så bildene kan ikke legges over hverandre"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmen bytte storlek, så bilderna kan inte läggas ovanpå varandra"
          }
        }
      }
    },
    "The screen held still, so there is only one picture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen held still, so there is only one picture"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm blieb unverändert, daher gibt es nur ein Bild"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla no cambió, así que solo hay una imagen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran est resté immobile, il n’y a donc qu’une seule image"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo è rimasto fermo, quindi c’è una sola immagine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面に動きがなかったため、画像は1枚だけです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 움직이지 않아 이미지가 한 장뿐입니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran się nie zmienił, więc jest tylko jeden obraz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela ficou parada, então há apenas uma imagem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕保持静止，因此只有一张画面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫面保持靜止，因此只有一張畫面"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmen stod stille, så der er kun ét billede"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttö pysyi paikallaan, joten kuvia on vain yksi"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjárinn hélst kyrr, svo það er aðeins ein mynd"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermen sto stille, så det er bare ett bilde"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmen var stilla, så det finns bara en bild"
          }
        }
      }
    },
    "The text is %@ to 1 against its background. It needs %@ to 1.": {
