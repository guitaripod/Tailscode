    "A background task is running on the machine; the agent continues when it finishes": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Hintergrundaufgabe läuft auf dem Rechner; der Agent macht weiter, sobald sie fertig ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A background task is running on the machine; the agent continues when it finishes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una tarea en segundo plano en curso en la máquina; el agente continúa cuando termine"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche en arrière-plan est en cours sur la machine ; l’agent reprend une fois qu’elle est terminée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’attività in background è in corso sulla macchina; l’agente riprende quando finisce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン上でバックグラウンドタスクが実行中です。完了するとエージェントが続行します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에서 백그라운드 작업이 실행 중입니다. 작업이 끝나면 에이전트가 이어서 진행합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa em segundo plano está em execução na máquina; o agente continua quando ela terminar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个后台任务正在这台机器上运行；完成后智能体会继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個背景任務正在這台機器上執行；完成後代理會繼續"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na komputerze działa zadanie w tle; agent będzie kontynuować, gdy się ono zakończy"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En baggrundsopgave kører på maskinen; agenten fortsætter, når den er færdig"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustatehtävä on käynnissä tietokoneella; agentti jatkaa, kun se valmistuu"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunnsverk keyrir á tölvunni; agentinn heldur áfram þegar það er búið"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En bakgrunnsoppgave kjører på maskinen. Agenten fortsetter når den er ferdig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En bakgrundsuppgift körs på datorn. Agenten fortsätter när den är klar"
          }
        }
      }
    },
