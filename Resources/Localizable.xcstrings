    "The agent keeps working until this is true, and won't stop early. You can close the app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent arbeitet weiter, bis dies zutrifft, und hört nicht vorher auf. Du kannst die App schließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent keeps working until this is true, and won't stop early. You can close the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente sigue trabajando hasta que esto se cumpla y no parará antes. Puedes cerrar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent continue jusqu’à ce que ce soit vrai et ne s’arrête pas avant. Vous pouvez fermer l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agente continua finché questo non è vero e non si ferma prima. Puoi chiudere l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはこれが満たされるまで作業を続け、途中で止まりません。App は閉じて構いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트는 이 조건이 참이 될 때까지 계속 작업하며 도중에 멈추지 않습니다. 앱을 닫아도 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente continua trabalhando até isso ser verdade e não para antes. Você pode fechar o app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体会一直工作到这一条件成立为止，不会提前停止。你可以关闭 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理會一直工作到這個條件成立為止，不會提前停止。你可以關閉 App。"
          }
        }
      }
    },
    "The agent needs your approval to continue.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent braucht deine Freigabe, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent needs your approval to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente necesita tu aprobación para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent a besoin de votre approbation pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agente ha bisogno della tua approvazione per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行にはあなたの承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 승인이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente precisa da sua aprovação para continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体需要你的批准才能继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理需要你的核准才能繼續。"
          }
        }
      }
    },
    "The agent re-reads this conversation, writes a summary of it, and carries the summary forward instead of the whole transcript.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent liest diese Unterhaltung erneut, schreibt eine Zusammenfassung und nimmt statt des vollständigen Transkripts nur diese mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent re-reads this conversation, writes a summary of it, and carries the summary forward instead of the whole transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente relee esta conversación, escribe un resumen y sigue con el resumen en lugar de con toda la transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent relit cette conversation, en écrit un résumé et poursuit avec ce résumé plutôt qu’avec toute la transcription."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agente rilegge questa conversazione, ne scrive un riepilogo e prosegue con quello invece che con l’intera trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはこの会話を読み直して要約を書き、全文の代わりにその要約を持ち越します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 이 대화를 다시 읽고 요약을 작성한 뒤, 전체 기록 대신 그 요약을 이어서 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente relê esta conversa, escreve um resumo e segue com ele em vez de toda a transcrição."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体会重读这段对话、写出摘要，并带着摘要继续，而不是整段记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理會重讀這段對話、寫出摘要，並帶著摘要繼續，而不是整段紀錄。"
          }
        }
      }
    },
    "The App Store installs it — this app cannot update itself.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store installiert es – diese App kann sich nicht selbst aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store installs it — this app cannot update itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La App Store la instala: esta app no puede actualizarse a sí misma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'App Store l'installe — cette app ne peut pas se mettre à jour elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È l'App Store a installarlo: questa app non può aggiornarsi da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeがインストールを行います — このアプリは自分自身を更新できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store가 설치를 진행합니다 — 이 앱은 스스로 업데이트할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store é quem instala — este app não pode se atualizar sozinho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 App Store 负责安装——此应用无法自行更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 App Store 負責安裝——此應用程式無法自行更新。"
          }
        }
      }
    },
    "The checkout at %@ could not reach its remote, so nothing here knows whether a newer build exists.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Checkout unter %@ konnte seinen Remote nicht erreichen, daher weiß hier niemand, ob ein neuerer Build existiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The checkout at %@ could not reach its remote, so nothing here knows whether a newer build exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El checkout en %@ no pudo contactar con su remoto, así que nada aquí sabe si existe un build más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le checkout à %@ n'a pas pu joindre son dépôt distant, donc rien ici ne sait s'il existe un build plus récent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il checkout in %@ non è riuscito a raggiungere il proprio remoto, quindi qui non si sa se esiste un build più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のチェックアウトはリモートに接続できなかったため、より新しいビルドが存在するかどうかは、ここでは分かりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 체크아웃이 원격 저장소에 연결하지 못해, 더 최신 빌드가 있는지 여기서는 알 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O checkout em %@ não conseguiu contatar seu remoto, então nada aqui sabe se existe um build mais recente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 %@ 的检出代码无法连接到其远程仓库，因此这里无法得知是否存在更新的版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位於 %@ 的簽出程式碼無法連線到其遠端版本庫，因此這裡無法得知是否存在更新的版本。"
          }
        }
      }
    },
    "The checkout at %@ has %@ commits of its own, so it cannot be fast-forwarded.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Checkout unter %1$@ hat %2$@ eigene Commits, daher kann er nicht per Fast-Forward aktualisiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The checkout at %@ has %@ commits of its own, so it cannot be fast-forwarded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El checkout en %1$@ tiene %2$@ commits propios, así que no se puede avanzar en modo fast-forward."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le checkout à %1$@ a %2$@ commits qui lui sont propres, donc il ne peut pas être mis à jour en fast-forward."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il checkout in %1$@ ha %2$@ commit propri, quindi non può essere aggiornato con un fast-forward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のチェックアウトには独自のコミットが%2$@件あるため、早送り(fast-forward)更新ができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 체크아웃에는 자체 커밋이 %2$@개 있어, 패스트포워드(fast-forward)로 업데이트할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O checkout em %1$@ tem %2$@ commits próprios, então não é possível avançar em fast-forward."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 %1$@ 的检出代码有 %2$@ 个自己的提交，因此无法进行快进(fast-forward)更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位於 %1$@ 的簽出程式碼有 %2$@ 個自己的提交，因此無法進行快轉(fast-forward)更新。"
          }
        }
      }
    },
    "The checkout at %@ has uncommitted changes, so nothing here will touch it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Checkout unter %@ enthält nicht committete Änderungen, daher wird hier nichts daran verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The checkout at %@ has uncommitted changes, so nothing here will touch it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El checkout en %@ tiene cambios sin confirmar, así que nada aquí lo tocará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le checkout à %@ contient des modifications non validées, donc rien ici n'y touchera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il checkout in %@ contiene modifiche non salvate (commit), quindi qui non verrà toccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のチェックアウトには未コミットの変更があるため、ここからは一切触れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 체크아웃에 커밋되지 않은 변경 사항이 있어, 여기서는 손대지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O checkout em %@ tem alterações não commitadas, então nada aqui vai mexer nele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 %@ 的检出代码存在未提交的更改，因此这里不会对它做任何改动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位於 %@ 的簽出程式碼存在未提交的變更，因此這裡不會對它做任何改動。"
          }
        }
      }
    },
    "The checkout at %@ tracks no upstream to update from.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Checkout unter %@ verfolgt keinen Upstream, von dem aus aktualisiert werden könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The checkout at %@ tracks no upstream to update from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El checkout en %@ no sigue ningún upstream desde el que actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le checkout à %@ ne suit aucun dépôt amont depuis lequel se mettre à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il checkout in %@ non segue alcun upstream da cui aggiornarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のチェックアウトは、更新元となるアップストリームを追跡していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 체크아웃은 업데이트할 대상 업스트림을 추적하고 있지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O checkout em %@ não acompanha nenhum upstream para se atualizar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于 %@ 的检出代码没有跟踪任何可用于更新的上游分支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位於 %@ 的簽出程式碼沒有追蹤任何可用於更新的上游分支。"
          }
        }
      }
    },
