          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Delegate e mais de uma atividade ao vivo ao mesmo tempo voltam a fazer parte do Tailscode Pro."
          }
        },
        "zh-Hans": {
