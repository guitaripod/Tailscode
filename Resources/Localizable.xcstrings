    "Asked %@ machines on both ports. Run the install command on the machine you code on, then scan again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Rechner auf beiden Ports gefragt. Führe den Installationsbefehl auf dem Rechner aus, auf dem du programmierst, und suche dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asked %@ machines on both ports. Run the install command on the machine you code on, then scan again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se preguntó a %@ máquinas en ambos puertos. Ejecuta el comando de instalación en la máquina donde programas y escanea de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ machines interrogées sur les deux ports. Exécutez la commande d’installation sur la machine où vous codez, puis scannez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macchine interrogate su entrambe le porte. Esegui il comando di installazione sulla macchina su cui scrivi codice, poi scansiona di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 台のマシンに両方のポートで問い合わせました。コードを書いているマシンでインストールコマンドを実行し、もう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@대의 머신에 양쪽 포트로 문의했습니다. 코드를 작성하는 머신에서 설치 명령을 실행한 다음 다시 검색하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ máquinas foram consultadas nas duas portas. Rode o comando de instalação na máquina onde você programa e escaneie de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在两个端口上询问了 %@ 台机器。请在你编写代码的那台机器上运行安装命令，然后重新扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在兩個連接埠上詢問了 %@ 台機器。請在你撰寫程式碼的那台機器上執行安裝指令，然後重新掃描。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytano %@ komputerów na obu portach. Uruchom polecenie instalacji na komputerze, na którym programujesz, a potem zeskanuj ponownie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spurgte %@ computere på begge porte. Kør installationskommandoen på den computer, du koder på, og scan igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysyttiin %@ tietokoneelta molemmista porteista. Suorita asennuskomento tietokoneella, jolla ohjelmoit, ja skannaa sitten uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spurt %@ tölvur á báðum gáttum. Keyrðu uppsetningarskipunina á tölvunni sem þú forritar á og skannaðu svo aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spurte %@ maskiner på begge porter. Kjør installasjonskommandoen på maskinen du koder på, og skann deretter på nytt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ datorer frågades på båda portarna. Kör installationskommandot på datorn där du kodar och skanna sedan igen."
          }
        }
      }
    },
