        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stigen læses fra computeren, så snart den svarer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Portaat luetaan tietokoneelta heti, kun se vastaa."
