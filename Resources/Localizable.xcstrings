          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo objetivo, caminhos e verificador, abertos para edição antes de partir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相同的目标、路径和验证方式，发送前可编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相同的目標、路徑和驗證方式，傳送前可編輯。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
