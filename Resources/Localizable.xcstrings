    "Nothing on this %@ is offering a microphone. Plug one in or pick one in the sound settings, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing on this %@ is offering a microphone. Plug one in or pick one in the sound settings, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem %@ bietet nichts ein Mikrofon an. Schließe eins an oder wähle eins in den Toneinstellungen, dann versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en este %@ ofrece un micrófono. Conecta uno o elígelo en los ajustes de sonido y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun micro n'est proposé par votre %@. Branchez-en un ou choisissez-le dans les réglages du son, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun microfono è disponibile su questo %@. Collegane uno o scegline uno nelle impostazioni audio, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%@にマイクが接続されていません。マイクを接続するか、サウンドの設定で選んでから、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 %@에서 사용할 수 있는 마이크가 없습니다. 마이크를 연결하거나 소리 설정에서 고른 뒤 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym %@ nic nie oferuje mikrofonu. Podłącz go albo wybierz w ustawieniach dźwięku, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum microfone está disponível neste %@. Conecte um ou escolha um nos ajustes de som e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台%@没有提供麦克风。请接入一个麦克风，或在声音设置中选择，然后再试一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 %@ 上沒有可用的麥克風。請接上麥克風，或在聲音設定中選擇一個，然後再試一次。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen mikrofon er tilgængelig på denne %@. Tilslut en, eller vælg en i lydindstillingerne, og prøv igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä %@ ei tarjoa mikrofonia. Liitä mikrofoni tai valitse se äänenasetuksista ja yritä uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ býður ekki upp á neinn hljóðnema. Tengdu einn eða veldu hann í hljóðstillingunum og reyndu aftur."
