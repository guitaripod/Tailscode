    "The same packet one rung down — a pass there is a streak the table can promote on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe Paket eine Stufe tiefer – ein Erfolg dort ist eine Serie, die die Tabelle hochstufen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same packet one rung down — a pass there is a streak the table can promote on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo paquete un nivel más abajo — un acierto ahí es una racha que la tabla puede ascender."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même paquet un niveau plus bas — une réussite là peut créer une série que le tableau peut promouvoir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stesso pacchetto un livello più in basso — un successo lì è una serie che la tabella può promuovere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じパケットを1段下で — そこで通れば、表が昇格させられる連勝になる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 패킷을 한 단 아래에서 — 거기서 통과하면 표가 승격시킬 수 있는 연승이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo pacote um nível abaixo — um sucesso ali é uma sequência que a tabela pode promover."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一个任务包，降一级 — 在那里通过一次，就是表格可以借此晋升的连胜。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一個任務包，降一級 — 在那裡通過一次，就是表格可以藉此晉升的連勝。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten sam pakiet o jeden szczebel niżej — sukces tam to seria, na podstawie której tabela może awansować."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den samme pakke ét trin nedenfor – et bestået forsøg dér er en stime, tabellen kan rykke op på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama paketti yhden tason alempana: läpäisy siellä on putki, jonka perusteella taulukko voi ylentää."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sami verkpakki einu þrepi neðar. Ef hann stenst þar myndast runa sem taflan getur nýtt til að hækka flokkinn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den samme pakken ett trinn lavere – en bestått der er en rekke som tabellen kan bruke til å rykke opp."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samma paket ett steg ner: en godkänd körning där räknas som en svit som tabellen kan använda för att flytta upp."
          }
        }
      }
    },
