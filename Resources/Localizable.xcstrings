    "%@ tokens written in %@ of generation, measured from the first output token so the prompt being read does not count against the model.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Token geschrieben in %@ Generierungszeit, gemessen ab dem ersten Ausgabe-Token, damit das Einlesen des Prompts nicht auf das Modell angerechnet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens written in %@ of generation, measured from the first output token so the prompt being read does not count against the model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens escritos en %@ de generación, medidos desde el primer token de salida para que la lectura del prompt no cuente contra el modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jetons écrits en %@ de génération, mesurés depuis le premier jeton de sortie afin que la lecture de l’invite ne compte pas dans le temps du modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ token scritti in %@ di generazione, misurati dal primo token di output così che la lettura del prompt non venga conteggiata a carico del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@の生成で%1$@トークンを書き出しました。プロンプトの読み込み時間がモデルの負担に数えられないよう、最初の出力トークンから計測しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 동안 %1$@ 토큰을 생성했습니다. 프롬프트를 읽는 시간이 모델의 부담으로 계산되지 않도록 첫 출력 토큰부터 측정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens escritos em %@ de geração, medidos a partir do primeiro token de saída para que a leitura do prompt não conte contra o modelo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %2$@ 的生成时间内写入了 %1$@ 个词元。从第一个输出词元开始计时，这样提示词的读取时间就不会算在模型头上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %2$@ 的產生時間內寫入了 %1$@ 個詞元。從第一個輸出詞元開始計時，這樣提示詞的讀取時間就不會算在模型頭上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokenów wygenerowanych w ciągu %@, mierzone od pierwszego tokena wyjściowego, dzięki czemu odczytywanie promptu nie liczy się na niekorzyść modelu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ token skrevet på %@ generering, målt fra det første outputtoken, så den læste prompt ikke tæller mod modellen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokenia kirjoitettu %@ generoinnin aikana, mitattuna ensimmäisestä tulostetusta tokenista, jotta kehotteen lukeminen ei vaikuta mallin nopeuslukuun."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tákn skrifuð á %@ framleiðslutíma, mælt frá fyrsta úttakstákni svo lestur fyrirmælanna teljist ekki með."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens skrevet på %@ generering, målt fra første utdata-token, slik at prompten som leses ikke telles mot modellen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens skrivna på %@ genereringstid, mätt från första utdatatoken så att den inlästa prompten inte räknas mot modellen."
          }
        }
      }
    },
    "%@ tokens written in %@ — the tokens the model produced, over the whole wait.": {
