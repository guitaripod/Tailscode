    "The next send re-reads all %@ tokens at full price instead of from the cache.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next send re-reads all %@ tokens at full price instead of from the cache."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nächste Sendung liest alle %@ Token zum vollen Preis neu statt aus dem Cache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El próximo envío vuelve a leer los %@ tokens a precio completo en lugar de desde la caché."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prochain envoi relit les %@ jetons au plein tarif au lieu du cache."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prossimo invio rilegge tutti i %@ token a prezzo pieno invece di leggerli dalla cache."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の送信は、キャッシュからではなく %@ トークンすべてを定価で読み直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 전송은 캐시 대신 %@ 토큰을 정가로 다시 읽습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następne wysłanie ponownie odczyta wszystkie %@ tokenów w pełnej cenie, zamiast z pamięci podręcznej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O próximo envio relê todos os %@ tokens por preço cheio, em vez de ler do cache."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次发送将以全价重新读取全部 %@ 个 token，而不是从缓存读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次傳送將以全價重新讀取全部 %@ 個 token，而不是從快取讀取。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Næste afsendelse genlæser alle %@ tokens til fuld pris i stedet for fra cachen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraava lähetys lukee kaikki %@ tokenia uudelleen täydellä hinnalla välimuistin sijaan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Næsta sending les alla %@ tákn upp á nýtt á fullu verði í stað þess að lesa þau úr skyndiminni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste sending leser alle %@ token på nytt til full pris i stedet for fra cachen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nästa meddelande läser om alla %@ token till fullt pris i stället för från cachen."
          }
        }
      }
    },
