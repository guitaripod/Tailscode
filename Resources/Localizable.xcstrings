    "Tailscode drives the coding agent on your computer, over your Tailscale network. Add the machine it runs on to begin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode drives the coding agent on your computer, over your Tailscale network. Add the machine it runs on to begin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode steuert den Coding-Agenten auf deinem Rechner, über dein Tailscale-Netzwerk. Füge den Rechner hinzu, auf dem er läuft, um zu beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode controla el agente de programación de tu equipo a través de tu red de Tailscale. Añade el equipo en el que se ejecuta para empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode pilote l'agent de code de ta machine, via ton réseau Tailscale. Ajoute la machine sur laquelle il tourne pour commencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode controlla l'agente di coding sul tuo computer, attraverso la tua rete Tailscale. Aggiungi il computer su cui gira per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode は、Tailscale ネットワーク越しにあなたのマシン上のコーディングエージェントを操作します。始めるには、エージェントが動いているマシンを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode는 Tailscale 네트워크를 통해 내 컴퓨터의 코딩 에이전트를 제어해요. 시작하려면 에이전트가 실행되는 컴퓨터를 추가해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode steruje agentem kodowania na Twoim komputerze przez Twoją sieć Tailscale. Aby zacząć, dodaj komputer, na którym działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode controla o agente de programação do seu computador pela sua rede Tailscale. Adicione o computador em que ele roda para começar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 通过你的 Tailscale 网络控制你电脑上的编程代理。添加它所在的电脑即可开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 會透過你的 Tailscale 網路控制你電腦上的程式設計代理。新增它所在的電腦即可開始。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode styrer kodeagenten på din computer via dit Tailscale-netværk. Tilføj computeren, agenten kører på, for at komme i gang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ohjaa tietokoneesi koodausagenttia tailnetin kautta. Aloita lisäämällä tietokone, jolla agentti toimii."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode stýrir kóðaagentinn á tölvunni þinni yfir Tailscale-netið þitt. Bættu við tölvunni sem hann keyrir á til að byrja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode styrer agenten på maskinen din, over Tailscale-nettverket ditt. Legg til maskinen den kjører på for å komme i gang."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode styr kodningsagenten på din dator, över ditt Tailscale-nätverk. Lägg till datorn den körs på för att börja."
          }
        }
      }
    },
