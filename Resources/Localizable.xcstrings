            "state": "translated",
            "value": "Pega abajo el ID de cliente y el secreto que te da."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez ci-dessous l’ID client et le secret qu’il vous donne."
          }
        },
        "it": {
