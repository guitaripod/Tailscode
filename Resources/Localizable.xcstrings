          "stringUnit": {
            "state": "translated",
            "value": "%@ は単一キーのみ使用でき、シーケンスは使用できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 단일 키만 사용할 수 있으며, 시퀀스는 사용할 수 없습니다"
