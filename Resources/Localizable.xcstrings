    "%@ The folder has to exist on that machine, not on this one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Der Ordner muss auf jenem Rechner existieren, nicht auf diesem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ The folder has to exist on that machine, not on this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ La carpeta debe existir en esa máquina, no en esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Le dossier doit exister sur cette machine-là, pas sur celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ La cartella deve esistere su quella macchina, non su questa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ そのフォルダは、このマシンではなく相手のマシン上に存在している必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 그 폴더는 이 컴퓨터가 아니라 해당 컴퓨터에 있어야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ A pasta precisa existir naquela máquina, não nesta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 该文件夹必须存在于那台机器上，而不是这台机器上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 該資料夾必須存在於那台機器上，而不是這台機器上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Folder musi istnieć na tamtym komputerze, nie na tym."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mappen skal findes på den computer, ikke på denne."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Kansion on oltava olemassa sillä tietokoneella, ei tällä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mappan þarf að vera til á þeirri tölvu, ekki á þessari."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mappen må finnes på den maskinen, ikke på denne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mappen måste finnas på den datorn, inte på den här."
          }
        }
      }
    },
