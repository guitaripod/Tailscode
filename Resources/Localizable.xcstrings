          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter, når du ringer op, og stopper efter ti minutters inaktivitet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistyy soitettaessa ja pysähtyy kymmenen minuutin toimettomuuden jälkeen"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ræsist þegar þú hringir og stöðvast eftir tíu mínútur án virkni"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
