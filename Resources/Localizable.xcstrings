    "Press the keys you want to summon Tailscode with.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke die Tasten, mit denen du Tailscode aufrufen möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the keys you want to summon Tailscode with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa las teclas con las que quieras invocar Tailscode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur les touches avec lesquelles vous voulez invoquer Tailscode."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi i tasti con cui vuoi richiamare Tailscode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode を呼び出すのに使うキーを押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode를 불러올 때 사용할 키를 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione as teclas com as quais você quer invocar o Tailscode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下你想用来唤出 Tailscode 的按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下你想用來喚出 Tailscode 的按鍵。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij klawisze, którymi chcesz przywoływać Tailscode."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på de taster, du vil bruge til at kalde Tailscode frem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina näppäimiä, joilla haluat kutsua Tailscoden esiin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu á takkana sem þú vilt nota til að kalla fram Tailscode."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på tastene du vil bruke til å kalle frem Tailscode."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på de tangenter du vill använda för att öppna Tailscode."
          }
        }
      }
    },
    "A key with no modifier belongs to whatever you are typing into. A summon has to be a chord no text field can want.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Taste ohne Modifikator gehört dem, wohinein du gerade tippst. Ein Aufruf muss eine Tastenkombination sein, die kein Textfeld für sich beanspruchen könnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A key with no modifier belongs to whatever you are typing into. A summon has to be a chord no text field can want."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tecla sin modificador pertenece a lo que sea que estés escribiendo. Una invocación debe ser una combinación que ningún campo de texto pueda querer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une touche sans modificateur appartient à ce dans quoi vous êtes en train de saisir du texte. Une invocation doit être une combinaison qu’aucun champ de texte ne pourrait vouloir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tasto senza modificatore appartiene a qualunque cosa tu stia digitando. Un richiamo deve essere una combinazione che nessun campo di testo potrebbe volere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーのない単独のキーは、入力中の場所に奪われてしまいます。呼び出しには、どんなテキストフィールドも欲しがらないキーの組み合わせが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조키가 없는 키는 지금 입력 중인 곳이 가로챕니다. 불러오기는 어떤 텍스트 필드도 원하지 않을 조합이어야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tecla sem modificador pertence a onde quer que você esteja digitando. Uma invocação precisa ser uma combinação que nenhum campo de texto possa querer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有修饰键的按键会被你正在输入的地方占用。用来唤出的组合键必须是任何文本框都不会需要的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有修飾鍵的按鍵會被你正在輸入的地方占用。用來喚出的組合鍵必須是任何文字欄位都不會需要的。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klawisz bez modyfikatora należy do tego, w co akurat piszesz. Przywołanie musi być taką kombinacją, której nie zechce żadne pole tekstowe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En tast uden modifikator tilhører det, du skriver i. Et kald skal være en tastekombination, som intet tekstfelt kan gøre krav på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelkkä näppäin kuuluu siihen, mihin kirjoitat parhaillaan. Kutsun täytyy olla näppäinyhdistelmä, jota mikään tekstikenttä ei voi vaatia itselleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Takki án breytilykils tilheyrir því sem þú ert að skrifa í. Kallið þarf að vera samsetning sem enginn textareitur getur viljað."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En tast uten modifikator tilhører det du skriver i. Et kall må være en tastekombinasjon som ingen tekstfelt kan ønske seg."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tangent utan modifierare hör till det du skriver i. Öppningen måste vara en tangentkombination som inget textfält vill ha."
          }
        }
      }
    },
    "A bare function key still reaches the app in front of you in some programs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine einzelne Funktionstaste erreicht in manchen Programmen trotzdem die App, die gerade im Vordergrund ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bare function key still reaches the app in front of you in some programs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tecla de función sola sigue llegando, en algunos programas, a la app que tienes delante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une simple touche de fonction atteint tout de même, dans certains programmes, l’app au premier plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tasto funzione da solo, in alcuni programmi, raggiunge comunque l’app in primo piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単独のファンクションキーでも、一部のプログラムでは手前にあるアプリに届いてしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단독 기능 키도 일부 프로그램에서는 앞에 있는 앱으로 전달됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tecla de função sozinha ainda chega ao app em primeiro plano em alguns programas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在某些程序中，单独按下功能键仍会传到最前面的那个应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在某些程式中，單獨按下功能鍵仍會傳到最前面的那個應用程式。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sam klawisz funkcyjny w niektórych programach nadal trafia do aplikacji na pierwszym planie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En enkelt funktionstast når i nogle programmer stadig den app, der er forrest."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelkkä toimintonäppäin osuu joissakin ohjelmissa silti edessä olevaan sovellukseen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Stakur F-takki nær samt í sumum forritum til forritsins sem er fremst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I noen programmer når en enkelt funksjonstast likevel fram til appen foran deg."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ensam funktionstangent når ändå appen framför dig i vissa program."
          }
        }
      }
    },
    "Shift and an arrow extends the selection by word in every editor, terminal and text field on this machine. Taking it would break the gesture you use right before you want to ask something.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umschalt und ein Pfeil erweitert die Auswahl wortweise in jedem Editor, Terminal und Textfeld auf diesem Rechner. Würde man das belegen, wäre genau die Geste kaputt, die du kurz bevor du etwas fragen willst benutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift and an arrow extends the selection by word in every editor, terminal and text field on this machine. Taking it would break the gesture you use right before you want to ask something."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mayús y una flecha amplía la selección palabra a palabra en todos los editores, terminales y campos de texto de esta máquina. Ocuparla rompería justo el gesto que usas justo antes de querer preguntar algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Majuscule et une flèche étend la sélection mot par mot dans chaque éditeur, terminal et champ de texte sur cette machine. La récupérer casserait justement le geste que vous utilisez juste avant de vouloir poser une question."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Maiusc e una freccia estende la selezione parola per parola in ogni editor, terminale e campo di testo su questa macchina. Occuparla romperebbe proprio il gesto che usi appena prima di voler chiedere qualcosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift と矢印キーは、このマシン上のあらゆるエディタ・ターミナル・テキストフィールドで単語単位に選択範囲を広げます。これを奪うと、何かを尋ねようとする直前に使うそのジェスチャーが壊れてしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift와 화살표 키는 이 컴퓨터의 모든 편집기, 터미널, 텍스트 필드에서 선택 영역을 단어 단위로 넓힙니다. 이 조합을 가져가면 무언가 물어보기 직전에 쓰는 바로 그 동작이 망가집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift e uma seta estendem a seleção palavra por palavra em todo editor, terminal e campo de texto nesta máquina. Usar essa combinação quebraria justamente o gesto que você faz pouco antes de querer perguntar algo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 加方向键，会在这台机器上的每个编辑器、终端和文本框里按单词扩展选区。占用它会破坏你在提问前那一刻正要用的手势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift 加方向鍵，會在這台機器上的每個編輯器、終端機和文字欄位裡按單詞展開選取範圍。佔用它會破壞你在提問前那一刻正要用的手勢。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift ze strzałką rozszerza zaznaczenie o słowo w każdym edytorze, terminalu i polu tekstowym na tym komputerze. Przejęcie go zepsułoby właśnie ten gest, którego używasz tuż przed tym, jak chcesz o coś zapytać."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift og en piletast udvider markeringen ord for ord i alle editorer, terminaler og tekstfelter på denne computer. Hvis man tog den, ville man ødelægge den gestus, du bruger lige før du vil stille et spørgsmål."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihto ja nuoli laajentavat valintaa sana kerrallaan jokaisessa editorissa, päätteessä ja tekstikentässä tällä tietokoneella. Jos varaisit sen, katkeaisi ele, jota käytät juuri ennen kuin haluat kysyä jotain."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift og ör færir valið um eitt orð í öllum ritlum, Terminal-gluggum og textareitum á þessari tölvu. Ef það væri tekið frá myndi brotna bendingin sem þú notar rétt áður en þú vilt spyrja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift og en piltast utvider markeringen ord for ord i alle editorer, terminaler og tekstfelt på denne maskinen. Å ta den ville ødelagt bevegelsen du bruker rett før du vil stille et spørsmål."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift och en pil utökar markeringen ord för ord i varje redigerare, terminal och textfält på den här datorn. Om den togs skulle gesten du använder precis innan du vill ställa en fråga gå sönder."
          }
        }
      }
    },
    "An arrow moves the caret or the workspace on every desktop. Taking it machine-wide breaks either one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Pfeil bewegt auf jedem Desktop entweder den Cursor oder den Arbeitsbereich. Belegt man ihn systemweit, geht eines von beidem kaputt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An arrow moves the caret or the workspace on every desktop. Taking it machine-wide breaks either one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una flecha mueve el cursor o el espacio de trabajo en todos los entornos de escritorio. Ocuparla en toda la máquina rompe uno de los dos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une flèche déplace le curseur ou l’espace de travail sur chaque bureau. La récupérer à l’échelle de la machine casse l’un des deux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una freccia sposta il cursore o lo spazio di lavoro su ogni desktop. Occuparla a livello di tutta la macchina rompe l’uno o l’altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印キーは、どのデスクトップでもカーソルかワークスペースのどちらかを動かします。マシン全体で奪ってしまうと、そのどちらかが壊れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화살표 키는 모든 데스크톱에서 커서나 작업 공간 중 하나를 이동시킵니다. 컴퓨터 전체에서 이 키를 가져가면 둘 중 하나가 망가집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma seta move o cursor ou a área de trabalho em todo desktop. Usá-la em toda a máquina quebra um dos dois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方向键在每种桌面环境里都会移动光标或工作区。如果在整台机器上占用它，两者中总有一个会失灵。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方向鍵在每種桌面環境裡都會移動游標或工作區。如果在整台機器上佔用它，兩者中總有一個會失靈。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strzałka porusza kursorem albo obszarem roboczym na każdym pulpicie. Przejęcie jej w całym systemie zepsuje jedno albo drugie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En piletast flytter enten markøren eller arbejdsområdet på hvert skrivebord. Tager man den for hele maskinen, går den ene af disse ting i stykker."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuoli siirtää kursoria tai työtilaa jokaisella työpöydällä. Jos varaat sen koko tietokoneelle, jompikumpi niistä hajoaa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ör færir bendilinn eða vinnusvæðið á hverju skjáborði. Ef örvarnar eru teknar frá fyrir alla tölvuna brotnar annað hvort."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En piltast flytter markøren eller arbeidsområdet på hvert skrivebord. Å ta den på maskinnivå ødelegger begge deler."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En pil flyttar markören eller arbetsytan på varje skrivbord. Om den togs för hela datorn går något av dem sönder."
          }
        }
      }
    },
    "Tab with a modifier belongs to the window and tab switchers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab mit einem Modifikator gehört den Fenster- und Tab-Umschaltern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab with a modifier belongs to the window and tab switchers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab con un modificador pertenece a los selectores de ventanas y pestañas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab avec un modificateur appartient aux sélecteurs de fenêtres et d’onglets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab con un modificatore appartiene ai selettori di finestre e schede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キー付きの Tab は、ウインドウ切り替えやタブ切り替えのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조키와 함께 쓰는 Tab은 창 전환기와 탭 전환기의 몫입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab com um modificador pertence aos alternadores de janelas e abas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带修饰键的 Tab 属于窗口切换器和标签页切换器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帶修飾鍵的 Tab 屬於視窗切換器和分頁切換器。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab z modyfikatorem należy do przełączników okien i kart."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab med en modifikator hører til vindues- og fanevælgerne."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarkain muokkaimen kanssa kuuluu ikkunoiden ja välilehtien vaihtajille."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab með breytilykli tilheyrir glugga- og flipaskiptunum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab med en modifikator tilhører vindus- og fanevekslerne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab med en modifierare hör till växlarna för fönster och flikar."
          }
        }
      }
    },
    "%@ is an editing shortcut in every app on this machine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist in jeder App auf diesem Rechner ein Bearbeitungs-Shortcut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is an editing shortcut in every app on this machine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es un atajo de edición en todas las apps de esta máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est un raccourci d’édition dans toutes les apps de cette machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è una scorciatoia di modifica in ogni app su questa macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は、このマシン上のあらゆるアプリで編集用のショートカットです。"
          }
        },
        "ko": {
