    "Giving containers the GPU needs administrator rights, so this one is yours to run in a shell on the machine.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Giving containers the GPU needs administrator rights, so this one is yours to run in a shell on the machine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den GPU-Zugriff von Containern sind Administratorrechte nötig. Dieser Schritt wird daher in einer Shell auf dem Rechner ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar a los contenedores acceso a la GPU requiere permisos de administrador, así que este paso se ejecuta en una shell de la máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donner accès au GPU aux conteneurs nécessite des droits d'administrateur : cette étape se lance donc dans un terminal sur la machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dare ai container accesso alla GPU richiede i diritti di amministratore, quindi questo passaggio va eseguito in una shell sulla macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテナに GPU を使わせるには管理者権限が必要なため、マシン上のシェルで実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨테이너에 GPU를 연결하려면 관리자 권한이 필요해서, 이 작업은 컴퓨터의 셸에서 직접 실행해야 해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnienie GPU kontenerom wymaga uprawnień administratora, więc uruchom to w powłoce na tym komputerze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dar à GPU acesso aos contêineres exige direitos de administrador, então execute isto em um shell na máquina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让容器使用 GPU 需要管理员权限，因此请在机器上的 shell 中运行此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓容器使用 GPU 需要管理員權限，因此請在機器上的 shell 中執行此操作。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At lade containere bruge GPU'en kræver administratorrettigheder, så dette trin skal du selv køre i en shell på computeren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU:n antaminen konteille vaatii ylläpitäjän oikeudet, joten suorita tämä itse tietokoneen komentorivillä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Til að ílát fái aðgang að GPU þarf stjórnandaréttindi, svo þetta skref þarftu að keyra sjálfur í skel á tölvunni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å gi containere tilgang til GPU-en krever administratorrettigheter, så dette må du kjøre selv i et skall på maskinen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att ge containrar tillgång till GPU:n kräver administratörsrättigheter, så det här steget kör du själv i Terminal på datorn."
          }
        }
      }
    },
