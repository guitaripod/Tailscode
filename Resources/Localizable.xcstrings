          }
        }
      }
    },
    "Held — the last send didn't go. It goes when the server answers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angehalten — der letzte Versand ist nicht durchgegangen. Er geht raus, sobald der Server antwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held — the last send didn't go. It goes when the server answers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En espera — el último envío no se realizó. Se enviará cuando el servidor responda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente — le dernier envoi n’est pas parti. Il partira quand le serveur répondra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In sospeso — l’ultimo invio non è andato a buon fine. Partirà quando il server risponde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中 — 直前の送信は完了していません。サーバが応答すると送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류됨 — 마지막 전송이 실패했습니다. 서버가 응답하면 전송됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em espera — o último envio não foi concluído. Ele será enviado quando o servidor responder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留 — 上一次发送没有成功。等服务器回应后就会发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留 — 上一次傳送沒有成功。等伺服器回應後就會傳送。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane — ostatnia wiadomość nie została wysłana. Zostanie wysłana, gdy serwer odpowie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilbageholdt – den sidste afsendelse gik ikke igennem. Den sendes, når serveren svarer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidossa: viimeisin lähetys ei onnistunut. Se lähtee, kun palvelin vastaa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í bið – síðasta sending fór ekki í gegn. Hún fer þegar netþjónninn svarar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Holdt tilbake: siste sending gikk ikke gjennom. Den sendes når serveren svarer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausad – den senaste skickningen gick inte igenom. Den skickas när servern svarar."
          }
        }
      }
    },
