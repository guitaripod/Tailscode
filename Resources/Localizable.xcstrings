    "⚠ Claude is signed out on %@ — every turn will refuse until it signs in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude ist auf %@ abgemeldet — jeder Zug wird verweigert, bis es sich anmeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude is signed out on %@ — every turn will refuse until it signs in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude está desconectado en %@: todos los turnos se rechazarán hasta que inicie sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude est déconnecté sur %@ — chaque tour sera refusé tant qu’il ne se sera pas connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude è disconnesso su %@ — ogni turno verrà rifiutato finché non avrà eseguito l’accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ で Claude がサインアウトしています — サインインするまで、すべてのターンが拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@에서 Claude가 로그아웃되어 있습니다 — 로그인하기 전까지는 모든 턴이 거부됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ O Claude está desconectado em %@ — todo turno vai ser recusado até que ele entre na conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ 上的 Claude 已登出 — 在它登录之前，每个回合都会被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ %@ 上的 Claude 已登出 — 在它登入之前，每個回合都會被拒絕。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude jest wylogowany na %@ — każda tura będzie odrzucana, dopóki się nie zaloguje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude er logget ud på %@ – hver tur afvises, indtil den logger ind."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude on kirjautunut ulos tietokoneella %@ – jokainen vuoro hylätään, kunnes se kirjautuu sisään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Ekki er skráð inn í Claude á %@ – hver umferð verður hafnað þar til innskráning fer fram."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude er logget av på %@ – hver tur blir avvist til den logger på."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude är utloggad på %@ – varje tur nekas tills den loggar in."
          }
        }
      }
    },
