    "Off — new versions wait for you.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus – neue Versionen warten auf Sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off — new versions wait for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: las versiones nuevas esperan a que tú decidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé — les nouvelles versions attendent votre accord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: le nuove versioni aspettano te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ — 新しいバージョンはあなたの操作を待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼짐 — 새 버전은 사용자의 조작을 기다립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado — as novas versões esperam por você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭——新版本会等待你来处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉——新版本會等待你來處理。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączone — nowe wersje czekają na ciebie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra – nye versioner venter på dig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pois – uudet versiot odottavat sinua."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Slökkt – nýjar útgáfur bíða eftir þér."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Av – nye versjoner venter på deg."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Av – nya versioner väntar på dig."
          }
        }
      }
    },
    "Older rows wait behind one button — this keeps a huge chat fast": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere Zeilen warten hinter einem Button — das hält einen riesigen Chat schnell"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older rows wait behind one button — this keeps a huge chat fast"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las filas antiguas esperan tras un botón: así un chat enorme sigue siendo rápido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes plus anciennes attendent derrière un seul bouton — cela garde une discussion énorme rapide"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le righe più vecchie aspettano dietro un solo pulsante — questo mantiene veloce una chat enorme"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それより古い行は1つのボタンの奥にまとめられます — これで巨大なチャットも高速に保てます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 오래된 행은 버튼 하나 뒤에 숨겨집니다 — 이렇게 하면 아주 긴 대화도 빠르게 유지됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linhas mais antigas esperam atrás de um botão — isso mantém uma conversa enorme rápida"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更早的行会收在一个按钮背后 — 这样即使对话很长也能保持流畅"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更早的行會收在一個按鈕背後 — 這樣即使對話很長也能保持流暢"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starsze wiersze czekają za jednym przyciskiem — dzięki temu ogromna rozmowa działa szybko"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ældre rækker venter bag én knap – det holder en enorm samtale hurtig"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanhemmat rivit odottavat yhden painikkeen takana – näin valtava keskustelu pysyy nopeana"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eldri línur bíða á bak við einn hnapp – þannig helst gríðarstórt spjall hratt"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eldre rader venter bak én knapp – dette holder en stor chat rask"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Äldre rader väntar bakom en knapp – det här håller en stor chatt snabb"
          }
        }
      }
    },
    "Ollama models served by ollama.com are metered by your plan — a session window and a weekly one. Paste the account's API key here and the plan's windows join the usage meters. Models on your own ollama server are unlimited and never wear this.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama-Modelle, die von ollama.com bereitgestellt werden, werden nach deinem Tarif gemessen — ein Sitzungsfenster und ein wöchentliches. Füge hier den API-Schlüssel des Kontos ein, und die Fenster des Tarifs werden Teil der Nutzungsanzeigen. Modelle auf deinem eigenen Ollama-Server sind unbegrenzt und tragen das nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama models served by ollama.com are metered by your plan — a session window and a weekly one. Paste the account's API key here and the plan's windows join the usage meters. Models on your own ollama server are unlimited and never wear this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos de Ollama que sirve ollama.com se miden según tu plan: una ventana de sesión y otra semanal. Pega aquí la clave de API de la cuenta y las ventanas del plan se unirán a los medidores de uso. Los modelos de tu propio servidor ollama son ilimitados y nunca afectan a esto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles Ollama servis par ollama.com sont mesurés selon votre forfait — une fenêtre de session et une hebdomadaire. Collez ici la clé API du compte, et les fenêtres du forfait rejoignent les jauges d’usage. Les modèles sur votre propre serveur ollama sont illimités et ne portent jamais cela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli Ollama serviti da ollama.com sono misurati in base al tuo piano — una finestra di sessione e una settimanale. Incolla qui la chiave API dell’account e le finestre del piano si uniranno agli indicatori di utilizzo. I modelli sul tuo server ollama personale sono illimitati e non lo mostrano mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ollama.com が提供する Ollama モデルは、あなたのプランによって計測されます — セッション単位の枠と週単位の枠です。アカウントの API キーをここに貼り付けると、プランの枠が使用量メーターに加わります。あなた自身の ollama サーバ上のモデルは無制限で、これには影響されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ollama.com이 제공하는 Ollama 모델은 당신의 요금제로 계량됩니다 — 세션 단위 구간과 주간 구간입니다. 계정의 API 키를 여기에 붙여넣으면 요금제의 구간이 사용량 게이지에 합류합니다. 당신 자신의 ollama 서버에 있는 모델은 무제한이며 이 영향을 전혀 받지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos do Ollama disponibilizados pelo ollama.com são medidos pelo seu plano — uma janela de sessão e uma semanal. Cole aqui a chave de API da conta e as janelas do plano se juntam aos medidores de uso. Os modelos no seu próprio servidor ollama são ilimitados e nunca contam para isso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ollama.com 提供的 Ollama 模型按你的套餐计量 — 一个会话周期和一个每周周期。把账户的 API 密钥粘贴到这里，套餐的周期就会并入用量表。你自己 ollama 服务器上的模型不受限制，也永远不会受此影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ollama.com 提供的 Ollama 模型按你的方案計量 — 一個工作階段週期和一個每週週期。把帳戶的 API 金鑰貼到這裡，方案的週期就會併入用量表。你自己 ollama 伺服器上的模型不受限制，也永遠不會受此影響。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modele Ollama udostępniane przez ollama.com są mierzone według twojego planu — okno sesji i okno tygodniowe. Wklej tu klucz API konta, a okna planu dołączą do wskaźników użycia. Modele na twoim własnym serwerze ollama są nieograniczone i nigdy ich to nie dotyczy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama-modeller fra ollama.com måles af din pakke – et sessionsvindue og et ugentligt vindue. Indsæt kontoens API-nøgle her, så pakkens vinduer kommer med i forbrugsmålerne. Modeller på din egen ollama-server er ubegrænsede og får aldrig dette."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama-mallit, joita ollama.com tarjoaa, mitataan paketisi mukaan: yksi istuntoikkuna ja yksi viikkoikkuna. Liitä tähän tilin API-avain, niin paketin ikkunat liittyvät käyttömittareihin. Omalla ollama-palvelimellasi olevat mallit ovat rajoittamattomia eivätkä kuulu tähän rajoitukseen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama-líkön frá ollama.com eru mæld eftir pakkanum þínum – setu-gluggi og vikulegur gluggi. Límdu API-lykil reikningsins hér og gluggar pakkans bætast við notkunarmælana. Líkön á þínum eigin Ollama-netþjóni eru ótakmörkuð og fá aldrei þessa mælingu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama-modeller fra ollama.com måles etter pakken din – et øktvindu og et ukevindu. Lim inn kontoens API-nøkkel her, så blir pakkens vinduer en del av bruksmålerne. Modeller på din egen ollama-server er ubegrenset og blir aldri målt på denne måten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama-modeller som serveras av ollama.com mäts mot ditt paket – ett sessionsfönster och ett veckofönster. Klistra in kontots API-nyckel här så räknas paketets fönster in i användningsmätarna. Modeller på din egen ollama-server är obegränsade och påverkas aldrig av detta."
          }
        }
      }
    },
