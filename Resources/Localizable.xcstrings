        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta GPU serwera jest zajęta innym połączeniem. Spróbuj ponownie, gdy się zakończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A GPU do servidor está ocupada com outra chamada. Tente de novo quando ela terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器的 GPU 正忙于另一通通话。请等它结束后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器的 GPU 正忙於另一通通話。請等它結束後再試。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverens GPU er optaget af et andet opkald. Prøv igen, når det er afsluttet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelimen GPU on toisen puhelun käytössä. Yritä uudelleen, kun se päättyy."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU netþjónsins er upptekið í öðru símtali. Reyndu aftur þegar það lýkur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverens GPU er opptatt med et annet anrop. Prøv igjen når det er avsluttet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverns GPU är upptagen av ett annat samtal. Försök igen när det är slut."
          }
        }
      }
    },
    "The voice began repeating itself, so it was stopped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice began repeating itself, so it was stopped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stimme hat sich zu wiederholen begonnen und wurde deshalb gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz empezó a repetirse, así que se detuvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix s'est mise à se répéter, elle a donc été arrêtée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La voce ha iniziato a ripetersi, quindi è stata interrotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声が繰り返し始めたため、停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성이 같은 말을 반복하기 시작해서 중지했어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głos zaczął się powtarzać, więc go zatrzymano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz começou a se repetir, então foi interrompida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音开始重复内容，因此已停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音開始重複內容，因此已停止。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmen begyndte at gentage sig selv, så den blev stoppet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ääni alkoi toistaa itseään, joten se pysäytettiin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Röddin fór að endurtaka sig, svo henni var hætt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmen begynte å gjenta seg selv, så den ble stoppet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rösten började upprepa sig, så den stoppades."
          }
        }
      }
    },
    "The voice gateway asks for a password. Add it for this server.": {
