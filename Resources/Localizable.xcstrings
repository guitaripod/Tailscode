          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem para editar: escolha um arquivo, cole ou pegue uma da prateleira da máquina"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要编辑的图片：选择文件、粘贴，或从机器的图库中选取"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要編輯的圖片：選擇檔案、貼上，或從機器的圖庫中選取"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et billede at redigere: vælg en fil, indsæt eller tag et fra maskinens hylde"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muokattava kuva: valitse tiedosto, liitä tai ota yksi koneen hyllyltä"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Mynd til að breyta: veldu skrá, límdu hana inn eða taktu eina úr hillu tölvunnar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et bilde å redigere: velg en fil, lim inn, eller ta ett fra maskinens hylle"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En bild att redigera: välj en fil, klistra in eller ta en från datorns hylla"
          }
        }
      }
    },
