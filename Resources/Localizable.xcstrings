    "Starts when you call and stops after ten idle minutes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts when you call and stops after ten idle minutes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet beim Anruf und stoppt nach zehn Minuten Leerlauf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se inicia al llamar y se detiene tras diez minutos de inactividad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre à l'appel et s'arrête après dix minutes d'inactivité"
