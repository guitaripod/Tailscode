    "Only while the app is not in front. When it’s done waits until the agent and everything it started have stopped: one piece of work, one notification.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only while the app is not in front. When it’s done waits until the agent and everything it started have stopped: one piece of work, one notification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur, wenn die App nicht im Vordergrund ist. „Bei Abschluss“ wartet, bis der Agent und alles, was er gestartet hat, beendet ist: eine Arbeit, eine Benachrichtigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo mientras la app no está en primer plano. «Al terminar» espera a que el agente y todo lo que inició se hayan detenido: un trabajo, una notificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement lorsque l’app n’est pas au premier plan. « Une fois terminé » attend que l’agent et tout ce qu’il a lancé soient arrêtés : un travail, une notification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo mentre l’app non è in primo piano. «Al termine» attende che l’agente e tutto ciò che ha avviato si siano fermati: un lavoro, una notifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが前面にないときだけ通知します。「完了時」は、エージェントとそれが開始したすべての処理が停止するまで待ちます。作業1つにつき通知は1回です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 전면에 없을 때만 알립니다. \"완료되면\"은 에이전트와 에이전트가 시작한 모든 작업이 멈출 때까지 기다립니다. 작업 하나에 알림 하나입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko gdy aplikacja nie jest na pierwszym planie. „Po zakończeniu” czeka, aż agent i wszystko, co uruchomił, się zatrzyma: jedna praca, jedno powiadomienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente enquanto o app não está em primeiro plano. “Ao concluir” espera até o agente e tudo o que ele iniciou terem parado: um trabalho, uma notificação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 App 不在前台时。“完成时”会等待智能体及其启动的所有工作都停止：一项工作，一条通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在 App 不在前景時。「完成時」會等待代理及其啟動的所有工作都停止：一項工作，一則通知。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun når appen ikke er forrest. »Når det er færdigt« venter, til agenten og alt, den har startet, er stoppet: ét stykke arbejde, én notifikation."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain kun sovellus ei ole etualalla. ”Kun työ on valmis” odottaa, kunnes agentti ja kaikki, mitä se käynnisti, ovat pysähtyneet: yksi työ, yksi ilmoitus."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins meðan appið er ekki í forgrunni. „Þegar lokið“ bíður þar til agentinn og allt sem hann ræsti hefur stöðvast: eitt verk, ein tilkynning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare når appen ikke er i forgrunnen. «Ved fullføring» venter til agenten og alt den har startet er stoppet: ett arbeid, ett varsel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara när appen inte är i förgrunden. När det är klart väntar den tills agenten och allt den startat har stoppats: ett arbete, en notis."
          }
        }
      }
    },
    "Quick answers end quietly. A failure always says so.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick answers end quietly. A failure always says so."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnelle Antworten enden still. Ein Fehler wird immer gemeldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas rápidas terminan en silencio. Un fallo siempre se anuncia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses rapides se terminent silencieusement. Un échec est toujours signalé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte rapide si chiudono in silenzio. Un errore viene sempre segnalato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに終わる回答は静かに終わります。失敗は必ず通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 답변은 조용히 끝납니다. 실패는 항상 알려드립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybkie odpowiedzi kończą się po cichu. Błąd zawsze jest sygnalizowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respostas rápidas terminam em silêncio. Uma falha sempre é avisada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速回答静默结束。失败时始终提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
