    "Its verifier passed. Nothing is in your tree until you apply it.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dens verifikator bestod. Intet er i din arbejdskatalog, før du anvender den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verifizierer hat bestanden. Im Arbeitsverzeichnis landet nichts, bevor du es anwendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its verifier passed. Nothing is in your tree until you apply it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su verificador lo aprobó. Nada llega a tu árbol de trabajo hasta que lo apliques."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkistaja hyväksyi sen. Mikään ei päädy työhakemistoosi, ennen kuin käytät sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son vérificateur a réussi. Rien n’arrive dans votre arbre de travail tant que vous ne l’appliquez pas."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sannprófarinn stóðst. Ekkert fer í vinnumöppuna fyrr en þú beitir því."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo verificatore ha dato esito positivo. Nulla arriva nel tuo albero di lavoro finché non lo applichi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証に合格しました。適用するまで、作業ツリーには何も入りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증을 통과했습니다. 적용하기 전에는 작업 트리에 아무것도 들어가지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollen bestod. Ingenting havner i arbeidskatalogen din før du bruker den."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego weryfikator zaliczył. Nic nie trafi do twojego drzewa roboczego, dopóki tego nie zastosujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O verificador aprovou. Nada entra na sua árvore de trabalho até você aplicar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dess verifierare godkändes. Inget hamnar i din arbetskatalog förrän du tillämpar den."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证已通过。在你应用之前，工作树里不会有任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證已通過。在你套用之前，工作樹裡不會有任何內容。"
          }
        }
      }
    },
