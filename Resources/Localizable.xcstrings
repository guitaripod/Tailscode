    "There are no saved credentials for %@, so nothing here could ask it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ sind keine Zugangsdaten gespeichert, daher kann hier nichts angefragt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no saved credentials for %@, so nothing here could ask it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay credenciales guardadas para %@, así que no hay forma de contactarlo desde aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun identifiant enregistré pour %@, donc rien ici ne peut le solliciter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono credenziali salvate per %@, quindi da qui non è possibile contattarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の保存済み認証情報がないため、ここから問い合わせることができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 대한 저장된 자격 증명이 없어, 여기서는 요청할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há credenciais salvas para %@, então nada aqui pode perguntar a ele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有保存 %@ 的凭据，因此这里无法向它发起请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有儲存 %@ 的憑證，因此這裡無法向它發出請求。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma zapisanych danych logowania dla %@, więc nic tutaj nie mogło o nie zapytać."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen gemte loginoplysninger til %@, så intet her kan spørge den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohteelle %@ ei ole tallennettuja tunnuksia, joten täältä ei voi pyytää niitä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engin vistuð innskráningargögn eru fyrir %@, svo ekki er hægt að spyrja hann um neitt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes ingen lagrede innloggingsopplysninger for %@, så ingenting her kan spørre den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inga sparade inloggningsuppgifter för %@, så ingenting här kan fråga den."
          }
        }
      }
    },
