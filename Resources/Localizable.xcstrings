    "Microphone access is off for Tailscode. Turn it on in Settings and the mic beside Send will listen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is off for Tailscode. Turn it on in Settings and the mic beside Send will listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonzugriff ist für Tailscode aus. Schalte ihn in den Einstellungen ein, dann hört das Mikrofon neben Senden zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al micrófono está desactivado para Tailscode. Actívalo en Ajustes y el micrófono junto a Enviar escuchará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au micro est désactivé pour Tailscode. Activez-le dans Réglages et le micro à côté d'Envoyer écoutera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al microfono è disattivato per Tailscode. Attivalo in Impostazioni e il microfono accanto a Invia ascolterà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode のマイクへのアクセスがオフです。「設定」でオンにすると、送信ボタンの横のマイクで聞き取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode의 마이크 접근이 꺼져 있습니다. 설정에서 켜면 보내기 옆 마이크가 듣습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do mikrofonu jest wyłączony dla Tailscode. Włącz go w Ustawieniach, a mikrofon obok Wyślij zacznie słuchać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone está desativado para o Tailscode. Ative-o em Ajustes e o microfone ao lado de Enviar vai ouvir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 的麦克风权限已关闭。请在“设置”中打开，之后发送旁的麦克风即可聆听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 的麥克風存取已關閉。請在「設定」中開啟，傳送旁的麥克風即可聆聽。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonadgang er slået fra for Tailscode. Slå den til i Indstillinger, så lytter mikrofonen ved siden af Send."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscoden mikrofonin käyttöoikeus on pois päältä. Ota se käyttöön asetuksissa, niin Lähetä-painikkeen vieressä oleva mikrofoni kuuntelee."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðgangur að hljóðnema er slökktur fyrir Tailscode. Kveiktu á honum í Stillingum og hljóðneminn við hliðina á „Senda“ hlustar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofontilgang er av for Tailscode. Slå den på i Innstillinger, så lytter mikrofonen ved siden av Send."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonåtkomst är avstängd för Tailscode. Slå på den i Inställningar så lyssnar mikrofonen bredvid Skicka."
          }
        }
      }
    },
    "No microphone answers": {
