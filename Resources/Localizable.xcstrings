    "Describe a picture below, or press and hold one on the shelf to start from it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe unten ein Bild, oder halte eines im Regal gedrückt, um damit zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe a picture below, or press and hold one on the shelf to start from it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe una imagen abajo, o mantén pulsada una en la estantería para partir de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez une image ci-dessous, ou appuyez de manière prolongée sur une image de l’étagère pour en repartir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi un’immagine qui sotto, oppure tieni premuta una sullo scaffale per partire da quella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下に絵を説明するか、棚にある画像を長押ししてそこから始めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에 그림을 설명하거나, 선반에 있는 사진을 길게 눌러 그것부터 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva uma imagem abaixo, ou toque e segure uma na prateleira para partir dela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方描述一幅画面，或者按住架子上的一张图片以从它开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方描述一幅畫面，或按住架子上的一張圖片以從它開始。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz obraz poniżej albo naciśnij i przytrzymaj jeden z półki, żeby zacząć od niego."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv et billede nedenfor, eller tryk længe på et billede på hylden for at starte derfra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvaile kuva alla tai paina hyllyltä pitkään yhtä kuvaa aloittaaksesi siitä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lýstu mynd hér að neðan, eða haltu einni inni í hillunni til að byrja út frá henni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv et bilde nedenfor, eller trykk og hold et i hyllen for å starte fra det."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv en bild nedan, eller tryck länge på en i hyllan för att börja där."
          }
        }
      }
    },
    "Describe a picture below. It is painted on the machine with the card.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe unten ein Bild. Es wird auf dem Rechner mit der Grafikkarte gemalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe a picture below. It is painted on the machine with the card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe una imagen abajo. Se pinta en la máquina con la tarjeta gráfica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez une image ci-dessous. Elle est peinte sur la machine avec la carte graphique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi un’immagine qui sotto. Viene dipinta sulla macchina con la scheda video."
