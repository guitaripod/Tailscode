    "Voice calls are not set up on this server yet. Press Call and the checklist shows where to start.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice calls are not set up on this server yet. Press Call and the checklist shows where to start."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachanrufe sind auf diesem Server noch nicht eingerichtet. Auf „Anrufen“ tippen, dann zeigt die Checkliste, wo es losgeht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas de voz aún no están configuradas en este servidor. Pulsa Llamar y la lista de tareas muestra por dónde empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels vocaux ne sont pas encore configurés sur ce serveur. Appuyez sur Appeler : la liste indique par où commencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiamate vocali non sono ancora configurate su questo server. Tocca Chiama e la lista mostra da dove iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーでは音声通話がまだセットアップされていません。「通話」を押すと、チェックリストで開始方法を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버에는 음성 통화가 아직 설정되지 않았어요. ‘통화’를 누르면 체크리스트에서 시작할 곳을 보여 줘요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenia głosowe nie są jeszcze skonfigurowane na tym serwerze. Naciśnij Połącz, a lista kontrolna pokaże, od czego zacząć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas de voz ainda não estão configuradas neste servidor. Toque em Ligar e a lista mostra por onde começar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器尚未设置语音通话。点按“通话”，清单会显示从何开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器尚未設定語音通話。點按「通話」，清單會顯示從何開始。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmeopkald er endnu ikke opsat på denne server. Tryk på »Ring op«, så viser tjeklisten, hvor du skal starte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Äänipuheluja ei ole vielä otettu käyttöön tällä palvelimella. Paina Soita, niin tarkistuslista näyttää, mistä aloitetaan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Raddsímtöl eru ekki sett upp á þessum netþjóni enn. Ýttu á „Hringja“ og gátlistinn sýnir hvar á að byrja."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmeanrop er ikke satt opp på denne serveren ennå. Trykk på «Ring», så viser sjekklisten hvor du skal begynne."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Röstsamtal är inte konfigurerade på den här servern än. Tryck på Ring, så visar checklistan var du ska börja."
          }
        }
      }
    },
