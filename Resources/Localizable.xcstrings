          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Delegate og mere end én Live Activity ad gangen er igen en del af Tailscode Pro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Delegate ja useampi samanaikainen Live Activity kuuluvat taas Tailscode Pro -versioon."
          }
        },
        "is": {
          "stringUnit": {
