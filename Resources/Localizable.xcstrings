    "No ping, not unread. Failures always speak.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No ping, not unread. Failures always speak."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Ping, keine Ungelesen-Markierung. Fehler melden sich immer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin aviso ni marca de no leído. Los fallos siempre avisan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de notification, pas de non-lu. Les échecs se signalent toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun avviso, nessun non letto. I guasti si fanno sempre sentire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知も未読マークもなし。失敗は必ず知らせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림도 안 읽음 표시도 없습니다. 실패는 항상 알려 줍니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez powiadomienia i bez oznaczenia jako nieprzeczytane. Błędy zawsze dają znać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem aviso, sem marca de não lido. Falhas sempre avisam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不发提醒，也不标为未读。失败总会提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不發提醒，也不標為未讀。失敗一定會提示。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen ping, ikke ulæst. Fejl melder sig altid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei ilmoitusta eikä lukemattomuusmerkkiä. Virheistä ilmoitetaan aina."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki ping og ekki ólesið. Villur láta alltaf vita af sér."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen ping, ikke ulest. Feil gir alltid beskjed."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen ping, inte oläst. Fel visas alltid."
          }
        }
      }
    },
