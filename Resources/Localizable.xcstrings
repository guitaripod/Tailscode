    "%@ is already added. Opening it instead of adding it twice.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already added. Opening it instead of adding it twice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereits hinzugefügt. Es wird geöffnet, statt es ein zweites Mal hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está añadido. Se abre en lugar de añadirlo dos veces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà ajouté. Ouverture à la place, pour ne pas l'ajouter deux fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è già aggiunto. Viene aperto invece di aggiungerlo due volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は追加済みです。二重に追加せず、そちらを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이미 추가되어 있어요. 두 번 추가하는 대신 그 항목을 열어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest już dodany. Zamiast dodawać go drugi raz, zostanie otwarty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já foi adicionado. Abrindo em vez de adicionar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已经添加过了。将直接打开它，而不是重复添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已經新增過了。將直接開啟它，而不是重複新增。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er allerede tilføjet. Åbner den i stedet for at tilføje den igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on jo lisätty. Avataan se sen sijaan, että lisättäisiin kahdesti."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er þegar bætt við. Opnað í staðinn, svo ekki sé bætt við tvisvar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er allerede lagt til. Åpner den i stedet for å legge den til to ganger."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är redan tillagd. Öppnar den i stället för att lägga till den två gånger."
          }
        }
      }
    },
