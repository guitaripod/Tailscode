    "Your next message makes this final. Until then, Restore brings everything back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine nächste Nachricht macht das endgültig. Bis dahin bringt „Wiederherstellen“ alles zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next message makes this final. Until then, Restore brings everything back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu próximo mensaje lo hace definitivo. Hasta entonces, «Restaurar» lo devuelve todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre prochain message rend cela définitif. Jusque-là, « Restaurer » ramène tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo prossimo messaggio lo rende definitivo. Fino ad allora, \"Ripristina\" riporta tutto indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のメッセージを送るとこれが確定します。それまでは「復元」を押せばすべて元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 메시지를 보내면 이것이 확정됩니다. 그 전까지는 \"복원\"으로 모두 되돌릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua próxima mensagem torna isso definitivo. Até lá, \"Restaurar\" traz tudo de volta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你发出下一条消息就会让这一切成为定局。在那之前，点按“恢复”可以把一切找回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你傳送下一則訊息就會讓這一切成為定局。在那之前，點按「回復」可以把一切找回來。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja następna wiadomość czyni to ostatecznym. Do tego czasu „Przywróć” przywraca wszystko."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din næste besked gør det endeligt. Indtil da bringer »Gendan« alt tilbage."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraava viestisi tekee tästä lopullisen. Siihen asti ”Palauta” tuo kaiken takaisin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Næstu skilaboð gera þetta endanlegt. Þangað til skilar „Endurheimta“ öllu aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den neste meldingen din gjør dette endelig. Inntil da bringer «Gjenopprett» alt tilbake."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt nästa meddelande gör det här slutgiltigt. Tills dess återställer ”Återställ” allt."
          }
        }
      }
    },
