    "Dictation can't listen in %@ on this %@. Pick another language in Settings ▸ Chat ▸ Dictation.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation can't listen in %@ on this %@. Pick another language in Settings ▸ Chat ▸ Dictation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktat kann in %@ auf diesem %@ nicht zuhören. Wähle eine andere Sprache unter Einstellungen ▸ Chat ▸ Diktat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado no puede escuchar en %@ en este %@. Elige otro idioma en Ajustes ▸ Chat ▸ Dictado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée ne peut pas écouter en %@ sur votre %@. Choisissez une autre langue dans Réglages ▸ Discussion ▸ Dictée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura non può ascoltare in %@ su questo %@. Scegli un'altra lingua in Impostazioni ▸ Chat ▸ Dettatura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%@では%@の音声を聞き取れません。「設定 ▸ チャット ▸ 音声入力」で別の言語を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 받아쓰기를 이 %@에서 할 수 없습니다. 설정 ▸ 대화 ▸ 받아쓰기에서 다른 언어를 고르세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie nie potrafi słuchać w %@ na tym %@. Wybierz inny język w Ustawienia ▸ Rozmowa ▸ Dyktowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado não consegue ouvir em %@ neste %@. Escolha outro idioma em Ajustes ▸ Conversa ▸ Ditado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听写无法识别%@，这台%@不支持。请在“设置 ▸ 对话 ▸ 听写”中换一种语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法以 %@ 聽寫，這台 %@ 不支援。請在「設定 ▸ 對話 ▸ 聽寫」中選擇其他語言。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering kan ikke genkende %@ på denne %@. Vælg et andet sprog under Indstillinger ▸ Chat ▸ Diktering."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanelu ei voi kuunnella kielellä %@ tässä laitteessa (%@). Valitse toinen kieli kohdassa Asetukset ▸ Keskustelu ▸ Sanelu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktun getur ekki hlustað á %@ á þessu tæki (%@). Veldu annað tungumál í Stillingum ▸ Spjall ▸ Diktun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering kan ikke lytte til %@ på %@. Velg et annet språk under Innstillinger ▸ Chat ▸ Diktering."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering kan inte lyssna på %@ på den här %@. Välj ett annat språk i Inställningar ▸ Chatt ▸ Diktering."
          }
        }
      }
    },
