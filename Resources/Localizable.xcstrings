    "Open the page, check the code matches, and confirm it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Seite, prüfe, ob der Code übereinstimmt, und bestätige ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the page, check the code matches, and confirm it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la página, comprueba que el código coincide y confírmalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la page, vérifiez que le code correspond, et confirmez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la pagina, verifica che il codice corrisponda e confermalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを開き、コードが一致することを確認して、確定してください。"
