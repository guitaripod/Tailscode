    "The work is being continued from where it stopped. Everything above is still this same conversation.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Arbeit wird dort fortgesetzt, wo sie aufgehört hat. Alles oben ist weiterhin dieselbe Unterhaltung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The work is being continued from where it stopped. Everything above is still this same conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trabajo continúa desde donde se detuvo. Todo lo de arriba sigue siendo esta misma conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le travail reprend là où il s’est arrêté. Tout ce qui précède reste cette même conversation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il lavoro riprende da dove si era fermato. Tutto quello sopra è ancora questa stessa conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業は中断した地点から続けられます。上に表示されている内容はすべて、この同じ会話のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 멈췄던 지점부터 계속됩니다. 위의 모든 내용은 여전히 같은 대화입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O trabalho está sendo continuado de onde parou. Tudo acima ainda é esta mesma conversa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作会从中断的地方继续。上面的一切仍然是同一段对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作會從中斷的地方繼續。上面的一切仍然是同一段對話。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Praca jest kontynuowana od miejsca, w którym się zatrzymała. Wszystko powyżej to nadal ta sama rozmowa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbejdet fortsættes der, hvor det stoppede. Alt ovenfor er stadig den samme samtale."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työtä jatketaan siitä, mihin se jäi. Kaikki yllä oleva kuuluu edelleen samaan keskusteluun."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinnan heldur áfram þar sem hún stöðvaðist. Allt hér fyrir ofan er enn sama samtalið."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeidet fortsetter der det stoppet. Alt over er fortsatt den samme samtalen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbetet fortsätter där det stannade. Allt ovan är fortfarande samma konversation."
          }
        }
      }
    },
    "This model takes no attachments": {
      "extractionState": "manual",
      "localizations": {
