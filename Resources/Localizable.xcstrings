    "%@\n\nThe server rebuilds and restarts, so it stops answering for a moment.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nDer Server baut neu und startet neu, deshalb antwortet er kurz nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nThe server rebuilds and restarts, so it stops answering for a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nEl servidor se recompila y se reinicia, así que deja de responder un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nLe serveur se recompile et redémarre, il cesse donc de répondre un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nIl server si ricompila e si riavvia, quindi smette di rispondere per un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nサーバはビルドし直して再起動するため、しばらく応答しなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n서버가 다시 빌드하고 재시작하므로 잠시 응답하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nO servidor recompila e reinicia, então para de responder por um momento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n服务器会重新构建并重启，其间会短暂无法响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n伺服器會重新建置並重新啟動，其間會短暫無法回應。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nSerwer buduje się od nowa i uruchamia ponownie, więc na chwilę przestaje odpowiadać."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nServeren bygger om og genstarter, så den svarer ikke i et øjeblik."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nPalvelin koostaa uudelleen ja käynnistyy, joten se ei hetkeen vastaa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nNetþjónninn endurbyggist og endurræsist, svo hann hættir að svara um stund."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nServeren bygger på nytt og starter på nytt, så den svarer ikke et øyeblikk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nServern byggs om och startar om, så den slutar svara en stund."
          }
        }
      }
    },
