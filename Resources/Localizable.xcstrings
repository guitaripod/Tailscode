            "state": "translated",
            "value": "Token de Tailscale no válido. Actualízalo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeton Tailscale invalide. Mettez-le à jour et réessayez."
          }
        },
        "it": {
          "stringUnit": {
