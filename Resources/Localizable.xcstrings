    "%@ did not answer — check Tailscale on both machines.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht geantwortet — prüfe Tailscale auf beiden Rechnern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not answer — check Tailscale on both machines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no respondió: comprueba Tailscale en ambas máquinas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas répondu — vérifiez Tailscale sur les deux machines."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha risposto — controlla Tailscale su entrambe le macchine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から応答がありません — 両方のマシンで Tailscale を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 응답이 없습니다 — 양쪽 머신에서 Tailscale을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não respondeu — confira o Tailscale nas duas máquinas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有回应 — 请检查两台机器上的 Tailscale。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有回應 — 請檢查兩台機器上的 Tailscale。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie odpowiedział — sprawdź Tailscale na obu komputerach."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarede ikke – kontrollér Tailscale på begge maskiner."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei vastannut – tarkista Tailscale molemmilla koneilla."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svaraði ekki – athugaðu Tailscale á báðum tölvum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarte ikke. Sjekk Tailscale på begge maskinene."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarade inte. Kontrollera Tailscale på båda datorerna."
          }
        }
      }
    },
    "%@ did not hand over a link — is the bridge up to date?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
