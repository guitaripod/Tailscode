    "Something answers on %@, but it does not speak ComfyUI. ComfyUI listens on %@ unless it was told otherwise.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something answers on %@, but it does not speak ComfyUI. ComfyUI listens on %@ unless it was told otherwise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf %@ antwortet etwas, aber es spricht nicht das ComfyUI-Protokoll. ComfyUI lauscht auf %@, sofern nichts anderes eingestellt wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo responde en %@, pero no habla el protocolo de ComfyUI. ComfyUI escucha en %@ salvo que se le indique otra cosa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose répond sur %@, mais ce n'est pas ComfyUI. ComfyUI écoute sur %@ sauf indication contraire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa risponde su %@, ma non parla il protocollo di ComfyUI. ComfyUI resta in ascolto su %@ salvo diversa configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で応答しているものは ComfyUI の通信方式に対応していません。別の設定がない限り、ComfyUI は %@ で待ち受けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 응답하는 것은 ComfyUI가 아닙니다. 별도 설정이 없으면 ComfyUI는 %@에서 수신합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na %@ odpowiada coś, co nie mówi protokołem ComfyUI. ComfyUI nasłuchuje na %@, chyba że ustawiono inaczej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo responde em %@, mas não fala o protocolo do ComfyUI. O ComfyUI escuta em %@, a menos que tenha sido configurado de outra forma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上有服务响应，但它不是 ComfyUI 协议。除非另行设置，ComfyUI 会监听 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上有服務回應，但它不是 ComfyUI 協定。除非另行設定，ComfyUI 會監聽 %@。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget svarer på %@, men det taler ikke ComfyUI-protokollen. ComfyUI lytter på %@, medmindre andet er angivet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoitteessa %@ vastaa jokin, joka ei puhu ComfyUI:n protokollaa. ComfyUI kuuntelee osoitteessa %@, ellei sitä ole asetettu toisin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eitthvað svarar á %@, en það talar ekki ComfyUI. ComfyUI hlustar á %@ nema annað sé stillt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe svarer på %@, men det snakker ikke ComfyUI-protokollen. ComfyUI lytter på %@ med mindre den er konfigurert annerledes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något svarar på %@, men det använder inte ComfyUI:s protokoll. ComfyUI lyssnar på %@ om inget annat har angetts."
          }
        }
      }
    },
