            "value": "Legt den Patch beiseite; das Arbeitsverzeichnis sieht ihn nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the patch aside; the tree never sees it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparta el parche; el árbol de trabajo nunca lo ve."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirtää patchin syrjään; työhakemisto ei näe sitä koskaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met le correctif de côté ; l’arbre de travail ne le voit jamais."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggur patch til hliðar; vinnumappan sér hann aldrei."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mette da parte la patch; l’albero di lavoro non la vede mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッチを脇に置きます。作業ツリーには一切反映されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
