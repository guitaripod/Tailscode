    "%@ answers at %@, and %@ is not on that machine anywhere this app looked. Change the agent this server is for, or start %@ there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ antwortet unter %@, und %@ ist an keiner Stelle auf diesem Rechner zu finden, die diese App durchsucht hat. Ändere den Agenten, für den dieser Server bestimmt ist, oder starte %@ dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ answers at %@, and %@ is not on that machine anywhere this app looked. Change the agent this server is for, or start %@ there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ responde en %@, y %@ no está en esa máquina en ningún lugar que esta app haya buscado. Cambia el agente para el que está pensado este servidor, o inicia %@ allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ répond à %@, et %@ n’est présent nulle part sur cette machine, d’après ce que cette app a pu voir. Changez l’agent auquel ce serveur est destiné, ou démarrez %@ là-bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ risponde su %@, e %@ non si trova da nessuna parte su quella macchina, per quanto quest’app abbia potuto verificare. Cambia l’agente a cui è destinato questo server, oppure avvia %@ lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %@ で応答していますが、%@ はこの App が調べた範囲でそのマシン上のどこにも見つかりません。このサーバが対象とするエージェントを変更するか、そこで %@ を起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) %@에서 응답하지만, 이 앱이 살펴본 범위 내에서 %@은(는) 그 컴퓨터 어디에서도 찾을 수 없습니다. 이 서버가 대상으로 하는 에이전트를 바꾸거나, 그곳에서 %@을(를) 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ responde em %@, e %@ não está em nenhum lugar dessa máquina que este app tenha verificado. Troque o agente para o qual este servidor está configurado, ou inicie %@ lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在 %@ 上应答，而这个 App 检查过的范围内，%@ 都不在那台机器上。请更改此服务器对应的智能体，或在那里启动 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在 %@ 上回應，而這個 App 檢查過的範圍內，%@ 都不在那台機器上。請更改此伺服器對應的代理，或在那裡啟動 %@。"
          }
        }
      }
    },
