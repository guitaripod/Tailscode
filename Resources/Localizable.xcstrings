    "\"%@\" is not a key this app can read. Try ctrl+b, g g, esc or f5.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is not a key this app can read. Try ctrl+b, g g, esc or f5."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ist keine Taste, die diese App lesen kann. Versuche ctrl+b, g g, esc oder f5."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" no es una tecla que esta app pueda leer. Prueba ctrl+b, g g, esc o f5."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" n’est pas une touche que cette app peut lire. Essayez ctrl+b, g g, esc ou f5."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" non è un tasto che questa app può leggere. Prova ctrl+b, g g, esc o f5."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" はこのアプリが読み取れるキーではありません。ctrl+b、g g、esc、f5 を試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"은(는) 이 앱이 읽을 수 있는 키가 아닙니다. ctrl+b, g g, esc 또는 f5를 시도해 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" to nie jest klawisz, który ta aplikacja potrafi odczytać. Spróbuj ctrl+b, g g, esc lub f5."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" não é uma tecla que este app consegue ler. Tente ctrl+b, g g, esc ou f5."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 不是本应用能识别的按键。请试试 ctrl+b、g g、esc 或 f5。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 不是本應用程式能識別的按鍵。請試試 ctrl+b、g g、esc 或 f5。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« er ikke en tast, som denne app kan læse. Prøv ctrl+b, g g, esc eller f5."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ei ole näppäin, jonka tämä sovellus osaa lukea. Kokeile ctrl+b, g g, esc tai f5."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ er ekki takki sem þetta forrit getur lesið. Prófaðu ctrl+b, g g, esc eða f5."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» er ikke en tast denne appen kan lese. Prøv ctrl+b, g g, esc eller f5."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” är inte en tangent som appen kan läsa. Prova ctrl+b, g g, esc eller f5."
          }
        }
      }
    },
