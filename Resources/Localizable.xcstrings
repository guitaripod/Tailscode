    "Tailscode answers its own window only. Turn this on to ask from anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode reagiert nur im eigenen Fenster. Schalte dies ein, um von überall aus zu fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode answers its own window only. Turn this on to ask from anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode solo responde en su propia ventana. Activa esto para preguntar desde cualquier lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ne répond que dans sa propre fenêtre. Activez ceci pour poser une question depuis n’importe où."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode risponde solo nella propria finestra. Attiva questa opzione per chiedere da qualsiasi punto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode は自分のウインドウでしか反応しません。どこからでも質問できるようにするには、これをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode는 자체 창에서만 응답합니다. 어디서든 질문하려면 이 옵션을 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode só responde em sua própria janela. Ative isto para perguntar de qualquer lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 只在自己的窗口里响应。打开此选项即可随时随地提问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 只在自己的視窗裡回應。開啟此選項即可隨時隨地提問。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode odpowiada tylko we własnym oknie. Włącz to, aby pytać skądkolwiek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode svarer kun i sit eget vindue. Slå dette til for at spørge fra hvor som helst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode reagoi vain omaan ikkunaansa. Ota tämä käyttöön, jotta voit kysyä mistä tahansa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode svarar aðeins í eigin glugga. Kveiktu á þessu til að spyrja hvar sem er."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode svarer bare i sitt eget vindu. Slå på dette for å spørre fra hvor som helst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode svarar bara i sitt eget fönster. Slå på det här för att fråga var som helst."
          }
        }
      }
    },
