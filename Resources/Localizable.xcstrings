        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En kommando kører nu. Send den med enter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Komento suoritetaan heti, lähetä se enterillä."
          }
        },
        "is": {
