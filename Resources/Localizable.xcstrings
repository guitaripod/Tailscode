          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒绝了该密码。请在服务器上检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒絕了該密碼。請在伺服器上檢查。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ odrzucił to hasło. Sprawdź je na serwerze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ afviste den adgangskode. Kontrollér den på serveren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hylkäsi tämän salasanan. Tarkista se palvelimelta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hafnaði þessu lykilorði. Athugaðu það á netþjóninum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avviste passordet. Sjekk det på serveren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ godkände inte det lösenordet. Kontrollera det på servern."
          }
        }
      }
    },
    "%@ stopped answering in the middle of the update, %@. Check again once it is back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat mitten im Update aufgehört zu antworten, %2$@. Bitte erneut prüfen, sobald es wieder da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stopped answering in the middle of the update, %@. Check again once it is back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dejó de responder en mitad de la actualización, %2$@. Vuelve a comprobarlo cuando esté de vuelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a cessé de répondre en pleine mise à jour, %2$@. Vérifiez à nouveau une fois qu'il sera de retour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha smesso di rispondere a metà dell'aggiornamento, %2$@. Controlla di nuovo quando sarà di nuovo raggiungibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は更新の途中、%2$@に応答しなくなりました。復旧したらもう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 업데이트 도중 응답을 멈췄습니다(%2$@). 복구되면 다시 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ parou de responder no meio da atualização, %2$@. Verifique de novo quando ele voltar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在更新过程中停止了响应(%2$@)。等它恢复后再检查一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在更新過程中停止了回應(%2$@)。等它恢復後再檢查一次。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ przestał odpowiadać w trakcie aktualizacji, %@. Sprawdź ponownie, gdy wróci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ holdt op med at svare midt i opdateringen, %2$@. Kontrollér igen, når den er tilbage."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lakkasi vastaamasta päivityksen keskellä, %2$@. Tarkista uudelleen, kun se on taas käynnissä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hætti að svara í miðri uppfærslu, %2$@. Athugaðu aftur þegar það er komið í gang á ný."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sluttet å svare midt i oppdateringen, %@. Sjekk igjen når den er tilbake."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ slutade svara mitt i uppdateringen, %2$@. Kontrollera igen när den är tillbaka."
          }
        }
      }
    },
