    "Installs opencode if it is missing, serves it on port 4096, and keeps its model list current.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs opencode if it is missing, serves it on port 4096, and keeps its model list current."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert opencode, falls es fehlt, stellt es auf Port 4096 bereit und hält die Modellliste aktuell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala opencode si falta, lo sirve en el puerto 4096 y mantiene actualizada su lista de modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe opencode s'il manque, le sert sur le port 4096 et tient sa liste de modèles à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa opencode se manca, lo serve sulla porta 4096 e mantiene aggiornato l'elenco dei modelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode がなければインストールし、ポート 4096 で提供して、モデル一覧を最新に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode가 없으면 설치하고, 포트 4096에서 제공하며, 모델 목록을 최신 상태로 유지해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaluje opencode, jeśli go brakuje, udostępnia go na porcie 4096 i utrzymuje aktualną listę modeli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala o opencode se ele não existir, o disponibiliza na porta 4096 e mantém a lista de modelos atualizada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果缺少 opencode，则安装它，在端口 4096 上提供服务，并保持其模型列表为最新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若缺少 opencode，則安裝它，在連接埠 4096 上提供服務，並保持其模型清單為最新。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Installerer opencode, hvis det mangler, kører det på port 4096 og holder modellisten opdateret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asentaa opencoden, jos se puuttuu, tarjoaa sen portissa 4096 ja pitää malliluettelon ajantasaisena."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Setur upp opencode ef það vantar, keyrir það á gátt 4096 og heldur listanum yfir líkön uppfærðum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Installerer opencode hvis den mangler, kjører den på port 4096, og holder modellisten oppdatert."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installerar opencode om det saknas, kör det på port 4096 och håller dess modellista uppdaterad."
          }
        }
      }
    },
    "Drives oh-my-pi (install it first) on port 4099. Needs git and a Swift 6 toolchain.": {
