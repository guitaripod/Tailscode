    "It had not done anything yet — nothing on the machine changed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es hatte noch nichts getan — auf dem Rechner hat sich nichts verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It had not done anything yet — nothing on the machine changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no había hecho nada — nada cambió en la máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’avait encore rien fait — rien n’a changé sur la machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non aveva ancora fatto nulla — nulla è cambiato sulla macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何もしていませんでした — マシン上には何の変化もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 아무 작업도 하지 않았습니다 — 컴퓨터에는 아무 변화도 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não tinha feito nada — nada mudou na máquina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它还没做任何事——机器上没有任何变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它還沒做任何事——機器上沒有任何變化。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nic nie zrobiła — na komputerze nic się nie zmieniło."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den havde ikke gjort noget endnu – intet på computeren var blevet ændret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ei ollut vielä tehnyt mitään, eikä tietokoneella muuttunut mikään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það hafði ekki gert neitt enn: ekkert breyttist á tölvunni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den hadde ikke gjort noe ennå. Ingenting på maskinen ble endret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den hade inte gjort något ännu – ingenting på datorn ändrades."
          }
        }
      }
    },
