    "On — installs new versions when nothing is running.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An – installiert neue Versionen, sobald nichts mehr läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On — installs new versions when nothing is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: instala las versiones nuevas en cuanto no hay nada en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé — installe les nouvelles versions dès que plus rien ne tourne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivato: installa le nuove versioni non appena non c'è più nulla in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン — 何も実行されていないときに新しいバージョンを自動でインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜짐 — 아무것도 실행되고 있지 않을 때 새 버전을 설치합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado — instala as novas versões assim que nada mais está em execução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启——在没有任何内容运行时自动安装新版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟——在沒有任何內容執行時自動安裝新版本。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączone — instaluje nowe wersje, gdy nic nie działa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til – installerer nye versioner, når intet kører."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päällä – asentaa uudet versiot, kun mitään ei ole käynnissä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kveikt – setur upp nýjar útgáfur þegar ekkert er í gangi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På – installerer nye versjoner når ingenting kjører."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På – installerar nya versioner när inget körs."
          }
        }
      }
    },
    "One at a time: each downloads and builds, then restarts once nothing is running on it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nacheinander: Jeder lädt herunter und kompiliert, dann startet er neu, sobald nichts mehr auf ihm läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One at a time: each downloads and builds, then restarts once nothing is running on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De uno en uno: cada servidor descarga y compila, y luego se reinicia en cuanto no queda nada en ejecución en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un par un : chacun télécharge et compile, puis redémarre dès que plus rien n'y tourne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno alla volta: ciascuno scarica e compila, poi si riavvia non appena non c'è più nulla in esecuzione su di esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1台ずつ処理します。それぞれがダウンロードとビルドを行い、その後何も実行されなくなり次第再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 대씩 진행됩니다. 각 서버가 다운로드와 빌드를 수행한 다음, 아무것도 실행되지 않을 때 재시동됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um de cada vez: cada um baixa e compila, depois reinicia assim que nada mais estiver em execução nele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐台进行：每台服务器先下载并构建，然后在没有任何内容运行时重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐台進行：每台伺服器先下載並建置，然後在沒有任何內容執行時重新開機。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po kolei: każdy pobiera i buduje, a potem uruchamia się ponownie, gdy nic już na nim nie działa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én ad gangen: hver downloader og bygger, og genstarter derefter, når intet kører på den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi kerrallaan: kukin lataa ja koostaa, ja käynnistyy uudelleen, kun sillä ei ole mitään käynnissä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein í einu: hver tölva sækir og byggir, og endurræsist síðan þegar ekkert er í gangi á henni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett om gangen: hver laster ned og bygger, og starter deretter på nytt når ingenting kjører på den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En i taget: varje laddar ner och bygger, och startar sedan om när inget körs på den."
          }
        }
      }
    },
    "One chord, pressed in any app on this Mac, opens the question box": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Tastenkombination, in jeder App auf diesem Mac gedrückt, öffnet das Fragefenster"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One chord, pressed in any app on this Mac, opens the question box"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una combinación, pulsada en cualquier app de este Mac, abre el cuadro de preguntas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une combinaison, pressée dans n’importe quelle app sur ce Mac, ouvre la fenêtre de question"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una combinazione, premuta in qualsiasi app su questo Mac, apre la finestra della domanda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac のどのアプリからでも、1 つのキーの組み合わせで質問ボックスが開きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 어떤 앱에서든, 키 조합 하나로 질문 상자가 열립니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma combinação, pressionada em qualquer app deste Mac, abre a caixa de perguntas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 的任何应用中，按下同一个组合键都能打开提问框"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這台 Mac 的任何應用程式中，按下同一個組合鍵都能打開提問框"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna kombinacja klawiszy, naciśnięta w dowolnej aplikacji na tym Macu, otwiera okno pytania"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én tastekombination, trykket i enhver app på denne Mac, åbner spørgefeltet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi näppäinyhdistelmä, joka avaa kysymysikkunan, kun sen painaa missä tahansa tämän Macin sovelluksessa"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein lyklasamsetning, ýtt á í hvaða forriti sem er á þessari Mac-tölvu, opnar spurningarreitinn"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én tastekombinasjon, trykket i en hvilken som helst app på denne Macen, åpner spørsmålsboksen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tangentkombination som trycks i valfri app på den här Mac:en öppnar frågerutan"
          }
        }
      }
    },
