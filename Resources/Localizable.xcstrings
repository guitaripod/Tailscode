    "Dictation learns the chat's file names, branch, commands and code words, so “composer view dot swift” is written ComposerView.swift. Nothing leaves this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation learns the chat's file names, branch, commands and code words, so “composer view dot swift” is written ComposerView.swift. Nothing leaves this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktat lernt die Dateinamen, Branch, Befehle und Codewörter des Chats, daher wird „composer view dot swift“ als ComposerView.swift geschrieben. Nichts verlässt dieses Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dictado aprende los nombres de archivo, la rama, los comandos y las palabras de código del chat, así que “composer view dot swift” se escribe ComposerView.swift. Nada sale de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dictée apprend les noms de fichiers, la branche, les commandes et les mots de code de la discussion, donc « composer view point swift » s'écrit ComposerView.swift. Rien ne quitte cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dettatura impara i nomi dei file, il branch, i comandi e le parole di codice della chat, quindi “composer view punto swift” viene scritto ComposerView.swift. Nulla esce da questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力はチャットのファイル名、ブランチ、コマンド、コードの単語を覚えるため、「composer view dot swift」は ComposerView.swift と書き起こされます。データはこの機器から外に出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기는 대화의 파일 이름, 브랜치, 명령어와 코드 단어를 익혀서 “composer view dot swift”를 ComposerView.swift로 받아씁니다. 아무것도 이 기기를 떠나지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie uczy się nazw plików, gałęzi, poleceń i słów kodu z rozmowy, więc „composer view dot swift” zapisze się jako ComposerView.swift. Nic nie opuszcza tego urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ditado aprende os nomes de arquivo, o branch, os comandos e as palavras de código da conversa, então “composer view ponto swift” é escrito ComposerView.swift. Nada sai deste aparelho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听写会学习对话中的文件名、分支、命令和代码词，因此“composer view dot swift”会写成 ComposerView.swift。内容不会离开这台设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽寫會學習對話中的檔名、分支、指令與程式碼用語，因此「composer view dot swift」會寫成 ComposerView.swift。內容都不會離開這台裝置。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering lærer chattens filnavne, gren, kommandoer og kodetermer, så »composer view dot swift« skrives ComposerView.swift. Intet forlader denne enhed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanelu oppii keskustelun tiedostonimet, haaran, komennot ja koodisanat, joten ”composer view dot swift” kirjoitetaan muodossa ComposerView.swift. Mikään ei poistu tältä laitteelta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktun lærir skráarheiti, grein, skipanir og kóðaorð spjallsins, þannig að „composer view dot swift“ er skrifað ComposerView.swift. Ekkert fer úr þessu tæki."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering lærer filnavnene, grenen, kommandoene og kodeordene i chatten, så «composer view dot swift» skrives som ComposerView.swift. Ingenting forlater denne enheten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktering lär sig chattens filnamn, gren, kommandon och kodord, så att ”composer view punkt swift” skrivs ComposerView.swift. Inget lämnar enheten."
          }
        }
      }
    },
