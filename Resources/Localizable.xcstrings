    "Approve to let the run spend %@; hold to stop it here.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkend, så kørslen må bruge %@; hold nede for at stoppe den her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib frei, damit der Lauf %@ ausgeben darf; stelle zurück, um ihn hier anzuhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve to let the run spend %@; hold to stop it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba para que la ejecución gaste %@; retén para detenerla aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyväksy, jos annat ajon käyttää %@; pidä painettuna pysäyttääksesi sen täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuvez pour que l’exécution dépense %@ ; suspendez pour l’arrêter ici."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Samþykktu til að leyfa keyrslunni að eyða %@; haltu inni til að stöðva hana hér."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva per lasciare che l’esecuzione spenda %@; sospendi per fermarla qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認すると、この実行は %@ を使えます。保留すると、ここで止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인하면 실행이 %@을(를) 사용합니다. 보류하면 여기서 멈춥니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkjenn for å la kjøringen bruke %@, eller hold inne for å stoppe den her."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdź, aby uruchomienie wydało %@; wstrzymaj, aby zatrzymać je tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprove para deixar a execução gastar %@; retenha para pará-la aqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkänn för att låta körningen spendera %@; håll in för att stoppa den här."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准后本次运行可花费 %@；保留则在此处停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准後本次執行可花費 %@；保留則在此處停止。"
          }
        }
      }
    },
