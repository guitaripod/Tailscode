        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe den Server oder Tailscale und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el servidor o Tailscale y vuelve a intentarlo."
          }
