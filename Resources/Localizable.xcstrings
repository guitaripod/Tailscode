        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Er startet neu auf dem neuen Build, sobald das erledigt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ It restarts on the new build as soon as that finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Se reiniciará con el nuevo build en cuanto eso termine."
          }
        },
        "fr": {
          "stringUnit": {
