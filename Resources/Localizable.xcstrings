    "Review the latest commits and point out anything risky.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die letzten Commits und weise auf alles Riskante hin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the latest commits and point out anything risky."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa los últimos commits y señala cualquier cosa arriesgada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relis les derniers commits et signale tout ce qui est risqué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivedi gli ultimi commit e segnala qualsiasi cosa rischiosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近のコミットをレビューして、リスクのある箇所を指摘して。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 커밋을 검토하고 위험한 부분을 짚어 줘."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise os commits recentes e aponte qualquer coisa arriscada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审阅最近的提交，并指出任何有风险的地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審閱最近的提交，並指出任何有風險的地方。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejrzyj najnowsze commity i wskaż wszystko, co ryzykowne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemgå de seneste commits og påpeg alt, der er risikabelt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista viimeisimmät commitit ja huomauta mahdollisista riskeistä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Yfirfarðu nýjustu commitin og bentu á allt sem er áhættusamt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjennomgå de siste commitene og påpek alt som er risikabelt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granska de senaste commitsen och peka ut allt riskfyllt."
          }
        }
      }
    },
