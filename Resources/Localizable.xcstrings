    "Avoid… (raises guidance, so the render takes longer)": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeiden … (erhöht die Guidance, wodurch der Render länger dauert)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid… (raises guidance, so the render takes longer)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitar… (sube la guía, así que el render tarda más)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À éviter… (augmente le guidage, donc le rendu prend plus de temps)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da evitare… (alza la guida, quindi il render richiede più tempo)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "避けたい語…（ガイダンスが上がるため、レンダリングに時間がかかります）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피할 것… (가이던스가 높아져 렌더링이 더 오래 걸립니다)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evitar… (aumenta a orientação, então a renderização demora mais)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要避免的词…（会提高引导强度，因此渲染耗时更长）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要避免的詞…（會提高引導強度，因此渲染耗時更長）"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj… (zwiększa guidance, więc render trwa dłużej)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Undgå… (øger guidance, så renderingen tager længere tid)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vältä… (nostaa ohjausvoimakkuutta, joten renderöinti kestää pidempään)"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Forðast… (hækkar leiðsögn, þannig að vinnslan tekur lengri tíma)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Unngå… (øker styrken på veiledningen, så rendringen tar lengre tid)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Undvik… (höjer guidance, så renderingen tar längre tid)"
          }
        }
      }
    },
