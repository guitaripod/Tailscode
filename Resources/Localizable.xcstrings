          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Delegate と複数のライブアクティビティの同時表示は、再び Tailscode Pro の機能になりました。"
          }
        },
        "ko": {
          "stringUnit": {
