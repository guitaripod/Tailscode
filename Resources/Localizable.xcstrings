    "%@ didn’t open. Go up along the path above, or pick another place.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn’t open. Go up along the path above, or pick another place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ließ sich nicht öffnen. Über den Pfad oben nach oben gehen oder einen anderen Ort wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se abrió. Sube por la ruta de arriba o elige otro lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne s’est pas ouvert. Remontez le chemin ci-dessus ou choisissez un autre endroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non si è aperta. Risali lungo il percorso qui sopra o scegli un altro posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を開けませんでした。上のパスをたどって戻るか、別の場所を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 폴더를 열 수 없습니다. 위의 경로를 따라 올라가거나 다른 위치를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não abriu. Suba pelo caminho acima ou escolha outro lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开 %@。请沿上方路径返回，或选择其他位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟 %@。請沿上方路徑返回，或選擇其他位置。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć %@. Wróć wyżej po ścieżce powyżej albo wybierz inne miejsce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kunne ikke åbnes. Vælg en mappe længere oppe i stien, eller vælg et andet sted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei avautunut. Siirry polulla ylemmäs tai valitse toinen paikka."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ opnaðist ekki. Farðu upp eftir slóðinni hér fyrir ofan eða veldu annan stað."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kunne ikke åpnes. Gå opp langs banen over, eller velg et annet sted."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ öppnades inte. Gå uppåt längs sökvägen ovan eller välj en annan plats."
          }
        }
      }
    },
