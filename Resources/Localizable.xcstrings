    "Uses the Tailscale API to list your devices, then checks which ones are running supported coding agent servers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt die Tailscale-API, um deine Geräte aufzulisten, und prüft dann, auf welchen unterstützte Coding-Agent-Server laufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the Tailscale API to list your devices, then checks which ones are running supported coding agent servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la API de Tailscale para listar tus dispositivos y luego comprueba cuáles ejecutan servidores de agentes de programación compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise l’API Tailscale pour lister vos appareils, puis vérifie lesquels exécutent des serveurs d’agents de code pris en charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa l’API di Tailscale per elencare i tuoi dispositivi e poi verifica quali eseguono server di agenti di programmazione supportati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale API でデバイス一覧を取得し、対応するコーディングエージェントのサーバが動いているものを調べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale API로 기기 목록을 가져온 뒤, 지원되는 코딩 에이전트 서버가 실행 중인 기기를 확인합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa a API do Tailscale para listar seus dispositivos e depois verifica quais rodam servidores de agentes de programação compatíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Tailscale API 列出你的设备，然后检查哪些设备正在运行受支持的编程智能体服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Tailscale API 列出你的裝置，然後檢查哪些裝置正在執行支援的程式設計代理伺服器。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzysta z API Tailscale, aby wyświetlić listę twoich urządzeń, a następnie sprawdza, na których z nich działają obsługiwane serwery agentów kodowania."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruger Tailscale-API'et til at hente dine enheder og kontrollerer derefter, hvilke der kører understøttede servere til kodeagenter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakee laitteidesi luettelon Tailscale-rajapinnan kautta ja tarkistaa, mitkä niistä suorittavat tuettuja koodausagenttipalvelimia."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Notar Tailscale-API til að telja upp tækin þín og athugar síðan hvaða þeirra keyra studda netþjóna fyrir kóðunaragenta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruker Tailscale-API-et for å liste opp enhetene dine, og sjekker deretter hvilke som kjører støttede servere for kodeagenter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använder Tailscale-API:t för att lista dina enheter och kontrollerar sedan vilka som kör stödda servrar för agenter."
          }
        }
      }
    },
