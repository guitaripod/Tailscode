    "Speak to this chat and it types what you say": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak to this chat and it types what you say"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich in diesen Chat, und er tippt, was du sagst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla en este chat y escribe lo que dices"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez dans ce chat et il tape ce que vous dites"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla in questa chat e scrive ciò che dici"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットに話しかけると、話した内容を入力します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅에 말하면 말한 내용을 입력합니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mów do tego czatu, a zapisze to, co mówisz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale com este chat e ele digita o que você diz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对此聊天说话，它会把你说的话打出来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對這個聊天說話，它會把你說的話打出來"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal til denne chat, og den skriver det, du siger"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhu tähän keskusteluun, ja se kirjoittaa sanomasi"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Talaðu inn í þetta spjall og það skrifar niður það sem þú segir"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Snakk med denne chatten, så skriver den det du sier"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tala till den här chatten så skrivs det du säger"
          }
        }
      }
    },
