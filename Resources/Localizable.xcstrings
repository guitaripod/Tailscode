            "value": "⚠ Claude 已登出 — 在它登入之前，每個回合都會被拒絕。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude jest wylogowany — każda tura będzie odrzucana, dopóki się nie zaloguje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude er logget ud – hver tur afvises, indtil den logger ind."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude on kirjautunut ulos – jokainen vuoro hylätään, kunnes se kirjautuu sisään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Ekki er skráð inn í Claude – hver umferð verður hafnað þar til innskráning fer fram."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude er logget av – hver tur blir avvist til den logger på."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ Claude är utloggad – varje tur nekas tills den loggar in."
          }
        }
      }
    },
