        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ist auf %@ abgemeldet – jeder Zug wird abgelehnt, bis es angemeldet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ha cerrado sesión en %@: cada turno será rechazado hasta que inicie sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude est déconnecté sur %@ — chaque tour sera refusé tant qu’il ne se reconnecte pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude è disconnesso su %@: ogni turno verrà rifiutato finché non accede."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で Claude がサインアウトしています。サインインするまで、すべてのターンが拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 Claude가 로그아웃되었습니다. 로그인할 때까지 모든 턴이 거부됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude jest wylogowany na %@ — każda tura będzie odrzucana, dopóki się nie zaloguje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude está desconectado em %@ — todos os turnos serão recusados até ele entrar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 Claude 已退出登录，登录之前每个回合都会被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 Claude 已登出，登入之前每個回合都會被拒絕。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude er logget ud på %@ – hver tur afvises, indtil den logger ind."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude on kirjautunut ulos tietokoneella %@ – jokainen vuoro hylätään, kunnes se kirjautuu sisään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude er ekki skráður inn á %@ – hver umferð verður hafnuð þar til hann skráir sig inn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude er logget av på %@ – hver tur blir avvist til den logger inn."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude är utloggad på %@ – varje tur avvisas tills den loggar in."
          }
        }
      }
