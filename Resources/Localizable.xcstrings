    "Percent of the normal size. The sample is set the way the window sets its own text.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Percent of the normal size. The sample is set the way the window sets its own text."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prozent der normalen Größe. Die Vorschau wird so gesetzt, wie das Fenster seinen eigenen Text setzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porcentaje del tamaño normal. La muestra se ajusta como el propio texto de la ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourcentage de la taille normale. L’exemple est composé comme le texte de la fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentuale della dimensione normale. L’anteprima è impostata come il testo della finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常サイズに対する割合です。サンプルは、ウインドウ自身のテキストと同じ方法で設定されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 크기의 백분율입니다. 샘플은 창 자체의 텍스트와 같은 방식으로 설정됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Procent normalnego rozmiaru. Próbka jest ustawiana tak, jak okno ustawia swój własny tekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Porcentagem do tamanho normal. A amostra é definida da mesma forma que a janela define o próprio texto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "占正常大小的百分比。示例文字的设置方式与窗口自身文字相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "佔正常大小的百分比。範例文字的設定方式與視窗自身文字相同。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Procent af normal størrelse. Eksemplet sættes, som vinduet sætter sin egen tekst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosenttia normaalikoosta. Näyte asetetaan samalla tavalla kuin ikkuna asettaa oman tekstinsä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlutfall af venjulegri stærð. Sýnishornið er stillt eins og glugginn stillir sinn eigin texta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosent av normal størrelse. Eksempelteksten settes slik vinduet setter sin egen tekst."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Procent av normal storlek. Förhandsvisningen ställs in på samma sätt som fönstret ställer in sin egen text."
          }
        }
      }
    },
    "Press Change… and then the keys you want. ⌘ shortcuts belong to the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Change… and then the keys you want. ⌘ shortcuts belong to the menu bar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke Ändern… und dann die gewünschten Tasten. ⌘-Kurzbefehle gehören zur Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Cambiar… y luego las teclas que quieras. Los atajos ⌘ pertenecen a la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Modifier… puis sur les touches souhaitées. Les raccourcis ⌘ appartiennent à la barre de menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi Cambia… e poi i tasti che vuoi. Le scorciatoie ⌘ appartengono alla barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「変更…」を押してから、使いたいキーを押してください。⌘ のショートカットはメニューバーのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경…을 누른 다음 원하는 키를 누르세요. ⌘ 단축키는 메뉴 막대에 속합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij Zmień…, a następnie żądane klawisze. Skróty ⌘ należą do paska menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione Alterar… e depois as teclas desejadas. Atalhos ⌘ pertencem à barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下“更改…”，然后按下你想要的按键。⌘ 快捷键属于菜单栏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下「變更…」，然後按下你想要的按鍵。⌘ 快捷鍵屬於選單列。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Ændr…, og tryk derefter på de taster, du ønsker. ⌘-genveje hører til menulinjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina Vaihda… ja sen jälkeen haluamasi näppäimet. ⌘-pikanäppäimet kuuluvat valikkopalkkiin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu á Breyta… og síðan á takkana sem þú vilt. ⌘-flýtilyklar tilheyra valmyndastikunni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk Endre… og deretter tastene du vil ha. ⌘-snarveier hører til menylinjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Ändra… och tryck sedan på de tangenter du vill ha. ⌘-kortkommandon hör till menyraden."
          }
        }
      }
    },
    "Press a second key to make it a two-key shortcut. Backspace clears; Esc closes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press a second key to make it a two-key shortcut. Backspace clears; Esc closes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke eine zweite Taste, um eine Zwei-Tasten-Kombination zu machen. Backspace löscht; Esc schließt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa una segunda tecla para convertirlo en un atajo de dos teclas. Backspace borra; Esc cierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur une seconde touche pour en faire un raccourci à deux touches. Backspace efface ; Esc ferme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi un secondo tasto per farne una scorciatoia a due tasti. Backspace cancella; Esc chiude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 つ目のキーを押すと 2 キーのショートカットになります。Backspace で消去、Esc で閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번째 키를 누르면 두 키 단축키가 됩니다. Backspace는 지우고, Esc는 닫습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij drugi klawisz, aby utworzyć skrót dwuklawiszowy. Backspace czyści; Esc zamyka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione uma segunda tecla para torná-lo um atalho de duas teclas. Backspace limpa; Esc fecha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再按一个按键即可变为双键快捷键。Backspace 清除；Esc 关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再按一個按鍵即可變為雙鍵快捷鍵。Backspace 清除；Esc 關閉。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på en anden tast for at lave en genvej med to taster. Backspace rydder; Esc lukker."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina toista näppäintä tehdäksesi kaksinäppäimisen pikanäppäimen. Askelpalautin tyhjentää; Esc sulkee."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu á annan takka til að gera þetta að tveggja takka flýtilykli. Backspace hreinsar; Esc lokar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk en andre tast for å lage en snarvei med to taster. Backspace tømmer; Esc lukker."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ytterligare en tangent för att göra det till ett kortkommando med två tangenter. Backspace rensar; Esc stänger."
          }
        }
      }
    },
