    "Nothing was running in the last hour that this device saw.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was running in the last hour that this device saw."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der letzten Stunde hat dieses Gerät nichts laufen sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la última hora este dispositivo no vio nada en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a rien vu tourner dans la dernière heure."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nell’ultima ora questo dispositivo non ha visto nulla in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスが見た限り、直近1時間に実行中のものはありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기가 본 지난 한 시간 동안 실행 중인 것은 없었어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W ostatniej godzinie to urządzenie nie widziało niczego uruchomionego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada rodou na última hora que este dispositivo tenha visto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备在过去一小时内没有看到任何正在运行的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置在過去一小時內沒有看到任何正在執行的內容。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet kørte i den sidste time, som denne enhed så."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä laite ei nähnyt viimeisen tunnin aikana mitään käynnissä olevaa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert keyrði síðustu klukkustund sem þetta tæki sá."
          }
