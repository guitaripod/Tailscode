            "value": "%@ cannot keep a schedule. Schedules need a machine running claude-bridge or omp-bridge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann keinen Zeitplan halten. Zeitpläne brauchen einen Rechner mit laufendem claude-bridge oder omp-bridge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no puede mantener una programación. Las programaciones necesitan una máquina que ejecute claude-bridge u omp-bridge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas garder de planification. Les planifications nécessitent une machine qui exécute claude-bridge ou omp-bridge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non può mantenere una pianificazione. Le pianificazioni richiedono una macchina che esegue claude-bridge o omp-bridge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はスケジュールを保持できません。スケジュールには claude-bridge または omp-bridge を実行しているマシンが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 일정을 유지할 수 없습니다. 일정에는 claude-bridge 또는 omp-bridge가 실행 중인 기기가 필요합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie może przechowywać harmonogramu. Harmonogramy wymagają komputera z uruchomionym claude-bridge lub omp-bridge."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não pode manter uma agenda. As agendas precisam de uma máquina com claude-bridge ou omp-bridge em execução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法保留日程。日程需要一台运行 claude-bridge 或 omp-bridge 的机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 無法保留排程。排程需要一台執行 claude-bridge 或 omp-bridge 的機器。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan ikke køre efter en tidsplan. Tidsplaner kræver en computer med claude-bridge eller omp-bridge kørende."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei voi ylläpitää aikataulua. Aikataulut vaativat tietokoneen, jolla on käynnissä claude-bridge tai omp-bridge."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ getur ekki haldið áætlun. Áætlanir þurfa tölvu þar sem claude-bridge eða omp-bridge keyrir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan ikke holde en tidsplan. Tidsplaner krever en maskin som kjører claude-bridge eller omp-bridge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan inte hålla ett schema. Scheman kräver en dator som kör claude-bridge eller omp-bridge."
          }
        }
      }
    },
