            "value": "%@ on muokkauksen pikanäppäin jokaisessa sovelluksessa tällä tietokoneella."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er flýtilykill fyrir breytingar á texta í öllum forritum á þessari tölvu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
