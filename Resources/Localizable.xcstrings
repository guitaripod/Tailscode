    "Hold Send to refine your draft with the on-device model": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte „Senden“ gedrückt, um deinen Entwurf mit dem Modell auf dem Gerät zu verfeinern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Send to refine your draft with the on-device model"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado Enviar para refinar tu borrador con el modelo del dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez Envoyer pour affiner votre brouillon avec le modèle sur l’appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto Invia per rifinire la bozza con il modello sul dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信を長押しすると、デバイス上のモデルで下書きを推敲します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기를 길게 누르면 온디바이스 모델로 초안을 다듬습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha Enviar pressionado para refinar seu rascunho com o modelo no dispositivo"
