    "No opencode, Claude Code, or Oh My Pi servers found.\nMake sure the servers are running and listening on ports 4096/4098/4099.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine opencode-, Claude-Code- oder Oh-My-Pi-Server gefunden.\nStelle sicher, dass die Server laufen und auf Port 4096/4098/4099 lauschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No opencode, Claude Code, or Oh My Pi servers found.\nMake sure the servers are running and listening on ports 4096/4098/4099."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron servidores de opencode, Claude Code ni Oh My Pi.\nAsegúrate de que los servidores estén activos y escuchando en los puertos 4096/4098/4099."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun serveur opencode, Claude Code ou Oh My Pi trouvé.\nVérifiez que les serveurs tournent et écoutent sur les ports 4096/4098/4099."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun server opencode, Claude Code o Oh My Pi trovato.\nAssicurati che i server siano in esecuzione e in ascolto sulle porte 4096/4098/4099."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode、Claude Code または Oh My Pi のサーバが見つかりません。\nサーバが起動し、ポート 4096/4098/4099 で待ち受けているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode, Claude Code 또는 Oh My Pi 서버를 찾지 못했습니다.\n서버가 실행 중이며 4096/4098/4099 포트에서 대기하는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum servidor opencode, Claude Code ou Oh My Pi encontrado.\nVerifique se os servidores estão rodando e escutando nas portas 4096/4098/4099."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 opencode、Claude Code 或 Oh My Pi 服务器。\n请确认服务器正在运行并监听 4096/4098/4099 端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 opencode、Claude Code 或 Oh My Pi 伺服器。\n請確認伺服器正在執行並監聽 4096/4098/4099 連接埠。"
          }
        }
      }
