          }
        }
      }
    },
    "Tailscode is free software under the GNU General Public License v3. You are entitled to the complete source, which is linked above.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ist freie Software unter der GNU General Public License v3. Du hast Anspruch auf den vollständigen Quellcode, der oben verlinkt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode is free software under the GNU General Public License v3. You are entitled to the complete source, which is linked above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode es software libre bajo la Licencia Pública General de GNU v3. Tienes derecho al código fuente completo, enlazado más arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode est un logiciel libre sous licence GNU General Public License v3. Vous avez droit au code source complet, dont le lien figure ci-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode è software libero sotto licenza GNU General Public License v3. Hai diritto al codice sorgente completo, collegato qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode は GNU General Public License v3 に基づくフリーソフトウェアです。上にリンクされた完全なソースコードを入手する権利があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode는 GNU General Public License v3에 따른 자유 소프트웨어입니다. 위에 링크된 전체 소스 코드를 받을 권리가 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode é software livre sob a GNU General Public License v3. Você tem direito ao código-fonte completo, com link acima."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 是遵循 GNU 通用公共许可证 v3 的自由软件。你有权获取完整源代码，链接见上方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 是遵循 GNU 通用公共授權條款 v3 的自由軟體。你有權取得完整原始碼，連結見上方。"
          }
        }
      }
    },
    "Tailscode is open source, with no ads, no tracking, and no server between you and your agents. The one-time Pro unlock funds development.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ist Open Source, ohne Werbung, ohne Tracking und ohne Server zwischen dir und deinen Agenten. Die einmalige Pro-Freischaltung finanziert die Entwicklung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode is open source, with no ads, no tracking, and no server between you and your agents. The one-time Pro unlock funds development."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode es de código abierto, sin anuncios, sin rastreo y sin ningún servidor entre tú y tus agentes. El desbloqueo Pro único financia el desarrollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode est open source, sans publicité, sans suivi et sans serveur entre vous et vos agents. Le déblocage Pro unique finance le développement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode è open source, senza pubblicità, senza tracciamento e senza server tra te e i tuoi agenti. Lo sblocco Pro una tantum finanzia lo sviluppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode はオープンソースで、広告もトラッキングもなく、あなたとエージェントの間にサーバはありません。買い切りの Pro 解除が開発を支えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode는 오픈 소스이며, 광고도 추적도 없고 사용자와 에이전트 사이에 서버가 없습니다. 일회성 Pro 잠금 해제가 개발을 지원합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode é de código aberto, sem anúncios, sem rastreamento e sem servidor entre você e seus agentes. O desbloqueio Pro único financia o desenvolvimento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 是开源软件，没有广告、没有追踪，你和你的智能体之间也没有服务器。一次性解锁 Pro 用于资助开发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 是開放原始碼軟體，沒有廣告、沒有追蹤，你和你的代理之間也沒有伺服器。一次性解鎖 Pro 用於支持開發。"
          }
        }
      }
    },
    "Takes a minute or two, and the conversation is busy until it finishes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dauert ein bis zwei Minuten; die Unterhaltung ist bis zum Ende belegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes a minute or two, and the conversation is busy until it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarda un par de minutos y la conversación estará ocupada hasta que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend une ou deux minutes, et la conversation reste occupée jusqu’à la fin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede un minuto o due e la conversazione resta occupata fino al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1〜2 分かかり、その間は会話がビジー状態になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1~2분 걸리며, 끝날 때까지 대화는 사용 중 상태입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leva um ou dois minutos, e a conversa fica ocupada até terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要一两分钟，期间对话处于忙碌状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要一兩分鐘，期間對話處於忙碌狀態。"
          }
        }
      }
    },
    "Tap Scan to discover servers on your tailnet.": {
