        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code on that machine is signed out, so it can't answer anything. Signing in here signs the machine in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code tiene la sesión cerrada en esa máquina, así que no puede responder nada. Iniciar sesión aquí inicia la sesión de la máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code est déconnecté sur cette machine, il ne peut donc rien répondre. Se connecter ici connecte la machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code è disconnesso su quella macchina, quindi non può rispondere. Accedere qui fa accedere la macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのマシンの Claude Code はサインアウトしているため、何も答えられません。ここでサインインすると、マシンがサインインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 컴퓨터의 Claude Code가 로그아웃되어 아무것도 답할 수 없습니다. 여기서 로그인하면 그 컴퓨터가 로그인됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude Code está desconectado naquela máquina, então não consegue responder nada. Entrar aqui conecta a máquina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那台机器上的 Claude Code 已登出，因此无法回答任何问题。在这里登录即可让那台机器登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那台機器上的 Claude Code 已登出，因此無法回答任何問題。在這裡登入即可讓那台機器登入。"
          }
        }
      }
    },
