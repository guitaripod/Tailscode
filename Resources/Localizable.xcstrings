    "Showing your screen each way on your Mac, one after another. Your live preview keeps going meanwhile.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing your screen each way on your Mac, one after another. Your live preview keeps going meanwhile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Ihren Bildschirm auf Ihrem Mac nacheinander in jeder Variante. Ihre Live-Vorschau läuft währenddessen weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tu pantalla de cada forma en tu Mac, una tras otra. Mientras tanto, tu vista previa en directo sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche votre écran de chaque façon sur votre Mac, l’une après l’autre. Votre aperçu en direct continue pendant ce temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra lo schermo in ciascun modo sul Mac, uno dopo l’altro. Nel frattempo l’anteprima dal vivo continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 上で画面をそれぞれの見え方で順に表示します。その間もライブプレビューは動き続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 화면을 각 모양으로 차례차례 보여 줍니다. 그동안 라이브 미리보기는 계속 실행됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje ekran na Macu w każdym wariancie, jeden po drugim. Podgląd na żywo działa tymczasem dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra sua tela de cada jeito no seu Mac, uma após a outra. Enquanto isso, sua prévia ao vivo continua rodando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 Mac 上依次展示屏幕的各种外观。实时预览同时继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的 Mac 上依序展示畫面的各種外觀。即時預覽同時繼續執行。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser din skærm i hver variant på din Mac, én efter én. Din live-forhåndsvisning kører videre imens."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytetään näyttösi jokaisella tavalla Macilla peräkkäin. Aktiivinen esikatselu jatkuu samaan aikaan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sýni skjáinn á Mac-tölvunni hverja stillingu í röð. Forskoðunin í beinni heldur áfram á meðan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser skjermen din på Macen i alle varianter, etter hverandre. Den levende forhåndsvisningen fortsetter imens."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar din skärm på varje sätt på din Mac, ett i taget. Din aktiva förhandsvisning fortsätter under tiden."
          }
        }
      }
    },
    "Shows your screen in light and dark, at larger text sizes and right to left. Your live preview keeps going meanwhile.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows your screen in light and dark, at larger text sizes and right to left. Your live preview keeps going meanwhile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Ihren Bildschirm hell und dunkel, mit größeren Textgrößen und von rechts nach links. Ihre Live-Vorschau läuft währenddessen weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tu pantalla en claro y oscuro, con tamaños de texto mayores y de derecha a izquierda. Mientras tanto, tu vista previa en directo sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche votre écran en clair et en sombre, avec des textes plus grands et de droite à gauche. Votre aperçu en direct continue pendant ce temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra lo schermo in chiaro e scuro, con testo più grande e da destra a sinistra. Nel frattempo l’anteprima dal vivo continua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面をライトとダーク、より大きな文字サイズ、右から左の表示で見せます。その間もライブプレビューは動き続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 라이트와 다크, 더 큰 텍스트 크기, 오른쪽에서 왼쪽 순서로 보여 줍니다. 그동안 라이브 미리보기는 계속 실행됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje ekran w jasnym i ciemnym motywie, przy większym tekście i od prawej do lewej. Podgląd na żywo działa tymczasem dalej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra sua tela no claro e no escuro, em tamanhos de texto maiores e da direita para a esquerda. Enquanto isso, sua prévia ao vivo continua rodando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展示屏幕的浅色和深色外观、更大的文字尺寸以及从右到左的排版。实时预览同时继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "展示畫面的淺色和深色外觀、較大的文字尺寸以及從右到左的排版。即時預覽同時繼續執行。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser din skærm i lys og mørk, ved større tekststørrelser og fra højre mod venstre. Din live-forhåndsvisning kører videre imens."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää näyttösi vaalealla ja tummalla, suuremmilla tekstikoilla ja oikealta vasemmalle. Aktiivinen esikatselu jatkuu samaan aikaan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sýnir skjáinn í ljósu og dökku útliti, með stærri textastærðum og frá hægri til vinstri. Forskoðunin í beinni heldur áfram á meðan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser skjermen din i lys og mørk modus, med større tekststørrelser og høyre til venstre. Den levende forhåndsvisningen fortsetter imens."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar din skärm i ljust och mörkt, med större textstorlekar och höger till vänster. Din aktiva förhandsvisning fortsätter under tiden."
          }
        }
      }
    },
