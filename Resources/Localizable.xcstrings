    "%@ didn't respond. Check the connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat nicht geantwortet. Prüfe die Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't respond. Check the connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no respondió. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n’a pas répondu. Vérifiez la connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non ha risposto. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が応答しませんでした。接続を確認してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 응답하지 않았습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não respondeu. Verifique a conexão e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 没有响应。请检查连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 沒有回應。請檢查連線後再試一次。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie odpowiedział. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ svarede ikke. Kontrollér forbindelsen, og prøv igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ei vastannut. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarar ekki. Athugaðu tenginguna og reyndu aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarte ikke. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ svarade inte. Kontrollera anslutningen och försök igen."
          }
        }
      }
    },
    "%@ didn't take it and gave no reason.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat es nicht angenommen und keinen Grund genannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't take it and gave no reason."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no lo aceptó y no dio ningún motivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne l'a pas accepté et n'a donné aucune raison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non l'ha accettato e non ha fornito alcun motivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこれを受け付けず、理由も示されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이를 받아들이지 않았고 이유도 알려주지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não aceitou e não deu nenhum motivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒绝了请求，且未说明原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒絕了請求，且未說明原因。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie przyjął tego i nie podał powodu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tog den ikke og gav ingen grund."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei hyväksynyt sitä eikä antanut syytä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tók því ekki og gaf enga ástæðu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tok ikke imot det og oppga ingen grunn."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tog inte emot det och angav ingen anledning."
          }
        }
      }
    },
    "%@ downloads and builds %@, then restarts once nothing is running on it. Chats reconnect by themselves.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lädt %2$@ herunter und kompiliert es, dann startet es neu, sobald nichts mehr darauf läuft. Chats verbinden sich von selbst neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ downloads and builds %@, then restarts once nothing is running on it. Chats reconnect by themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ descarga y compila %2$@, y luego se reinicia en cuanto no queda nada en ejecución. Los chats se reconectan solos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ télécharge et compile %2$@, puis redémarre dès que plus rien n'y tourne. Les discussions se reconnectent d'elles-mêmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ scarica e compila %2$@, poi si riavvia non appena non c'è più nulla in esecuzione su di essa. Le chat si riconnettono da sole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が%2$@をダウンロードしてビルドし、その後何も実行されなくなり次第再起動します。チャットは自動で再接続されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) %2$@을(를) 다운로드하고 빌드한 다음, 아무것도 실행되지 않을 때 재시동됩니다. 채팅은 자동으로 다시 연결됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ baixa e compila %2$@, depois reinicia assim que nada mais estiver em execução nela. As conversas se reconectam sozinhas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 会下载并构建 %2$@，然后在没有任何内容运行时重新启动。聊天会自动重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 會下載並建置 %2$@，然後在沒有任何內容執行時重新開機。對話會自動重新連線。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pobiera i buduje %@, a potem uruchamia się ponownie, gdy nic już na nim nie działa. Rozmowy łączą się ponownie same."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ henter %2$@, laver en build og genstarter, når der ikke kører noget på den. Chats forbinder sig selv igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lataa ja koostaa %2$@, ja käynnistyy uudelleen, kun siinä ei enää aja mitään. Keskustelut yhdistyvät uudelleen itsestään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sækir %2$@ og byggir það, endurræsist síðan þegar ekkert er í gangi á því. Spjöll tengjast sjálf aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ laster ned og bygger %2$@, og starter deretter på nytt når ingenting kjører på den. Chatter kobles til igjen av seg selv."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hämtar och bygger %2$@, och startar sedan om när inget körs på den. Chattar ansluter igen av sig själva."
          }
        }
      }
    },
    "%@ downloads and builds the new version, then restarts once nothing is running on it. Chats reconnect by themselves.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lädt die neue Version herunter und kompiliert sie, dann startet es neu, sobald nichts mehr darauf läuft. Chats verbinden sich von selbst neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ downloads and builds the new version, then restarts once nothing is running on it. Chats reconnect by themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ descarga y compila la nueva versión, y luego se reinicia en cuanto no queda nada en ejecución. Los chats se reconectan solos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ télécharge et compile la nouvelle version, puis redémarre dès que plus rien n'y tourne. Les discussions se reconnectent d'elles-mêmes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ scarica e compila la nuova versione, poi si riavvia non appena non c'è più nulla in esecuzione su di essa. Le chat si riconnettono da sole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が新しいバージョンをダウンロードしてビルドし、その後何も実行されなくなり次第再起動します。チャットは自動で再接続されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 새 버전을 다운로드하고 빌드한 다음, 아무것도 실행되지 않을 때 재시동됩니다. 채팅은 자동으로 다시 연결됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ baixa e compila a nova versão, depois reinicia assim que nada mais estiver em execução nela. As conversas se reconectam sozinhas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会下载并构建新版本，然后在没有任何内容运行时重新启动。聊天会自动重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會下載並建置新版本，然後在沒有任何內容執行時重新開機。對話會自動重新連線。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pobiera i buduje nową wersję, a potem uruchamia się ponownie, gdy nic już na nim nie działa. Rozmowy łączą się ponownie same."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ henter den nye version, laver en build og genstarter, når der ikke kører noget på den. Chats forbinder sig selv igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lataa uuden version ja koostaa sen, ja käynnistyy uudelleen, kun siinä ei enää aja mitään. Keskustelut yhdistyvät uudelleen itsestään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sækir nýju útgáfuna og byggir hana, endurræsist síðan þegar ekkert er í gangi á því. Spjöll tengjast sjálf aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ laster ned og bygger den nye versjonen, og starter deretter på nytt når ingenting kjører på den. Chatter kobles til igjen av seg selv."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hämtar och bygger den nya versionen, och startar sedan om när inget körs på den. Chattar ansluter igen av sig själva."
          }
        }
      }
    },
