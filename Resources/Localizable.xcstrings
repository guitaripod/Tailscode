    "Switching reads this chat again, uncached: about %@ tokens, once.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching reads this chat again, uncached: about %@ tokens, once."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wechseln wird dieser Chat noch einmal ungecacht gelesen: etwa %@ Tokens, einmalig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar vuelve a leer este chat sin caché: unos %@ tokens, una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement relit cette conversation sans cache : environ %@ jetons, une seule fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cambio rilegge questa chat senza cache: circa %@ token, una volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替えるとこのチャットがキャッシュなしで再読み込みされます。約 %@ トークン、1 回のみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환하면 이 채팅을 캐시 없이 다시 읽습니다. 약 %@ 토큰, 한 번만."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternar lê este chat de novo, sem cache: cerca de %@ tokens, uma vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换时会不使用缓存重新读取此对话:约 %@ 词元,仅一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換時會不使用快取重新讀取此對話:約 %@ 詞元,僅一次。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przełączenie ponownie wczyta ten czat bez pamięci podręcznej: około %@ tokenów, jednorazowo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du skifter, læses denne chat igen uden cache: cirka %@ tokens, én gang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihtaminen lukee tämän keskustelun uudelleen ilman välimuistia: noin %@ tokenia, kerran."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipti les þetta spjall upp á nýtt, án skyndiminnis: um %@ tákn, einu sinni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved bytte leses denne chatten på nytt uten hurtigbuffer: omtrent %@ tokener, én gang."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vid byte läses den här chatten om utan cache: cirka %@ tokens, en gång."
          }
        }
      }
    },
    "The ladder shows the levels of the row you are on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ladder shows the levels of the row you are on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leiter zeigt die Stufen der aktuellen Zeile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escalera muestra los niveles de la fila en la que estás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’échelle montre les niveaux de la ligne sélectionnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scala mostra i livelli della riga selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラダーには、選択中の行のレベルが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사다리에는 현재 행의 단계가 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A escada mostra os níveis da linha em que você está."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阶梯显示当前所在行的级别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "階梯顯示目前所在列的級別。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drabina pokazuje poziomy wiersza, na którym jesteś."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stigen viser niveauerne for den række, du er på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Portaat näyttävät nykyisellä rivillä olevat tasot."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiginn sýnir stigin í röðinni sem þú ert í."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stigen viser nivåene for raden du er på."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stegen visar nivåerna för raden där du är."
          }
        }
      }
    },
    "The levels of the row under the cursor. A level set here goes with the pick.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The levels of the row under the cursor. A level set here goes with the pick."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stufen der Zeile unter dem Cursor. Eine hier gesetzte Stufe gilt mit der Auswahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los niveles de la fila bajo el cursor. Un nivel fijado aquí acompaña a la selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les niveaux de la ligne sous le curseur. Un niveau choisi ici suit la sélection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I livelli della riga sotto il cursore. Un livello impostato qui accompagna la scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーソル下の行のレベル。ここで設定したレベルは選択と一緒に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커서 아래 행의 단계입니다. 여기서 설정한 단계는 선택과 함께 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os níveis da linha sob o cursor. Um nível definido aqui acompanha a escolha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光标所在行的级别。在此设置的级别会随所选项一并生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "游標所在列的級別。在此設定的級別會隨所選項目一併生效。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poziomy wiersza pod kursorem. Poziom ustawiony tutaj jest stosowany razem z wyborem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Niveauerne for rækken under markøren. Et niveau, der er sat her, gælder med valget."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohdistimen alla olevan rivin tasot. Tässä asetettu taso kulkee valinnan mukana."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Stigin í röðinni undir bendlinum. Stig sem er stillt hér fylgir valinu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivåene for raden under markøren. Et nivå som settes her, gjelder sammen med valget."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivåerna för raden under markören. En nivå som ställs in här följer med valet."
          }
        }
      }
    },
