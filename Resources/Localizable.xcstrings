    "Nothing is running on it, so %@ brings it straight back on the new build — a few seconds.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts läuft gerade darauf, daher bringt %@ es sofort mit dem neuen Build zurück – wenige Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is running on it, so %@ brings it straight back on the new build — a few seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada en ejecución en ella, así que %@ la vuelve a poner en marcha directamente con el nuevo build: unos segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'y tourne, donc %@ la relance directement avec le nouveau build — quelques secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è nulla in esecuzione su di essa, quindi %@ la riporta subito attiva con il nuovo build: pochi secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのマシン上では何も実行されていないため、%@がすぐに新しいビルドで復帰させます — 数秒です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 머신에서 실행 중인 것이 없으므로, %@이(가) 새 빌드로 곧바로 되돌립니다 — 몇 초면 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada está em execução nela, então %@ a traz de volta imediatamente com o novo build — poucos segundos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于该机器上没有任何内容在运行，%@ 会立即以新版本将其带回——只需几秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於該機器上沒有任何內容在執行，%@ 會立即以新版本將其帶回——只需幾秒。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic na nim nie działa, więc %@ od razu przywraca go na nowym buildzie — kilka sekund."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet kører på den, så %@ henter den straks tilbage på den nye build – et par sekunder."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sillä ei ole käynnissä mitään, joten %@ käynnistää sen heti uudelleen uudella koonnilla – muutama sekunti."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert er í gangi á henni, svo %@ kemur henni strax aftur í gang á nýju útgáfunni – nokkrar sekúndur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting kjører på den, så %@ starter den rett igjen med det nye bygget – noen få sekunder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting körs på den, så %@ startar den direkt igen på den nya versionen – några sekunder."
          }
        }
      }
    },
