          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkouten på %@ har endringer som ikke er committet, så ingenting her vil røre den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkouten på %@ har ändringar som inte är committade, så ingenting här rör den."
