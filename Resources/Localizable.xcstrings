    "%@ tokens are in the conversation. How much %@ can hold is not reported, so there is no share to state.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tokens befinden sich in der Unterhaltung. Wie viel %@ fassen kann, wird nicht gemeldet, daher lässt sich kein Anteil angeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tokens are in the conversation. How much %@ can hold is not reported, so there is no share to state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay %@ tokens en la conversación. No se informa cuánto puede contener %@, así que no hay una proporción que indicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jetons se trouvent dans la conversation. La capacité de %@ n’est pas communiquée, il n’y a donc pas de proportion à indiquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella conversazione ci sono %@ token. Quanto può contenere %@ non viene comunicato, quindi non c’è una quota da indicare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話には %@ トークンがあります。%@ がどれだけ保持できるかは報告されないため、割合は示せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화에 %@ 토큰이 있습니다. %@이(가) 얼마나 담을 수 있는지는 보고되지 않으므로 표시할 비율이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há %@ tokens nesta conversa. Quanto %@ consegue conter não é informado, então não há uma proporção a indicar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话中共有 %@ 个词元。%@ 能容纳多少并未提供，因此无法给出占比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話中共有 %@ 個詞元。%@ 能容納多少並未提供，因此無法給出佔比。"
          }
        }
      }
    },
    "%@ tokens are in the conversation. This model's window is not reported, so there is no share to state.": {
