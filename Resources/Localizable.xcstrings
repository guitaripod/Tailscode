    "The next clip opens where “%@” ended — change the words, then render": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next clip opens where “%@” ended — change the words, then render"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der nächste Clip beginnt, wo “%@” endet – ändere die Worte und rendere dann"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El siguiente clip empieza donde terminó “%@”: cambia las palabras y luego renderiza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clip suivant commence là où “%@” s’est terminé : modifiez les mots, puis lancez le rendu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La clip successiva inizia dove è finita “%@”: modifica le parole, poi avvia il rendering"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のクリップは “%@” が終わったところから始まります。言葉を変えてから、レンダリングしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 클립은 “%@”이(가) 끝난 지점에서 시작합니다. 문구를 바꾼 뒤 렌더링하세요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następny klip zaczyna się tam, gdzie zakończył się “%@”. Zmień słowa, potem renderuj"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O próximo clipe começa onde “%@” terminou. Altere as palavras e depois renderize"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一个片段从“%@”结束的地方开始。修改文字后再渲染"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一個片段從“%@”結束的地方開始。修改文字後再算圖"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det næste klip begynder, hvor »%@« slutter – ændr ordene, og render derefter"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraava klippi alkaa siitä, mihin ”%@” päättyi. Muuta sanoja ja renderöi sitten"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Næsta myndskeið byrjar þar sem „%@“ endar – breyttu orðunum og renderaðu svo"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste klipp starter der «%@» endte – endre ordene, og render deretter"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nästa klipp startar där ”%@” slutade – ändra orden och rendera sedan"
          }
        }
      }
    },
    "The next clip opens on the last frame of this one. Change the words to say what happens next, then render": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next clip opens on the last frame of this one. Change the words to say what happens next, then render"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der nächste Clip beginnt beim letzten Bild dieses Clips. Ändere die Worte, damit sie beschreiben, was als Nächstes passiert, und rendere dann"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El siguiente clip empieza en el último fotograma de este. Cambia las palabras para decir qué pasa después y luego renderiza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le clip suivant commence sur la dernière image de celui-ci. Modifiez les mots pour dire ce qui se passe ensuite, puis lancez le rendu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La clip successiva parte dall’ultimo fotogramma di questa. Modifica le parole per dire cosa succede dopo, poi avvia il rendering"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のクリップは、このクリップの最後のフレームから始まります。次に何が起こるかを言葉で書き換えてから、レンダリングしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 클립은 이 클립의 마지막 프레임에서 시작합니다. 다음에 일어날 일을 문구로 바꾼 뒤 렌더링하세요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Następny klip zaczyna się od ostatniej klatki tego. Zmień słowa, opisując, co dzieje się dalej, a potem renderuj"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O próximo clipe começa no último quadro deste. Altere as palavras para dizer o que acontece em seguida e depois renderize"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一个片段从这个片段的最后一帧开始。修改文字，说明接下来发生什么，然后渲染"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一個片段從這個片段的最後一格開始。修改文字，說明接下來會發生什麼，然後算圖"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det næste klip begynder på det sidste billede i dette. Ændr ordene, så de beskriver, hvad der sker bagefter, og render derefter"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraava klippi alkaa tämän viimeisestä kuvasta. Muuta sanoja kuvaamaan, mitä seuraavaksi tapahtuu, ja renderöi sitten"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Næsta myndskeið byrjar á síðasta ramma þessa. Breyttu orðunum þannig að þau lýsi því sem gerist næst, og renderaðu svo"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste klipp starter på siste bilde i dette. Endre ordene slik at de beskriver hva som skjer videre, og render deretter"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nästa klipp startar på sista bildrutan i det här. Ändra orden så att de beskriver vad som händer härnäst och rendera sedan."
          }
        }
      }
    },
    "%@ has no record of this render — it was probably restarted before the clip was saved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no record of this render — it was probably restarted before the clip was saved"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat keinen Eintrag zu diesem Render – er wurde vermutlich neu gestartet, bevor der Clip gespeichert wurde"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene registro de este renderizado: probablemente se reinició antes de que se guardara el clip"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a aucune trace de ce rendu : il a probablement redémarré avant que le clip ne soit enregistré"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha traccia di questo rendering: probabilmente è stato riavviato prima del salvataggio della clip"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にはこのレンダリングの記録がありません。クリップが保存される前に再起動された可能性があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 이 렌더링 기록이 없습니다. 클립이 저장되기 전에 다시 시작된 것으로 보입니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie ma zapisu tego renderowania. Prawdopodobnie został uruchomiony ponownie, zanim klip zapisano"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem registro desta renderização: provavelmente foi reiniciado antes de o clipe ser salvo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有这次渲染的记录，很可能是在片段保存前重启了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有這次算圖的紀錄，很可能是在片段儲存前重新啟動了"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen registrering af dette render – den er sandsynligvis genstartet, før klippet blev gemt"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ei tunne tätä renderöintiä – se on todennäköisesti käynnistetty uudelleen ennen kuin klippi tallennettiin"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hefur enga skrá um þessa renderingu – líklega var endurræst áður en myndskeiðið var vistað"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har ingen oversikt over denne renderingen – den ble sannsynligvis startet på nytt før klippet ble lagret"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ känner inte till den här renderingen – den startades troligen om innan klippet sparades"
          }
        }
      }
    },
