    "Tailscode answers its own window only. Turn this on to ask from anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode reagiert nur im eigenen Fenster. Schalte dies ein, um von überall aus zu fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode answers its own window only. Turn this on to ask from anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode solo responde en su propia ventana. Activa esto para preguntar desde cualquier lugar."
          }
