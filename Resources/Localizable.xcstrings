    "Release to keep the words. Slide left to cancel.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release to keep the words. Slide left to cancel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loslassen, um die Wörter zu behalten. Nach links wischen zum Abbrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta para conservar las palabras. Desliza a la izquierda para cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relâchez pour garder les mots. Glissez à gauche pour annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilascia per tenere le parole. Scorri a sinistra per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "離すと話した内容を残します。左にスライドするとキャンセル。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손을 떼면 말한 내용을 유지합니다. 왼쪽으로 밀면 취소합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Puść, by zachować słowa. Przesuń w lewo, by anulować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte para manter as palavras. Deslize para a esquerda para cancelar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "松开保留文字。向左滑动取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放開即保留文字。向左滑動即取消。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip for at beholde ordene. Stryg til venstre for at annullere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vapauta, jotta sanat säilyvät. Peruuta pyyhkäisemällä vasemmalle."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
