    "This model has averaged %@ tok/s here over %d turns.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell hat hier über %2$d Züge hinweg durchschnittlich %1$@ Tok/s erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model has averaged %@ tok/s here over %d turns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo ha promediado %1$@ tok/s aquí a lo largo de %2$d turnos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle a atteint en moyenne %1$@ tok/s ici sur %2$d tours."
