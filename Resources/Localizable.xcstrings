          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge kører ikke på denne server. Start den der med systemctl --user start voice-bridge."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge ei ole käynnissä tällä palvelimella. Käynnistä se siellä komennolla systemctl --user start voice-bridge."
