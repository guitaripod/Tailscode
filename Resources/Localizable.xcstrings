    "A stopped turn pauses the queue. Nothing in it goes until you resume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stopped turn pauses the queue. Nothing in it goes until you resume"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gestoppter Zug pausiert die Warteschlange. Nichts darin wird gesendet, bis du fortsetzt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener un turno pone la cola en pausa. Nada de lo que contiene se envía hasta que la reanudes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour interrompu met la file en pause. Rien n'en part tant que vous ne la reprenez pas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un turno interrotto mette in pausa la coda. Nulla viene inviato finché non la riprendi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターンを停止するとキューが一時停止します。再開するまで何も送られません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴을 중지하면 대기열이 일시 정지됩니다. 재개할 때까지 아무것도 전송되지 않습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymana tura wstrzymuje kolejkę. Nic z niej nie zostanie wysłane, dopóki jej nie wznowisz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar um turno pausa a fila. Nada nela é enviado até você retomar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止一轮会暂停队列。在你恢复之前，其中的内容不会发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止一輪會暫停佇列。在你繼續之前，其中的內容不會傳送"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En stoppet tur pauser køen. Intet i den sendes, før du fortsætter"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pysäytetty vuoro keskeyttää jonon. Mitään siinä ei lähetetä, ennen kuin jatkat"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Stöðvuð umferð setur biðröðina í bið. Ekkert í henni fer fyrr en þú heldur áfram"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En stoppet tur setter køen på pause. Ingenting i den sendes før du fortsetter"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En stoppad tur pausar kön. Inget i den skickas förrän du fortsätter"
          }
        }
      }
    },
