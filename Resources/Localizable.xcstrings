    "Automatic follows the first language in your Mac's preferred list. Nothing you say leaves it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic follows the first language in your Mac's preferred list. Nothing you say leaves it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch folgt der ersten Sprache in deiner Vorzugsliste des Macs. Nichts, was du sagst, verlässt ihn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático sigue el primer idioma de la lista preferida de tu Mac. Nada de lo que digas sale de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique suit la première langue de la liste préférée de votre Mac. Rien de ce que vous dites ne quitte le Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatico segue la prima lingua nell'elenco preferito del Mac. Nulla di ciò che dici esce dal Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動は Mac の優先言語リストの先頭の言語に従います。話した内容は Mac から外に出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 Mac의 기본 언어 목록에서 첫 번째 언어를 따릅니다. 말한 내용은 기기 밖으로 나가지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie wybiera pierwszy język z listy preferowanych języków Mac. Nic, co powiesz, nie opuszcza go."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático usa o primeiro idioma da lista de preferências do seu Mac. Nada do que você disser sai dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动跟随 Mac 偏好列表中的第一种语言。你说的话不会离开 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動會依你 Mac 偏好語言清單中的第一種語言辨識。你說的內容都不會離開 Mac。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk følger det første sprog på din Macs foretrukne liste. Intet, du siger, forlader den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen seuraa Macin ensisijaisten kielten luettelon ensimmäistä kieltä. Mikään sanomasi ei poistu Macista."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjálfvirkt fylgir fyrsta tungumálinu á óskalista Macsins þíns. Ekkert sem þú segir fer úr honum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk følger første språk i Macens foretrukne liste. Ingenting du sier forlater Macen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiskt följer första språket i Macens språklista. Inget du säger lämnar Mac:en."
          }
        }
      }
    },
    "Automatic follows the keyboard you are typing with. Nothing you say leaves this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic follows the keyboard you are typing with. Nothing you say leaves this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch folgt der Tastatur, mit der du schreibst. Nichts, was du sagst, verlässt dieses Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático sigue el teclado con el que escribes. Nada de lo que digas sale de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique suit la disposition du clavier que vous utilisez. Rien de ce que vous dites ne quitte cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatico segue la tastiera che stai usando. Nulla di ciò che dici esce da questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動は入力中のキーボードに従います。話した内容はこの機器から外に出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 입력 중인 키보드를 따릅니다. 말한 내용은 이 기기를 떠나지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie wybiera układ klawiatury, na której piszesz. Nic, co powiesz, nie opuszcza tego urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático segue o teclado que você está usando. Nada do que você disser sai deste aparelho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动跟随你正在使用的键盘。你说的话不会离开这台设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動會依你正在使用的鍵盤語言辨識。你說的內容都不會離開這台裝置。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk følger det tastatur, du skriver med. Intet, du siger, forlader denne enhed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen seuraa näppäimistöä, jolla kirjoitat. Mikään sanomasi ei poistu tältä laitteelta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjálfvirkt fylgir lyklaborðinu sem þú skrifar á. Ekkert sem þú segir fer úr þessu tæki."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk følger tastaturet du skriver med. Ingenting du sier forlater denne enheten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiskt följer tangentbordet du skriver med. Inget du säger lämnar enheten."
          }
        }
      }
    },
