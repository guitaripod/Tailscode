            "value": "Läser in nya modeller, konfiguration och plugins"
          }
        }
      }
    },
    "The server stops answering for a few seconds and comes back with everything it reads at startup — models, config, plugins.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server antwortet für ein paar Sekunden nicht und kommt danach mit allem zurück, was er beim Start einliest — Modelle, Konfiguration, Plugins."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server stops answering for a few seconds and comes back with everything it reads at startup — models, config, plugins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor deja de responder durante unos segundos y vuelve con todo lo que lee al iniciar — modelos, configuración, complementos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur cesse de répondre pendant quelques secondes, puis revient avec tout ce qu’il lit au démarrage — modèles, configuration, extensions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server smette di rispondere per qualche secondo e torna con tutto ciò che legge all’avvio — modelli, configurazione, plugin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバは数秒間応答を停止し、その後、起動時に読み込むすべて — モデル、設定、プラグイン — を反映して復帰します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 몇 초간 응답을 멈췄다가, 시작할 때 읽어들이는 모든 것 — 모델, 설정, 플러그인 — 을 반영해 돌아옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor para de responder por alguns segundos e volta com tudo o que lê na inicialização — modelos, configuração, plugins."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器会停止响应几秒钟，然后带着它启动时读取的一切重新上线 — 模型、配置、插件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器會停止回應幾秒鐘，然後帶著它啟動時讀取的一切重新上線 — 模型、設定、外掛。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer przestaje odpowiadać na kilka sekund, a potem wraca ze wszystkim, co wczytuje przy starcie — modelami, konfiguracją, wtyczkami."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren svarer ikke i et par sekunder og kommer tilbage med alt, den læser ved opstart – modeller, konfiguration, plugins."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin lakkaa vastaamasta muutamaksi sekunniksi ja palaa lukien uudelleen kaiken, minkä se lukee käynnistyessään: mallit, asetukset ja liitännäiset."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Netþjónninn hættir að svara í nokkrar sekúndur og kemur aftur með öllu sem hann les við ræsingu – líkönum, stillingum, viðbótum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren slutter å svare i noen sekunder og kommer tilbake med alt den leser ved oppstart: modeller, konfigurasjon, plugins."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern slutar svara i några sekunder och kommer tillbaka med allt den läser vid start – modeller, konfiguration, plugins."
          }
        }
      }
    },
    "A turn is running on it. Restarting stops it where it stands.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf ihm läuft gerade ein Zug. Ein Neustart stoppt ihn genau dort, wo er steht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A turn is running on it. Restarting stops it where it stands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un turno en curso en él. Reiniciar lo detiene justo donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour est en cours dessus. Le redémarrage l’arrête là où il en est."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C’è un turno in corso su di esso. Il riavvio lo interrompe esattamente dove si trova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこでは 1 件のターンが実行中です。再起動すると、その時点で止まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 위에서 턴 1개가 실행 중입니다. 재시동하면 지금 상태 그대로 멈춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um turno em execução nele. Reiniciar o interrompe onde estiver."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上面正在运行一个回合。重新启动会让它停在当前位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上面正在執行一個回合。重新開機會讓它停在目前位置。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa na nim tura. Ponowne uruchomienie zatrzyma ją w miejscu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kører en tur på den. Genstart stopper den, hvor den står."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelimella on käynnissä vuoro. Uudelleenkäynnistys pysäyttää sen siihen paikkaan, jossa se on."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Umferð er í gangi á honum. Endurræsing stöðvar hana þar sem hún stendur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En tur kjører på den. Omstart stopper den der den står."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tur körs på den. Omstart stoppar den där den står."
          }
        }
      }
    },
