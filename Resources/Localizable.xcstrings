            "state": "translated",
            "value": "No servers yet — add the machine your agent runs on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay servidores: añade la máquina en la que se ejecuta tu agente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de serveurs — ajoutez la machine sur laquelle tourne votre agent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun server — aggiungi la macchina su cui gira il tuo agente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバがまだありません — エージェントを実行しているマシンを追加してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 서버가 없습니다 — 에이전트가 실행 중인 머신을 추가하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há servidores — adicione a máquina em que seu agente roda"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有服务器 — 添加运行你智能体的那台机器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有伺服器 — 新增執行你代理的那台機器"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak serwerów — dodaj komputer, na którym działa twój agent"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen servere endnu – tilføj den computer, din agent kører på"
