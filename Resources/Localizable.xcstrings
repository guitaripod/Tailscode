          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostik fra forbindelser, chats og synkroniseringer vises her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteyksien, keskustelujen ja synkronointien diagnostiikka näkyy tässä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Greiningar um tengingar, spjall og samstillingar birtast hér."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostikk fra tilkoblinger, chatter og synkroniseringer vises her."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
