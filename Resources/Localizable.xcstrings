    "No servers yet — add the machine your agent runs on": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Server — füge den Rechner hinzu, auf dem dein Agent läuft"
          }
        },
        "en": {
