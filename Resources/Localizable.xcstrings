    "%d%% of what the model read came from cache, saving %@ against fresh-input prices": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d %% dessen, was das Modell gelesen hat, kam aus dem Cache und sparte %2$@ gegenüber den Preisen für frische Eingaben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% of what the model read came from cache, saving %@ against fresh-input prices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El %1$d %% de lo que el modelo leyó vino de la caché, ahorrando %2$@ frente a los precios de entrada nueva"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d %% de ce que le modèle a lu provenait du cache, économisant %2$@ par rapport aux tarifs d’entrée neuve"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il %1$d%% di ciò che il modello ha letto proveniva dalla cache, risparmiando %2$@ rispetto ai prezzi di input nuovo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが読み取った内容の %1$d%% はキャッシュからのもので、新規入力の料金と比べて %2$@ を節約しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 읽은 내용의 %1$d%%가 캐시에서 왔으며, 새 입력 가격 대비 %2$@를 절약했습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d%% do que o modelo leu veio do cache, economizando %2$@ em relação aos preços de entrada nova"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型读取的内容中有 %1$d%% 来自缓存，相比全新输入价格节省了 %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型讀取的內容中有 %1$d%% 來自快取，相比全新輸入價格節省了 %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d%% tego, co model odczytał, pochodziło z cache’u, oszczędzając %2$@ względem cen świeżych danych wejściowych"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%d %% af det, som modellen læste, kom fra cache og sparede %@ i forhold til priserne for friske input"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% mallin lukemasta sisällöstä tuli välimuistista, mikä säästi %@ verrattuna uusien syötteiden hintoihin"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%d %% af því sem líkanið las kom úr skyndiminni og sparaði %@ miðað við verð á nýjum inntökum"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% av det modellen leste kom fra hurtigbufferen og sparte %@ sammenlignet med priser for ny inndata"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%d %% av det modellen läste kom från cacheminnet, vilket sparade %@ jämfört med priser för nya indata"
          }
        }
      }
    },
