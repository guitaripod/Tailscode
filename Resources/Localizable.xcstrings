    "Shared with the video renderer — one ComfyUI holds both sets of models.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeinsam mit dem Video-Renderer genutzt — ein ComfyUI verwaltet beide Modellsätze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared with the video renderer — one ComfyUI holds both sets of models."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartido con el renderizador de vídeo — un mismo ComfyUI aloja ambos conjuntos de modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagé avec la machine de rendu vidéo — un seul ComfyUI héberge les deux jeux de modèles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condiviso con la macchina di rendering video — un solo ComfyUI ospita entrambi i set di modelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画レンダラーと共有しています — 1つの ComfyUI が両方のモデル一式を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동영상 렌더러와 공유됩니다 — 하나의 ComfyUI가 두 모델 세트를 모두 보유합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhado com a máquina de renderização de vídeo — um único ComfyUI guarda os dois conjuntos de modelos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与视频渲染机共用 — 一个 ComfyUI 同时保存两套模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與影片算圖機共用 — 一個 ComfyUI 同時保存兩套模型。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Współdzielone z rendererem wideo — jedno ComfyUI przechowuje oba zestawy modeli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Delt med videorendereren – én ComfyUI har begge sæt modeller."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaettu videorenderöijän kanssa: yksi ComfyUI pitää molemmat mallisarjat."
          }
        },
