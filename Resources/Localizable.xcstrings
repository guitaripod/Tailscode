    "The voice model is still loading on the server, which can take a few minutes. Try again shortly.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice model is still loading on the server, which can take a few minutes. Try again shortly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sprachmodell wird auf dem Server noch geladen, das kann einige Minuten dauern. Versuche es gleich erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de voz todavía se está cargando en el servidor, lo que puede tardar unos minutos. Inténtalo de nuevo en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle vocal se charge encore sur le serveur, ce qui peut prendre quelques minutes. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello vocale si sta ancora caricando sul server, può richiedere alcuni minuti. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーで音声モデルを読み込み中です。数分かかることがあります。少し待ってから再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 음성 모델을 아직 불러오는 중이에요. 몇 분 걸릴 수 있어요. 잠시 후 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model głosowy wciąż się ładuje na serwerze, co może potrwać kilka minut. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de voz ainda está carregando no servidor, o que pode levar alguns minutos. Tente de novo em breve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器上的语音模型仍在加载，可能需要几分钟。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器上的語音模型仍在載入，可能需要幾分鐘。請稍後再試。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmemodellen indlæses stadig på serveren, hvilket kan tage et par minutter. Prøv igen om lidt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Puhemalli ladataan vielä palvelimella, mikä voi kestää muutaman minuutin. Yritä hetken päästä uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Raddlíkanið er enn að hlaðast inn á netþjóninum, sem getur tekið nokkrar mínútur. Reyndu aftur fljótlega."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmemodellen laster fortsatt på serveren, noe som kan ta noen minutter. Prøv igjen om litt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Röstmodellen laddas fortfarande på servern, vilket kan ta några minuter. Försök igen strax."
          }
        }
      }
    },
