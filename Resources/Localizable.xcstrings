    "Nothing this app raises will reach you until notifications are turned on for it in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts, was diese App auslöst, erreicht dich, bis Mitteilungen dafür in den Systemeinstellungen aktiviert sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing this app raises will reach you until notifications are turned on for it in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de lo que esta app muestre te llegará hasta que actives las notificaciones para ella en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de ce que cette app déclenche ne vous parviendra tant que les notifications ne seront pas activées pour elle dans Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla di ciò che questa app genera ti raggiungerà finché le notifiche non saranno attivate per essa in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でこのアプリの通知をオンにするまで、このアプリが発する通知は届きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 이 앱의 알림을 켜기 전까지는 이 앱이 보내는 어떤 알림도 도착하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada do que este app mostrar vai chegar até você enquanto as notificações não forem ativadas para ele em Ajustes do Sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置里为这个应用打开通知之前，它发出的任何提醒都不会送达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定裡為這個應用程式打開通知之前，它發出的任何提醒都不會送達。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic, co wywoła ta aplikacja, do ciebie nie dotrze, dopóki nie włączysz dla niej powiadomień w Ustawieniach systemowych."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen notifikationer fra denne app når dig, før de er slået til for appen i Systemindstillinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään tämän sovelluksen lähettämä ilmoitus ei tavoita sinua, ennen kuin ilmoitukset on otettu käyttöön sille Järjestelmäasetuksissa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert sem þetta forrit sendir berst þér fyrr en tilkynningar eru kveiktar fyrir það í Kerfisstillingum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen varsler fra denne appen når deg før varsler er slått på for appen i Systeminnstillinger."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget som den här appen skickar når dig förrän aviseringar är påslagna för den i Systeminställningar."
          }
        }
      }
    },
