    "The linker cannot find the Kit on the runner. Pinning the checkout fixes it, and the test passes locally.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The linker cannot find the Kit on the runner. Pinning the checkout fixes it, and the test passes locally."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Linker findet das Kit auf dem Runner nicht. Ein fixierter Checkout behebt das, und der Test läuft lokal durch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlazador no encuentra el Kit en el runner. Fijar el checkout lo soluciona, y el test pasa en local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'éditeur de liens ne trouve pas le Kit sur le runner. Épingler le checkout corrige le problème, et le test passe en local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il linker non trova il Kit sul runner. Fissare il checkout risolve, e il test passa in locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランナー上でリンカーが Kit を見つけられません。チェックアウトを固定すると直り、テストはローカルで通ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "러너에서 링커가 Kit을 찾지 못합니다. 체크아웃을 고정하면 해결되고, 테스트는 로컬에서 통과합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linker nie znajduje Kit na runnerze. Przypięcie checkoutu to naprawia, a test przechodzi lokalnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O linker não encontra o Kit no runner. Fixar o checkout resolve, e o teste passa localmente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接器在 runner 上找不到 Kit。固定检出版本即可解决，且测试在本地通过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結器在 runner 上找不到 Kit。固定檢出版本即可解決，且測試在本機通過。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkeren kan ikke finde Kittet på runneren. Når checkouten fastgøres, løses det, og testen går igennem lokalt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkkeri ei löydä Kit-kirjastoa CI-koneelta. Checkoutin kiinnittäminen korjaa sen, ja testi menee läpi paikallisesti."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengillinn finnur ekki Kit á keyrsluvélinni. Að festa checkout lagar það og prófið stenst á staðnum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkeren finner ikke Kit på runneren. Å låse checkouten løser det, og testen består lokalt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Länkaren hittar inte Kit på runnern. Att låsa checkouten åtgärdar det, och testet går igenom lokalt."
          }
        }
      }
    },
