    "Archive a chat from its row menu to set it aside without deleting it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiviere einen Chat über sein Zeilenmenü, um ihn beiseitezulegen, ohne ihn zu löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive a chat from its row menu to set it aside without deleting it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiva un chat desde su menú de fila para apartarlo sin eliminarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivez une discussion depuis son menu de ligne pour la mettre de côté sans la supprimer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivia una chat dal suo menu di riga per metterla da parte senza eliminarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行のメニューからチャットをアーカイブすると、削除せずに脇へ置いておけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행 메뉴에서 채팅을 보관하면 삭제하지 않고 한쪽으로 치워둘 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquive um chat pelo menu da linha para deixá-lo de lado sem excluí-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在行菜单中归档一段对话，可以把它搁置一旁而不删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在列選單中封存一段對話，可以把它擱置一旁而不刪除。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarchiwizuj rozmowę z menu jej wiersza, by odłożyć ją na bok bez usuwania."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkivér en chat fra dens rækkemenu for at lægge den til side uden at slette den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkistoi keskustelu rivivalikosta, jotta se siirtyy sivuun poistamatta sitä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Geymdu spjall úr línuvalmyndinni til að leggja það til hliðar án þess að eyða því."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkiver en chat fra radmenyen for å legge den til side uten å slette den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkivera en chatt från dess radmeny för att lägga undan den utan att ta bort den."
          }
        }
      }
    },
    "Archived chats stay on their server — archiving only hides them from this device's lists. One that goes live again resurfaces by itself.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivierte Chats bleiben auf ihrem Server — das Archivieren blendet sie nur aus den Listen dieses Geräts aus. Wird einer wieder aktiv, taucht er von selbst wieder auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived chats stay on their server — archiving only hides them from this device's lists. One that goes live again resurfaces by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los chats archivados permanecen en su servidor — archivarlos solo los oculta de las listas de este dispositivo. Uno que vuelva a estar activo reaparece por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les discussions archivées restent sur leur serveur — l’archivage ne fait que les masquer des listes de cet appareil. Une discussion qui redevient active réapparaît d’elle-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat archiviate restano sul loro server — l’archiviazione le nasconde solo dagli elenchi di questo dispositivo. Una che torna attiva riemerge da sola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブされたチャットはサーバ上に残ります。アーカイブは、このデバイスの一覧から隠すだけです。再び動き出したチャットは自動的に再表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관한 채팅은 서버에 그대로 남아 있습니다 — 보관은 이 기기의 목록에서만 숨길 뿐입니다. 다시 활동하는 채팅은 저절로 다시 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os chats arquivados permanecem no servidor deles — arquivar apenas os oculta das listas deste dispositivo. Um que volte a ficar ativo ressurge sozinho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已归档的对话仍保留在它们的服务器上 — 归档只是把它们从这台设备的列表中隐藏。一旦重新活跃，就会自动重新出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已封存的對話仍保留在它們的伺服器上 — 封存只是把它們從這台裝置的清單中隱藏。一旦重新活躍，就會自動重新出現。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarchiwizowane rozmowy pozostają na swoim serwerze — archiwizacja tylko ukrywa je z list tego urządzenia. Ta, która znów staje się aktywna, sama wypływa na powierzchnię."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkiverede chats bliver på deres server; arkivering skjuler dem kun fra denne enheds lister. En chat, der bliver aktiv igen, dukker selv op igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkistoidut keskustelut pysyvät palvelimellaan – arkistointi piilottaa ne vain tämän laitteen luetteloista. Keskustelu, joka palaa aktiiviseksi, ilmestyy listalle itsestään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Geymd spjöll haldast á netþjóninum sínum – geymsla felur þau aðeins á listum þessa tækis. Spjall sem verður virkt aftur birtist af sjálfu sér."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkiverte chatter forblir på serveren sin. Arkivering skjuler dem bare fra denne enhetens lister. En som blir aktiv igjen, dukker opp av seg selv."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkiverade chattar finns kvar på sin server – arkivering döljer dem bara från enhetens listor. En chatt som blir aktiv igen dyker upp av sig själv."
          }
        }
      }
    },
    "As much as the size can hold": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So viel, wie die Größe fasst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As much as the size can hold"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que el tamaño permita"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autant que la taille peut contenir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che la dimensione può contenere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズが許す限りすべて"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기가 허용하는 만큼 모두"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quanto o tamanho permitir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在尺寸允许范围内尽量多显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在尺寸允許範圍內盡量多顯示"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyle, ile pomieści rozmiar"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Så meget som størrelsen kan rumme"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Niin paljon kuin kokoon mahtuu"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eins mikið og stærðin rúmar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Så mye som størrelsen rommer"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så mycket som storleken rymmer"
          }
        }
      }
    },
    "Ask your agent anything, no project, no setup.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag deinen Agenten alles — kein Projekt, keine Einrichtung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask your agent anything, no project, no setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a tu agente lo que sea, sin proyecto, sin configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez n’importe quoi à votre agent, sans projet, sans configuration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi qualsiasi cosa al tuo agente, senza progetto, senza configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトも設定も不要で、エージェントに何でも質問できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트도 설정도 없이, 에이전트에게 무엇이든 물어보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte qualquer coisa ao seu agente, sem projeto, sem configuração."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需项目，无需设置，随时向你的智能体提问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需專案，無需設定，隨時向你的代理提問。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj swojego agenta o cokolwiek — bez projektu, bez konfiguracji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørg din agent om hvad som helst, uden projekt og uden opsætning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysy agentiltasi mitä tahansa, ilman projektia ja ilman asetuksia."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spurðu agentinn hvers sem er – ekkert verkefni, engin uppsetning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør agenten din om hva som helst, uten prosjekt og uten oppsett."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga din agent vad som helst, inget projekt och ingen inställning krävs."
          }
        }
      }
    },
