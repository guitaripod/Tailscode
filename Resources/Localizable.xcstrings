    "Caching kept %@ off the ledger — more than the window itself cost": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caching hat %@ von der Rechnung ferngehalten — mehr, als der Zeitraum selbst gekostet hat"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caching kept %@ off the ledger — more than the window itself cost"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El uso de caché evitó %@ en la factura, más de lo que costó la propia ventana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise en cache a évité %@ sur la facture — plus que ce qu’a coûté la période elle-même"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cache ha tenuto %@ fuori dal conto — più di quanto sia costata la finestra stessa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュにより %@ を請求から除外できました — この期間自体の費用より多い額です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐싱 덕분에 %@가 청구서에서 빠졌습니다 — 이 기간 자체 비용보다 많은 금액입니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cache manteve %@ fora da conta — mais do que a própria janela custou"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存让 %@ 免于计入账单 — 超过了该窗口期本身的花费"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快取讓 %@ 免於計入帳單 — 超過了該視窗期間本身的花費"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buforowanie uchroniło %@ przed rachunkiem — więcej, niż kosztowało samo to okno"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Caching holdt %@ ude af regningen – mere, end perioden selv kostede"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välimuisti piti %@ pois laskusta: enemmän kuin ajanjakso itse maksoi"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skyndiminni hélt %@ utan reikningsins, meira en tímabilið sjálft kostaði"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hurtigbufring holdt %@ utenfor regningen, mer enn selve perioden kostet"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachning sparade %@ utanför bokföringen, mer än perioden kostade i sig"
          }
        }
      }
    },
