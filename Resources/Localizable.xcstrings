    "Your browser confirms it, not this app — no password is typed here and none is kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Browser bestätigt es, nicht diese App — hier wird kein Passwort eingegeben und keines gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your browser confirms it, not this app — no password is typed here and none is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu navegador lo confirma, no esta app: aquí no se escribe ninguna contraseña ni se guarda ninguna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
