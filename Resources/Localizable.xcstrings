    "No opencode or Claude Code servers found.\nMake sure the servers are running and listening on ports 4096/4098.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine opencode- oder Claude-Code-Server gefunden.\nStelle sicher, dass die Server laufen und auf Port 4096/4098 lauschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No opencode or Claude Code servers found.\nMake sure the servers are running and listening on ports 4096/4098."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron servidores de opencode ni Claude Code.\nAsegúrate de que los servidores estén activos y escuchando en los puertos 4096/4098."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun serveur opencode ou Claude Code trouvé.\nVérifiez que les serveurs tournent et écoutent sur les ports 4096/4098."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun server opencode o Claude Code trovato.\nAssicurati che i server siano in esecuzione e in ascolto sulle porte 4096/4098."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode または Claude Code のサーバが見つかりません。\nサーバが起動し、ポート 4096/4098 で待ち受けているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode 또는 Claude Code 서버를 찾지 못했습니다.\n서버가 실행 중이며 4096/4098 포트에서 대기하는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum servidor opencode ou Claude Code encontrado.\nVerifique se os servidores estão rodando e escutando nas portas 4096/4098."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 opencode 或 Claude Code 服务器。\n请确认服务器正在运行并监听 4096/4098 端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到 opencode 或 Claude Code 伺服器。\n請確認伺服器正在執行並監聽 4096/4098 連接埠。"
          }
        }
      }
    },
