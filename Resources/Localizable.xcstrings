    "This build is stamped %@ and the newest published is %@, which cannot be ranked against each other.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build ist mit %1$@ gestempelt, und die neueste veröffentlichte Version ist %2$@ – beide lassen sich nicht miteinander vergleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build is stamped %@ and the newest published is %@, which cannot be ranked against each other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este build está marcado como %1$@ y la última versión publicada es %2$@, que no se pueden comparar entre sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce build porte l'estampille %1$@ et la dernière version publiée est %2$@, deux valeurs impossibles à comparer entre elles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo build è contrassegnato come %1$@ e l'ultima versione pubblicata è %2$@, valori che non si possono confrontare tra loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドには%1$@という刻印があり、公開されている最新バージョンは%2$@です。両者は互いに順序を比較できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에는 %1$@(이)라는 기록이 있고, 공개된 최신 버전은 %2$@입니다. 이 둘은 서로 순위를 매길 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este build está marcado como %1$@ e a versão mais recente publicada é %2$@, que não podem ser comparadas entre si."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的时间戳是 %1$@，而最新发布的版本是 %2$@，两者无法互相比较大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的時間戳記是 %1$@，而最新發布的版本是 %2$@，兩者無法互相比較大小。"
          }
        }
      }
    },
