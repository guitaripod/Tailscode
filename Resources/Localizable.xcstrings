            "value": "シェブロンで、それを実行する他のプロバイダを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화살표를 누르면 이 모델을 실행하는 다른 제공자가 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A seta abre os outros provedores que o executam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按箭头可展开运行它的其他提供方。"
