    "This turn had been running %@ when the machine running it stopped. It was noticed %@, when the server came back — nothing was wrong with what you asked.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Zug lief bereits %@, als der Rechner, auf dem er lief, stoppte. Es wurde %@ bemerkt, als der Server zurückkam — an deiner Anfrage war nichts falsch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This turn had been running %@ when the machine running it stopped. It was noticed %@, when the server came back — nothing was wrong with what you asked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este turno llevaba %@ en marcha cuando la máquina que lo ejecutaba se detuvo. Se detectó %@, cuando el servidor volvió — no había nada malo en lo que pediste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce tour tournait depuis %@ quand la machine qui l’exécutait s’est arrêtée. Cela a été remarqué %@, quand le serveur est revenu — il n’y avait rien de mal dans votre demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo turno era in corso da %@ quando la macchina che lo eseguiva si è fermata. È stato notato %@, quando il server è tornato — non c’era nulla di sbagliato in quello che hai chiesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターンは %@ 実行されていましたが、実行していたマシンが停止しました。サーバが復帰した %@ に気づかれました — あなたが依頼した内容に問題はありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 턴은 %@ 동안 실행되고 있었는데, 실행 중이던 컴퓨터이 멈췄습니다. 서버가 돌아온 %@ 후에 알아차렸습니다 — 요청하신 내용에는 문제가 없었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este turno já rodava havia %@ quando a máquina que o executava parou. Isso foi percebido %@, quando o servidor voltou — não havia nada de errado no que você pediu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个回合已经运行了 %@，运行它的机器就停止了。服务器恢复后 %@ 才发现——你的请求本身没有任何问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個回合已經執行了 %@，執行它的機器就停止了。伺服器恢復後 %@ 才發現——你的請求本身沒有任何問題。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta tura trwała już %@, gdy komputer, na którym działała, przestał działać. Zauważono to %@, gdy serwer wrócił — z twoim poleceniem wszystko było w porządku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Turen havde kørt i %@, da computeren, der kørte den, stoppede. Det blev bemærket %@, da serveren kom tilbage – det, du bad om, var ikke galt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä vuoro oli käynnissä %@, kun sitä suorittanut tietokone pysähtyi. Pysähtyminen huomattiin %@, kun palvelin palasi. Pyynnössäsi ei ollut mitään vikaa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi umferð hafði verið í gangi í %@ þegar tölvan sem keyrði hana stöðvaðist. Það var tekið eftir því %@, þegar netþjónninn kom aftur: ekkert var að því sem þú baðst um."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne turen hadde kjørt i %@ da maskinen som kjørte den stoppet. Det ble lagt merke til %@, da serveren kom tilbake: det var ingenting galt med det du ba om."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här turen hade pågått i %@ när datorn som körde den stannade. Det märktes %@, när servern kom tillbaka – det var inget fel på det du bad om."
          }
        }
      }
    },
