    "One path or glob per line. Anything the worker changes outside them fails the attempt.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Pfad oder Glob pro Zeile. Ändert der Worker etwas außerhalb davon, schlägt der Versuch fehl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One path or glob per line. Anything the worker changes outside them fails the attempt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ruta o patrón glob por línea. Si el worker modifica algo fuera de ellas, el intento falla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chemin ou un glob par ligne. Si le worker modifie quoi que ce soit en dehors, la tentative échoue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un percorso o glob per riga. Se il worker modifica qualcosa al di fuori, il tentativo fallisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 行につき 1 つのパスまたは glob パターンを指定してください。ワーカーがそれ以外を変更すると、その試行は失敗になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 경로나 glob 패턴을 하나씩 적으세요. 워커가 그 밖의 파일을 변경하면 시도가 실패합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um caminho ou glob por linha. Se o worker alterar algo fora deles, a tentativa falha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行填写一个路径或 glob 匹配模式。执行者只要修改了范围之外的内容，这次尝试就会失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行填寫一個路徑或 glob 比對模式。執行者只要修改了範圍之外的內容，這次嘗試就會失敗。"
          }
        }
      }
    },
