    "The packet, the ladder and the tier a class starts at keep moving between releases": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The packet, the ladder and the tier a class starts at keep moving between releases"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Paket, die Leiter und die Stufe, bei der eine Klasse beginnt, ändern sich zwischen Versionen weiter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete, la escalera y el nivel en el que empieza una clase siguen cambiando entre versiones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet, l’échelle et le palier où démarre une classe continuent d’évoluer d’une version à l’autre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pacchetto, la scala e il livello da cui parte una classe continuano a cambiare da una versione all’altra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パケット、ラダー、クラスが始まるティアは、リリースごとに変わり続けます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패킷, 래더, 그리고 클래스가 시작하는 티어는 릴리스마다 계속 바뀝니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakiet, drabina i poziom, od którego zaczyna klasa, wciąż zmieniają się między wersjami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pacote, a escada e o nível em que uma classe começa continuam mudando entre versões"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据包、阶梯以及某个类别的起始层级，在各个版本之间还会不断变化"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封包、階梯以及某個類別的起始層級，在各個版本之間還會不斷變化"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakken, stigen og det niveau, en klasse starter på, bliver ved med at ændre sig mellem udgivelser"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketti, portaat ja taso, josta luokka alkaa, muuttuvat edelleen julkaisujen välillä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakkinn, stiginn og þrepið sem flokkur byrjar í breytast enn milli útgáfna"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakken, stigen og nivået en klasse starter på, endrer seg fortsatt mellom versjoner"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppgiftspaketet, stegen och nivån som en klass startar på ändras hela tiden mellan versionerna"
          }
        }
      }
    },
    "Use headphones, or the model hears its own voice and answers itself": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use headphones, or the model hears its own voice and answers itself"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutze Kopfhörer, sonst hört das Modell seine eigene Stimme und antwortet sich selbst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa auriculares, o el modelo oirá su propia voz y se responderá a sí mismo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un casque, sinon le modèle entend sa propre voix et se répond à lui-même"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa le cuffie, altrimenti il modello sente la propria voce e si risponde da solo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘッドホンを使ってください。使わないと、モデルが自分の声を聞いて自分に答えてしまいます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "헤드폰을 사용하세요. 그렇지 않으면 모델이 자기 목소리를 듣고 스스로 대답합니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj słuchawek, inaczej model usłyszy własny głos i zacznie odpowiadać sam sobie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use fones de ouvido, ou o modelo ouve a própria voz e responde a si mesmo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用耳机，否则模型会听到自己的声音并自问自答"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用耳機，否則模型會聽到自己的聲音並自問自答"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug hovedtelefoner, ellers hører modellen sin egen stemme og svarer sig selv"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä kuulokkeita, muuten malli kuulee oman äänensä ja vastaa itselleen"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Notaðu heyrnartól, annars heyrir líkanið sína eigin rödd og svarar sjálft sér."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk hodetelefoner, ellers hører modellen sin egen stemme og svarer seg selv"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd hörlurar, annars hör modellen sin egen röst och svarar sig själv"
          }
        }
      }
    },
