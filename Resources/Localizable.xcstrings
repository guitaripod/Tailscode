    "%@ refused to grant a key and said no more.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ refused to grant a key and said no more."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die Freigabe eines Schlüssels verweigert und nichts weiter gesagt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se negó a conceder una clave y no dijo nada más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé d'accorder une clé et n'a rien ajouté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha rifiutato di concedere una chiave e non ha aggiunto altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はキーの付与を拒否し、それ以上は何も言いませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 키 발급을 거부했으며 더 이상 아무 말도 하지 않았습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ odmówił przyznania klucza i na tym poprzestał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recusou conceder uma chave e não disse mais nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒绝授予密钥，之后没有再说任何话。"
