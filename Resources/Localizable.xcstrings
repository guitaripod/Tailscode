    "Last checked %@ — too long ago to still call it current.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt geprüft %@ – das ist zu lange her, um es noch als aktuell zu bezeichnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last checked %@ — too long ago to still call it current."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última comprobación: %@; ha pasado demasiado tiempo para considerarlo actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière vérification %@ — trop ancien pour être encore considéré comme à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultimo controllo %@ — troppo tempo fa perché sia ancora considerato aggiornato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終確認は%@ — 現在の状態と呼ぶには古すぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 확인은 %@ — 최신 상태라고 하기엔 너무 오래되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Última verificação %@ — tempo demais para ainda considerar atual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次检查是在%@——已经太久，不能再算作最新状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次檢查是在%@——已經太久，不能再算作最新狀態。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnio sprawdzono %@ — to zbyt dawno, by nadal uznawać to za aktualne."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidst tjekket %@ – for længe siden til at kalde det aktuelt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeksi tarkistettu %@ – liian kauan sitten, jotta tieto olisi ajan tasalla."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Síðast athugað %@ – of langt síðan til að kalla það enn núverandi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sist sjekket %@ – for lenge siden til å kalle det aktuelt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Senast kontrollerad %@ – för gammal för att räknas som aktuell."
          }
        }
      }
    },
