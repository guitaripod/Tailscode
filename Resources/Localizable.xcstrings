          "stringUnit": {
            "state": "translated",
            "value": "通話時に起動し、10分間アイドル状態が続くと停止します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화할 때 시작되고 10분 동안 유휴 상태이면 중지돼요"
