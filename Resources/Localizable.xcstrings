    "Paste the address of the machine with the card — 100.x.y.z, a MagicDNS name, or the whole line ComfyUI printed when it started.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Adresse des Rechners mit der Grafikkarte ein — 100.x.y.z, ein MagicDNS-Name oder die ganze Zeile, die ComfyUI beim Start ausgegeben hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the address of the machine with the card — 100.x.y.z, a MagicDNS name, or the whole line ComfyUI printed when it started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega la dirección de la máquina con la tarjeta gráfica — 100.x.y.z, un nombre MagicDNS, o la línea completa que ComfyUI imprimió al iniciarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez l’adresse de la machine équipée de la carte graphique — 100.x.y.z, un nom MagicDNS, ou la ligne entière affichée par ComfyUI à son démarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla l’indirizzo della macchina con la scheda grafica — 100.x.y.z, un nome MagicDNS, oppure l’intera riga stampata da ComfyUI all’avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラフィックカードを積んだマシンのアドレスを貼り付けてください — 100.x.y.z、MagicDNS 名、または起動時に ComfyUI が表示した行全体です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래픽 카드가 있는 컴퓨터의 주소를 붙여넣으세요 — 100.x.y.z, MagicDNS 이름, 또는 ComfyUI가 시작할 때 출력한 줄 전체도 가능합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole o endereço da máquina com a placa de vídeo — 100.x.y.z, um nome MagicDNS, ou a linha inteira que o ComfyUI exibiu ao iniciar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴装有显卡的那台机器的地址 — 可以是 100.x.y.z、MagicDNS 名称，或 ComfyUI 启动时打印的整行内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上裝有顯示卡的那台機器的位址 — 可以是 100.x.y.z、MagicDNS 名稱，或 ComfyUI 啟動時印出的整行內容。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej adres komputera z kartą graficzną — 100.x.y.z, nazwę MagicDNS albo całą linię, którą ComfyUI wypisało przy starcie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt adressen på computeren med kortet – 100.x.y.z, et MagicDNS-navn eller hele linjen ComfyUI skrev, da den startede."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä sen tietokoneen osoite, jossa on näytönohjain: 100.x.y.z, MagicDNS-nimi tai koko rivi, jonka ComfyUI tulosti käynnistyessään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Límdu vistfang tölvunnar með skjákortinu – 100.x.y.z, MagicDNS-nafn eða alla línuna sem ComfyUI prentaði þegar það var ræst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn adressen til maskinen med grafikkortet – 100.x.y.z, et MagicDNS-navn eller hele linjen ComfyUI skrev ut ved oppstart."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in adressen till datorn med grafikkortet: 100.x.y.z, ett MagicDNS-namn eller hela raden ComfyUI skrev ut när den startade."
          }
        }
      }
    },
