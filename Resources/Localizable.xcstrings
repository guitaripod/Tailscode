      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Mock-ups – in der App hat sich noch nichts geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mock-ups only — nothing in the app has changed yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo maquetas: nada ha cambiado todavía en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement des maquettes — rien n’a encore changé dans l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo mock-up — nell’app non è ancora cambiato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モックだけです。アプリ本体はまだ何も変わっていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목업일 뿐입니다 — 앱에서는 아직 아무것도 바뀌지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente mock-ups — nada mudou no app ainda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只是设计稿 — App 里目前还什么都没变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只是設計稿 — App 裡目前還什麼都沒變。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko makiety — w aplikacji nic jeszcze się nie zmieniło."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun mockups – intet i appen er ændret endnu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain malleja. Sovelluksessa ei ole vielä muutettu mitään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins frumgerðir: ekkert í forritinu hefur breyst enn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare mock-ups – ingenting i appen har endret seg ennå."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast mockups, ingenting i appen har ändrats ännu."
          }
