    "Tell the helper what to change, then press Return": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag dem Helfer, was sich ändern soll, und drück dann die Zeilenschaltungstaste."
