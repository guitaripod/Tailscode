    "No answer — is the other machine awake and on the tailnet?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Antwort — ist der andere Rechner wach und im Tailnet?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answer — is the other machine awake and on the tailnet?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin respuesta: ¿la otra máquina está despierta y en el tailnet?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune réponse — l’autre machine est-elle éveillée et sur le tailnet ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna risposta — l’altra macchina è attiva ed è sul tailnet?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答がありません — 相手のマシンは起動していて tailnet 上にありますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답이 없습니다 — 상대 머신이 켜져 있고 tailnet에 있나요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem resposta — será que a outra máquina está ativa e na tailnet?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有回应 — 那台机器是不是已开机并且在 tailnet 上？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有回應 — 那台機器是不是已開機並且在 tailnet 上？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak odpowiedzi — czy drugi komputer jest aktywny i w tailnet?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet svar – er den anden computer vågen og på tailnettet?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vastausta – onko toinen tietokone hereillä ja tailnetissä?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert svar – er hin tölvan vakandi og á tailnetinu?"
