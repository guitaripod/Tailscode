        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avain on asetettu, mutta ollama.com ei ole vastannut vielä – tilisi ikkunat näkyvät täällä heti, kun se vastaa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lykillinn er stilltur en ollama.com hefur ekki svarað enn – gluggar pakkans birtast hér um leið og það gerist."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøkkelen er angitt, og ollama.com har ikke svart ennå – vinduene i pakken din vises her så snart den gjør det."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckeln är angiven och ollama.com har inte svarat än – paketets fönster visas här så snart det gör det."
          }
        }
      }
    },
