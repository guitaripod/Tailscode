            "state": "translated",
            "value": "The download was interrupted. Trying again picks up where it stopped."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download wurde unterbrochen. Ein erneuter Versuch setzt dort fort, wo er abbrach."
