    "0.0.0.0 is what a server binds to, never where it lives.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 ist die Adresse, an die sich ein Server bindet, nie der Ort, an dem er lebt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 is what a server binds to, never where it lives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 es la dirección en la que escucha un servidor, nunca donde vive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 est l’adresse à laquelle un serveur se lie, jamais l’endroit où il vit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 è l’indirizzo a cui un server si lega, mai il luogo in cui vive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 はサーバがバインドするアドレスであり、サーバの実体があるアドレスではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0은 서버가 바인딩하는 주소일 뿐, 서버가 실제로 있는 곳이 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 é o endereço em que um servidor escuta, nunca onde ele mora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 只是服务器绑定的地址，从来不是它实际所在的地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 只是伺服器綁定的位址，從來不是它實際所在的地方。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 to adres, pod którym nasłuchuje serwer, nigdy miejsce, w którym działa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 er den adresse, en server binder sig til, aldrig hvor den befinder sig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 on osoite, johon palvelin sitoutuu, ei koskaan sen oma osoite."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 er það sem netþjónn bindur sig við, aldrei staðsetningin þar sem hann er."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 er adressen serveren binder seg til, aldri stedet der den faktisk befinner seg."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 är adressen en server binder till, aldrig adressen där den finns."
          }
        }
      }
    },
    "0.0.0.0 is what the server binds to. Use that machine's own address.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 is what the server binds to. Use that machine's own address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An 0.0.0.0 bindet sich der Server. Nutze die eigene Adresse des Rechners."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 es la dirección en la que escucha el servidor. Usa la dirección propia de esa máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 est l’adresse d’écoute du serveur. Utilisez l’adresse propre de cette machine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 è l’indirizzo su cui il server si mette in ascolto. Usa l’indirizzo proprio di quella macchina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 はサーバがバインドするアドレスです。そのマシン自身のアドレスを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0은 서버가 바인딩하는 주소입니다. 해당 컴퓨터 자체의 주소를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 é o endereço em que o servidor escuta. Use o endereço da própria máquina."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 是服务器绑定的地址。请使用那台机器自己的地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 是伺服器綁定的位址。請改用那台電腦自己的位址。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 to adres, pod którym nasłuchuje serwer. Użyj własnego adresu tego komputera."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 er den adresse, serveren binder sig til. Brug maskinens egen adresse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 on osoite, johon palvelin sitoutuu. Käytä kyseisen koneen omaa osoitetta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Netþjónninn bindur sig við 0.0.0.0. Notaðu eigið vistfang þeirrar tölvu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren binder seg til 0.0.0.0. Bruk maskinens egen adresse."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "0.0.0.0 är det servern binder till. Använd datorns egna adress."
          }
        }
      }
    },
