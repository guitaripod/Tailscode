      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each server waits until nothing is running on it, then restarts and comes back with everything it reads at startup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Server wartet, bis nichts mehr auf ihm läuft, startet dann neu und kommt mit allem zurück, was er beim Start einliest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada servidor espera hasta que no haya nada en ejecución en él, luego se reinicia y vuelve con todo lo que lee al iniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque serveur attend que rien ne tourne dessus, puis redémarre et revient avec tout ce qu’il lit au démarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni server attende che non ci sia più nulla in esecuzione su di esso, poi si riavvia e torna con tutto ciò che legge all’avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各サーバは、上で何も実行されなくなるまで待ってから再起動し、起動時に読み込むすべてを反映して復帰します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 서버는 실행 중인 작업이 없어질 때까지 기다렸다가 재시동하고, 시작할 때 읽어들이는 모든 것을 반영해 돌아옵니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy serwer czeka, aż nic na nim nie będzie działać, po czym uruchamia się ponownie i wraca ze wszystkim, co wczytuje przy starcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada servidor espera até que nada esteja em execução nele, depois reinicia e volta com tudo o que lê na inicialização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台服务器会等到上面没有任何任务在运行，然后重新启动，并带着它启动时读取的一切重新上线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每台伺服器會等到上面沒有任何執行中的工作，然後重新開機，並帶著它啟動時讀取的一切重新上線。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver server venter, til der ikke kører noget på den, genstarter og kommer tilbage med alt, den læser ved opstart."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen palvelin odottaa, kunnes sillä ei ole mitään käynnissä, käynnistyy sitten uudelleen ja lataa kaiken, mitä se lukee käynnistyessään."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver netþjónn bíður þar til ekkert er í gangi á honum, endurræsist síðan og kemur aftur upp með allt sem hann les við ræsingu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver server venter til ingenting kjører på den, starter så på nytt og kommer tilbake med alt den leser ved oppstart."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje server väntar tills ingenting körs på den, startar sedan om och kommer tillbaka med allt den läser in vid start."
          }
        }
      }
    },
    "It waits until nothing is running on it, then restarts and comes back with everything it reads at startup — models, config, plugins.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It waits until nothing is running on it, then restarts and comes back with everything it reads at startup — models, config, plugins."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wartet, bis nichts mehr auf ihm läuft, startet dann neu und kommt mit allem zurück, was er beim Start einliest — Modelle, Konfiguration, Plugins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera hasta que no haya nada en ejecución en él, luego se reinicia y vuelve con todo lo que lee al iniciar — modelos, configuración, complementos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il attend que rien ne tourne dessus, puis redémarre et revient avec tout ce qu’il lit au démarrage — modèles, configuration, extensions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attende che non ci sia più nulla in esecuzione su di esso, poi si riavvia e torna con tutto ciò che legge all’avvio — modelli, configurazione, plugin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で何も実行されなくなるまで待ってから再起動し、起動時に読み込むすべて — モデル、設定、プラグイン — を反映して復帰します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 작업이 없어질 때까지 기다렸다가 재시동하고, 시작할 때 읽어들이는 모든 것 — 모델, 설정, 플러그인 — 을 반영해 돌아옵니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czeka, aż nic na nim nie będzie działać, po czym uruchamia się ponownie i wraca ze wszystkim, co wczytuje przy starcie — modelami, konfiguracją, wtyczkami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera até que nada esteja em execução nele, depois reinicia e volta com tudo o que lê na inicialização — modelos, configuração, plugins."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会等到上面没有任何任务在运行，然后重新启动，并带着它启动时读取的一切重新上线 — 模型、配置、插件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會等到上面沒有任何執行中的工作，然後重新開機，並帶著它啟動時讀取的一切重新上線 — 模型、設定、外掛。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den venter, til der ikke kører noget på den, genstarter og kommer tilbage med alt, den læser ved opstart: modeller, konfiguration, plugins."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se odottaa, kunnes sillä ei ole mitään käynnissä, käynnistyy sitten uudelleen ja lataa kaiken, mitä se lukee käynnistyessään: mallit, asetukset, laajennukset."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hann bíður þar til ekkert er í gangi á honum, endurræsist síðan og kemur aftur upp með allt sem hann les við ræsingu: líkön, stillingar, viðbætur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den venter til ingenting kjører på den, starter så på nytt og kommer tilbake med alt den leser ved oppstart: modeller, konfigurasjon, plugins."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den väntar tills ingenting körs på den, startar sedan om och kommer tillbaka med allt den läser in vid start: modeller, konfiguration och tillägg."
          }
        }
      }
    },
