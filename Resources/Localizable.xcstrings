    "The default server is where a new chat starts when you haven't aimed the composer somewhere else.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standardserver ist der Ort, an dem ein neuer Chat beginnt, wenn du das Eingabefeld nicht anders ausgerichtet hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default server is where a new chat starts when you haven't aimed the composer somewhere else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor predeterminado es donde comienza un chat nuevo si no has apuntado el compositor a otro sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur par défaut est celui où démarre une nouvelle discussion quand vous n’avez pas orienté la zone de saisie ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server predefinito è dove inizia una nuova chat quando non hai puntato il compositore altrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトのサーバは、入力欄を他に向けていないときに新しいチャットが始まる場所です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 서버는 작성창을 다른 곳으로 지정하지 않았을 때 새 대화가 시작되는 곳입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor padrão é onde uma nova conversa começa quando você não direcionou o campo de texto para outro lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认服务器是在你没有把输入框指向别处时，新对话的起点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設伺服器是在你沒有把輸入框指向他處時，新對話的起點。"
          }
        }
      }
    },
    "The dollar ceiling the monthly gauge fills against.": {
