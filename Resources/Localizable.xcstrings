    "The machine answered, so the address is right. If ComfyUI is running there, start it with --listen so other machines can reach it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The machine answered, so the address is right. If ComfyUI is running there, start it with --listen so other machines can reach it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Rechner hat geantwortet, die Adresse stimmt also. Läuft dort ComfyUI, starte es mit --listen, damit andere Rechner es erreichen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El equipo respondió, así que la dirección es correcta. Si ComfyUI se ejecuta allí, inícialo con --listen para que otros equipos puedan acceder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine a répondu, l'adresse est donc correcte. Si ComfyUI tourne là-bas, lancez-le avec --listen pour que les autres machines puissent s'y connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La macchina ha risposto, quindi l'indirizzo è corretto. Se ComfyUI è in esecuzione lì, avvialo con --listen così che anche le altre macchine possano raggiungerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンから応答があったため、アドレスは正しいです。そこで ComfyUI が動いている場合は、他のマシンから接続できるよう --listen を付けて起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 응답했으므로 주소는 맞습니다. 그곳에서 ComfyUI가 실행 중이라면 다른 기기가 접속할 수 있도록 --listen 옵션으로 시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komputer odpowiedział, więc adres jest poprawny. Jeśli ComfyUI działa tam, uruchom je z opcją --listen, aby inne komputery mogły się połączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A máquina respondeu, então o endereço está certo. Se o ComfyUI estiver rodando aí, inicie-o com --listen para que outras máquinas possam acessá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备有响应，说明地址正确。如果 ComfyUI 运行在那里，请使用 --listen 启动，以便其他设备访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置有回應，表示位址正確。若 ComfyUI 運行於該處，請使用 --listen 啟動，以便其他裝置連線。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Computeren svarede, så adressen er korrekt. Hvis ComfyUI kører der, så start det med --listen, så andre computere kan nå det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietokone vastasi, joten osoite on oikein. Jos ComfyUI on siellä käynnissä, käynnistä se --listen-asetuksella, jotta muut tietokoneet voivat tavoittaa sen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tölvan svaraði, svo vistfangið er rétt. Ef ComfyUI keyrir þar, byrjaðu það með --listen svo aðrar tölvur nái í það."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Maskinen svarte, så adressen stemmer. Hvis ComfyUI kjører der, start den med --listen, så andre maskiner kan nå den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Datorn svarade, så adressen stämmer. Om ComfyUI körs där, starta det med --listen så att andra datorer kan nå det."
          }
        }
      }
    },
