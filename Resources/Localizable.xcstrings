            "state": "translated",
            "value": "Ubegrenset antall servere og delegering til rimeligere modeller"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Obegränsat antal servrar och delegering till billigare modeller"
          }
        }
      }
    },
    "No servers yet. Add the machine your agents run on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No servers yet. Add the machine your agents run on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Server. Füge den Rechner hinzu, auf dem deine Agenten laufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay servidores. Añade la máquina en la que se ejecutan tus agentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun serveur pour l'instant. Ajoute la machine sur laquelle tournent tes agents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun server ancora. Aggiungi la macchina su cui girano i tuoi agenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバはまだありません。エージェントを実行するマシンを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 서버가 없습니다. 에이전트가 실행되는 머신을 추가하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak serwerów. Dodaj komputer, na którym działają Twoje agenty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum servidor ainda. Adicione a máquina onde seus agentes rodam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有服务器。请添加运行你的智能体的机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有伺服器。請新增執行你的代理程式的機器。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen servere endnu. Tilføj den computer, dine agenter kører på."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä palvelimia. Lisää tietokone, jolla agenttisi ajavat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Engir netþjónar ennþá. Bættu við tölvunni sem agentarnir þínir keyra á."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen servere ennå. Legg til maskinen agentene dine kjører på."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga servrar ännu. Lägg till datorn som dina agenter körs på."
          }
        }
      }
    },
