    "Signed out — the board can still show what's on": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgemeldet — die Übersicht kann trotzdem zeigen, was läuft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed out — the board can still show what's on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión cerrada: el panel puede seguir mostrando lo que hay en directo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecté — le tableau peut quand même afficher ce qui passe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnesso — la bacheca può comunque mostrare cosa c’è in onda"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウト中でも、ボードは配信中の番組を表示できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃됨 — 보드는 여전히 방송 중인 콘텐츠를 보여줄 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconectado — o painel ainda pode mostrar o que está no ar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登出 — 看板仍可显示正在直播的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已登出 — 看板仍可顯示正在直播的內容"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowano — tablica nadal może pokazać, co jest na żywo"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Logget ud – oversigten kan stadig vise, hvad der kører"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautunut ulos: näkymä voi silti näyttää, mitä on päällä"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Útskráð, yfirlitið getur samt sýnt hvað er í gangi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logget av: oversikten kan fortsatt vise hva som sendes"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utloggad, men tavlan kan fortfarande visa vad som sänds"
          }
        }
      }
    },
