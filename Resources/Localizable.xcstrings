    "The question carried a picture, and a model that will not be handed one answers exactly like this.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Frage enthielt ein Bild, und ein Modell, dem keines übergeben wird, antwortet genau so."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The question carried a picture, and a model that will not be handed one answers exactly like this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pregunta incluía una imagen, y un modelo al que no se le entrega ninguna responde exactamente así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La question comportait une image, et un modèle à qui l’on n’en transmet pas répond exactement ainsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La domanda conteneva un’immagine, e un modello a cui non ne viene passata una risponde esattamente così."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問には画像が含まれていましたが、画像を渡されないモデルはまさにこのように答えます。"
          }
        },
        "ko": {
