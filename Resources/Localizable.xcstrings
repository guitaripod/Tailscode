          "stringUnit": {
            "state": "translated",
            "value": "按下你想要的按鍵。⌘ 屬於選單列，此處無法使用。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på de taster, du ønsker. ⌘ hører til menulinjen og er ikke tilgængelig her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina haluamasi näppäimet. ⌘ kuuluu valikkopalkkiin, eikä sitä voi käyttää tässä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýttu á takkana sem þú vilt. ⌘ tilheyrir valmyndastikunni og er ekki í boði hér."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk tastene du vil ha. ⌘ hører til menylinjen og er ikke tilgjengelig her."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på tangenterna du vill ha. ⌘ hör till menyraden och går inte att använda här."
          }
        }
      }
    },
