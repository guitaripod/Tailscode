    "voice-bridge is not running on this server. Start it there with systemctl --user start voice-bridge.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge is not running on this server. Start it there with systemctl --user start voice-bridge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge läuft auf diesem Server nicht. Starte es dort mit systemctl --user start voice-bridge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge no se está ejecutando en este servidor. Inícialo allí con systemctl --user start voice-bridge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge ne tourne pas sur ce serveur. Démarrez-le là-bas avec systemctl --user start voice-bridge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge non è in esecuzione su questo server. Avvialo lì con systemctl --user start voice-bridge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーでは voice-bridge が動作していません。そこで systemctl --user start voice-bridge を実行して起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버에서 voice-bridge가 실행되고 있지 않아요. 서버에서 systemctl --user start voice-bridge 명령으로 시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "voice-bridge nie działa na tym serwerze. Uruchom go tam poleceniem systemctl --user start voice-bridge."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O voice-bridge não está rodando neste servidor. Inicie-o aí com systemctl --user start voice-bridge."
