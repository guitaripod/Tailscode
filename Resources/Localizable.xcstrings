    "Every server in Tailscode is reached over your tailnet. The API token is only used to list your devices during discovery.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Server in Tailscode wird über dein Tailnet erreicht. Das API-Token dient nur dazu, beim Suchen deine Geräte aufzulisten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every server in Tailscode is reached over your tailnet. The API token is only used to list your devices during discovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A todos los servidores de Tailscode se accede por tu tailnet. El token de la API solo se usa para listar tus dispositivos durante el descubrimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque serveur dans Tailscode est joint via votre tailnet. Le jeton API sert uniquement à lister vos appareils pendant la découverte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni server in Tailscode viene raggiunto tramite il tuo tailnet. Il token API serve solo a elencare i tuoi dispositivi durante il rilevamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode のすべてのサーバには tailnet 経由で接続します。API トークンは検出時にデバイス一覧を取得するためだけに使われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode의 모든 서버는 tailnet을 통해 연결됩니다. API 토큰은 검색 중 기기 목록을 가져올 때만 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os servidores no Tailscode são acessados pela sua tailnet. O token de API só é usado para listar seus dispositivos durante a descoberta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 中的每台服务器都通过你的 tailnet 访问。API 令牌仅用于在发现过程中列出你的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 中的每台伺服器都透過你的 tailnet 連線。API 權杖僅用於探索時列出你的裝置。"
          }
        }
      }
    },
