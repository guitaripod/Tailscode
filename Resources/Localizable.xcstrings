          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O raciocínio e as chamadas de ferramentas entre os prompts se recolhem em uma linha que você pode abrir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
