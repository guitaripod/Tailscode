          "stringUnit": {
            "state": "translated",
            "value": "正在生成圖片"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powstaje obraz"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et billede genereres"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvaa luodaan"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Mynd er í smíðum"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et bilde lages"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En bild skapas"
          }
        }
      }
    },
    "A rebuild takes xcodegen and a multi-minute xcodebuild, and what it produces is the bundle this process is running from — so the command is handed over rather than pressed here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein erneuter Build braucht xcodegen und ein mehrminütiges xcodebuild, und dabei entsteht genau das Bundle, aus dem dieser Prozess gerade läuft – daher wird der Befehl weitergegeben, statt hier per Knopfdruck ausgelöst zu werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rebuild takes xcodegen and a multi-minute xcodebuild, and what it produces is the bundle this process is running from — so the command is handed over rather than pressed here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una reconstrucción exige xcodegen y un xcodebuild de varios minutos, y lo que produce es precisamente el bundle desde el que se está ejecutando este proceso, así que el comando se entrega para ejecutarlo en lugar de pulsarlo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une recompilation nécessite xcodegen et un xcodebuild de plusieurs minutes, et ce qu'elle produit est exactement le bundle depuis lequel ce processus s'exécute — la commande est donc transmise plutôt que déclenchée ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ricompilazione richiede xcodegen e un xcodebuild di più minuti, e ciò che produce è esattamente il bundle da cui questo processo è in esecuzione: perciò il comando viene consegnato invece di essere premuto qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再ビルドにはxcodegenと数分かかるxcodebuildが必要で、生成されるのはまさにこのプロセスが実行中のバンドルです — そのため、ここでは押すボタンではなくコマンドが渡されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재빌드에는 xcodegen과 몇 분이 걸리는 xcodebuild가 필요하며, 그 결과물은 바로 이 프로세스가 실행 중인 번들입니다 — 그래서 여기서 버튼을 누르는 대신 명령을 전달합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma recompilação exige xcodegen e um xcodebuild de vários minutos, e o que ela produz é exatamente o bundle a partir do qual este processo está sendo executado — por isso o comando é repassado, em vez de ser apertado por aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新构建需要 xcodegen 和耗时数分钟的 xcodebuild，其产物正是本进程当前运行所用的应用包——因此这里给出的是命令，而不是一个可按的按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新建置需要 xcodegen 和耗時數分鐘的 xcodebuild，其產物正是本處理程序目前執行所用的應用程式包——因此這裡給出的是指令，而不是一個可按的按鈕。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponowny build wymaga xcodegen i kilkuminutowego xcodebuild, a efektem jest dokładnie ten pakiet, z którego działa ten proces — dlatego polecenie jest przekazywane, a nie uruchamiane tutaj przyciskiem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En genopbygning kræver xcodegen og et xcodebuild, der tager flere minutter, og resultatet er netop den bundle, denne proces kører fra, så kommandoen gives videre i stedet for at blive startet herfra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Uudelleenrakennus vaatii xcodegenin ja useita minuutteja kestävän xcodebuildin, ja sen tuottama paketti on se, josta tämä prosessi on käynnissä. Siksi komento annetaan käsin, eikä sitä suoriteta täällä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Endurbygging keyrir xcodegen og margra mínútna xcodebuild, og það sem hún framleiðir er einingin sem þetta ferli keyrir úr, þess vegna er skipunin afhent frekar en ýtt á hana hér."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En ombygging krever xcodegen og en xcodebuild på flere minutter, og resultatet er pakken prosessen kjører fra akkurat nå, så kommandoen gis til deg i stedet for å kjøres herfra."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ny build kräver xcodegen och ett xcodebuild som tar flera minuter, och det som produceras är just det paket som den här processen körs från, så kommandot lämnas över i stället för att startas här med en knapp."
          }
        }
      }
    },
    "A saved chat lists itself even when its server is unreachable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gesicherter Chat listet sich selbst auf, auch wenn sein Server nicht erreichbar ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved chat lists itself even when its server is unreachable"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chat guardado se sigue mostrando aunque su servidor sea inaccesible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une discussion enregistrée s’affiche dans la liste même quand son serveur est injoignable"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chat salvata compare comunque nell’elenco anche quando il suo server non è raggiungibile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したチャットは、サーバに到達できなくても一覧に表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 대화는 서버에 연결할 수 없어도 목록에 표시됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conversa salva continua aparecendo mesmo quando o servidor está inacessível"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使服务器无法访问，已保存的对话仍会显示在列表中"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使伺服器無法連線，已儲存的對話仍會顯示在清單中"
