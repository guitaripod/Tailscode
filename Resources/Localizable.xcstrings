    "A single modifier and space is what most launchers and input switchers are on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einzelner Modifikator mit Leertaste ist das, worauf die meisten Launcher und Eingabequellen-Umschalter liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single modifier and space is what most launchers and input switchers are on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo modificador y espacio es lo que usan la mayoría de lanzadores y selectores de teclado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un simple modificateur et espace est ce sur quoi reposent la plupart des lanceurs et sélecteurs de méthode de saisie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un singolo modificatore e la barra spaziatrice sono ciò su cui si basano la maggior parte dei launcher e dei selettori di input."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単一の修飾キーとスペースは、多くのランチャーや入力切り替えが使っている組み合わせです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단일 보조키와 스페이스는 대부분의 런처와 입력기 전환에 쓰이는 조합입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um único modificador e espaço é o que a maioria dos launchers e trocadores de teclado usa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单个修饰键加空格，是大多数启动器和输入法切换所占用的组合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單個修飾鍵加空白鍵，是大多數啟動器和輸入法切換所佔用的組合。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojedynczy modyfikator ze spacją to skrót, na którym opiera się większość launcherów i przełączników źródeł wprowadzania."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En enkelt modifikatortast og mellemrum er det, de fleste launchere og inputskiftere bruger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi muokkain ja välilyönti on se, mihin useimmat käynnistimet ja syöttölähteen vaihtajat on sidottu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Einn breytilykill ásamt bili er það sem flestir ræsar og innsláttarskiptar nota."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En enkelt modifikator og mellomrom er det de fleste programstartere og inndatabyttere bruker."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En enda modifierare och mellanslag är det de flesta startprogram och inmatningsväxlare använder."
          }
        }
      }
    },
    "The desktop itself claims most Super chords before an app sees them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Desktop selbst beansprucht die meisten Super-Kombinationen, bevor eine App sie überhaupt sieht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The desktop itself claims most Super chords before an app sees them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El propio escritorio se queda con la mayoría de combinaciones con Super antes de que una app las vea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bureau lui-même s’approprie la plupart des combinaisons avec Super avant qu’une app ne les voie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il desktop stesso si appropria della maggior parte delle combinazioni con Super prima che un’app le veda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Super キーを使った組み合わせのほとんどは、アプリに届く前にデスクトップ自体が奪ってしまいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Super 키를 쓰는 조합 대부분은 앱에 도달하기도 전에 데스크톱 자체가 가로챕니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O próprio desktop se apropria da maioria das combinações com Super antes que um app as veja."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大多数带 Super 键的组合键，还没等应用看到就已经被桌面环境自己占用了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大多數帶 Super 鍵的組合鍵，還沒等應用程式看到就已經被桌面環境自己佔用了。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sam pulpit przechwytuje większość kombinacji z Super, zanim zobaczy je jakakolwiek aplikacja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivebordet selv gør krav på de fleste Super-kombinationer, før en app ser dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Työpöytä itse varaa useimmat Super-yhdistelmät ennen kuin sovellus ne näkee."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjáborðið sjálft tekur flestar Super-samsetningar áður en forrit sjá þær."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Selve skrivebordet tar de fleste Super-kombinasjoner før en app ser dem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivbordet tar själv de flesta tangentkombinationerna med Super innan en app ser dem."
          }
        }
      }
    },
