    "Review this and point out anything wrong.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe das und weise auf alles hin, was nicht stimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review this and point out anything wrong."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa esto y señala cualquier cosa que esté mal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relisez ceci et signalez tout ce qui ne va pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivedi questo e segnala tutto ciò che non va."
          }
