          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samme mål, stier og verifikator, åben til redigering, inden det går i gang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama tavoite, polut ja verifiointikomento, avoinna muokattavaksi ennen lähtöä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama markmið, slóðir og sannprófari, opið til breytinga áður en lagt er af stað."
          }
        },
        "nb": {
          "stringUnit": {
