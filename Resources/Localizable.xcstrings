        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto responde, pero no como un agente: prueba el puerto del otro agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le port répond, mais pas comme un agent — essayez le port de l’autre agent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La porta risponde, ma non come un agente — prova la porta dell’altro agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのポートは応答しますが、エージェントのようではありません — もう一方のエージェントのポートを試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 포트는 응답하지만 에이전트 같지 않습니다 — 다른 에이전트의 포트를 시도해 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A porta responde, mas não como um agente — tente a porta do outro agente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那个端口有响应，但不像是智能体 — 试试另一个智能体的端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那個埠有回應，但不像是代理 — 試試另一個代理的埠。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Port odpowiada, ale nie jak agent — spróbuj portu innego agenta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Porten svarer, men ikke som en agent – prøv den anden agents port."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Portti vastaa, mutta ei kuin agentti – kokeile toisen agentin porttia."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gáttin svarar, en ekki eins og agent – prófaðu gátt hins agentsins."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Porten svarer, men ikke som en agent. Prøv den andre agentens port."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Porten svarar, men inte som en agent. Prova den andra agentens port."
          }
        }
      }
    },
    "The port is open and something is on it, yet it didn't respond as a known agent. Check the port — 4096 opencode, 4098 claude-bridge, 4099 omp-bridge.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The port is open and something is on it, yet it didn't respond as a known agent. Check the port — 4096 opencode, 4098 claude-bridge, 4099 omp-bridge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Port ist offen und etwas liegt darauf, doch es hat nicht als bekannter Agent geantwortet. Prüfe den Port – 4096 opencode, 4098 claude-bridge, 4099 omp-bridge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto está abierto y hay algo en él, pero no respondió como un agente conocido. Comprueba el puerto: 4096 opencode, 4098 claude-bridge, 4099 omp-bridge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le port est ouvert et quelque chose s’y trouve, mais il n’a pas répondu comme un agent connu. Vérifiez le port — 4096 opencode, 4098 claude-bridge, 4099 omp-bridge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La porta è aperta e c’è qualcosa in ascolto, ma non ha risposto come un agente conosciuto. Controlla la porta — 4096 opencode, 4098 claude-bridge, 4099 omp-bridge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポートは開いていて何かが動いていますが、既知のエージェントとしての応答ではありませんでした。ポートを確認してください。4096 が opencode、4098 が claude-bridge、4099 が omp-bridge です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트가 열려 있고 무언가 사용 중이지만, 알려진 에이전트로 응답하지는 않았습니다. 포트를 확인하세요 — 4096 opencode, 4098 claude-bridge, 4099 omp-bridge."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A porta está aberta e há algo nela, mas não respondeu como um agente conhecido. Verifique a porta — 4096 opencode, 4098 claude-bridge, 4099 omp-bridge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口是开放的，上面也有程序，但它没有以已知智能体的方式响应。请检查端口 — 4096 opencode，4098 claude-bridge，4099 omp-bridge。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接埠是開的，上面也有東西，但它的回應不像已知的代理。請檢查連接埠 — 4096 opencode，4098 claude-bridge，4099 omp-bridge。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Port jest otwarty i coś na nim jest, ale nie odpowiedziało jak znany agent. Sprawdź port — 4096 opencode, 4098 claude-bridge, 4099 omp-bridge."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Porten er åben, og noget kører på den, men den svarede ikke som en kendt agent. Tjek porten – 4096 opencode, 4098 claude-bridge, 4099 omp-bridge."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Portti on auki ja siellä on jotain, mutta se ei vastannut tunnettuna agenttina. Tarkista portti – 4096 opencode, 4098 claude-bridge, 4099 omp-bridge."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gáttin er opin og eitthvað er á henni, en það svaraði ekki sem þekktur agent. Athugaðu gáttina – 4096 opencode, 4098 claude-bridge, 4099 omp-bridge."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Porten er åpen og noe kjører på den, men det svarte ikke som en kjent agent. Sjekk porten: 4096 opencode, 4098 claude-bridge, 4099 omp-bridge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Porten är öppen och något lyssnar på den, men det svarade inte som en känd agent. Kontrollera porten: 4096 opencode, 4098 claude-bridge, 4099 omp-bridge."
          }
        }
      }
    },
