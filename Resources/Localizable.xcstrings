    "A small tool that carries the picture. It will be fetched once.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small tool that carries the picture. It will be fetched once."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kleines Werkzeug, das das Bild überträgt. Es wird einmal heruntergeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pequeña herramienta que transmite la imagen. Se descargará una sola vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit outil qui transporte l’image. Il sera téléchargé une seule fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piccolo strumento che trasmette l’immagine. Verrà scaricato una sola volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を送る小さなツールです。最初に一度だけ取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 전달하는 작은 도구입니다. 한 번만 내려받습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mały program, który przesyła obraz. Zostanie pobrany jeden raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pequena ferramenta que transporta a imagem. Ela será baixada uma vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个负责传送画面的小工具，只会下载一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個負責傳送畫面的小工具，只會下載一次。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lille værktøj, der bærer billedet. Det hentes én gang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieni työkalu, joka välittää kuvan. Se ladataan kerran."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lítið tól sem ber myndina áfram. Það verður sótt einu sinni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lite verktøy som bærer bildet. Det lastes ned én gang."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett litet verktyg som bär bilden. Det hämtas en gång."
          }
        }
      }
    },
