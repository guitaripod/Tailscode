    "From the ACP registry. Downloads are checked against the registry's checksum and run on the machine, not on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the ACP registry. Downloads are checked against the registry's checksum and run on the machine, not on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem ACP-Register. Downloads werden gegen die Prüfsumme des Registers geprüft und auf dem Rechner ausgeführt, nicht auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Del registro de ACP. Las descargas se verifican con la suma de comprobación del registro y se ejecutan en la máquina, no en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du registre ACP. Les téléchargements sont vérifiés par la somme de contrôle du registre et exécutés sur la machine, pas sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal registro ACP. I download vengono verificati con il checksum del registro ed eseguiti sulla macchina, non su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ACP レジストリから。ダウンロードはレジストリのチェックサムで検証され、このデバイスではなくマシン上で実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ACP 레지스트리에서 가져옵니다. 다운로드는 레지스트리의 체크섬으로 검사되며, 이 기기가 아닌 기기에서 실행됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z rejestru ACP. Pliki są sprawdzane sumą kontrolną rejestru i uruchamiane na komputerze, a nie na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Do registro ACP. Os downloads são verificados pela soma de verificação do registro e executados na máquina, não neste dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 ACP 注册表。下载内容会按注册表的校验和检查，并在机器上运行，而不是在本设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 ACP 註冊表。下載內容會依註冊表的校驗碼檢查，並在機器上執行，而非在本裝置上。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra ACP-registret. Overførsler kontrolleres mod registrets checksum og køres på computeren, ikke på denne enhed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "ACP-rekisteristä. Lataukset tarkistetaan rekisterin tarkistussummaa vasten ja ne suoritetaan tietokoneella, ei tällä laitteella."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Úr ACP-skránni. Niðurhal er borið saman við athugunarsummu skrárinnar og keyrt á tölvunni, ekki á þessu tæki."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra ACP-registeret. Nedlastinger kontrolleres mot registerets sjekksum og kjøres på maskinen, ikke på denne enheten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från ACP-registret. Hämtningar kontrolleras mot registrets checksumma och körs på datorn, inte på den här enheten."
          }
        }
      }
    },
