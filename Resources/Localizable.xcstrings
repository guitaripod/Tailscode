    "%@ is up but didn't answer about updates in time — it may be busy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft, hat aber nicht rechtzeitig zu Updates geantwortet – es ist möglicherweise ausgelastet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is up but didn't answer about updates in time — it may be busy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está activo, pero no respondió a tiempo sobre actualizaciones: puede que esté ocupado."
          }
        },
        "fr": {
