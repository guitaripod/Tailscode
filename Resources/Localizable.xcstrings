    "Live from %@. Percentages are the account's actual consumption, not an estimate.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live von %@. Die Prozentwerte sind der tatsächliche Verbrauch des Kontos, keine Schätzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live from %@. Percentages are the account's actual consumption, not an estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En vivo desde %@. Los porcentajes son el consumo real de la cuenta, no una estimación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En direct depuis %@. Les pourcentages sont la consommation réelle du compte, pas une estimation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In diretta da %@. Le percentuali sono il consumo reale dell’account, non una stima."
