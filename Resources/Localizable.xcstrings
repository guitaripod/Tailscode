    "Answering on %@. The first render still waits while it loads the model.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwortet auf %@. Der erste Render wartet trotzdem noch, während das Modell geladen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answering on %@. The first render still waits while it loads the model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde en %@. El primer renderizado igualmente espera mientras se carga el modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répond sur %@. Le premier rendu attend tout de même le chargement du modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Risponde su %@. Il primo rendering comunque attende il caricamento del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で応答しています。ただし最初のレンダリングは、モデルの読み込みが終わるまで待ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 응답 중입니다. 다만 첫 렌더링은 모델을 불러오는 동안 계속 대기합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respondendo em %@. Mesmo assim, a primeira renderização espera o modelo carregar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
