    "Tailscale isn't reporting an address here — nothing will answer until it is connected.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale meldet hier keine Adresse — nichts antwortet, solange keine Verbindung besteht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale isn't reporting an address here — nothing will answer until it is connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale no informa ninguna dirección aquí — nada responderá hasta que esté conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale ne signale aucune adresse ici — rien ne répondra tant que ce n’est pas connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale non segnala alcun indirizzo qui — nulla risponderà finché non sarà connesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは Tailscale がアドレスを報告していません — 接続されるまで何も応答しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 Tailscale이 주소를 알려주지 않고 있습니다 — 연결되기 전까지는 아무것도 응답하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscale não está informando um endereço aqui — nada vai responder até que esteja conectado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 在这里没有报告地址 — 在连接之前不会有任何响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 在這裡沒有回報位址 — 在連線之前不會有任何回應。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale nie podaje tutaj żadnego adresu — nic nie odpowie, dopóki nie zostanie połączone."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale viser ingen adresse her – intet svarer, før den er forbundet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale ei ilmoita tässä osoitetta: mikään ei vastaa, ennen kuin yhteys on muodostettu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale sýnir ekkert vistfang hér – ekkert svarar fyrr en tenging er komin á."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale melder ingen adresse her – ingenting svarer før det er tilkoblet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale visar ingen adress här. Ingenting svarar förrän den är ansluten."
          }
        }
      }
    },
