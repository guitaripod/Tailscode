        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una tarea en segundo plano en curso en la máquina; el agente continúa cuando termine"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche en arrière-plan est en cours sur la machine ; l’agent reprend une fois qu’elle est terminée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’attività in background è in corso sulla macchina; l’agente riprende quando finisce"
