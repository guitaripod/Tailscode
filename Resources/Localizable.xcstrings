    "Tailscode asked %@ for %@ and it has not been granted yet. Finish it in that desktop's own shortcut settings, or bind the command below.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode hat %@ um %@ gebeten, was noch nicht gewährt wurde. Schließe das in den eigenen Kurzbefehl-Einstellungen dieses Desktops ab, oder binde den Befehl unten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode asked %@ for %@ and it has not been granted yet. Finish it in that desktop's own shortcut settings, or bind the command below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode le pidió %@ %@, y todavía no se ha concedido. Complétalo en la configuración de atajos propia de ese escritorio, o asigna el comando de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode a demandé %@ pour %@, et cela n’a pas encore été accordé. Terminez cela dans les propres réglages de raccourcis de ce bureau, ou associez la commande ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ha chiesto a %@ %@, e non è ancora stato concesso. Completalo nelle impostazioni delle scorciatoie di quel desktop, oppure assegna il comando qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode は %@ に %@ を求めましたが、まだ許可されていません。そのデスクトップ自身のショートカット設定で完了させるか、下のコマンドを割り当ててください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode가 %@에 %@ 권한을 요청했지만 아직 허용되지 않았습니다. 해당 데스크톱 자체의 단축키 설정에서 완료하거나, 아래 명령어를 지정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode pediu %@ para %@ e isso ainda não foi concedido. Conclua isso nas próprias configurações de atalhos daquele desktop, ou vincule o comando abaixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 向 %@ 请求了 %@，但尚未获得授权。请在那个桌面环境自己的快捷键设置中完成授权，或者绑定下面的命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 向 %@ 請求了 %@，但尚未取得授權。請在那個桌面環境自己的快速鍵設定中完成授權，或是繫結下面的指令。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode poprosił %@ o %@, ale to nie zostało jeszcze przyznane. Dokończ to we własnych ustawieniach skrótów tego pulpitu albo przypisz poniższe polecenie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode bad %@ om %@, men det er endnu ikke tildelt. Afslut det i skrivebordets egne genvejsindstillinger, eller bind kommandoen nedenfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode pyysi %@:ltä näppäintä %@, eikä sitä ole vielä myönnetty. Viimeistele asia sen työpöydän omissa pikanäppäinasetuksissa tai määritä alla oleva komento."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode bað %@ um %@, og það hefur ekki verið veitt ennþá. Ljúktu því í flýtilyklastillingum þessa skjáborðs, eða úthlutaðu skipuninni hér fyrir neðan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ba %@ om %@, og den er ikke innvilget ennå. Fullfør det i skrivebordets egne snarveisinnstillinger, eller knytt kommandoen nedenfor til en tast."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode bad %@ om %@ och det har ännu inte beviljats. Slutför det i skrivbordets egna inställningar för kortkommandon, eller koppla kommandot nedan."
          }
        }
      }
    },
    "Something else on this machine already answers %@. Pick another chord.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas anderes auf diesem Rechner reagiert bereits auf %@. Wähle eine andere Tastenkombination."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something else on this machine already answers %@. Pick another chord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra cosa en esta máquina ya responde a %@. Elige otra combinación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autre chose sur cette machine répond déjà à %@. Choisissez une autre combinaison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcos’altro su questa macchina risponde già a %@. Scegli un’altra combinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシン上の別の何かが、すでに %@ に反応しています。別のキーの組み合わせを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터의 다른 무언가가 이미 %@에 반응하고 있습니다. 다른 키 조합을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra coisa nesta máquina já responde a %@. Escolha outra combinação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台机器上已经有别的东西在响应 %@ 了。请换一个组合键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台機器上已經有別的東西在回應 %@ 了。請換一個組合鍵。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś innego na tym komputerze już odpowiada na %@. Wybierz inną kombinację."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget andet på denne computer svarer allerede på %@. Vælg en anden tastekombination."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokin muu tällä tietokoneella reagoi jo näppäimeen %@. Valitse toinen näppäinyhdistelmä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eitthvað annað á þessari tölvu er þegar með %@. Veldu aðra samsetningu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe annet på denne maskinen svarer allerede på %@. Velg en annen tastekombinasjon."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något annat på den här datorn svarar redan på %@. Välj en annan kombination."
          }
        }
      }
    },
