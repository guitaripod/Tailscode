    "Nothing has answered yet. Pull down to ask this app and every server what they are running.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es hat noch niemand geantwortet. Nach unten ziehen, um diese App und jeden Server nach ihrer Version zu fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has answered yet. Pull down to ask this app and every server what they are running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie ha respondido todavía. Desliza hacia abajo para preguntar a esta app y a cada servidor qué versión ejecutan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a encore répondu. Tirez vers le bas pour demander à cette app et à chaque serveur ce qu'ils exécutent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno ha ancora risposto. Trascina verso il basso per chiedere a questa app e a ogni server cosa stanno eseguendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も応答していません。下に引っ張ると、このアプリと各サーバーに実行中のバージョンを問い合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 아무 응답도 없습니다. 아래로 당기면 이 앱과 모든 서버에 실행 중인 버전을 물어봅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada respondeu ainda. Puxe para baixo para perguntar a este app e a cada servidor o que eles estão executando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前还没有任何响应。下拉可以询问本应用和每台服务器正在运行的版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前還沒有任何回應。下拉可以詢問本應用程式和每台伺服器正在執行的版本。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic jeszcze nie odpowiedziało. Pociągnij w dół, aby zapytać tę aplikację i każdy serwer, co uruchamiają."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet har svaret endnu. Træk ned for at spørge denne app og hver server, hvilken version de kører."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään ei ole vielä vastannut. Vedä alas, niin tämä sovellus ja jokainen palvelin kertovat, mitä versiota ne käyttävät."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Enginn hefur svarað enn. Dragðu niður til að spyrja þetta forrit og alla netþjóna hvaða útgáfu þeir keyra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen har svart ennå. Dra ned for å spørre denne appen og hver server hva de kjører."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget har svarat än. Dra nedåt för att fråga den här appen och alla servrar vad de kör."
          }
        }
      }
    },
    "Nothing has been asked yet. This app and every server you add answer for their own software.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde noch nichts abgefragt. Diese App und jeder Server, den Sie hinzufügen, antworten für ihre eigene Software."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has been asked yet. This app and every server you add answer for their own software."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se ha consultado nada. Esta app y cada servidor que se añada responden por su propio software."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a encore été demandé. Cette app et chaque serveur que vous ajoutez répondent de leur propre logiciel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato ancora chiesto nulla. Questa app e ogni server che aggiungi rispondono del proprio software."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も問い合わせていません。このアプリと追加した各サーバーが、それぞれ自分のソフトウェアについて答えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 아무것도 물어보지 않았습니다. 이 앱과 추가한 모든 서버가 각자 자신의 소프트웨어에 대해 답합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda nada foi perguntado. Este app e cada servidor que você adicionar respondem pelo próprio software."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前还没有进行过任何查询。本应用和你添加的每台服务器，都会各自回答有关自身软件的问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前還沒有進行過任何查詢。本應用程式和你新增的每台伺服器，都會各自回答有關自身軟體的問題。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze o nic nie zapytano. Ta aplikacja i każdy dodany przez ciebie serwer odpowiadają za własne oprogramowanie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke spurgt endnu. Denne app og hver server, du tilføjer, oplyser deres egen software."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei ole vielä kysytty. Tämä sovellus ja jokainen lisäämäsi palvelin vastaavat omista ohjelmistoistaan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert hefur verið spurt enn. Þetta forrit og hver netþjónn sem þú bætir við svara fyrir sinn eigin hugbúnað."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting er spurt om ennå. Denne appen og hver server du legger til svarer om sin egen programvare."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen har frågats än. Den här appen och varje server du lägger till svarar för sin egen programvara."
          }
        }
      }
    },
    "Nothing here knows when this was last checked.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier weiß niemand, wann zuletzt geprüft wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here knows when this was last checked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aquí sabe cuándo se comprobó por última vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ici ne sait quand cela a été vérifié pour la dernière fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non si sa quando è stato controllato l'ultima volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後にいつ確認したのか、ここでは分かりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 언제 확인했는지 여기서는 알 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aqui sabe quando isso foi verificado pela última vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里无法得知上次检查是什么时候。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡無法得知上次檢查是什麼時候。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic tutaj nie wie, kiedy to sprawdzono ostatnio."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ved ingen, hvornår dette sidst blev tjekket."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täällä ei tiedetä, milloin tämä tarkistettiin viimeksi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert hér veit hvenær þetta var síðast athugað."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Her vet ingen når dette sist ble sjekket."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting här vet när det senast kontrollerades."
          }
        }
      }
    },
