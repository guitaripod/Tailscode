    "opencode cannot wait, so it restarts at once and stops the %lld turns it is running.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode cannot wait, so it restarts at once and stops the %lld turns it is running."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode kann nicht warten, deshalb startet es sofort neu und stoppt die %lld Züge, die es gerade ausführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode no puede esperar, así que se reinicia de inmediato y detiene los %lld turnos que está ejecutando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode ne peut pas attendre : il redémarre aussitôt et arrête les %lld tours qu’il exécute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode non può attendere, quindi riavvia subito e interrompe i %lld turni che sta eseguendo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode は待機できないため、すぐに再起動し、実行中の %lld 件のターンを停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode는 기다릴 수 없으므로 바로 재시동하고, 실행 중인 턴 %lld개를 멈춥니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode nie może czekać, więc uruchamia się ponownie od razu i zatrzymuje %lld działających tur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O opencode não consegue esperar, então reinicia de imediato e interrompe os %lld turnos em execução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode 无法等待，因此会立即重新启动，并停止它正在运行的 %lld 个回合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode 無法等待，因此會立即重新開機，並停止它正在執行的 %lld 個回合。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode kan ikke vente, så den genstarter straks og stopper de %lld ture, den kører."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode ei voi odottaa, joten se käynnistyy heti uudelleen ja pysäyttää käynnissä olevat %lld vuoroa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode getur ekki beðið, svo það endurræsist strax og stöðvar þær %lld umferðir sem eru í gangi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode kan ikke vente, så den starter straks på nytt og stopper de %lld turene den kjører."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "opencode kan inte vänta, så den startar om direkt och stoppar de %lld turerna den kör."
          }
        }
      }
    },
