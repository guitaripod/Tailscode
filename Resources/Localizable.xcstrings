          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeczytaj %@ i kontynuuj tam, gdzie skończyło. "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia %@ e continue de onde parou. "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通读 %@，并从它停下的地方继续。 "
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通讀 %@，並從它停下的地方繼續。 "
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læs %@ igennem og fortsæt, hvor det slap. "
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lue %@ läpi ja jatka siitä, mihin jäätiin. "
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lestu yfir %@ og haltu áfram þar sem frá var horfið. "
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gjennom %@ og fortsett der det slapp. "
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs igenom %@ och fortsätt där det slutade. "
          }
        }
      }
    },
