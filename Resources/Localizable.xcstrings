    "The package manager that installed this says when a newer one exists.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Paketmanager, der dies installiert hat, meldet, wann es eine neuere Version gibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
