    "Nothing was sent. Your words are still in the box.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was sent. Your words are still in the box."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wurde gesendet. Deine Worte stehen noch im Feld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envió nada. Tus palabras siguen en el cuadro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été envoyé. Vos mots sont toujours dans la zone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato inviato nulla. Le tue parole sono ancora nella casella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も送信されていません。入力した言葉はそのまま残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 전송되지 않았습니다. 입력한 글은 그대로 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostało wysłane. Twoje słowa nadal są w polu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi enviado. Suas palavras continuam na caixa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有发送任何内容。你的文字仍在输入框中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有傳送任何內容。你的文字仍在輸入框中。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet blev sendt. Dine ord står stadig i feltet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitään ei lähetetty. Kirjoittamasi teksti on edelleen kentässä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert var sent. Textinn þinn er enn í reitnum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting ble sendt. Ordene dine står fortsatt i feltet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget skickades. Dina ord finns kvar i fältet."
          }
        }
      }
