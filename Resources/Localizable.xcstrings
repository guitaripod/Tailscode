    "Enter that machine's tailnet address. Run tailscale ip -4 on it, or read it off the machine list in the Tailscale app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter that machine's tailnet address. Run tailscale ip -4 on it, or read it off the machine list in the Tailscale app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die Tailnet-Adresse des Rechners ein. Führe dort tailscale ip -4 aus oder lies sie in der Geräteliste der Tailscale-App ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la dirección de tailnet de esa máquina. Ejecuta tailscale ip -4 en ella o consúltala en la lista de máquinas de la app de Tailscale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez l’adresse tailnet de cette machine. Lancez tailscale ip -4 dessus, ou lisez-la dans la liste des machines de l’app Tailscale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci l’indirizzo tailnet di quella macchina. Esegui tailscale ip -4 su di essa, oppure leggilo nell’elenco delle macchine nell’app Tailscale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのマシンの tailnet アドレスを入力します。マシン上で tailscale ip -4 を実行するか、Tailscale App のマシン一覧で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 컴퓨터의 tailnet 주소를 입력하세요. 그 컴퓨터에서 tailscale ip -4를 실행하거나, Tailscale 앱의 기기 목록에서 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o endereço tailnet dessa máquina. Rode tailscale ip -4 nela ou leia na lista de máquinas do app Tailscale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入那台机器的 tailnet 地址。在它上面运行 tailscale ip -4，或在 Tailscale App 的机器列表中查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入那台電腦的 tailnet 位址。在它上面執行 tailscale ip -4，或在 Tailscale App 的電腦清單中查看。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz adres tailnet tego komputera. Uruchom na nim tailscale ip -4 albo odczytaj go z listy urządzeń w aplikacji Tailscale."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast computerens tailnet-adresse. Kør tailscale ip -4 på den, eller læs den af computerlisten i Tailscale-appen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä koneen tailnet-osoite. Suorita siinä tailscale ip -4 tai lue se Tailscale-sovelluksen koneluettelosta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Settu inn tailnet-vistfang tölvunnar. Keyrðu tailscale ip -4 á henni eða lestu það af tölvulistanum í Tailscale-appinu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn tailnet-adressen til maskinen. Kjør tailscale ip -4 på den, eller les den av maskinlisten i Tailscale-appen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange datorns tailnet-adress. Kör tailscale ip -4 på den eller läs av den i datorlistan i Tailscale-appen."
          }
        }
      }
    },
