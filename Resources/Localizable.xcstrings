    "%@ is what says when a newer one exists.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist zuständig dafür, zu sagen, wann es eine neuere Version gibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is what says when a newer one exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es quien avisa cuando hay una versión más nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est %@ qui indique quand une version plus récente existe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È %@ a segnalare quando esiste una versione più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンの有無を教えてくれるのは%@です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 버전이 있는지 알려주는 것은 %@입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é quem avisa quando existe uma versão mais nova."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 %@ 负责提示是否有更新版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 %@ 負責提示是否有更新版本。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To %@ mówi, kiedy istnieje nowsza wersja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er den, der melder, når en nyere version findes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on se, joka ilmoittaa, kun uudempi versio on saatavilla."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sér um að láta vita þegar nýrri útgáfa er til."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sier fra når en nyere versjon finnes."
          }
        },
        "sv": {
