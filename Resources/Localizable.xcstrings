        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ からのライブ表示です。パーセンテージはアカウントの実際の消費量であり、推定値ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 실시간으로 가져온 값입니다. 백분율은 추정치가 아니라 계정의 실제 사용량입니다."
