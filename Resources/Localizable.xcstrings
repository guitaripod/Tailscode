    "%@ stopped with an error and did not finish.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stopped with an error and did not finish."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde mit einem Fehler gestoppt und hat nicht abgeschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se detuvo con un error y no terminó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’est arrêté sur une erreur et n’a pas terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si è fermato con un errore e non ha finito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はエラーで停止し、完了しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 오류로 중단되어 끝내지 못했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zatrzymał się z błędem i nie dokończył."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parou com um erro e não terminou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 因出错而停止，没有完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 因發生錯誤而停止，沒有完成。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stoppede med en fejl og blev ikke afsluttet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pysähtyi virheeseen eikä valmistunut."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stöðvaðist með villu og lauk ekki."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stoppet med en feil og ble ikke fullført."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stoppades med ett fel och slutfördes inte."
          }
        }
      }
    },
