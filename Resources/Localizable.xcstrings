    "Approvals and turn alerts are raised by this device while it is watching a session. Push from servers is what reaches you after the app is closed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigaben und Zug-Hinweise löst dieses Gerät aus, solange es eine Sitzung beobachtet. Push von Servern erreicht dich, nachdem die App geschlossen wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approvals and turn alerts are raised by this device while it is watching a session. Push from servers is what reaches you after the app is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las aprobaciones y los avisos de turno los emite este dispositivo mientras observa una sesión. Las notificaciones push de los servidores te llegan cuando la app está cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les approbations et les alertes de tour sont émises par cet appareil tant qu’il observe une session. Les notifications push des serveurs vous atteignent une fois l’app fermée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le approvazioni e gli avvisi di turno vengono generati da questo dispositivo mentre osserva una sessione. I push dai server ti raggiungono dopo la chiusura dell’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認とターン通知は、このデバイスがセッションを監視している間に発行されます。App を閉じた後に届くのはサーバからのプッシュです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 및 턴 알림은 이 기기가 세션을 지켜보는 동안 발생합니다. 앱이 닫힌 뒤에는 서버 푸시가 알려 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As aprovações e os alertas de turno são emitidos por este dispositivo enquanto ele observa uma sessão. O push dos servidores é o que chega até você depois que o app é fechado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当此设备正在关注会话时，由它发出批准和回合提醒。App 关闭后，则由服务器推送通知你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當此裝置正在關注工作階段時，由它發出核准與回合提醒。App 關閉後，則由伺服器推播通知你。"
          }
        }
      }
    },
