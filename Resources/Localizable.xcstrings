    "Class, ladder, verifier and the rest. The class fills anything you leave alone.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasse, stige, verifikator og resten. Klassen udfylder alt, du lader stå tomt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasse, Leiter, Verifizierer und der Rest. Die Klasse füllt alles aus, was du leer lässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Class, ladder, verifier and the rest. The class fills anything you leave alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Classe, escalera, verificador y el resto. La clase rellena lo que dejes sin tocar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luokka, portaat, tarkistaja ja muut. Luokka täyttää kohdat, joita et muuta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classe, échelle, vérificateur et le reste. La classe remplit tout ce que vous laissez de côté."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Flokkur, stigi, sannprófari og annað. Flokkurinn fyllir inn allt sem þú lætur ósnert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Classe, scala, verificatore e il resto. La classe compila ciò che lasci stare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラス、はしご、検証など。触れなかった項目はクラスが埋めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클래스, 사다리, 검증 등. 건드리지 않은 항목은 클래스가 채웁니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasse, stige, verifikator og resten. Klassen fyller inn alt du lar være tomt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasa, drabina, weryfikator i reszta. Klasa uzupełnia wszystko, czego nie ruszysz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Classe, escada, verificador e o resto. A classe preenche o que você deixar de lado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klass, stege, verifierare med mera. Klassen fyller i det du lämnar orört."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "类别、阶梯、验证等设置。你没改动的项由类别补全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "類別、階梯、驗證等設定。你沒改動的項目由類別補齊。"
          }
        }
      }
    },
