          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidores ilimitados e delegação para modelos mais baratos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器数量不限，并可委派给更便宜的模型"
