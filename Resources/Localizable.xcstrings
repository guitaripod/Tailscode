        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvaða útgáfur þessa líkans passa í skjákortið mitt og hversu hratt myndu þær keyra?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilke varianter av denne modellen passer i GPU-en min, og hvor raskt ville de kjørt?"
