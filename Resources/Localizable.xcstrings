    "Kept on this device only — %@ cannot keep pins or archives yet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept on this device only — %@ cannot keep pins or archives yet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf diesem Gerät gespeichert — %@ kann Anheftungen und Archive noch nicht speichern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guarda en este dispositivo — %@ aún no puede guardar chats fijados ni archivados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservé sur cet appareil uniquement — %@ ne peut pas encore conserver les épingles ni les archives"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato solo su questo dispositivo — %@ non può ancora conservare chat fissate o archiviate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにのみ保存されます — %@ はまだピン留めやアーカイブを保持できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에만 저장됩니다 — %@은(는) 아직 고정이나 보관을 저장할 수 없습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane tylko na tym urządzeniu — %@ nie potrafi jeszcze przechowywać przypiętych ani zarchiwizowanych rozmów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo apenas neste dispositivo — %@ ainda não consegue guardar conversas fixadas ou arquivadas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存在此设备上 — %@ 暂时无法保存置顶或归档"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅儲存在此裝置上 — %@ 暫時無法儲存置頂或封存"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun gemt på denne enhed – %@ kan endnu ikke gemme fastgjorte chats eller arkiver"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu vain tälle laitteelle – %@ ei voi vielä tallentaa kiinnityksiä tai arkistoja"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Aðeins geymt á þessu tæki – %@ getur ekki fest spjöll eða geymt þau enn"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret bare på denne enheten – %@ kan ikke feste eller arkivere ennå"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparas bara på den här enheten. %@ kan ännu inte spara fästa chattar eller arkiv."
          }
        }
      }
    },
