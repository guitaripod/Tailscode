    "It was started without --listen, so nothing else on the tailnet can reach it. Start it again with --listen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was started without --listen, so nothing else on the tailnet can reach it. Start it again with --listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde ohne --listen gestartet, daher kann im Tailnet niemand anderes es erreichen. Starte es erneut mit --listen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se inició sin --listen, así que nada más en la tailnet puede acceder. Vuelve a iniciarlo con --listen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a été lancé sans --listen, donc rien d'autre sur le tailnet ne peut l'atteindre. Relancez-le avec --listen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato avviato senza --listen, quindi nessun altro dispositivo della tailnet può raggiungerlo. Avvialo di nuovo con --listen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "--listen なしで起動されているため、tailnet 上の他の機器からは接続できません。--listen を付けて再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--listen 없이 시작되어 tailnet의 다른 기기에서 접근할 수 없습니다. --listen 옵션을 붙여 다시 시작하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchomiono je bez --listen, więc nic inne w tailnecie nie może się z nim połączyć. Uruchom ponownie z --listen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele foi iniciado sem --listen, então nada mais na tailnet consegue acessá-lo. Inicie-o novamente com --listen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它是在没有 --listen 的情况下启动的，因此 tailnet 中的其他设备无法访问。请使用 --listen 重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它是在沒有 --listen 的情況下啟動的，因此 tailnet 上的其他裝置無法連線。請加上 --listen 重新啟動。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det blev startet uden --listen, så ingen andre på tailnet kan nå det. Start det igen med --listen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se käynnistettiin ilman --listen-asetusta, joten tailnetin muut laitteet eivät tavoita sitä. Käynnistä se uudelleen --listen-asetuksella."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það var byrjað án --listen, svo ekkert annað á tailnetinu getur náð í það. Byrjaðu það aftur með --listen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ble startet uten --listen, så ingen andre enheter på tailnetet kan nå den. Start den på nytt med --listen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det startades utan --listen, så ingen annan på tailnet kan nå det. Starta det igen med --listen."
          }
        }
      }
    },
