    "%@ runs on %@, and a conversation lives on the machine that answers it. This chat stays where it is.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft auf %@, und eine Unterhaltung lebt auf dem Rechner, der sie beantwortet. Dieser Chat bleibt, wo er ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ runs on %@, and a conversation lives on the machine that answers it. This chat stays where it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ejecuta en %@, y una conversación vive en la máquina que la responde. Este chat se queda donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’exécute sur %@, et une conversation vit sur la machine qui y répond. Cette discussion reste où elle est."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viene eseguito su %@, e una conversazione vive sulla macchina che le risponde. Questa chat resta dove si trova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %@ で動作しており、会話はそれに応答するマシン上にあります。このチャットはそのままそこに留まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) %@에서 실행되며, 대화는 그것에 응답하는 컴퓨터에 머뭅니다. 이 대화는 있던 자리에 그대로 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é executado em %@, e uma conversa vive na máquina que responde por ela. Esta conversa permanece onde está."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在 %@ 上运行，对话保存在响应它的那台机器上。此对话会留在原处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在 %@ 上執行，對話保存在回應它的那台機器上。此對話會留在原處。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ działa na %@, a rozmowa żyje na komputerze, który na nią odpowiada. Ta rozmowa zostaje tam, gdzie jest."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kører på %@, og en samtale lever på den computer, der besvarer den. Denne chat bliver, hvor den er."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ toimii laitteella %@, ja keskustelu kuuluu siihen vastaavalle tietokoneelle. Tämä keskustelu pysyy paikallaan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ keyrir á %@, og samtal lifir á tölvunni sem svarar því. Þetta spjall helst þar sem það er."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kjører på %@, og en samtale lever på maskinen som svarer på den. Denne chatten blir der den er."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ körs på %@, och en konversation lever på datorn som svarar på den. Den här chatten stannar där den är."
          }
        }
      }
    },
