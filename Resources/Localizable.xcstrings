    "A command runs now — send it with enter.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A command runs now — send it with enter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Befehl läuft sofort – sende ihn mit Enter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comando se ejecuta ahora: envíalo con Intro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une commande s'exécute maintenant — envoyez-la avec Entrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un comando viene eseguito subito: invialo con Invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドは今すぐ実行されます — Enter で送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령은 지금 실행됩니다 — Enter로 보내세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie działa od razu — wyślij je klawiszem Enter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um comando roda agora — envie com Enter."
          }
        },
