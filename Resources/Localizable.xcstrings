          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle områder og vinduets zoom vender tilbage til normal"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki alueet ja ikkunan zoomaus palautuvat normaaliksi"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Öll svæðin og gluggaaðdrátturinn fara aftur í venjulega stærð"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle områdene og vinduet går tilbake til normal zoom"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla områden och fönstrets zoom återgår till normal storlek"
          }
        }
      }
    },
    "Every shortcut goes back to the keys it shipped with. Notes you wrote in keybindings.json stay.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every shortcut goes back to the keys it shipped with. Notes you wrote in keybindings.json stay."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Tastenkombination kehrt zu den ausgelieferten Tasten zurück. Notizen, die du in keybindings.json geschrieben hast, bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada atajo vuelve a las teclas originales. Las notas que escribiste en keybindings.json se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque raccourci revient aux touches d’origine. Les notes écrites dans keybindings.json restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni scorciatoia torna ai tasti originali. Le note scritte in keybindings.json restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのショートカットが出荷時のキーに戻ります。keybindings.json に書いたメモは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 단축키가 출하 시 키로 돌아갑니다. keybindings.json에 적은 메모는 그대로 남습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy skrót wraca do klawiszy domyślnych. Notatki zapisane w keybindings.json pozostają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada atalho volta às teclas originais. As notas que você escreveu em keybindings.json permanecem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有快捷键都会恢复为出厂按键。你在 keybindings.json 中写的注释会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有快捷鍵都會恢復為出廠按鍵。你在 keybindings.json 中寫的註解會保留。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle genveje vender tilbage til de taster, de blev leveret med. Noter, du har skrevet i keybindings.json, bliver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen pikanäppäin palautuu oletusnäppäimiinsä. Muistiinpanot, jotka kirjoitit tiedostoon keybindings.json, säilyvät."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver flýtilykill fer aftur í þá takka sem hann kom með.Athugasemdir sem þú skrifaðir í keybindings.json haldast."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver snarvei går tilbake til tastene den fulgte med. Notater du skrev i keybindings.json forblir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje kortkommando återgår till standardtangenterna. Anteckningar du skrev i keybindings.json behålls."
          }
        }
      }
    },
