    "Claude quota is unavailable right now — the bridge couldn't reach api.anthropic.com.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Claude-Kontingent ist gerade nicht verfügbar – die Bridge hat api.anthropic.com nicht erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude quota is unavailable right now — the bridge couldn't reach api.anthropic.com."
          }
        },
        "es": {
