          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o worker precisa alcançar, escrito para um leitor sem nenhum outro contexto. Nomeie os arquivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写明执行者必须达成的目标，措辞要让没有其他背景信息的读者也能看懂。请指出具体文件名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫明執行者必須達成的目標，措辭要讓沒有其他背景資訊的讀者也能看懂。請指出具體檔案名稱。"
          }
        }
      }
    },
