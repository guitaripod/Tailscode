            "state": "translated",
            "value": "Questo avvia una nuova conversazione sull’agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント側で新しい会話を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트에서 새 대화를 시작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso inicia uma nova conversa no agente."
          }
        },
        "zh-Hans": {
