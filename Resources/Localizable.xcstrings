    "Rebind any of these by id in keybindings.json — in this app's folder in Files.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belege jede davon per ID in keybindings.json neu — im Ordner dieser App in Dateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
