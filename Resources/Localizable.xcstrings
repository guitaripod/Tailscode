        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지를 열고 코드가 일치하는지 확인한 다음 확정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a página, confira se o código bate e confirme-o."
