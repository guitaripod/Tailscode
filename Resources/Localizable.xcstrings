    "Try again. If it keeps stopping, the log has what happened.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. If it keeps stopping, the log has what happened."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen. Wenn es weiter stoppt, steht im Log, was passiert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a intentarlo. Si sigue parándose, el registro muestra lo ocurrido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez. Si cela s'arrête encore, le journal indique ce qui s'est passé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova. Se continua a fermarsi, il registro mostra cosa è successo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度試してください。何度も停止する場合は、ログに詳細があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도하세요. 계속 멈추면 로그에 원인이 남아 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj ponownie. Jeśli ciągle się zatrzymuje, w dzienniku jest, co się stało."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente de novo. Se continuar parando, o registro mostra o que aconteceu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再试一次。若仍停止，日志里有详情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請再試一次。若持續停止，記錄檔會顯示原因。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv igen. Hvis det bliver ved med at stoppe, står der i loggen, hvad der skete."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yritä uudelleen. Jos se pysähtyy toistuvasti, loki kertoo, mitä tapahtui."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Reyndu aftur. Ef þetta heldur áfram að stöðvast sýnir annállinn hvað gerðist."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv igjen. Hvis det fortsetter å stoppe, står det i loggen hva som skjedde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Försök igen. Om det fortsätter att stanna visar loggen vad som hände."
          }
        }
      }
    },
