    "A two-key shortcut that starts with this key (%@) would stop working.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A two-key shortcut that starts with this key (%@) would stop working."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zwei-Tasten-Kombination, die mit dieser Taste (%@) beginnt, würde nicht mehr funktionieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un atajo de dos teclas que empieza con esta tecla (%@) dejaría de funcionar."
          }
        },
