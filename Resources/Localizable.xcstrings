        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断信息已改为复制到剪贴板。请发送到 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "診斷資訊已改為複製到剪貼板。請寄送至 %@。"
          }
        },
        "pl": {
          "stringUnit": {
