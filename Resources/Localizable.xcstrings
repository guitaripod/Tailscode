    "Kept on the machine, readable only by its user. It never comes back to this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept on the machine, readable only by its user. It never comes back to this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Rechner gespeichert, nur für seinen Benutzer lesbar. Sie kommt nie auf dieses Gerät zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada en el equipo y solo legible por su usuario. Nunca vuelve a este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservée sur la machine, lisible seulement par son utilisateur. Elle ne revient jamais sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservata sul computer, leggibile solo dal suo utente. Non torna mai su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンに保存され、そのユーザーだけが読めます。この端末には二度と戻りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 보관되며 해당 사용자만 읽을 수 있습니다. 이 기기로 다시 전송되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowywane na komputerze, czytelne tylko dla jego użytkownika. Nigdy nie wraca na to urządzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada na máquina, legível só pelo seu usuário. Nunca volta para este dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在这台机器上，只有其所属用户可以读取。它不会再回到这台设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在這台機器上，只有其使用者可以讀取。它不會再回到這台裝置。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt på computeren, kun læsbar for dens bruger. Den kommer aldrig tilbage til denne enhed."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytetty tietokoneella, ja vain sen käyttäjä voi lukea sitä. Se ei koskaan palaa tälle laitteelle."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Geymt á tölvunni, aðeins læsilegt fyrir notanda hennar. Hann kemur aldrei aftur á þetta tæki."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret på maskinen, og bare brukeren kan lese den. Den kommer aldri tilbake til denne enheten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparad på datorn, läsbar bara för dess användare. Den kommer aldrig tillbaka till den här enheten."
          }
        }
      }
    },
