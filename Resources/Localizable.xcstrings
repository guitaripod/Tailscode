    "%1$@ holds %2$d modules. Turn one off to add another.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ holds %2$d modules. Turn one off to add another."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ fasst %2$d Module. Schalte eines aus, um ein anderes hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ admite %2$d módulos. Desactiva uno para añadir otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ contient %2$d modules. Désactivez-en un pour en ajouter un autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ contiene %2$d moduli. Disattivane uno per aggiungerne un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ に入るモジュールは%2$d個までです。別のものを追加するには、どれかをオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에는 모듈 %2$d개가 들어갑니다. 다른 모듈을 추가하려면 하나를 끄세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba modułów w formacie %1$@: %2$d. Wyłącz jeden, aby dodać kolejny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ comporta %2$d módulos. Desative um para adicionar outro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 最多容纳 %2$d 个模块。先关闭一个才能添加其他的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 最多容納 %2$d 個模組。先關閉一個才能新增其他的。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rummer %2$d moduler. Slå et fra for at tilføje et andet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sisältää %2$d moduulia. Poista yksi käytöstä, jotta voit lisätä toisen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ geymir %2$d einingar. Slökktu á einni til að bæta við annarri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ inneholder %2$d moduler. Slå av én for å legge til en annen."
