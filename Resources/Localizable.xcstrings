    "This app is not sold in the %@ store, so nothing here can say what the newest version is.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App wird im %@-Store nicht verkauft, daher kann hier niemand sagen, was die neueste Version ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is not sold in the %@ store, so nothing here can say what the newest version is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app no se vende en la tienda de %@, así que nada aquí puede decir cuál es la versión más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app n’est pas vendue sur la boutique %@, donc rien ici ne peut dire quelle est la dernière version."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app non è in vendita nello store %@, quindi qui non si può dire quale sia la versione più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは %@ ストアでは販売されていないため、最新バージョンが何かをここで示すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 %@ 스토어에서 판매되지 않아, 여기서는 최신 버전이 무엇인지 알 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app não é vendido na loja %@, então nada aqui pode dizer qual é a versão mais recente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用未在 %@ 商店上架，因此这里无法说明最新版本是什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式未在 %@ 商店上架，因此這裡無法說明最新版本是什麼。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aplikacja nie jest sprzedawana w sklepie %@, więc nic tu nie może powiedzieć, jaka jest najnowsza wersja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne app sælges ikke i %@-butikken, så her kan ingen sige, hvad den nyeste version er."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä sovellusta ei myydä kaupassa %@, joten täällä ei voida kertoa uusinta versiota."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta forrit er ekki selt í %@-versluninni, svo hér er ekki hægt að segja hver nýjasta útgáfan er."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne appen selges ikke i %@-butikken, så ingenting her kan si hva den nyeste versjonen er."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här appen säljs inte i %@-butiken, så det går inte att se vad den senaste versionen är."
          }
        }
      }
    },
    "This device has no Taptic Engine, so cues fall back to the system's canned feedback and the slider can only approximate them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat keine Taptic Engine, daher greifen Signale auf das eingebaute Feedback des Systems zurück, und der Regler kann sie nur annähern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no Taptic Engine, so cues fall back to the system's canned feedback and the slider can only approximate them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene Taptic Engine, así que las señales recurren a la respuesta predefinida del sistema y el control deslizante solo puede aproximarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas de Taptic Engine, donc les signaux se rabattent sur le retour préenregistré du système et le curseur ne peut que les approximer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha il Taptic Engine, quindi i segnali ricadono sul feedback preconfezionato del sistema e il cursore può solo approssimarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末には Taptic Engine が搭載されていないため、キューはシステムの既定のフィードバックにフォールバックし、スライダーはそれを近似することしかできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에는 Taptic Engine이 없어서, 신호는 시스템의 기본 피드백으로 대체되며 슬라이더는 그것을 근사치로만 표현할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem Taptic Engine, então os sinais recorrem ao feedback padrão do sistema e o controle deslizante só consegue aproximá-los."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备没有 Taptic Engine，因此提示音会退回系统自带的固定反馈，滑块只能近似地表现它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置沒有 Taptic Engine，因此提示音會退回系統內建的固定回饋，滑桿只能近似地表現它們。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie ma Taptic Engine, więc sygnały korzystają z gotowego systemowego sprzężenia zwrotnego, a suwak może je jedynie przybliżać."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed har ingen Taptic Engine, så signaler falder tilbage til systemets indbyggede feedback, og skyderen kan kun efterligne dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä laitteessa ei ole Taptic Engineä, joten signaalit käyttävät järjestelmän valmista palautetta, ja liukusäädin voi vain likimäärin jäljitellä niitä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta tæki er án Taptic Engine, svo vísbendingar nota innbyggð kerfisviðbrögð og rennibrautin getur aðeins líkt eftir þeim."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enheten har ingen Taptic Engine, så signaler faller tilbake til systemets innebygde tilbakemelding, og glidebryteren kan bare tilnærme dem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här enheten har ingen Taptic Engine, så signaler faller tillbaka till systemets vanliga feedback och reglaget kan bara efterlikna dem."
          }
        }
      }
    },
    "This device has no graphics processor Tailscode can reach, so Aurora cannot run here and every answer is written by Classic.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat keinen Grafikprozessor, den Tailscode erreichen kann, daher kann Aurora hier nicht laufen und jede Antwort wird von Classic geschrieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no graphics processor Tailscode can reach, so Aurora cannot run here and every answer is written by Classic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene un procesador gráfico al que Tailscode pueda acceder, así que Aurora no puede ejecutarse aquí y cada respuesta la escribe Classic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas de processeur graphique que Tailscode puisse atteindre, donc Aurora ne peut pas s’exécuter ici et chaque réponse est écrite par Classic."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha un processore grafico che Tailscode possa raggiungere, quindi Aurora non può funzionare qui e ogni risposta viene scritta da Classic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末には Tailscode が利用できるグラフィックプロセッサがないため、Aurora はここでは動作せず、すべての回答は Classic によって描画されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에는 Tailscode가 접근할 수 있는 그래픽 프로세서가 없어서, Aurora는 여기서 실행될 수 없으며 모든 답변은 Classic이 작성합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem um processador gráfico que o Tailscode consiga acessar, então o Aurora não pode rodar aqui e cada resposta é escrita pelo Classic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备没有 Tailscode 能够访问的图形处理器，因此 Aurora 无法在这里运行，每个回答都会由 Classic 写出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置沒有 Tailscode 能夠存取的圖形處理器，因此 Aurora 無法在這裡執行，每個回答都會由 Classic 寫出。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie ma procesora graficznego, do którego Tailscode może dotrzeć, więc Aurora nie może tu działać, a każda odpowiedź jest zapisywana przez Classic."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed har ingen grafikprocessor, som Tailscode kan nå, så Aurora kan ikke køre her, og hvert svar skrives af Classic."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä laitteessa ei ole grafiikkaprosessoria, johon Tailscode yltää, joten Aurora ei voi toimia täällä ja Classic kirjoittaa jokaisen vastauksen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta tæki hefur engan grafíkörgjörva sem Tailscode nær til, svo Aurora getur ekki keyrt hér og hvert svar er skrifað af Classic."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enheten har ingen grafikkprosessor som Tailscode kan bruke, så Aurora kan ikke kjøre her, og hvert svar skrives av Classic."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här enheten har ingen grafikprocessor som Tailscode kan nå, så Aurora kan inte köras här och varje svar skrivs av Classic."
          }
        }
      }
    },
    "This iPad is not on your tailnet, so it cannot reach your machine yet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
