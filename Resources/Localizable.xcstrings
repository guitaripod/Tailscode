        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta líkan hefur hér skilað %@ tákn/s að meðaltali yfir %d umferðir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
