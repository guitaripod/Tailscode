    "Added. They are in the model pill once they answer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added. They are in the model pill once they answer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzugefügt. Sie erscheinen in der Modellauswahl, sobald sie antworten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadido. Estarán en el selector de modelo cuando respondan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouté. Ils figurent dans le sélecteur de modèle dès qu'ils répondent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunto. Saranno nel selettore del modello appena risponderanno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加しました。応答するとモデル選択に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가됨. 응답하면 모델 선택에 나타납니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodano. Pojawią się w wyborze modelu, gdy odpowiedzą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionados. Eles aparecem no seletor de modelo assim que responderem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加。它们一旦响应，就会出现在模型选择器中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已加入。它們一旦回應，就會出現在模型選擇器中。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføjet. De vises i modelvælgeren, når de svarer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisätty. Ne näkyvät mallivalinnassa, kun ne vastaavat."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Bætt við. Þau birtast í líkanavalinu þegar þau svara."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagt til. De vises i modellvelgeren når de har svart."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillagda. De finns i modellväljaren när de har svarat."
          }
        }
      }
    },
