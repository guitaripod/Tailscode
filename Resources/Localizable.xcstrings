    "The address is verified before it is saved, so a typo fails here rather than as errors in every chat.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse wird vor dem Sichern geprüft, damit ein Tippfehler hier auffällt statt später in jedem Chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address is verified before it is saved, so a typo fails here rather than as errors in every chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección se verifica antes de guardarla, así una errata falla aquí y no como errores en cada chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse est vérifiée avant d’être enregistrée : une faute de frappe échoue ici plutôt que dans chaque discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indirizzo viene verificato prima del salvataggio, così un refuso fallisce qui e non come errore in ogni chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスは保存前に検証されるため、入力ミスはここで判明します。すべてのチャットでエラーになることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소는 저장 전에 확인되므로, 오타는 모든 대화에서 오류가 되는 대신 여기서 걸립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço é verificado antes de ser salvo, então um erro de digitação falha aqui em vez de virar erro em toda conversa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址会在保存前先验证，这样拼写错误会在这里暴露，而不是在每次对话中报错。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位址會在儲存前先驗證，這樣拼字錯誤會在這裡暴露，而不是在每次對話中報錯。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres jest weryfikowany przed zapisaniem, dzięki czemu literówka zostanie wychwycona tutaj, a nie jako błędy w każdej rozmowie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen kontrolleres, før den gemmes, så en tastefejl opdages her i stedet for som fejl i hver chat."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoite vahvistetaan ennen tallennusta, joten kirjoitusvirhe paljastuu jo tässä eikä virheinä jokaisessa keskustelussa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vistfangið er staðfest áður en það er vistað, þannig að innsláttarvilla komi strax í ljós hér í stað þess að birtast sem villur í hverju spjalli."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen bekreftes før den lagres, så en skrivefeil oppdages her og ikke som feil i hver chat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen verifieras innan den sparas, så ett stavfel märks här i stället för som fel i varje chatt."
          }
        }
      }
    },
