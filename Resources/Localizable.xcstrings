          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga ao assistente o que mudar e pressione a tecla Return."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉助手要改什么，然后按回车键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴助手要改什麼，然後按 Return 鍵。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz pomocnikowi, co zmienić, a potem naciśnij Return"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortæl hjælperen, hvad der skal ændres, og tryk derefter på Retur"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro apurille, mitä muutetaan, ja paina Return-näppäintä"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Segðu hjálparanum hvað á að breyta, ýttu svo á Return"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortell hjelperen hva som skal endres, og trykk Retur"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berätta för hjälparen vad som ska ändras, tryck sedan på Retur"
