    "The turn ended without a word — no answer, no tool call, and no error to explain it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zug endete ohne ein Wort — keine Antwort, kein Werkzeugaufruf und kein Fehler, der es erklärt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The turn ended without a word — no answer, no tool call, and no error to explain it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El turno terminó sin una palabra: ni respuesta, ni llamada a una herramienta, ni un error que lo explique."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tour s’est terminé sans un mot — pas de réponse, pas d’appel d’outil, et aucune erreur pour l’expliquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il turno è terminato senza una parola — nessuna risposta, nessuna chiamata a uno strumento e nessun errore che lo spieghi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターンは一言もなく終わりました。回答もツール呼び出しもなく、原因を説明するエラーもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴이 한마디도 없이 끝났습니다. 답변도, 도구 호출도, 이를 설명할 오류도 없었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O turno terminou sem uma palavra — sem resposta, sem chamada de ferramenta e sem erro que o explique."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回合没有留下只言片语就结束了——没有回答、没有工具调用，也没有任何错误可以解释原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回合沒有留下隻字片語就結束了——沒有回答、沒有工具呼叫，也沒有任何錯誤可以解釋原因。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tura zakończyła się bez słowa — bez odpowiedzi, bez wywołania narzędzia i bez błędu, który by to wyjaśniał."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Turen sluttede uden ord: intet svar, intet værktøjskald og ingen fejl, der forklarer det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoro päättyi ilman sanaa – ei vastausta, ei työkalukutsua eikä virhettä, joka sen selittäisi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Umferðin lauk án orðs – ekkert svar, ekkert verkfærakall og engin villa til að útskýra það."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Turen ble avsluttet uten et ord: ingen svar, ingen verktøykall og ingen feil som forklarer det."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Turen avslutades utan ett ord: inget svar, inget verktygsanrop och inget fel som förklarar det."
          }
        }
      }
    },
    "%@ ended the turn without a word — no answer, no tool call, and no error to explain it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den Zug ohne ein Wort beendet — keine Antwort, kein Werkzeugaufruf und kein Fehler, der es erklärt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
