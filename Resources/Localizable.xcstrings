        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ on käynnissä, mutta ei vastannut päivityksiin ajoissa – se voi olla kiireinen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er í gangi en svaraði ekki um uppfærslur í tæka tíð – það er líklega upptekið."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er oppe, men svarte ikke på oppdateringer i tide. Den kan være opptatt."
