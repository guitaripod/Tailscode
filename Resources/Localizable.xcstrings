    "A GPU-rendered creature at the foot of the chat list, breathing what every conversation is doing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A GPU-rendered creature at the foot of the chat list, breathing what every conversation is doing"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein GPU-gerendertes Wesen am Fuß der Chatliste, das atmet, was jede Unterhaltung gerade tut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una criatura renderizada por GPU al pie de la lista de chats, que respira lo que hace cada conversación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une créature rendue par le GPU au pied de la liste des discussions, qui respire ce que fait chaque conversation"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una creatura resa dalla GPU ai piedi dell’elenco chat, che respira ciò che sta facendo ogni conversazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャット一覧の足元にいる GPU 描画の生き物。すべての会話の動きを呼吸のように映します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 목록 아래쪽의 GPU로 그린 생명체. 모든 대화가 하고 있는 일을 호흡으로 보여 줍니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderowana przez GPU istota u stóp listy rozmów, oddychająca tym, co robi każda rozmowa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma criatura renderizada pela GPU no pé da lista de conversas, respirando o que cada conversa está fazendo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于对话列表底部、由 GPU 渲染的生物，随每个对话的动态而呼吸"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位於對話清單底部、由 GPU 渲染的生物，隨每個對話的動態而呼吸"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et GPU-renderet væsen nederst i chatlisten, der trækker vejret i takt med, hvad hver samtale laver"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU-piirretty olento keskustelulistan alareunassa, joka hengittää sen mukaan, mitä kukin keskustelu tekee"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skepna sem skjákortið teiknar neðst í spjalllistanum og andar í takt við það sem hvert samtal gerir"
          }
        },
        "nb": {
