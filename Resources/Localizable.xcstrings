    "On — installs new versions when nothing is running.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An – installiert neue Versionen, sobald nichts mehr läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On — installs new versions when nothing is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado: instala las versiones nuevas en cuanto no hay nada en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé — installe les nouvelles versions dès que plus rien ne tourne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivato: installa le nuove versioni non appena non c'è più nulla in esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン — 何も実行されていないときに新しいバージョンを自動でインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜짐 — 아무것도 실행되고 있지 않을 때 새 버전을 설치합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado — instala as novas versões assim que nada mais está em execução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启——在没有任何内容运行时自动安装新版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟——在沒有任何內容執行時自動安裝新版本。"
          }
        }
      }
    },
    "One at a time: each downloads and builds, then restarts once nothing is running on it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nacheinander: Jeder lädt herunter und kompiliert, dann startet er neu, sobald nichts mehr auf ihm läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One at a time: each downloads and builds, then restarts once nothing is running on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De uno en uno: cada servidor descarga y compila, y luego se reinicia en cuanto no queda nada en ejecución en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un par un : chacun télécharge et compile, puis redémarre dès que plus rien n'y tourne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno alla volta: ciascuno scarica e compila, poi si riavvia non appena non c'è più nulla in esecuzione su di esso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1台ずつ処理します。それぞれがダウンロードとビルドを行い、その後何も実行されなくなり次第再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 대씩 진행됩니다. 각 서버가 다운로드와 빌드를 수행한 다음, 아무것도 실행되지 않을 때 재시동됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um de cada vez: cada um baixa e compila, depois reinicia assim que nada mais estiver em execução nele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐台进行：每台服务器先下载并构建，然后在没有任何内容运行时重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐台進行：每台伺服器先下載並建置，然後在沒有任何內容執行時重新開機。"
          }
        }
      }
    },
