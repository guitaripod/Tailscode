          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el servidor guardado y su contraseña del llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime le serveur enregistré et son mot de passe du trousseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina il server salvato e la sua password dal portachiavi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのサーバとそのパスワードをキーチェーンから削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 서버와 그 암호를 키체인에서 삭제합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga o servidor salvo e sua senha das Chaves."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从钥匙串中删除已保存的服务器及其密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從鑰匙圈中刪除已儲存的伺服器及其密碼。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie zapisanego serwera i jego hasła z Pęku kluczy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter den gemte server og dens adgangskode fra nøgleringen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa tallennetun palvelimen ja sen salasanan avainnipusta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þetta eyðir vistaða netþjóninum og lykilorði hans úr lyklakippunni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter den lagrede serveren og passordet fra Nøkkelringen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här tar bort den sparade servern och dess lösenord från nyckelringen."
          }
        }
      }
    },
