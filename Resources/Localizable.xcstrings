    "Drag %@ from the Finder window beside it into the list. If the list already shows %@ switched on, that is an older build: select it, press −, then drag this one in.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh %@ aus dem Finder-Fenster daneben in die Liste. Zeigt die Liste %@ schon eingeschaltet, ist das ein älterer Build: Wähl ihn aus, klick auf −, und zieh dann diesen hinein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag %@ from the Finder window beside it into the list. If the list already shows %@ switched on, that is an older build: select it, press −, then drag this one in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra %@ desde la ventana del Finder de al lado a la lista. Si la lista ya muestra %@ activado, es una versión anterior: selecciónala, pulsa − y arrastra esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser %@ depuis la fenêtre du Finder à côté dans la liste. Si la liste affiche déjà %@ activé, c'est une ancienne version : sélectionnez-la, cliquez sur −, puis faites glisser celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina %@ dalla finestra del Finder accanto nell'elenco. Se l'elenco mostra già %@ attivo, è una build precedente: selezionala, premi −, poi trascina questa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横の Finder ウインドウから %@ をリストにドラッグします。リストにすでに %@ がオンで表示されている場合、それは古いビルドです。選択して − を押してから、こちらをドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆의 Finder 윈도우에서 %@을(를) 목록으로 드래그하세요. 목록에 %@이(가) 이미 켜져 있다면 이전 빌드입니다. 선택하고 −를 누른 다음 이것을 드래그하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste %@ da janela do Finder ao lado para a lista. Se a lista já mostrar %@ ativado, é uma versão anterior: selecione-a, clique em − e arraste esta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将旁边访达窗口中的 %@ 拖入列表。如果列表中已显示 %@ 且已打开，那是旧版本：选中它，按 −，然后将这个拖进去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將旁邊 Finder 視窗中的 %@ 拖入列表。如果列表中已顯示 %@ 且已開啟，那是舊版本：選取它，按 −，然後將這個拖進去。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij %@ z okna Findera obok na listę. Jeśli lista pokazuje już włączone %@, to starszy build: zaznacz go, kliknij −, a potem przeciągnij ten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk %@ fra Finder-vinduet ved siden af ind i listen. Viser listen allerede %@ slået til, er det en ældre build: Markér den, tryk på −, og træk så denne ind."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä %@ viereisestä Finder-ikkunasta luetteloon. Jos luettelossa on jo %@ päällä, se on vanhempi versio: valitse se, paina −, ja vedä sitten tämä luetteloon."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragðu %@ úr Finder-glugganum við hliðina inn í listann. Ef %@ er þegar kveikt í listanum, er það eldri útgáfa: veldu hana, ýttu á −, og dragðu síðan þessa inn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra %@ fra Finder-vinduet ved siden av inn i listen. Viser listen allerede %@ på, er det en eldre build: velg den, trykk på −, og dra så denne inn."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra %@ från Finder-fönstret bredvid in i listan. Om listan redan visar %@ påslagen är det en äldre version: markera den, tryck på −, och dra sedan in den här."
          }
        }
      }
    },
    "macOS asks for your password or Touch ID. This screen notices when it's on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt nach deinem Passwort oder Touch ID. Dieser Bildschirm bemerkt, wenn es aktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS asks for your password or Touch ID. This screen notices when it's on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS te pedirá tu contraseña o Touch ID. Esta pantalla se da cuenta en cuanto esté activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS vous demande votre mot de passe ou Touch ID. Cet écran remarque dès que c'est activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chiederà la tua password o il Touch ID. Questa schermata se ne accorge non appena è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSがパスワードまたはTouch IDを求めます。オンになると、この画面が気づきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 암호나 Touch ID를 요청합니다. 켜지면 이 화면이 바로 알아챕니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS vai pedir sua senha ou Touch ID. Esta tela percebe assim que estiver ativado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会要求输入密码或使用 Touch ID。它一打开，这个界面就会察觉到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 會要求輸入密碼或使用 Touch ID。它一打開，這個畫面就會察覺到。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS prosi o twoje hasło lub Touch ID. Ten ekran zauważa, kiedy jest włączony."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS beder om din adgangskode eller Touch ID. Denne skærm bemærker, når det er slået til."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pyytää salasanaasi tai Touch ID:tä. Tämä näkymä huomaa, kun oikeus on päällä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS biður um lykilorðið þitt eða Touch ID. Þessi skjár tekur eftir þegar það er kveikt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ber om passordet ditt eller Touch ID. Denne skjermen registrerer når den er slått på."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS frågar efter ditt lösenord eller Touch ID. Den här skärmen märker när det är aktiverat."
          }
        }
      }
    },
    "Done — agents on %@ can work anywhere in your files.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertig — Agenten auf %@ können überall in deinen Dateien arbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done — agents on %@ can work anywhere in your files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo — los agentes en %@ pueden trabajar en cualquier parte de tus archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminé — les agents sur %@ peuvent travailler partout dans vos fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatto — gli agenti su %@ possono lavorare ovunque nei tuoi file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了 — %@ 上のエージェントはあなたのファイルのどこでも作業できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 — %@의 에이전트가 당신의 파일 어디에서든 작업할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto — os agentes em %@ podem trabalhar em qualquer lugar dos seus arquivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成 — %@ 上的智能体可以在你的任意文件中工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成 — %@ 上的代理可以在你的任何檔案中工作。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe — agenci na %@ mogą pracować w dowolnym miejscu twoich plików."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Færdig – agenter på %@ kan arbejde overalt i dine filer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmis – agentit tietokoneella %@ voivat työskennellä missä tahansa tiedostoissasi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokið – agentar á %@ geta unnið hvar sem er í skránum þínum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferdig – agenter på %@ kan jobbe hvor som helst i filene dine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klart – agenter på %@ kan arbeta var som helst i dina filer."
          }
        }
      }
    },
