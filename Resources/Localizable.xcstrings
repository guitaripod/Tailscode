    "**Tap a name** to rename it. **Tap the button** on a ball to change its level.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tap a name** to rename it. **Tap the button** on a ball to change its level."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tippe auf einen Namen**, um ihn umzubenennen. **Tippe auf den Knopf** auf einer Kugel, um die Stufe zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Toca un nombre** para renombrarlo. **Toca el botón** de una bola para cambiar su nivel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Touchez un nom** pour le renommer. **Touchez le bouton** sur une pastille pour changer son niveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tocca un nome** per rinominarlo. **Tocca il pulsante** su una pallina per cambiarne il livello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**名前をタップ**して名称を変更します。球の**ボタンをタップ**するとレベルを変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 **탭하면** 이름을 바꿀 수 있습니다. 공의 **버튼을 탭하면** 단계를 바꿀 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dotknij nazwy**, aby ją zmienić. **Dotknij przycisku** na kulce, aby zmienić poziom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Toque em um nome** para renomeá-lo. **Toque no botão** em uma bolinha para mudar o nível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**点按名称**即可重命名。**点按圆球上的按钮**即可更改等级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**點按名稱**即可重新命名。**點按圓球上的按鈕**即可變更等級。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tryk på et navn** for at omdøbe det. **Tryk på knappen** på en kugle for at skifte niveau."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Napauta nimeä** nimetäksesi sen uudelleen. **Napauta pallon painiketta** vaihtaaksesi sen tasoa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "**Banka á nafn** til að endurnefna það. **Banka á hnappinn** á kúlu til að breyta stiginu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Trykk på et navn** for å gi det nytt navn. **Trykk på knappen** på en kule for å endre nivået."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tryck på ett namn** för att byta namn. **Tryck på knappen** på en kula för att ändra nivå."
          }
        }
      }
    },
    "**Drag** onto another to swap. ✕ puts it back in the box.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Drag** onto another to swap. ✕ puts it back in the box."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ziehe** auf einen anderen, um zu tauschen. ✕ legt es zurück in die Ablage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Arrastra** sobre otro para intercambiar. ✕ lo devuelve al almacén."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Faites glisser** sur un autre pour échanger. ✕ le remet dans la réserve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Trascina** su un altro per scambiare. ✕ lo rimette nel deposito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**ドラッグ**して別のモデルと入れ替えます。✕ で保管庫に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**끌어서** 다른 모델 위에 놓으면 교체됩니다. ✕는 보관함에 다시 넣습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Przeciągnij** na inny, aby zamienić. ✕ odkłada go do schowka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Arraste** para outro para trocar. ✕ devolve ao depósito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**拖拽**到另一个上即可交换。✕ 放回收纳箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**拖曳**到另一個上即可交換。✕ 放回收納箱。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "**Træk** den over på en anden for at bytte. ✕ lægger den tilbage i kassen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Vedä** toisen päälle vaihtaaksesi. ✕ palauttaa sen laatikkoon."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dragðu** yfir á annað til að skipta. ✕ setur það aftur í geymsluna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dra** over til en annen for å bytte. ✕ legger den tilbake i boksen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "**Dra** till en annan för att byta plats. ✕ lägger tillbaka den i lådan."
          }
        }
      }
    },
    "Click a name to rename it. Click the ball to change its level. Drag a card onto another to swap.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a name to rename it. Click the ball to change its level. Drag a card onto another to swap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf einen Namen, um ihn umzubenennen. Klicke auf die Kugel, um die Stufe zu ändern. Ziehe eine Karte auf eine andere, um zu tauschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un nombre para renombrarlo. Haz clic en la bola para cambiar su nivel. Arrastra una tarjeta sobre otra para intercambiarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un nom pour le renommer. Cliquez sur la pastille pour changer son niveau. Faites glisser une carte sur une autre pour échanger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicca un nome per rinominarlo. Clicca la pallina per cambiarne il livello. Trascina una scheda su un'altra per scambiarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前をクリックして名称を変更します。球をクリックするとレベルを変更できます。カードを別のカードにドラッグすると入れ替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 클릭하면 이름을 바꿀 수 있습니다. 공을 클릭하면 단계를 바꿀 수 있습니다. 카드를 다른 카드 위로 끌면 교체됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij nazwę, aby ją zmienić. Kliknij kulkę, aby zmienić poziom. Przeciągnij kartę na inną, aby zamienić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em um nome para renomeá-lo. Clique na bolinha para mudar o nível. Arraste um cartão sobre outro para trocar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击名称即可重命名。点击圆球即可更改等级。将卡片拖到另一张上即可交换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按名稱即可重新命名。點按圓球即可變更等級。將卡片拖曳到另一張上即可交換。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på et navn for at omdøbe det. Klik på kuglen for at skifte niveau. Træk et kort over på et andet for at bytte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsauta nimeä nimetäksesi sen uudelleen. Napsauta palloa vaihtaaksesi sen tasoa. Vedä kortti toisen päälle vaihtaaksesi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Smelltu á nafn til að endurnefna það. Smelltu á kúluna til að breyta stiginu. Dragðu spjald yfir á annað til að skipta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på et navn for å gi det nytt navn. Klikk på kulen for å endre nivået. Dra et kort over til et annet for å bytte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på ett namn för att byta namn. Klicka på kulan för att ändra nivå. Dra ett kort till ett annat för att byta plats."
          }
        }
      }
    },
