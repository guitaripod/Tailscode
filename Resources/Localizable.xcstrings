    "Each run sees what it said last time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each run sees what it said last time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Lauf sieht, was er beim letzten Mal gesagt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ejecución ve lo que dijo la última vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque exécution voit ce qu'elle a dit la dernière fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni esecuzione vede ciò che ha detto l'ultima volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各実行は、前回の回答を参照します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 실행은 지난번에 말한 내용을 봅니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde uruchomienie widzi, co powiedziało ostatnio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada execução vê o que disse da última vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次运行都能看到它上一次说过的话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次執行都能看到它上一次說過的話。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver kørsel ser, hvad den sagde sidste gang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen ajo näkee, mitä se sanoi viimeksi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver keyrsla sér hvað hún sagði síðast."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver kjøring ser hva den sa forrige gang."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje körning ser vad den sa förra gången."
          }
        }
      }
    },
