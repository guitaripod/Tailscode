    "Nudge queued. The agent reads it when its turn yields.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nudge queued. The agent reads it when its turn yields."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anstoß eingereiht. Der Agent liest ihn, wenn sein Zug endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso en cola. El agente lo lee cuando termine su turno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relance mise en file. L'agent la lit quand son tour s'arrête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sollecito in coda. L'agente lo legge quando finisce il turno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひと言を送信しました。エージェントは現在のターンが終わると読みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "넛지가 대기열에 들어갔습니다. 에이전트는 현재 턴이 끝나면 읽습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpowiedź w kolejce. Agent odczyta ją, gdy skończy bieżącą turę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cutucada na fila. O agente a lê quando o turno dele terminar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒已排队，智能体会在当前轮次结束时读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒已排隊，代理會在目前這一輪結束時讀取。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Puf er sat i kø. Agenten læser den, når dens tur er slut."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kehotus jonossa. Agentti lukee sen, kun sen vuoro päättyy."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ýting sett í biðröð. Agentinn les hana þegar umferð hans lýkur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyttet er satt i kø. Agenten leser det når turen er over."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Knuffen står i kö. Agenten läser den när den avslutar turen."
          }
        }
      }
    },
