    "Every token this window ran on hardware you already own — %@ of them, at no cost": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Token in diesem Zeitraum lief auf Hardware, die dir bereits gehört — %@ davon, ohne Kosten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every token this window ran on hardware you already own — %@ of them, at no cost"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los tokens de esta ventana se ejecutaron en hardware que ya tienes — %@ de ellos, sin coste"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jeton de cette période a tourné sur du matériel qui vous appartient déjà — %@ d’entre eux, sans frais"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni token di questa finestra è stato eseguito su hardware che possiedi già — %@ di essi, a costo zero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間のトークンはすべて、すでに所有しているハードウェア上で実行されました — そのうち%@、費用はかかっていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기간의 모든 토큰은 이미 소유한 하드웨어에서 실행되었습니다 — 그중 %@는 비용이 들지 않았습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo token desta janela rodou em hardware que você já possui — %@ deles, sem custo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此窗口期内的每个词元都运行在你已拥有的硬件上 — 其中 %@ 个，完全免费"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此視窗期間的每個詞元都執行在你已擁有的硬體上 — 其中 %@ 個，完全免費"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy token w tym okresie działał na sprzęcie, który już posiadasz — %@ z nich bezpłatnie"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle tokens i denne periode kørte på hardware, du allerede ejer – %@ af dem, uden omkostning"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikki tämän ajanjakson tokenit kuluivat laitteistolla, joka on jo omasi: niitä on %@, ilman kustannuksia"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Öll tákn í þessu tímabili keyrðu á vélbúnaði sem þú átt nú þegar, %@ af þeim, án kostnaðar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle token i denne perioden kjørte på maskinvare du allerede eier, %@ av dem, uten kostnad"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla token under den här perioden kördes på hårdvara du redan äger, %@ av dem utan kostnad"
          }
        }
      }
    },
