    "Lets you point at anything on the screen and check it for readability. It is built once on this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you point at anything on the screen and check it for readability. It is built once on this Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit können Sie auf alles auf dem Bildschirm zeigen und es auf Lesbarkeit prüfen. Es wird einmal auf diesem Mac erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te permite señalar cualquier cosa de la pantalla y comprobar si se lee bien. Se compila una sola vez en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet de pointer n’importe quel élément de l’écran et d’en vérifier la lisibilité. Il est compilé une seule fois sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette di indicare qualsiasi elemento sullo schermo e verificarne la leggibilità. Viene compilato una sola volta su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上の任意の要素を指定して、読みやすさを確認できます。この Mac で一度だけビルドされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면의 아무 요소나 가리켜 읽기 쉬운지 확인할 수 있습니다. 이 Mac에서 한 번만 빌드됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala wskazać dowolny element ekranu i sprawdzić jego czytelność. Jest budowany raz na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite apontar qualquer coisa na tela e verificar se ela é legível. É compilado uma vez neste Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让你指向屏幕上的任何内容，并检查其可读性。它在这台 Mac 上只需构建一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓你指向畫面上的任何內容，並檢查其可讀性。它在這台 Mac 上只需建置一次。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lader dig pege på alt på skærmen og tjekke det for læsbarhed. Den builder én gang på denne Mac."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit osoittaa mitä tahansa näytöllä ja tarkistaa sen luettavuuden. Se koostetaan kerran tällä Macilla."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerir þér kleift að benda á hvað sem er á skjánum og athuga hvort það sé læsilegt. Það er byggt einu sinni á þessari Mac-tölvu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar deg peke på hva som helst på skjermen og sjekke at det er lesbart. Den bygges én gang på denne Macen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låter dig peka på vad som helst på skärmen och kontrollera läsbarheten. Den byggs en gång på den här Mac:en."
          }
        }
      }
    },
