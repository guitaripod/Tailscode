    "Softer settings drop a cue's reinforcement before they drop the cue; drag to feel each stop": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanftere Einstellungen lassen zuerst die Verstärkung eines Signals weg, bevor sie das Signal selbst weglassen; ziehe, um jede Stufe zu spüren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Softer settings drop a cue's reinforcement before they drop the cue; drag to feel each stop"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes más suaves eliminan el refuerzo de una señal antes que la señal misma; arrastra para sentir cada tope"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des réglages plus doux suppriment d’abord le renfort d’un signal avant de supprimer le signal lui-même ; faites glisser pour ressentir chaque palier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni più leggere eliminano prima il rinforzo di un segnale, poi il segnale stesso; trascina per sentire ogni tacca"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を弱めると、まず合図の強調が減り、それから合図自体が消えます — ドラッグして各段階を確かめてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 약하게 하면 신호의 강조가 먼저 줄고, 그다음 신호 자체가 사라집니다 — 드래그하며 각 단계를 느껴 보세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes mais suaves removem o reforço de um sinal antes de remover o próprio sinal; arraste para sentir cada parada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调弱设置时，会先减少提示的强调感，再减少提示本身 — 拖动滑块逐档体会"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調弱設定時，會先減少提示的強調感，再減少提示本身 — 拖曳滑桿逐檔體會"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łagodniejsze ustawienia najpierw usuwają wzmocnienie sygnału, zanim usuną sam sygnał; przeciągnij, aby wyczuć każdy próg"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blødere indstillinger fjerner signalets forstærkning, før de fjerner selve signalet; træk for at mærke hvert trin"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pehmeämmät asetukset poistavat signaalin vahvistuksen ennen signaalin itsensä poistamista; vedä ja tunne jokainen taso"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Mildari stillingar fjarlægja styrkingu vísbendingar á undan sjálfri vísbendingunni; dragðu til að finna fyrir hverju þrepi"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mykere innstillinger fjerner forsterkningen av et signal før de fjerner selve signalet; dra for å kjenne hvert trinn"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjukare inställningar tar bort signalens förstärkning innan de tar bort signalen; dra för att känna varje steg"
          }
        }
      }
    },
