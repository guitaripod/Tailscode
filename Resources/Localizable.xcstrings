    "Any chat, not only the open one — raised only while the app is in the background": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Chat, nicht nur der geöffnete — erscheint nur, während die App im Hintergrund ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any chat, not only the open one — raised only while the app is in the background"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier chat, no solo el abierto: se muestra solo mientras la app está en segundo plano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’importe quelle discussion, pas seulement celle ouverte — affichée seulement quand l’app est en arrière-plan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi chat, non solo quella aperta — mostrata solo mentre l’app è in background"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いていないチャットも対象 — アプリがバックグラウンドのときだけ通知します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열려 있지 않은 대화도 포함 — 앱이 백그라운드에 있을 때만 알립니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer conversa, não só a aberta — aparece somente enquanto o app está em segundo plano"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不限于当前打开的对话 — 仅在应用处于后台时提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不限於目前開啟的對話 — 僅在應用程式處於背景時提醒"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dowolna rozmowa, nie tylko ta otwarta — pojawia się tylko, gdy aplikacja działa w tle"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhver chat, ikke kun den åbne, giver kun notifikation, mens appen er i baggrunden"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikä tahansa keskustelu, ei vain avoin: nostetaan vain, kun sovellus on taustalla"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvaða spjall sem er, ekki bara það opna, birtist aðeins meðan appið er í bakgrunni"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle chatter, ikke bare den åpne – vises bare når appen er i bakgrunnen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilken chatt som helst, inte bara den öppna, visas bara när appen är i bakgrunden"
          }
        }
      }
    },
