          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentet fra komprimeringen: bare sammendraget er fortsatt i vinduet"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtat från komprimeringen: endast sammanfattningen finns kvar i fönstret"
