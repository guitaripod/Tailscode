    "The purchase didn't go through. Try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase didn't go through. Try again in a moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf ist nicht zustande gekommen. Versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra no se completó. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'achat n'a pas abouti. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto non è andato a buon fine. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を完了できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매가 완료되지 않았습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup się nie powiódł. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra não foi concluída. Tente novamente em instantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买未能完成。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買未能完成。請稍後再試。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Købet blev ikke gennemført. Prøv igen om lidt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostoa ei onnistunut. Yritä hetken kuluttua uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaupið gekk ekki í gegn. Reyndu aftur eftir smá stund."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kjøpet ble ikke gjennomført. Prøv igjen om litt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köpet gick inte igenom. Försök igen om en stund."
          }
        }
      }
    },
    "%@ runs on %@. Your conversation comes with you as a short brief; this chat stays where it is.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ runs on %@. Your conversation comes with you as a short brief; this chat stays where it is."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft auf %@. Deine Unterhaltung kommt als kurze Zusammenfassung mit, dieser Chat bleibt, wo er ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ejecuta en %@. Tu conversación viene contigo como un resumen breve; este chat se queda donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tourne sur %@. Votre conversation vous suit sous forme de bref résumé ; cette discussion reste où elle est."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gira su %@. La conversazione ti segue come breve riepilogo; questa chat resta dov'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %@ で動作します。会話は短い要約として引き継がれ、このチャットはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 %@에서 실행됩니다. 대화는 짧은 요약으로 함께 넘어가고, 이 대화는 그대로 남습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ działa na %@. Rozmowa przejdzie dalej jako krótkie streszczenie; ten czat zostaje tam, gdzie jest."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ roda em %@. Sua conversa vai junto como um resumo curto; esta conversa continua onde está."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 运行于 %@。对话会以简短摘要的形式带过去，本对话保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 運行於 %@。對話會以簡短摘要的形式帶過去，本對話保持不變。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kører på %@. Din samtale følger med som et kort resumé; denne chat bliver, hvor den er."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
