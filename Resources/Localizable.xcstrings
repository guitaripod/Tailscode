    "“%@” also uses this key. Adding it here takes it from there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” also uses this key. Adding it here takes it from there."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ verwendet diese Taste ebenfalls. Sie hier hinzuzufügen nimmt sie dort weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» también usa esta tecla. Añadirla aquí la quita de allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » utilise aussi cette touche. L’ajouter ici la retire de là-bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» usa anche questo tasto. Aggiungerlo qui lo toglie da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」もこのキーを使っています。ここに追加すると、そちらから取り除かれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"도 이 키를 사용합니다. 여기에 추가하면 그쪽에서는 제거됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” też używa tego klawisza. Dodanie go tutaj zabiera go stamtąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" também usa esta tecla. Adicioná-la aqui a tira de lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”也使用这个按键。在这里添加，就会从那边移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」也使用這個按鍵。在這裡新增，就會從那裡移除。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« bruger også denne tast. Tilføjer du den her, flyttes den derfra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” käyttää myös tätä näppäintä. Kun lisäät sen tänne, se siirtyy sieltä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ notar þennan lykil líka. Að bæta honum við hér tekur hann þaðan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» bruker også denne tasten. Legges den til her, fjernes den der."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” använder också den här tangenten. Om du lägger till den här flyttas tangenten därifrån."
          }
        }
      }
    },
    "“%@” has a two-key shortcut (%@) that starts with this key, so it would stop working. Adding it here takes that shortcut from there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” has a two-key shortcut (%@) that starts with this key, so it would stop working. Adding it here takes that shortcut from there."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hat eine Zwei-Tasten-Kombination (%@), die mit dieser Taste beginnt; sie würde daher nicht mehr funktionieren. Sie hier hinzuzufügen nimmt diese Kombination dort weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» tiene un atajo de dos teclas (%@) que empieza con esta tecla, así que dejaría de funcionar. Añadirla aquí quita ese atajo de allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » a un raccourci à deux touches (%@) commençant par cette touche : il cesserait de fonctionner. L’ajouter ici retire ce raccourci de là-bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ha una scorciatoia a due tasti (%@) che inizia con questo tasto, quindi smetterebbe di funzionare. Aggiungerlo qui toglie quella scorciatoia da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」には、このキーで始まる 2 キーのショートカット（%@）があり、使えなくなります。ここに追加すると、そのショートカットはそちらから取り除かれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"에는 이 키로 시작하는 두 키 단축키(%@)가 있어 작동하지 않게 됩니다. 여기에 추가하면 그 단축키는 그쪽에서 제거됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” ma skrót dwuklawiszowy (%@) zaczynający się od tego klawisza, więc przestałby działać. Dodanie go tutaj zabiera ten skrót stamtąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" tem um atalho de duas teclas (%@) que começa com esta tecla, então deixaria de funcionar. Adicioná-lo aqui tira esse atalho de lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”有一个以此按键开头的双键快捷键（%@），因此会失效。在这里添加，就会把该快捷键从那边移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」有一個以此按鍵開頭的雙鍵快捷鍵（%@），因此會失效。在這裡新增，就會把該快捷鍵從那裡移除。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« har en tastaturgenvej med to taster (%@), der starter med denne tast, så den ville holde op med at virke. Tilføjer du den her, flyttes den derfra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” käyttää kaksinäppäistä pikanäppäintä (%@), joka alkaa tällä näppäimellä, joten se lakkaisi toimimasta. Kun lisäät sen tänne, pikanäppäin siirtyy sieltä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ hefur tveggja lykla flýtileið (%@) sem byrjar á þessum lykli, svo hún myndi hætta að virka. Að bæta honum við hér tekur þá flýtileið þaðan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» har en tastekombinasjon med to taster (%@) som starter med denne tasten, så den ville slutte å virke. Legges den til her, fjernes tastekombinasjonen der."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” har en tvåtangentskombination (%@) som börjar med den här tangenten, så den skulle sluta fungera. Om du lägger till den här flyttas kombinationen därifrån."
          }
        }
      }
    },
    "“%@” uses %@ on its own, so this two-key shortcut could never be reached. Adding it here takes that key from there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” uses %@ on its own, so this two-key shortcut could never be reached. Adding it here takes that key from there."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ verwendet %@ allein, daher wäre diese Zwei-Tasten-Kombination nie erreichbar. Sie hier hinzuzufügen nimmt diese Taste dort weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» usa %@ por sí solo, así que este atajo de dos teclas nunca podría activarse. Añadirla aquí quita esa tecla de allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » utilise %@ seul, donc ce raccourci à deux touches ne pourrait jamais être atteint. L’ajouter ici retire cette touche de là-bas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» usa %@ da solo, quindi questa scorciatoia a due tasti non potrebbe mai essere raggiunta. Aggiungerla qui toglie quel tasto da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は %@ を単独で使っているため、この 2 キーのショートカットには到達できません。ここに追加すると、そのキーはそちらから取り除かれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\"은(는) %@을(를) 단독으로 사용하므로 이 두 키 단축키에는 도달할 수 없습니다. 여기에 추가하면 그 키는 그쪽에서 제거됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” używa %@ samodzielnie, więc ten skrót dwuklawiszowy nigdy nie mógłby zadziałać. Dodanie go tutaj zabiera ten klawisz stamtąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" usa %@ sozinho, então este atalho de duas teclas nunca poderia ser alcançado. Adicioná-la aqui tira essa tecla de lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”单独使用 %@，因此这个双键快捷键永远无法触发。在这里添加，就会把该按键从那边移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」單獨使用 %@，因此這個雙鍵快捷鍵永遠無法觸發。在這裡新增，就會把該按鍵從那裡移除。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "»%@« bruger %@ alene, så denne tastaturgenvej med to taster kunne aldrig nås. Tilføjer du den her, flyttes tasten derfra."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” käyttää yksinään näppäintä %@, joten tätä kaksinäppäistä pikanäppäintä ei voitaisi koskaan käyttää. Kun lisäät sen tänne, näppäin siirtyy sieltä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ notar %@ eitt og sér, svo þessi tveggja lykla flýtileið næðist aldrei. Að bæta honum við hér tekur þann lykil þaðan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» bruker %@ alene, så denne tastekombinasjonen med to taster kunne aldri nås. Legges den til her, fjernes tasten der."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” använder %@ på egen hand, så den här tvåtangentskombinationen skulle aldrig kunna nås. Om du lägger till den här flyttas tangenten därifrån."
          }
        }
      }
    },
    "⌘ belongs to the menu bar and is not available here. Try Ctrl, Option or Shift.": {
