          "stringUnit": {
            "state": "translated",
            "value": "claude-bridge siempre necesita una contraseña: la del comando de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "claude-bridge exige toujours un mot de passe — celui de la commande ci-dessus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "claude-bridge richiede sempre una password — quella nel comando qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "claude-bridge には必ずパスワードが必要です。上のコマンドで指定したものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "claude-bridge에는 항상 암호가 필요합니다 — 위 명령에 있는 그 암호입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O claude-bridge sempre precisa de uma senha — a do comando acima."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "claude-bridge 始终需要密码 — 就是上面命令中的那个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "claude-bridge 一律需要密碼 — 就是上面命令中的那一組。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "claude-bridge zawsze wymaga hasła — tego z polecenia powyżej."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "claude-bridge kræver altid en adgangskode – den fra kommandoen ovenfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "claude-bridge tarvitsee aina salasanan: sen, joka on yllä olevassa komennossa."
