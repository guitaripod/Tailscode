    "Asked by %@, whether or not this device is on.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asked by %@, whether or not this device is on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von %@ gefragt, ob dieses Gerät an ist oder nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntado por %@, esté o no encendido este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandé par %@, que cet appareil soit allumé ou non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiesto da %@, che questo dispositivo sia acceso o no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が質問します。このデバイスの電源が入っているかどうかは問いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 질문합니다. 이 기기가 켜져 있는지는 상관없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyta %@, niezależnie od tego, czy to urządzenie jest włączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntado por %@, esteja ou não este dispositivo ligado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 %@ 提问，无论本设备是否开机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 %@ 提問，無論本裝置是否開機。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spurgt af %@, uanset om denne enhed er tændt eller ej."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysyjänä %@, riippumatta siitä, onko tämä laite päällä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Spurt af %@, hvort sem kveikt er á þessu tæki eða ekki."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spurt av %@, uavhengig av om denne enheten er på."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frågad av %@, oavsett om den här enheten är på."
          }
        }
      }
    },
