    "The full quota picture lives at the foot of the chat list; the Ollama Cloud and DeepSeek keys are the account facts this machine keeps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das vollständige Kontingentbild lebt am Fuß der Chatliste; die Ollama-Cloud- und DeepSeek-Schlüssel sind die Kontofakten, die dieser Rechner verwahrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full quota picture lives at the foot of the chat list; the Ollama Cloud and DeepSeek keys are the account facts this machine keeps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El panorama completo de las cuotas vive al pie de la lista de chats; las claves de Ollama Cloud y DeepSeek son los datos de cuenta que guarda esta máquina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vue d’ensemble des quotas se trouve au pied de la liste des discussions ; les clés Ollama Cloud et DeepSeek sont les informations de compte que cette machine conserve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il quadro completo delle quote vive ai piedi dell’elenco chat; le chiavi di Ollama Cloud e DeepSeek sono i dati dell’account che questa macchina conserva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用量の全体像はチャットリストの下部にあります。Ollama Cloud と DeepSeek のキーは、このマシンが保持するアカウント情報です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 할당량 현황은 대화 목록 아래쪽에 있습니다. Ollama Cloud와 DeepSeek 키는 이 머신이 보관하는 계정 정보입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O panorama completo das cotas vive ao pé da lista de conversas; as chaves do Ollama Cloud e do DeepSeek são os dados de conta que esta máquina guarda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整的配额概览位于对话列表底部；Ollama Cloud 和 DeepSeek 密钥是这台机器保存的账户信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整的配額概覽位於對話清單底部；Ollama Cloud 和 DeepSeek 金鑰是這台機器保存的帳戶資訊。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pełny obraz limitów znajduje się na dole listy rozmów; klucze Ollama Cloud i DeepSeek to dane konta przechowywane przez ten komputer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fulde kvoteoversigt findes nederst i chatlisten; Ollama Cloud- og DeepSeek-nøglerne er de kontooplysninger, som denne computer gemmer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koko kiintiökuva on keskusteluluettelon alareunassa. Ollama Cloud- ja DeepSeek-avaimet ovat tilitietoja, joita tämä kone säilyttää."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt kvótayfirlitið er neðst á spjallalistanum; Ollama Cloud- og DeepSeek-API-lyklarnir eru þær reikningsupplýsingar sem þessi tölva geymir."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele kvotebildet finnes nederst i chatlisten. Ollama Cloud- og DeepSeek-nøklene er kontoopplysningene denne maskinen lagrer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela kvotbilden finns längst ner i chattlistan. API-nycklarna för Ollama Cloud och DeepSeek är de kontouppgifter som den här datorn sparar."
          }
        }
      }
    },
