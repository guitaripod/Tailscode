        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store가 응답하지 않아, 여기서는 최신 버전이 무엇인지 알 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não respondeu, então nada aqui pode dizer qual é a versão mais recente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 没有响应，因此这里无法说明最新版本是什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 沒有回應，因此這裡無法說明最新版本是什麼。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store nie odpowiedział, więc nic tu nie może powiedzieć, jaka jest najnowsza wersja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store svarede ikke, så her kan ingen sige, hvad den nyeste version er."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ei vastannut, joten tässä ei tiedetä uusinta versiota."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store svaraði ekki, svo hér er ekki hægt að segja hver nýjasta útgáfan er."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store svarte ikke, så ingenting her kan si hva den nyeste versjonen er."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store svarade inte, så det går inte att se vad den senaste versionen är."
          }
        }
