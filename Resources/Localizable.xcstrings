    "A GPU-rendered creature at the foot of the chat list, breathing what every conversation is doing; may cost battery": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein GPU-gerendertes Wesen am Fuß der Chatliste, das atmet, was jede Unterhaltung gerade tut; kann Akkulaufzeit kosten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A GPU-rendered creature at the foot of the chat list, breathing what every conversation is doing; may cost battery"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una criatura renderizada por GPU al pie de la lista de chats, que respira lo que hace cada conversación; puede consumir batería"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une créature rendue par le GPU au pied de la liste des discussions, qui respire ce que fait chaque conversation ; peut coûter de la batterie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una creatura renderizzata dalla GPU ai piedi dell’elenco chat, che respira ciò che sta facendo ogni conversazione; può costare batteria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットリストの下にいる GPU 描画の生き物が、すべての会話の様子を息づかいで表します — バッテリーを消費する場合があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 목록 아래에 있는 GPU 렌더링 생물이 모든 대화가 하는 일을 숨결로 표현합니다 — 배터리를 소모할 수 있습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma criatura renderizada por GPU ao pé da lista de conversas, que respira o que cada conversa está fazendo; pode consumir bateria"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话列表底部的一只 GPU 渲染的生物，用呼吸般的起伏表现每段对话正在做什么 — 可能会消耗电量"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話清單底部的一隻 GPU 算圖生物，用呼吸般的起伏表現每段對話正在做什麼 — 可能會消耗電量"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyrenderowane przez GPU stworzenie u podstawy listy rozmów, oddychające tym, co dzieje się w każdej rozmowie; może zużywać baterię"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et GPU-renderet væsen nederst i chatlisten, der ånder med det, hver samtale laver; kan belaste batteriet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU:lla renderöity olento keskusteluluettelon alareunassa, joka hengittää sen mukaan, mitä jokainen keskustelu tekee; voi kuluttaa akkua"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU-teiknuð skepna neðst í spjalllistanum, sem andar í takt við það sem hvert samtal gerir; getur reynt á rafhlöðuna"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et GPU-tegnet vesen nederst i chatlisten, som puster i takt med det hver samtale gjør; kan tære på batteriet"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En GPU-renderad varelse längst ner i chattlistan, som andas i takt med vad varje konversation gör; kan påverka batteritiden"
          }
        }
      }
    },
