    "The App Store didn't answer, so nothing here can say what the newest version is.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store hat nicht geantwortet, daher kann hier niemand sagen, was die neueste Version ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store didn't answer, so nothing here can say what the newest version is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no respondió, así que nada aquí puede decir cuál es la versión más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store n’a pas répondu, donc rien ici ne peut dire quelle est la dernière version."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
