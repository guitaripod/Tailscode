          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 코드를 받았지만 여전히 로그아웃 상태라고 보고합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor aceitou o código, mas ainda aparece como desconectado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器接受了代码，但仍然报告未登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器接受了代碼，但仍然回報未登入。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer przyjął kod, ale nadal zgłasza stan „wylogowano”."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren tog koden, men melder stadig, at du er logget ud."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin otti koodin vastaan, mutta ilmoittaa yhä kirjautuneensa ulos."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Netþjónninn tók við kóðanum en tilkynnir enn að ekki sé skráð inn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren tok imot koden, men melder fortsatt at du er logget av."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern tog emot koden men rapporterar fortfarande att du är utloggad."
          }
        }
      }
    },
    "The store's record is older than what is installed — it has not caught up yet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eintrag im Store ist älter als die installierte Version – er hat noch nicht aufgeholt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The store's record is older than what is installed — it has not caught up yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de la tienda es más antiguo que lo instalado: todavía no se ha puesto al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations de la boutique sont plus anciennes que ce qui est installé — elles n'ont pas encore été mises à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il registro dello store è più vecchio di quanto installato: non si è ancora aggiornato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアの記録はインストール済みのものより古く、まだ追いついていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스토어 기록이 설치된 버전보다 오래되어, 아직 따라잡지 못했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro da loja é mais antigo do que o que está instalado — ele ainda não foi atualizado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商店记录的版本比已安装的还旧——它尚未跟上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "商店記錄的版本比已安裝的還舊——它尚未跟上。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapis sklepu jest starszy niż zainstalowana wersja — jeszcze się nie zaktualizował."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store viser en ældre version end den, der er installeret – den er ikke nået op endnu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaupan tietue on vanhempi kuin asennettu versio – se ei ole vielä päivittynyt."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Skráin í versluninni er eldri en það sem er uppsett – hún hefur ekki náð því enn."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppføringen i butikken er eldre enn den installerte versjonen. Den har ikke tatt igjen ennå."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Butiken har ännu inte hunnit ikapp: dess uppgifter är äldre än den installerade versionen."
          }
        }
      }
    },
    "The trackpad reports the wait — sent, a step landing, needs you, finished — while a hand is on it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Trackpad meldet das Warten — gesendet, ein Schritt landet, braucht dich, fertig — solange eine Hand daran liegt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trackpad reports the wait — sent, a step landing, needs you, finished — while a hand is on it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trackpad refleja la espera — enviado, un paso que llega, te necesita, terminado — mientras tienes la mano encima"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trackpad signale l’attente — envoyé, une étape qui arrive, a besoin de vous, terminé — tant qu’une main s’y trouve"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il trackpad segnala l’attesa — inviato, un passaggio che arriva, ha bisogno di te, finito — finché una mano è sopra di esso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラックパッドが待ち状態を伝えます — 送信、ステップの到着、確認が必要、完了 — 手が触れている間だけ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙패드가 대기 상태를 전달합니다 — 전송됨, 단계 도착, 확인 필요, 완료 — 손이 닿아 있는 동안만"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O trackpad reflete a espera — enviado, um passo chegando, precisa de você, terminado — enquanto sua mão está nele"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控板会传达等待的状态 — 已发送、一步落地、需要你、已完成 — 仅在手放在上面时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸控板會傳達等待的狀態 — 已傳送、一步落地、需要你、已完成 — 僅在手放在上面時"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gładzik sygnalizuje oczekiwanie — wysłano, krok się kończy, potrzebuje cię, gotowe — dopóki leży na nim dłoń"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpadet melder status – sendt, et trin lander, har brug for dig, færdig – mens en hånd hviler på det"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosketuslevy näyttää odotuksen – lähetetty, vaihe valmistuu, tarvitsee sinua, valmis – kun kätesi on sen päällä"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Snertiflöturinn segir frá biðinni – sent, skref lendir, þarfnast þín, lokið – meðan hönd er á honum"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Styreflaten melder ventingen (sendt, et steg fullføres, trenger deg, ferdig) mens en hånd ligger på den"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Styrplattan visar statusen (skickat, ett steg landar, behöver dig, klart) medan en hand ligger på den"
          }
        }
      }
    },
    "The tree moved under this patch": {
