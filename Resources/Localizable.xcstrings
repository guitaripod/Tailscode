    "Filled in below, so this phone and the bridge carry the same password.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filled in below, so this phone and the bridge carry the same password."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unten eingetragen, damit dieses iPhone und die Bridge dasselbe Passwort haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha rellenado abajo, para que este teléfono y el bridge lleven la misma contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renseigné ci-dessous, pour que ce téléphone et le bridge portent le même mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserita qui sotto, così questo telefono e il bridge usano la stessa password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下に入力しました。これでこの iPhone とブリッジが同じパスワードを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에 입력해 두었으니 이 휴대폰과 브리지가 같은 암호를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenchida abaixo, para que este telefone e o bridge usem a mesma senha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已填入下方，这样这台手机和 bridge 使用同一个密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已填入下方，讓這台手機和 bridge 使用同一組密碼。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisane poniżej, aby ten telefon i bridge miały to samo hasło."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udfyldt nedenfor, så telefonen og Bridge'en har samme adgangskode."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täytetään alla, jotta tämä puhelin ja Bridge käyttävät samaa salasanaa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyllt út hér fyrir neðan, svo þessi sími og Bridge noti sama lykilorð."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fylles ut nedenfor, så denne telefonen og Bridge får samme passord."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fylls i nedan, så att den här telefonen och Bridge har samma lösenord."
          }
        }
      }
    },
