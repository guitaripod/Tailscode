            "value": "제공업체의 다운로드 사이트가 접근을 거부해서 아무것도 다운로드되지 않았어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strona pobierania dostawcy odmówiła dostępu, więc nic nie zostało pobrane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
