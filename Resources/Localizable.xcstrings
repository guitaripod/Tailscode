    "%d%% of it read back out of cache, which costs a tenth of fresh input.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% davon wurden aus dem Cache gelesen, was ein Zehntel der Kosten frischer Eingabe hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% of it read back out of cache, which costs a tenth of fresh input."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El %d %% se leyó desde la caché, lo que cuesta una décima parte de una entrada nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d %% ont été relus depuis le cache, ce qui coûte un dixième d’une entrée neuve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il %d%% è stato riletto dalla cache, il che costa un decimo di un input nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのうち %d%% はキャッシュから読み戻されたもので、新規入力の10分の1のコストです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그중 %d%%는 캐시에서 다시 읽은 것으로, 새 입력의 10분의 1 비용입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% disso foi lido de volta do cache, o que custa um décimo de uma entrada nova."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中 %d%% 是从缓存中读回的，费用只有全新输入的十分之一。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中 %d%% 是從快取中讀回的，費用只有全新輸入的十分之一。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% z nich odczytano z pamięci podręcznej, co kosztuje dziesiątą część świeżego wejścia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% af dem blev hentet fra cachen, hvilket koster en tiendedel af prisen for nye input-token."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% siitä luettiin takaisin välimuistista, ja se maksaa kymmenesosan tuoreesta syötteestä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% af þessu var lesið úr skyndiminni, sem kostar tíunda hluta af fersku inntaki."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% av dette ble hentet fra hurtigbufferen, og det koster en tidel av ny inndata."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%d%% av det lästes tillbaka från cachen, vilket kostar en tiondel av nya indata."
          }
        }
      }
    },
