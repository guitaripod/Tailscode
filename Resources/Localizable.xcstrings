    "Set aside. You'll hear about it again when something changes.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgestellt. Es meldet sich wieder, sobald sich etwas ändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set aside. You'll hear about it again when something changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartado por ahora. Volverás a saber de esto cuando algo cambie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis de côté. Vous en réentendrez parler dès que quelque chose changera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accantonato. Ne sentirai parlare di nuovo quando qualcosa cambierà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留しました。状況が変わればまたお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류했습니다. 상황이 바뀌면 다시 알려드리겠습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiado. Você vai ouvir falar disso de novo quando algo mudar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已搁置。情况有变化时会再次提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已擱置。情況有變化時會再次提醒你。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odłożone. Odezwie się ponownie, gdy coś się zmieni."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagt til side. Du får besked igen, når noget ændrer sig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirretty syrjään. Kuulet siitä taas, kun jokin muuttuu."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagt til hliðar. Þetta birtist aftur þegar eitthvað breytist."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagt til side. Du får beskjed når noe endrer seg."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkerad. Du får besked igen när något ändras."
          }
        }
      }
    },
