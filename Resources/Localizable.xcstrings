    "Agents that are working, waiting on you or have just finished show up here, across every machine you have connected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents that are working, waiting on you or have just finished show up here, across every machine you have connected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten, die arbeiten, auf dich warten oder gerade fertig sind, erscheinen hier, über alle Rechner hinweg, die du verbunden hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen los agentes que trabajan, esperan por ti o acaban de terminar, en todas las máquinas que hayas conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les agents en cours, ceux qui attendent votre réponse ou viennent de finir apparaissent ici, sur toutes les machines connectées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui compaiono gli agenti che lavorano, aspettano te o hanno appena finito, su tutte le macchine che hai collegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業中、あなたの返答待ち、または完了したばかりのエージェントがここに表示されます。接続したすべてのマシンのものが対象です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 중이거나 당신의 응답을 기다리거나 방금 끝난 에이전트가 연결한 모든 컴퓨터에서 여기에 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawiają się agenci, którzy pracują, czekają na ciebie albo właśnie skończyli, ze wszystkich połączonych komputerów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui aparecem os agentes que estão trabalhando, aguardando você ou que acabaram de terminar, em todas as máquinas que você conectou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在工作、等你处理或刚刚完成的智能体都会显示在这里，覆盖你连接的每台机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在工作、等你處理或剛完成的代理都會顯示在這裡，涵蓋你連接的每台機器。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter, der arbejder, venter på dig eller lige er blevet færdige, vises her på tværs af alle de computere, du har forbundet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentit, jotka työskentelevät, odottavat sinua tai ovat juuri valmistuneet, näkyvät tässä kaikilla yhdistämilläsi tietokoneilla."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentar sem eru að vinna, bíða eftir þér eða hafa nýlokið störfum birtast hér, á öllum tölvum sem þú hefur tengt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter som jobber, venter på deg eller nettopp er ferdige, vises her, på tvers av alle maskiner du har koblet til."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenter som arbetar, väntar på dig eller just har slutat visas här, på alla datorer du har anslutit."
          }
        }
      }
    },
