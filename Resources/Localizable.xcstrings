    "An update started %@ and never reported how it ended.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Update wurde %@ gestartet und hat nie gemeldet, wie es endete."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An update started %@ and never reported how it ended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se inició una actualización %@ y nunca informó cómo terminó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mise à jour a démarré %@ et n'a jamais indiqué comment elle s'est terminée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aggiornamento è iniziato %@ e non ha mai segnalato come è finito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に更新が開始されましたが、結果が一度も報告されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 업데이트가 시작되었지만 결과를 전혀 알려오지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma atualização foi iniciada %@ e nunca informou como terminou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新已于%@开始，但一直没有报告它是如何结束的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新已於%@開始，但一直沒有回報它是如何結束的。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizacja rozpoczęła się %@ i nigdy nie zgłosiła, jak się zakończyła."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En opdatering blev startet %@ og meldte aldrig, hvordan den endte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitys käynnistyi %@ eikä koskaan ilmoittanut, miten se päättyi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppfærsla hófst %@ og skilaði aldrei skýrslu um hvernig hún endaði."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En oppdatering startet %@ og meldte aldri hvordan den endte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En uppdatering startade %@ och rapporterade aldrig hur den slutade."
          }
        }
      }
    },
