    "Nothing here matches. Type a path starting with / or ~ to use it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts davon passt. Gib einen Pfad ein, der mit / oder ~ beginnt, um ihn zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here matches. Type a path starting with / or ~ to use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de esto coincide. Escribe una ruta que empiece por / o ~ para usarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne correspond ici. Saisissez un chemin commençant par / ou ~ pour l’utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente corrisponde qui. Digita un percorso che inizia con / o ~ per usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致するものがありません。/ または ~ で始まるパスを入力すると、それを使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 항목이 없습니다. /나 ~로 시작하는 경로를 입력하면 그대로 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aqui corresponde. Digite um caminho começando com / ou ~ para usá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有匹配项。输入以 / 或 ~ 开头的路径即可直接使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有相符項目。輸入以 / 或 ~ 開頭的路徑即可直接使用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic tu nie pasuje. Wpisz ścieżkę zaczynającą się od / lub ~, by jej użyć."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet her matcher. Skriv en sti, der starter med / eller ~, for at bruge den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään ei vastaa. Kirjoita polku, joka alkaa merkillä / tai ~, jotta voit käyttää sitä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert hér passar. Skrifaðu slóð sem byrjar á / eða ~ til að nota hana."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen treff her. Skriv en bane som starter med / eller ~ for å bruke den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget här matchar. Skriv en sökväg som börjar med / eller ~ för att använda den."
          }
        }
      }
    },
