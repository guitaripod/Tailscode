    "Tailscode cannot hear you. Pick an input device in your sound settings, then call again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode cannot hear you. Pick an input device in your sound settings, then call again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode kann dich nicht hören. Wähle ein Eingabegerät in deinen Toneinstellungen und ruf dann erneut an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode no puede oírte. Elige un dispositivo de entrada en los ajustes de sonido y vuelve a llamar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ne vous entend pas. Choisissez un périphérique d'entrée dans vos réglages de son, puis rappelez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode non ti sente. Scegli un dispositivo di input nelle impostazioni audio, poi richiama."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscodeに音声が届いていません。サウンド設定で入力デバイスを選んでから、もう一度通話してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode가 소리를 듣지 못하고 있어요. 사운드 설정에서 입력 장치를 고른 다음 다시 통화하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode cię nie słyszy. Wybierz urządzenie wejściowe w ustawieniach dźwięku, a potem zadzwoń ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode não consegue ouvir você. Escolha um dispositivo de entrada nos ajustes de som e ligue de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 听不到你的声音。请在声音设置中选择输入设备，然后重新通话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 聽不到你的聲音。請在聲音設定中選擇輸入裝置，然後重新通話。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode kan ikke høre dig. Vælg en inputenhed i dine lydindstillinger, og ring derefter op igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ei kuule sinua. Valitse ääniasetuksissa sisääntulolaite ja soita sitten uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode heyrir ekki í þér. Veldu inntakstæki í hljóðstillingunum og hringdu svo aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode kan ikke høre deg. Velg en inngangsenhet i lydinnstillingene, og ring deretter igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode kan inte höra dig. Välj en ingångsenhet i ljudinställningarna och ring igen."
          }
        }
      }
    },
    "Tailscode cannot hear you. Turn on Microphone for Tailscode in Settings, under Privacy & Security, then call again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode cannot hear you. Turn on Microphone for Tailscode in Settings, under Privacy & Security, then call again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode kann dich nicht hören. Aktiviere in den Einstellungen unter Datenschutz & Sicherheit das Mikrofon für Tailscode und ruf dann erneut an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode no puede oírte. Activa Micrófono para Tailscode en Ajustes, en Privacidad y seguridad, y vuelve a llamar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ne vous entend pas. Activez Micro pour Tailscode dans Réglages, sous Confidentialité et sécurité, puis rappelez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode non ti sente. Attiva Microfono per Tailscode in Impostazioni, in Privacy e sicurezza, poi richiama."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscodeに音声が届いていません。「設定」の「プライバシーとセキュリティ」で Tailscode のマイクをオンにしてから、もう一度通話してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode가 소리를 듣지 못하고 있어요. 설정의 개인 정보 보호 및 보안에서 Tailscode의 마이크를 켠 다음 다시 통화하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode cię nie słyszy. Włącz Mikrofon dla Tailscode w Ustawieniach, w sekcji Prywatność i bezpieczeństwo, a potem zadzwoń ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode não consegue ouvir você. Ative Microfone para o Tailscode em Ajustes, em Privacidade e Segurança, e ligue de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 听不到你的声音。请在“设置”的“隐私与安全性”中开启 Tailscode 的麦克风，然后重新通话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 聽不到你的聲音。請在「設定」的「隱私權與安全性」中開啟 Tailscode 的麥克風，然後重新通話。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode kan ikke høre dig. Slå Mikrofon til for Tailscode i Indstillinger under Privatliv og sikkerhed, og ring derefter op igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode ei kuule sinua. Ota Asetuksissa kohdassa Tietosuoja ja turvallisuus käyttöön Tailscoden mikrofoni ja soita sitten uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode heyrir ekki í þér. Kveiktu á hljóðnema fyrir Tailscode í Stillingum undir Persónuvernd og öryggi, og hringdu svo aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode kan ikke høre deg. Slå på Mikrofon for Tailscode i Innstillinger under Personvern og sikkerhet, og ring deretter igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode kan inte höra dig. Slå på Mikrofon för Tailscode i Inställningar under Integritet och säkerhet, och ring sedan igen."
          }
        }
      }
