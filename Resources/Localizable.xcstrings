    "Stored only in this Mac's Keychain. Read once per refresh from api.deepseek.com — the key never touches your servers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur im Schlüsselbund dieses Mac gespeichert. Wird bei jeder Aktualisierung einmal von api.deepseek.com abgerufen — der Schlüssel berührt nie deine Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored only in this Mac's Keychain. Read once per refresh from api.deepseek.com — the key never touches your servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guarda en el llavero de este Mac. Se lee una vez por actualización desde api.deepseek.com: la clave nunca toca tus servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockée uniquement dans le trousseau de ce Mac. Lue une fois par actualisation depuis api.deepseek.com — la clé ne touche jamais vos serveurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvata solo nel portachiavi di questo Mac. Letta una volta per aggiornamento da api.deepseek.com — la chiave non tocca mai i tuoi server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac のキーチェーンにのみ保存されます。更新のたびに api.deepseek.com から 1 回だけ読み取られます — キーがあなたのサーバに触れることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 키체인에만 저장됩니다. 새로고침할 때마다 api.deepseek.com에서 한 번만 읽어옵니다 — 이 키가 당신의 서버에 닿는 일은 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazenada apenas nas Chaves deste Mac. Lida uma vez a cada atualização a partir de api.deepseek.com — a chave nunca toca nos seus servidores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只保存在这台 Mac 的钥匙串中。每次刷新只从 api.deepseek.com 读取一次 — 密钥不会经过你的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只儲存在這台 Mac 的鑰匙圈中。每次重新整理只從 api.deepseek.com 讀取一次 — 金鑰不會經過你的伺服器。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowywany tylko w Pęku kluczy tego Maca. Odczytywany raz na odświeżenie z api.deepseek.com — klucz nigdy nie trafia na twoje serwery."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmes kun i nøgleringen på denne Mac. Hentes én gang ved hver opdatering fra api.deepseek.com – nøglen rører aldrig dine servere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu vain tämän Macin avainnippuun. Luetaan kerran päivityksen yhteydessä osoitteesta api.deepseek.com – avain ei koskaan kulje palvelimillesi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Geymt eingöngu í lyklakippu þessarar Mac-tölvu. Lesið einu sinni við hverja endurnýjun frá api.deepseek.com. Lykillinn fer aldrei á netþjónana þína."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret bare i nøkkelringen på denne Macen. Leses én gang per oppdatering fra api.deepseek.com – nøkkelen berører aldri serverne dine."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagras bara i nyckelringen på den här Mac:en. Läses en gång per uppdatering från api.deepseek.com – nyckeln når aldrig dina servrar."
          }
        }
      }
    },
