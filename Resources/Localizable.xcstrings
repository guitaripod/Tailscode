          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집할 그림: 파일 선택, 붙여넣기 또는 머신의 선반에서 가져오기"
          }
        },
        "pl": {
          "stringUnit": {
