    "The default server is where a new chat starts when you haven't aimed the composer somewhere else.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standardserver ist der Ort, an dem ein neuer Chat beginnt, wenn du das Eingabefeld nicht anders ausgerichtet hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default server is where a new chat starts when you haven't aimed the composer somewhere else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor predeterminado es donde comienza un chat nuevo si no has apuntado el compositor a otro sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur par défaut est celui où démarre une nouvelle discussion quand vous n’avez pas orienté la zone de saisie ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server predefinito è dove inizia una nuova chat quando non hai puntato il compositore altrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトのサーバは、入力欄を他に向けていないときに新しいチャットが始まる場所です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 서버는 작성창을 다른 곳으로 지정하지 않았을 때 새 대화가 시작되는 곳입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor padrão é onde uma nova conversa começa quando você não direcionou o campo de texto para outro lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认服务器是在你没有把输入框指向别处时，新对话的起点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設伺服器是在你沒有把輸入框指向他處時，新對話的起點。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślny serwer to miejsce, w którym zaczyna się nowa rozmowa, jeśli edytor wiadomości nie został skierowany gdzieś indziej."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardserveren er stedet, hvor en ny chat starter, når du ikke har rettet inputfeltet mod noget andet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oletuspalvelin on se paikka, josta uusi keskustelu alkaa, ellet ole kohdistanut kehotekenttää muualle."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjálfgefni netþjónninn er staðurinn þar sem nýtt spjall byrjar ef þú hefur ekki beint innsláttarreitnum annað."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardserveren er stedet en ny chat starter når du ikke har rettet inntastingsfeltet mot noe annet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardservern är där en ny chatt startar, om du inte har valt en annan i inmatningsfältet."
          }
        }
      }
    },
