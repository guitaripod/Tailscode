    "It was removed while this window was open. Choose another server, or add it again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wurde entfernt, während dieses Fenster geöffnet war. Wähle einen anderen Server oder füge ihn erneut hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was removed while this window was open. Choose another server, or add it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó mientras esta ventana estaba abierta. Elige otro servidor o añádelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a été supprimé pendant que cette fenêtre était ouverte. Choisissez un autre serveur, ou ajoutez-le à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato rimosso mentre questa finestra era aperta. Scegli un altro server, oppure aggiungilo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウインドウが開いている間に削除されました。別のサーバを選ぶか、もう一度追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 창이 열려 있는 동안 제거되었습니다. 다른 서버를 선택하거나 다시 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele foi removido enquanto esta janela estava aberta. Escolha outro servidor ou adicione-o novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此窗口打开期间它被移除了。请选择其他服务器，或重新添加它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此視窗開啟期間它被移除了。請選擇其他伺服器，或重新加入它。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Został usunięty, gdy to okno było otwarte. Wybierz inny serwer albo dodaj go ponownie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den blev fjernet, mens dette vindue var åbent. Vælg en anden server, eller tilføj den igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se poistettiin, kun tämä ikkuna oli auki. Valitse toinen palvelin tai lisää se uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hann var fjarlægður meðan þessi gluggi var opinn. Veldu annan netþjón, eða bættu honum við aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ble fjernet mens dette vinduet var åpent. Velg en annen server, eller legg den til på nytt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den togs bort medan fönstret var öppet. Välj en annan server eller lägg till den igen."
          }
        }
      }
    },
