    "One gesture for what happens, never longer than two seconds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One gesture for what happens, never longer than two seconds"
          }
        },
        "de": {
