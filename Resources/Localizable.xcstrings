    },
    "Couldn't reach Tailscale to check the token. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach Tailscale to check the token. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale war nicht erreichbar, um das Token zu prüfen. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo contactar con Tailscale para comprobar el token. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Tailscale pour vérifier le jeton. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile contattare Tailscale per verificare il token. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンを確認するため Tailscale に接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰을 확인하려고 Tailscale에 연결할 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć z Tailscale, aby sprawdzić token. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível contactar o Tailscale para verificar o token. Confira sua conexão e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Tailscale 来检查令牌。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法連上 Tailscale 來檢查權杖。請檢查網路連線後再試一次。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke nå Tailscale for at kontrollere tokenet. Kontrollér din forbindelse, og prøv igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscaleen ei saatu yhteyttä, joten pääsytunnusta ei voitu tarkistaa. Tarkista yhteys ja yritä uudelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekki tókst að ná sambandi við Tailscale til að athuga aðgangstáknið. Athugaðu tenginguna og reyndu aftur."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke nå Tailscale for å sjekke tokenet. Sjekk tilkoblingen og prøv igjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att nå Tailscale för att verifiera åtkomsttoken. Kontrollera anslutningen och försök igen."
          }
        }
      }
    },
    "No Tailscale token, but this phone remembers %lld machines. Ask them again, or add a token to find new ones.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Tailscale token, but this phone remembers %lld machines. Ask them again, or add a token to find new ones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Tailscale-Token, aber dieses Telefon kennt %lld Rechner. Frag sie erneut ab oder füge ein Token hinzu, um neue zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay token de Tailscale, pero este teléfono recuerda %lld máquinas. Pregúntales de nuevo o añade un token para encontrar nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun jeton Tailscale, mais ce téléphone se souvient de %lld machines. Interrogez-les à nouveau, ou ajoutez un jeton pour en trouver de nouvelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun token Tailscale, ma questo telefono ricorda %lld macchine. Interrogale di nuovo o aggiungi un token per trovarne di nuove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale のトークンはありませんが、この端末は %lld 台のマシンを記憶しています。もう一度問い合わせるか、トークンを追加して新しいマシンを探してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 토큰이 없지만 이 휴대폰은 %lld대의 머신을 기억하고 있습니다. 다시 문의하거나 토큰을 추가해 새 머신을 찾으세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak tokena Tailscale, ale ten telefon pamięta %lld komputery. Zapytaj je ponownie albo dodaj token, aby znaleźć nowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem token do Tailscale, mas este celular lembra de %lld máquinas. Pergunte a elas de novo ou adicione um token para encontrar novas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 Tailscale 令牌，但这部手机记得 %lld 台机器。可再次询问它们，或添加令牌以发现新机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有 Tailscale 權杖，但這支手機記得 %lld 台電腦。可再次詢問它們，或新增權杖以探索新電腦。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet Tailscale-token, men denne telefon kender %lld computere. Spørg dem igen, eller tilføj et token for at finde nye."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale-pääsytunnusta ei ole, mutta tämä puhelin muistaa %lld tietokonetta. Kysy ne uudelleen tai lisää pääsytunnus, jotta löydät uusia."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert Tailscale-aðgangstákn, en þessi sími man vistaðar tölvur: %lld. Spurðu þær aftur, eða bættu við aðgangstákni til að finna nýjar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen Tailscale-token, men denne telefonen husker %lld maskiner. Spør dem på nytt, eller legg til et token for å finne nye."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen Tailscale-åtkomsttoken, men den här telefonen minns %lld datorer. Fråga dem igen, eller lägg till en åtkomsttoken för att hitta nya."
          }
        }
      }
    },
