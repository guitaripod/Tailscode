    "That agent hasn't reported into this conversation yet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Agent hat sich in dieser Unterhaltung noch nicht gemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That agent hasn't reported into this conversation yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese agente aún no ha informado en esta conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet agent ne s’est pas encore manifesté dans cette conversation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quell’agente non si è ancora fatto vivo in questa conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのエージェントはまだこの会話に報告していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 에이전트는 아직 이 대화에 보고하지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse agente ainda não reportou nesta conversa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该智能体尚未在此对话中回报。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該代理尚未在此對話中回報。"
          }
        }
      }
    },
    "The address is verified before it is saved, so a typo fails here rather than as errors in every chat.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse wird vor dem Sichern geprüft, damit ein Tippfehler hier auffällt statt später in jedem Chat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address is verified before it is saved, so a typo fails here rather than as errors in every chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección se verifica antes de guardarla, así una errata falla aquí y no como errores en cada chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse est vérifiée avant d’être enregistrée : une faute de frappe échoue ici plutôt que dans chaque discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indirizzo viene verificato prima del salvataggio, così un refuso fallisce qui e non come errore in ogni chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスは保存前に検証されるため、入力ミスはここで判明します。すべてのチャットでエラーになることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소는 저장 전에 확인되므로, 오타는 모든 대화에서 오류가 되는 대신 여기서 걸립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço é verificado antes de ser salvo, então um erro de digitação falha aqui em vez de virar erro em toda conversa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址会在保存前先验证，这样拼写错误会在这里暴露，而不是在每次对话中报错。"
          }
        },
