    "The agent keeps working until this is true, and won't stop early. You can close the app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Agent arbeitet weiter, bis dies zutrifft, und hört nicht vorher auf. Du kannst die App schließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent keeps working until this is true, and won't stop early. You can close the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente sigue trabajando hasta que esto se cumpla y no parará antes. Puedes cerrar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent continue jusqu’à ce que ce soit vrai et ne s’arrête pas avant. Vous pouvez fermer l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agente continua finché questo non è vero e non si ferma prima. Puoi chiudere l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはこれが満たされるまで作業を続け、途中で止まりません。App は閉じて構いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트는 이 조건이 참이 될 때까지 계속 작업하며 도중에 멈추지 않습니다. 앱을 닫아도 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente continua trabalhando até isso ser verdade e não para antes. Você pode fechar o app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体会一直工作到这一条件成立为止，不会提前停止。你可以关闭 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理會一直工作到這個條件成立為止，不會提前停止。你可以關閉 App。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent pracuje, dopóki to się nie ziści, i nie przerwie wcześniej. Możesz zamknąć aplikację."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten arbejder videre, indtil dette er opfyldt, og stopper ikke for tidligt. Du kan lukke appen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentti jatkaa työtä, kunnes tämä pitää paikkansa, eikä lopeta ennenaikaisesti. Voit sulkea sovelluksen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentinn heldur áfram að vinna þar til þetta er orðið satt og hættir ekki fyrr. Þú mátt loka appinu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten fortsetter å jobbe til dette stemmer, og stopper ikke tidlig. Du kan lukke appen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten fortsätter arbeta tills detta stämmer och slutar inte i förtid. Du kan stänga appen."
          }
        }
      }
    },
    "The agent needs your approval to continue.": {
      "extractionState": "manual",
      "localizations": {
