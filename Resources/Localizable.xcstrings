    "Something is listening on %@, but it isn't an agent this app knows. opencode serves 4096, claude-bridge 4098, omp-bridge 4099.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something is listening on %@, but it isn't an agent this app knows. opencode serves 4096, claude-bridge 4098, omp-bridge 4099."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf %@ lauscht etwas, aber es ist kein Agent, den diese App kennt. opencode läuft auf Port 4096, claude-bridge auf 4098, omp-bridge auf 4099."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo escucha en %@, pero no es un agente que esta app conozca. opencode usa el puerto 4096, claude-bridge el 4098 y omp-bridge el 4099."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose écoute sur %@, mais ce n’est pas un agent que cette app connaît. opencode expose le port 4096, claude-bridge le 4098, omp-bridge le 4099."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è in ascolto su %@, ma non è un agente che questa app conosca. opencode usa la porta 4096, claude-bridge la 4098, omp-bridge la 4099."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で何かが待ち受けていますが、このアプリが知っているエージェントではありません。opencode はポート 4096、claude-bridge は 4098、omp-bridge は 4099 を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 무언가 대기 중이지만 이 앱이 아는 에이전트가 아닙니다. opencode는 4096, claude-bridge는 4098, omp-bridge는 4099 포트를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo está escutando em %@, mas não é um agente que este app conheça. O opencode serve na porta 4096; o claude-bridge, na 4098; o omp-bridge, na 4099."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上有程序在监听，但它不是这个应用认识的智能体。opencode 使用 4096 端口，claude-bridge 使用 4098，omp-bridge 使用 4099。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上有東西在監聽，但不是這個 App 認識的代理。opencode 使用 4096 連接埠，claude-bridge 使用 4098，omp-bridge 使用 4099。"
          }
        }
      }
    },
