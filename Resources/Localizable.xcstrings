        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kræver en enkelt tast, ikke en sekvens"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hyväksyy vain yhden näppäimen, ei sarjaa"
