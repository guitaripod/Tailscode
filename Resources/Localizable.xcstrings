    "Connect to a Claude Code, opencode or Oh My Pi server to see usage.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde dich mit einem Claude-Code-, opencode- oder Oh-My-Pi-Server, um die Nutzung zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to a Claude Code, opencode or Oh My Pi server to see usage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate a un servidor de Claude Code, opencode u Oh My Pi para ver el uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à un serveur Claude Code, opencode ou Oh My Pi pour voir l’usage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti a un server Claude Code, opencode o Oh My Pi per vedere l’utilizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用状況を見るには Claude Code、opencode または Oh My Pi のサーバに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용량을 보려면 Claude Code, opencode 또는 Oh My Pi 서버에 연결하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se a um servidor Claude Code, opencode ou Oh My Pi para ver o uso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接 Claude Code、opencode 或 Oh My Pi 服务器以查看用量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線 Claude Code、opencode 或 Oh My Pi 伺服器以查看用量。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z serwerem Claude Code, opencode lub Oh My Pi, aby zobaczyć użycie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret forbindelse til en Claude Code-, opencode- eller Oh My Pi-server for at se forbruget."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä palvelin, jossa on Claude Code, opencode tai Oh My Pi, nähdäksesi käytön."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengdu netþjón fyrir Claude Code, opencode eða Oh My Pi til að sjá notkun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til en server for Claude Code, opencode eller Oh My Pi for å se bruk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut till en Claude Code-, opencode- eller Oh My Pi-server för att se användningen."
          }
        }
      }
    },
    "Connect unlimited servers — one unified session list across every machine on your tailnet": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbegrenzt viele Server verbinden – eine gemeinsame Sitzungsliste über alle Rechner im Tailnet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect unlimited servers — one unified session list across every machine on your tailnet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta servidores ilimitados: una lista de sesiones unificada para todas las máquinas de tu tailnet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez un nombre illimité de serveurs — une liste de sessions unifiée pour toutes vos machines du tailnet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connetti server illimitati — un unico elenco di sessioni per tutte le macchine del tuo tailnet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバを無制限に接続 — tailnet 上のすべてのマシンのセッションを 1 つのリストに"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버를 무제한 연결 — tailnet의 모든 컴퓨터를 하나의 세션 목록으로"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte servidores ilimitados — uma lista de sessões unificada para todas as máquinas da sua tailnet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接无限台服务器 — 将 tailnet 上所有机器汇总为一份会话列表"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線無限台伺服器 — 將 tailnet 上所有電腦彙整為一份工作階段清單"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącz nieograniczoną liczbę serwerów — jedna wspólna lista sesji dla wszystkich komputerów w twoim tailnet"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret forbindelse til ubegrænset antal servere – én samlet sessionsliste på tværs af alle computere i dit tailnet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä rajattomasti palvelimia – yksi yhtenäinen istuntoluettelo jokaiselle tailnetisi tietokoneelle"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tengdu ótakmarkaðan fjölda netþjóna – ein sameinuð setulisti yfir allar tölvur á tailnetinu þínu"
