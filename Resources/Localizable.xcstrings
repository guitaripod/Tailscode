    "Held — change a word and only that word changes. Press to roll again": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehalten — ändere ein Wort, und nur dieses Wort ändert sich. Drücken, um neu zu würfeln"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held — change a word and only that word changes. Press to roll again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija — cambia una palabra y solo esa palabra cambia. Pulsa para volver a tirar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixée — changez un mot et seul ce mot change. Appuyez pour retirer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccato — cambia una parola e solo quella parola cambia. Premi per tirare di nuovo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定中 — 一語を変えると、その語だけが変わります。もう一度振るにはタップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정됨 — 단어 하나를 바꾸면 그 단어만 바뀝니다. 다시 굴리려면 누르세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixada — mude uma palavra e só essa palavra muda. Toque para sortear de novo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已锁定 — 改一个词，只有那个词会变。点按可重新掷出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已鎖定 — 改一個字，只有那個字會變。點一下可重新擲出"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymany — zmień słowo, a zmieni się tylko ono. Naciśnij, aby wylosować ponownie"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Holdt – ændr et ord, så ændrer kun det ord sig. Tryk for at slå igen"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidetty: vaihda sana, ja vain se muuttuu. Paina arpoaksesi uudelleen"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Haldið: breyttu einu orði og aðeins það orð breytist. Ýttu til að draga aftur"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Holdt: endre ett ord, så endres bare det ordet. Trykk for å trekke på nytt"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låst – ändra ett ord, så ändras bara det ordet. Tryck för att slå om igen"
          }
        }
      }
    },
