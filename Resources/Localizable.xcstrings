    "%lld attached — they'll be sent with your next message.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld angehängt — sie werden mit deiner nächsten Nachricht gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld attached — they'll be sent with your next message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld adjuntos — se enviarán con tu próximo mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pièces jointes — elles seront envoyées avec votre prochain message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld allegati — saranno inviati con il tuo prossimo messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件添付済み — 次のメッセージと一緒に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개 첨부됨 — 다음 메시지와 함께 전송됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld anexados — serão enviados com sua próxima mensagem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已附加 %lld 个 — 会随你的下一条消息发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已附加 %lld 個 — 會隨你的下一則訊息傳送。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołączono %lld — zostaną wysłane z twoją następną wiadomością."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld vedhæftet, de sendes med din næste besked."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld liitettä lisätty, ne lähetetään seuraavan viestisi mukana."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld viðhengi fylgja – þau verða send með næstu skilaboðum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld vedlagt – sendes med neste melding."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilagor: %lld – skickas med ditt nästa meddelande."
          }
        }
      }
    },
