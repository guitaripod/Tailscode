        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拒絕授予金鑰，之後沒有再說任何話。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ afviste at give en nøgle og sagde ikke mere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kieltäytyi myöntämästä avainta eikä sanonut enempää."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hafnaði að veita lykil og sagði ekki meira."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nektet å gi en nøkkel og sa ikke mer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vägrade att ge ut en nyckel och sa inte mer."
          }
        }
      }
    },
