    "The hour shows what this Mac saw while the board was open.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hour shows what this Mac saw while the board was open."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stunde zeigt, was dieser Mac gesehen hat, während das Board offen war."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora muestra lo que este Mac vio mientras el panel estaba abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure montre ce que ce Mac a vu pendant que le tableau était ouvert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ora mostra ciò che questo Mac ha visto mentre la bacheca era aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この1時間には、ボードを開いている間にこの Mac が見た内容が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 한 시간은 보드가 열려 있는 동안 이 Mac이 본 내용을 보여줘요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godzina pokazuje, co ten Mac widział, gdy tablica była otwarta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A hora mostra o que este Mac viu enquanto o painel estava aberto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一小时显示的是此 Mac 在面板打开期间看到的内容。"
