          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバはフォルダの一覧を取得できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버에서 폴더 목록을 가져올 수 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor não consegue listar as pastas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器无法列出其文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器無法列出其資料夾"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten serwer nie może wyświetlić swoich folderów"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne server kan ikke vise sine mapper"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä palvelin ei voi listata kansioitaan"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þessi netþjónn getur ekki sýnt möppurnar sínar"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne serveren kan ikke liste opp mappene sine"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här servern kan inte lista sina mappar"
          }
        }
      }
    },
    "It may be offline, waiting for a password, or too old to list folders. Typing a path in the new-chat field still works.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may be offline, waiting for a password, or too old to list folders. Typing a path in the new-chat field still works."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ist vielleicht offline, wartet auf ein Passwort oder ist zu alt, um Ordner aufzulisten. Einen Pfad im Feld für neue Chats einzugeben funktioniert weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede estar sin conexión, esperando una contraseña o ser demasiado antiguo para listar carpetas. Escribir una ruta en el campo del nuevo chat sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est peut-être hors ligne, en attente d’un mot de passe ou trop ancien pour lister les dossiers. Saisir un chemin dans le champ de la nouvelle discussion fonctionne toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere offline, in attesa di una password o troppo vecchio per elencare le cartelle. Digitare un percorso nel campo della nuova chat funziona comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン、パスワード待ち、またはフォルダ一覧に対応していない古いバージョンの可能性があります。新規チャットの入力欄にパスを入力する方法は引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인이거나, 비밀번호를 기다리고 있거나, 폴더 목록을 지원하기엔 너무 오래된 버전일 수 있습니다. 새 대화 입력란에 경로를 직접 입력하는 방법은 계속 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode estar offline, aguardando uma senha ou ser antigo demais para listar pastas. Digitar um caminho no campo da nova conversa continua funcionando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已离线、正在等待密码，或版本过旧而无法列出文件夹。在新对话输入框中直接输入路径仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已離線、正在等待密碼，或版本過舊而無法列出資料夾。在新對話輸入欄中直接輸入路徑仍然可用。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może być offline, czekać na hasło albo być zbyt stary, by wyświetlać foldery. Wpisanie ścieżki w polu nowej rozmowy nadal działa."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er måske offline, venter på en adgangskode eller er for gammel til at vise mapper. Du kan stadig skrive en sti i feltet for nye chats."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se voi olla offline-tilassa, odottaa salasanaa tai olla liian vanha kansioiden listaamiseen. Polun kirjoittaminen uuden keskustelun kenttään toimii edelleen."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hann gæti verið ótengdur, bíði eftir lykilorði eða verið of gamall til að sýna möppur. Hægt er samt að slá inn slóð í reitinn fyrir nýtt spjall."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren kan være frakoblet, vente på et passord eller være for gammel til å liste opp mapper. Du kan fortsatt skrive inn en bane i feltet for nye chatter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kanske är offline, väntar på ett lösenord eller är för gammal för att lista mappar. Det går fortfarande att skriva en sökväg i fältet för nya chattar."
          }
        }
      }
    },
