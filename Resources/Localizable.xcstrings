        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode는 자체 창에서만 응답합니다. 어디서든 질문하려면 이 옵션을 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode só responde em sua própria janela. Ative isto para perguntar de qualquer lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 只在自己的窗口里响应。打开此选项即可随时随地提问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 只在自己的視窗裡回應。開啟此選項即可隨時隨地提問。"
          }
        }
      }
    },
    "Press %@ in any app to ask a question. %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke %@ in einer beliebigen App, um eine Frage zu stellen. %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press %@ in any app to ask a question. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa %@ en cualquier app para hacer una pregunta. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur %@ dans n’importe quelle app pour poser une question. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi %@ in qualsiasi app per fare una domanda. %@"
