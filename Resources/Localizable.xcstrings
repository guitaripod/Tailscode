    "It did not answer in time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es hat nicht rechtzeitig geantwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It did not answer in time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No respondió a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’a pas répondu à temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ha risposto in tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間内に応答しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제시간에 응답하지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não respondeu a tempo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能及时响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能及時回應。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie odpowiedział na czas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den svarede ikke i tide."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ei vastannut ajoissa."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það svaraði ekki í tæka tíð."
          }
        },
        "nb": {
