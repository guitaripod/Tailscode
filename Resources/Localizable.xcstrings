            "value": "… se omitieron entradas anteriores; Compartir exporta el registro completo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "… entrées antérieures omises — Partager exporte le journal complet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "… voci precedenti omesse — Condividi esporta il log completo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "… 以前のエントリは省略されました — 「共有」で全ログを書き出せます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "… 이전 항목은 생략됨 — 공유하면 전체 로그를 내보냅니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "… entradas anteriores omitidas — Compartilhar exporta o registro completo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "… 已省略较早的条目 — “共享”可导出完整日志"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "… 已省略較早的項目 — 「分享」可輸出完整日誌"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "… wcześniejsze wpisy pominięto — „Udostępnij” eksportuje pełny dziennik"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "… tidligere poster udeladt – Del eksporterer hele loggen"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "… aiemmat merkinnät jätettiin pois – Jaa vie koko lokin"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "… eldri færslum sleppt – Deila flytur út allan annálinn"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "… tidligere oppføringer utelatt – «Del» eksporterer hele loggen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "… tidigare poster utelämnade – Dela exporterar hela loggen"
          }
        }
      }
    },
