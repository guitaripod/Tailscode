    "Go up a level, use the path above, or pick another place.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå op et niveau, brug stien ovenfor, eller vælg et andet sted."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe eine Ebene nach oben, nutze den Pfad oben oder wähle einen anderen Ort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go up a level, use the path above, or pick another place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube un nivel, usa la ruta de arriba o elige otro lugar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Siirry yläkansioon, käytä yllä olevaa polkua tai valitse toinen paikka."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remontez d’un niveau, utilisez le chemin ci-dessus ou choisissez un autre endroit."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Farðu upp um eitt stig, notaðu slóðina hér fyrir ofan eða veldu annan stað."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sali di un livello, usa il percorso qui sopra o scegli un altro posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとつ上の階層へ移動するか、上のパスを使うか、別の場所を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 단계 위로 이동하거나 위의 경로를 사용하거나 다른 위치를 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå opp ett nivå, bruk stien over, eller velg et annet sted."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź poziom wyżej, użyj ścieżki powyżej albo wybierz inne miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suba um nível, use o caminho acima ou escolha outro lugar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå upp en nivå, använd sökvägen ovan eller välj en annan plats."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回上一级，使用上方的路径，或选择其他位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "返回上一層，使用上方的路徑，或選擇其他位置。"
          }
        }
      }
    },
    "It may be offline, want a password, or be too old to list its folders. A path typed in the new-chat field still works.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den er måske offline, kræver en adgangskode eller er for gammel til at vise sine mapper. En sti skrevet i feltet for ny chat virker stadig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ist möglicherweise offline, verlangt ein Passwort oder ist zu alt, um seine Ordner aufzulisten. Ein im Feld für neue Chats eingegebener Pfad funktioniert trotzdem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may be offline, want a password, or be too old to list its folders. A path typed in the new-chat field still works."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede estar sin conexión, pedir una contraseña o ser demasiado antiguo para listar sus carpetas. Una ruta escrita en el campo de nuevo chat sigue funcionando."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se voi olla pois verkosta, vaatia salasanan tai olla liian vanha luettelemaan kansionsa. Uuden keskustelun kenttään kirjoitettu polku toimii edelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est peut-être hors ligne, demande un mot de passe ou est trop ancien pour lister ses dossiers. Un chemin saisi dans le champ de nouvelle discussion fonctionne toujours."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hann gæti verið án nettengingar, krafist lykilorðs eða verið of gamall til að birta möppur sínar. Slóð sem er slegin inn í reitinn fyrir nýtt spjall virkar samt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere offline, richiedere una password o essere troppo vecchio per elencare le sue cartelle. Un percorso scritto nel campo della nuova chat funziona comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインか、パスワードが必要か、フォルダを一覧するには古すぎる可能性があります。新しいチャットの入力欄に入力したパスは引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인이거나, 암호가 필요하거나, 폴더를 나열하기에는 너무 오래된 버전일 수 있습니다. 새 대화 입력란에 직접 입력한 경로는 계속 사용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan være frakoblet, kreve passord eller være for gammel til å liste opp mappene. En sti skrevet i feltet for ny chat fungerer fortsatt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może być offline, wymagać hasła albo być zbyt stary, by wyświetlić swoje foldery. Ścieżka wpisana w polu nowej rozmowy nadal działa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele pode estar offline, pedir uma senha ou ser antigo demais para listar suas pastas. Um caminho digitado no campo da nova conversa continua funcionando."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kan vara offline, kräva lösenord eller vara för gammal för att lista sina mappar. En sökväg som skrivs i fältet för ny chatt fungerar ändå."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已离线、需要密码，或版本过旧而无法列出文件夹。在新对话输入框中输入的路径仍然有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已離線、需要密碼，或版本過舊而無法列出資料夾。在新對話輸入欄中輸入的路徑仍然有效。"
          }
        }
      }
    },
