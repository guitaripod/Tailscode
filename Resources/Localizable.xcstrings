    "Tap the mic beside Send to talk, or touch and hold it to talk while held. Dictation runs on this %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the mic beside Send to talk, or touch and hold it to talk while held. Dictation runs on this %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe neben Senden auf das Mikrofon zum Sprechen, oder berühre es gedrückt, um beim Halten zu sprechen. Diktat läuft auf diesem %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el micrófono junto a Enviar para hablar, o mantenlo pulsado para hablar mientras lo mantienes. El dictado funciona en este %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le micro à côté d'Envoyer pour parler, ou touchez-le et maintenez pour parler pendant l'appui. La dictée fonctionne sur votre %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il microfono accanto a Invia per parlare, o toccalo e tienilo premuto per parlare mentre lo tieni. La dettatura funziona su questo %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信ボタンの横のマイクをタップして話すか、タッチして押さえると押している間話せます。音声入力はこの%@で動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기 옆 마이크를 탭해서 말하거나, 터치해서 누르고 있는 동안 말하세요. 받아쓰기는 이 %@에서 실행됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij mikrofon obok Wyślij, by mówić, albo dotknij i przytrzymaj go, by mówić, dopóki trzymasz. Dyktowanie działa na tym %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no microfone ao lado de Enviar para falar, ou toque e segure para falar enquanto segura. O ditado roda neste %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点发送旁的麦克风说话，或按住它边按边说。听写在这台%@上运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按傳送旁的麥克風即可說話，或觸碰並按住它來持續說話。聽寫在這台 %@ 上執行。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på mikrofonen ved siden af Send for at tale, eller hold den nede, mens du taler. Diktering kører på denne %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta Lähetä-painikkeen vieressä olevaa mikrofonia puhuaksesi tai kosketa ja pidä sitä painettuna, jotta puhut vain niin kauan kuin pidät sormea paikallaan. Sanelu toimii tällä laitteella: %@."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikkaðu á hljóðnemann við hliðina á „Senda“ til að tala, eða haltu honum inni til að tala meðan haldið er. %@ keyrir raddritunina."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på mikrofonen ved siden av Send for å snakke, eller hold den inne for å snakke så lenge du holder. Diktering kjører på %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på mikrofonen bredvid Skicka för att prata, eller tryck och håll kvar den medan du pratar. Diktering körs på %@."
          }
        }
      }
    },
