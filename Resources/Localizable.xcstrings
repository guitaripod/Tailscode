    "It answered without the review routes. delegate 0.4 can hold, apply and discard a patch.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den svarede uden gennemgangsruterne. delegate 0.4 kan tilbageholde, anvende og kassere en patch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er hat ohne die Prüf-Routen geantwortet. delegate 0.4 kann einen Patch zurückhalten, anwenden und verwerfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It answered without the review routes. delegate 0.4 can hold, apply and discard a patch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respondió sin las rutas de revisión. delegate 0.4 puede retener, aplicar y descartar un parche."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vastasi ilman tarkistusreittejä. delegate 0.4 osaa pidättää, käyttää ja hylätä patchin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a répondu sans les routes de relecture. delegate 0.4 sait retenir, appliquer et ignorer un correctif."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það svaraði án yfirferðarslóðanna. delegate 0.4 getur haldið, beitt og hent patch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha risposto senza le route di revisione. delegate 0.4 può trattenere, applicare e scartare una patch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レビュー用のルートなしで応答しました。delegate 0.4 ならパッチの保留・適用・破棄ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토 경로 없이 응답했습니다. delegate 0.4는 패치를 보류, 적용, 폐기할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den svarte uten gjennomgangsrutene. delegate 0.4 kan holde tilbake, bruke og forkaste en patch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedział bez tras przeglądu. delegate 0.4 potrafi wstrzymać, zastosować i odrzucić łatkę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respondeu sem as rotas de revisão. O delegate 0.4 pode reter, aplicar e descartar um patch."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den svarade utan granskningsrutterna. delegate 0.4 kan hålla, tillämpa och kassera en patch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的响应里没有审阅路由。delegate 0.4 可以保留、应用和丢弃补丁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的回應裡沒有審閱路由。delegate 0.4 可以保留、套用和捨棄修補程式。"
          }
        }
      }
    },
    "it didn't answer in time": {
      "extractionState": "manual",
      "localizations": {
