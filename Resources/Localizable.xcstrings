    "The conversations beside the one you are in; drag its edge to size it, and the size is remembered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversations beside the one you are in; drag its edge to size it, and the size is remembered"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Unterhaltungen neben der aktuellen; zum Anpassen den Rand ziehen, die Größe wird gemerkt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conversaciones junto a la que tienes abierta; arrastra su borde para ajustarla, y el tamaño se recuerda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conversations à côté de celle que tu ouvres ; fais glisser son bord pour la redimensionner, la taille est mémorisée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le conversazioni accanto a quella aperta; trascina il bordo per dimensionarla, la dimensione viene ricordata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中の会話の横に並ぶ会話。端をドラッグして幅を変えると、その幅は記憶されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 대화 옆에 보이는 대화들. 가장자리를 끌어 크기를 조절하면 그 크기가 기억됩니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmowy obok otwartej; przeciągnij jej krawędź, aby zmienić rozmiar, a rozmiar zostanie zapamiętany"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As conversas ao lado da que você está; arraste a borda para ajustar o tamanho, e o tamanho fica lembrado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与当前对话并排的会话；拖动边缘调整宽度，宽度会被记住"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與目前對話並排的對話；拖曳邊緣調整寬度，寬度會被記住"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtalerne ved siden af den du er i; træk i kanten for at ændre størrelsen, og størrelsen huskes"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskustelut sen vieressä, jossa olet. Vedä reunasta muuttaaksesi kokoa, ja koko muistetaan"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtölin við hliðina á því sem þú ert í; dragðu brúnina til að stilla stærð, og hún er vistuð"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtalene ved siden av den du er i. Dra kanten for å endre størrelse; størrelsen huskes"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konversationerna bredvid den du är i. Dra i kanten för att ändra storlek, storleken sparas."
          }
        }
