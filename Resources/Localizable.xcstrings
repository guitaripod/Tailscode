            "state": "translated",
            "value": "Draw it before building it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibújalo antes de construirlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dessiner avant de le construire"
          }
        },
        "it": {
