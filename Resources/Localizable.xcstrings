    "The attempt out on the machine finishes on its own; nothing after it starts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Versuch auf dem Rechner läuft von selbst zu Ende; danach beginnt nichts Neues."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The attempt out on the machine finishes on its own; nothing after it starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intento en la máquina termina por sí solo; nada empieza después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tentative en cours sur la machine se termine d’elle-même ; rien ne démarre après."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tentativo in corso sulla macchina si conclude da solo; non parte nient’altro dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン側で実行中の試行はそのまま完了します。それ以降は何も開始しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터에서 실행 중인 시도는 스스로 끝납니다. 그 이후로는 아무것도 시작되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tentativa em andamento na máquina termina por conta própria; nada começa depois dela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器上正在进行的尝试会自行结束；此后不会再开始任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "機器上正在進行的嘗試會自行結束；此後不會再開始任何內容。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Próba trwająca na komputerze zakończy się sama; nic po niej się nie rozpocznie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forsøget på computeren afsluttes af sig selv; intet efter det starter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yritys tietokoneella päättyy itsestään; sen jälkeen mitään uutta ei käynnisty."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
