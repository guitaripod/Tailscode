    "Something is listening on %@, but it isn't an agent this app knows. opencode serves 4096, claude-bridge 4098, omp-bridge 4099.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something is listening on %@, but it isn't an agent this app knows. opencode serves 4096, claude-bridge 4098, omp-bridge 4099."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf %@ lauscht etwas, aber es ist kein Agent, den diese App kennt. opencode läuft auf Port 4096, claude-bridge auf 4098, omp-bridge auf 4099."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo escucha en %@, pero no es un agente que esta app conozca. opencode usa el puerto 4096, claude-bridge el 4098 y omp-bridge el 4099."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose écoute sur %@, mais ce n’est pas un agent que cette app connaît. opencode expose le port 4096, claude-bridge le 4098, omp-bridge le 4099."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è in ascolto su %@, ma non è un agente che questa app conosca. opencode usa la porta 4096, claude-bridge la 4098, omp-bridge la 4099."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で何かが待ち受けていますが、このアプリが知っているエージェントではありません。opencode はポート 4096、claude-bridge は 4098、omp-bridge は 4099 を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 무언가 대기 중이지만 이 앱이 아는 에이전트가 아닙니다. opencode는 4096, claude-bridge는 4098, omp-bridge는 4099 포트를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo está escutando em %@, mas não é um agente que este app conheça. O opencode serve na porta 4096; o claude-bridge, na 4098; o omp-bridge, na 4099."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上有程序在监听，但它不是这个应用认识的智能体。opencode 使用 4096 端口，claude-bridge 使用 4098，omp-bridge 使用 4099。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上有東西在監聽，但不是這個 App 認識的代理。opencode 使用 4096 連接埠，claude-bridge 使用 4098，omp-bridge 使用 4099。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś nasłuchuje na %@, ale to nie jest agent znany tej aplikacji. opencode działa na porcie 4096, claude-bridge na 4098, omp-bridge na 4099."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget lytter på %@, men det er ikke en agent, som denne app kender. opencode kører på port 4096, claude-bridge på port 4098 og omp-bridge på port 4099."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoitteessa %@ kuuntelee jokin, mutta se ei ole tämän sovelluksen tuntema agentti. opencode käyttää porttia 4096, claude-bridge porttia 4098 ja omp-bridge porttia 4099."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Eitthvað hlustar á %@, en það er ekki agent sem þetta forrit þekkir. opencode notar gátt 4096, claude-bridge 4098 og omp-bridge 4099."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe lytter på %@, men det er ikke en agent appen kjenner. opencode svarer på 4096, claude-bridge på 4098, omp-bridge på 4099."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något lyssnar på %@, men det är inte en agent som appen känner till. opencode använder port 4096, claude-bridge port 4098 och omp-bridge port 4099."
          }
        }
      }
    },
