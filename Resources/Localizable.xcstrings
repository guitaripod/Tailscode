    },
    "Ctrl+plus and Ctrl+minus scale everything in the window, on top of the sizes above": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+plus and Ctrl+minus scale everything in the window, on top of the sizes above"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+Plus und Ctrl+Minus skalieren alles im Fenster zusätzlich zu den Größen oben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+más y Ctrl+menos escalan todo en la ventana, además de los tamaños de arriba"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+plus et Ctrl+moins mettent à l’échelle toute la fenêtre, en plus des tailles ci-dessus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+più e Ctrl+meno scalano tutto nella finestra, oltre alle dimensioni sopra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+プラスと Ctrl+マイナスは、上のサイズに加えてウインドウ全体を拡大・縮小します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+플러스와 Ctrl+마이너스는 위의 크기에 더해 창 전체를 확대·축소합니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+plus i Ctrl+minus skalują wszystko w oknie, oprócz rozmiarów powyżej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+mais e Ctrl+menos escalam tudo na janela, além dos tamanhos acima"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+加号和 Ctrl+减号会在上述大小的基础上缩放窗口中的所有内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+加號和 Ctrl+減號會在上述大小的基礎上縮放視窗中的所有內容"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+plus og Ctrl+minus skalerer alt i vinduet ud over størrelserne ovenfor"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+plus ja Ctrl+miinus skaalaavat koko ikkunan sisältöä edellä mainittujen kokojen lisäksi"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+plús og Ctrl+mínus stækka allt í glugganum, ofan á stærðirnar hér að ofan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+pluss og Ctrl+minus skalerer alt i vinduet, i tillegg til størrelsene over"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ctrl+plus och Ctrl+minus skalar allt i fönstret, utöver storlekarna ovan"
          }
        }
      }
    },
    "Drag any divider to size a pane; the sizes are remembered.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag any divider to size a pane; the sizes are remembered."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe an einem beliebigen Trenner, um einen Bereich zu bemessen; die Größen werden gemerkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra cualquier divisor para dimensionar un panel; los tamaños se recuerdan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser n’importe quel séparateur pour dimensionner un volet ; les tailles sont mémorisées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un divisore qualsiasi per dimensionare un riquadro; le dimensioni vengono ricordate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "区切り線をドラッグするとペインのサイズを変更でき、サイズは記憶されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구분선을 끌어 패널 크기를 조절하세요. 크기는 기억됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij dowolny separator, aby zmienić rozmiar panelu; rozmiary są zapamiętywane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste qualquer divisor para dimensionar um painel; os tamanhos são lembrados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动任意分隔线可调整面板大小，大小会被记住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳任意分隔線可調整面板大小，大小會被記住。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk i en vilkårlig skillelinje for at justere et område; størrelserne huskes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedä mitä tahansa jakajaa säätääksesi aluetta; koot muistetaan."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Dragðu í hvaða skil sem er til að stilla stærð svæðis; stærðirnar eru geymdar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra i et hvilket som helst skille for å endre størrelsen på et område; størrelsene huskes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra i valfri avdelare för att ändra storlek på en panel. Storlekarna sparas."
          }
        }
      }
    },
    "Early work, off by default: it may cost battery, change shape, or leave": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Early work, off by default: it may cost battery, change shape, or leave"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühe Arbeit, standardmäßig aus: Sie kann Akku kosten, die Form ändern oder verlassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajo temprano, desactivado por defecto: puede gastar batería, cambiar de forma o dejar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travail préliminaire, désactivé par défaut : il peut coûter de la batterie, changer de forme ou quitter"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavoro in anteprima, disattivato di default: può consumare batteria, cambiare forma o lasciare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試験的な機能で既定はオフです。バッテリーを消費したり、形が変わったり、消えたりすることがあります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초기 기능으로 기본값은 꺼짐입니다. 배터리를 쓰거나, 모양이 바뀌거나, 사라질 수 있습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczesna wersja, domyślnie wyłączona: może zużywać baterię, zmieniać kształt lub zniknąć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalho inicial, desligado por padrão: pode gastar bateria, mudar de forma ou sair"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "早期功能，默认关闭：可能耗电、改变形态，或者离开"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "早期功能，預設關閉：可能耗電、改變形態，或是離開"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidlig version, slået fra som standard: den kan koste batteri, ændre form eller forlade"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskeneräinen ominaisuus, oletuksena pois päältä: se voi kuluttaa akkua, muuttaa muotoaan tai jättää"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Snemmbúin vinna, slökkt sjálfgefið: hún getur kostað rafhlöðu, breytt lögun eða yfirgefið gluggann"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksperimentelt, av som standard: det kan koste batteri, endre form eller forlate"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
