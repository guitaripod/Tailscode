    "Your browser confirms it, not this app — no password is typed here and none is kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Browser bestätigt es, nicht diese App — hier wird kein Passwort eingegeben und keines gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your browser confirms it, not this app — no password is typed here and none is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu navegador lo confirma, no esta app: aquí no se escribe ninguna contraseña ni se guarda ninguna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est votre navigateur qui le confirme, pas cette app — aucun mot de passe n’est saisi ici ni conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il tuo browser a confermarlo, non questa app — qui non si digita né si conserva alcuna password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認するのはこのアプリではなくあなたのブラウザです — ここでパスワードを入力することも、保存することもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 브라우저가 확인하며, 이 앱이 아닙니다 — 여기서는 비밀번호를 입력하지도 보관하지도 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É o seu navegador que confirma, não este app — nenhuma senha é digitada aqui nem fica guardada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认这一步的是你的浏览器，不是本应用 — 这里不会输入也不会保存任何密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認這一步的是你的瀏覽器，不是本應用程式 — 這裡不會輸入也不會保存任何密碼。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To twoja przeglądarka to potwierdza, nie ta aplikacja — tutaj nie wpisujesz żadnego hasła i żadne nie jest przechowywane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din browser bekræfter det, ikke denne app – der indtastes ingen adgangskode her, og der gemmes ingen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Selaimesi vahvistaa kirjautumisen, ei tämä sovellus: salasanaa ei kirjoiteta tähän eikä sitä tallenneta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Vafrinn þinn staðfestir það, ekki þetta forrit. Hér er ekkert lykilorð slegið inn og ekkert geymt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettleseren din bekrefter det, ikke denne appen: ingen passord skrives inn her, og ingen lagres."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din webbläsare bekräftar det, inte den här appen. Inget lösenord skrivs in här och inget sparas."
          }
        }
      }
    },
    "The board now knows who you follow.": {
