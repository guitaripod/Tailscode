    },
    "%@ is up but nothing listens on %@ — is the server running?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist erreichbar, aber niemand lauscht auf %@ — läuft der Server?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is up but nothing listens on %@ — is the server running?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está activo, pero nada responde en %@: ¿el servidor está en marcha?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est joignable, mais rien n’écoute sur %@ — le serveur est-il lancé ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è raggiungibile, ma nulla è in ascolto su %@ — il server è in esecuzione?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は起動していますが、%@ で待ち受けているものがありません — サーバは実行されていますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 켜져 있지만 %@에서 수신 대기 중인 것이 없습니다 — 서버가 실행 중인가요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está acessível, mas nada responde em %@ — o servidor está rodando?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已开机，但 %@ 上没有任何服务在监听 — 服务器在运行吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已開機，但 %@ 上沒有任何服務在監聽 — 伺服器在執行嗎？"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ działa, ale nic nie nasłuchuje na %@ — czy serwer jest uruchomiony?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er oppe, men intet lytter på %@ – kører serveren?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on käynnissä, mutta osoitteessa %2$@ ei kuuntele mitään – onko palvelin käynnissä?"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er í gangi en enginn hlustar á %@ – er netþjónninn í gangi?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er oppe, men ingen lytter på %@. Kjører serveren?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ är igång men ingen lyssnar på %2$@. Körs servern?"
          }
        }
      }
    },
