    "⌘+ and ⌘− scale everything in the window, on top of the sizes above": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+ and ⌘− scale everything in the window, on top of the sizes above"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+ und ⌘− skalieren alles im Fenster zusätzlich zu den Größen oben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+ y ⌘− escalan todo en la ventana, sobre los tamaños de arriba"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+ et ⌘− mettent à l'échelle toute la fenêtre, en plus des tailles ci-dessus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+ e ⌘− scalano tutto nella finestra, oltre alle dimensioni sopra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+ と ⌘− は上のサイズに加えて、ウインドウ全体を拡大・縮小します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+와 ⌘−는 위 크기에 더해 창 전체를 확대·축소합니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+ i ⌘− skalują wszystko w oknie, ponad rozmiary powyżej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+ e ⌘− ampliam ou reduzem tudo na janela, além dos tamanhos acima"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+ 和 ⌘− 在上述大小之上，缩放窗口中的所有内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+ 與 ⌘− 在上述大小之上，縮放視窗中的所有內容"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+ og ⌘− skalerer alt i vinduet ud over størrelserne ovenfor"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+ ja ⌘− skaalaavat kaiken ikkunassa edellä valittujen kokojen lisäksi"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+ og ⌘− stækka og minnka allt í glugganum, ofan á stærðirnar hér að ofan"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘+ og ⌘− skalerer alt i vinduet, i tillegg til størrelsene over"
