    "Counted per conversation: %@ reports what each chat spent, not the turns inside it, the tools they called or the hour they ran.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro Unterhaltung gezählt: %@ meldet, was jeder Chat gekostet hat, nicht die Züge darin, die aufgerufenen Werkzeuge oder die Stunde, in der er lief."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted per conversation: %@ reports what each chat spent, not the turns inside it, the tools they called or the hour they ran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contado por conversación: %@ informa lo que gastó cada chat, no los turnos que contiene, las herramientas que llamó ni la hora en que se ejecutó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comptabilisé par conversation : %@ indique ce qu’a dépensé chaque discussion, pas les tours qu’elle contient, les outils appelés ni l’heure d’exécution."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteggiato per conversazione: %@ riporta quanto ha speso ogni chat, non i turni al suo interno, gli strumenti chiamati o l’ora in cui è stata eseguita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話単位で集計: %@ は各チャットが使った金額を報告しますが、その中のターン数、呼び出したツール、実行した時間帯は報告しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 단위로 집계: %@는 각 대화가 사용한 비용을 보고할 뿐, 그 안의 턴 수, 호출한 도구, 실행된 시간대는 보고하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contado por conversa: %@ informa o que cada conversa gastou, não os turnos dentro dela, as ferramentas chamadas ou a hora em que rodou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按对话计数：%@ 报告的是每个对话花费了多少，而不是其中的回合数、调用的工具或运行的时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按對話計數：%@ 回報的是每個對話花費了多少，而不是其中的回合數、呼叫的工具或執行的時間。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczone na rozmowę: %@ podaje, ile kosztowała każda rozmowa, a nie tury w jej wnętrzu, wywołane narzędzia czy godzinę, o której działała."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgjort pr. samtale: %@ viser, hvad hver chat har kostet, ikke turene i den, værktøjskaldene eller tidspunktet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laskettu keskustelukohtaisesti: %@ näyttää, mitä kukin keskustelu kulutti, ei sen sisällä olevia vuoroja, käytettyjä työkaluja eikä ajankohtaa, jolloin ne ajettiin."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Talið eftir samtali: %@ sýnir hvað hvert spjall kostaði, ekki umferðirnar í því, verkfærin sem þau kölluðu á né klukkustundina sem þau keyrðu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Telt per samtale: %@ viser hva hver chat brukte, ikke turene i den, verktøykallene de gjorde eller klokkeslettet de kjørte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Räknat per konversation: %@ redovisar vad varje chatt kostade, inte turerna i den, verktygen den anropade eller när den kördes."
          }
        }
      }
    },
