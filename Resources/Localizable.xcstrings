          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリと通信する各サーバ：それぞれが実行中のバージョンと、更新可能なバージョン"
          }
        },
        "ko": {
          "stringUnit": {
