        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未保存任何内容。点击“连接”以添加 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未儲存任何內容。按下「連線」以新增 %@。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet gemt endnu. Tryk på Opret forbindelse for at tilføje %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä mitään tallennettuna. Lisää %@ painamalla ”Yhdistä”."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekkert vistað ennþá. Ýttu á Tengjast til að bæta við %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting er lagret ennå. Trykk Koble til for å legge til %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget sparat ännu. Tryck på Anslut för att lägga till %@."
          }
        }
      }
    },
