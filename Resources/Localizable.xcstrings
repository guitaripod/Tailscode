          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnósticos de conexões, conversas e sincronizações aparecem aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
