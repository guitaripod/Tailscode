            "value": "Stigen leses fra maskinen så snart den svarer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stegen läses från datorn när den svarar."
          }
        }
      }
    },
    "Runs only at %@ — the %@ class's own rung.": {
      "extractionState": "manual",
