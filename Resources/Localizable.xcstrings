        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strzałka otwiera innych dostawców, którzy go uruchamiają."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilen åbner listen over de andre udbydere, der kører den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuoli avaa muut palveluntarjoajat, jotka tarjoavat tätä mallia."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Örin opnar aðra veitendur sem keyra það."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilen åpner de andre leverandørene som kjører den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilen öppnar de andra leverantörerna som kör den."
          }
        }
      }
    },
