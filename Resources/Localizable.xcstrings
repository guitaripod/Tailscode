    },
    "Paste the client id and secret it gives you below.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Client-ID und das Client-Secret, die du dort erhältst, unten ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the client id and secret it gives you below."
          }
        },
        "es": {
