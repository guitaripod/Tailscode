    "Lands the files unstaged; nothing is committed.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lander filerne uden staging; intet committes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt die Dateien unstaged ab; es wird nichts committet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lands the files unstaged; nothing is committed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja los archivos sin preparar; no se hace commit de nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedostot viedään indeksoimattomina; mitään ei tehdä commitiksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépose les fichiers non indexés ; rien n’est validé."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Setur skrárnar í vinnumöppuna óstagaðar; ekkert fer í commit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta i file non in stage; nulla viene committato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをステージせずに反映します。何もコミットされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 스테이징하지 않은 채로 반영합니다. 커밋되는 것은 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legger filene i arbeidskatalogen uten å stage dem; ingenting blir committet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadza pliki niezaindeksowane; nic nie jest zatwierdzane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca os arquivos fora do stage; nada é commitado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägger filerna ostegade; inget committas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件以未暂存状态落入工作树；不会提交任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案以未暫存狀態落入工作樹；不會提交任何內容。"
          }
        }
      }
    },
