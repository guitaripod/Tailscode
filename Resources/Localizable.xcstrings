        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostikken blev i stedet kopieret til udklipsholderen. Send den til %@."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostiikka kopioitiin sen sijaan leikepöydälle. Lähetä se osoitteeseen %@."
