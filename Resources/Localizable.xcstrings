          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将它提供的客户端 ID 和密钥粘贴到下面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將它提供的用戶端 ID 和密鑰貼到下面。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej poniżej identyfikator klienta i klucz tajny, które otrzymasz."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt klient-ID'et og klienthemmeligheden, du får dér, nedenfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä alle saamasi asiakastunnus ja salaisuus."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Límdu hér fyrir neðan auðkenni viðskiptavinar og leyndarmál sem þú færð."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn klient-ID-en og hemmeligheten du får der, nedenfor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in klient-ID och klienthemligheten som Google ger dig nedan."
          }
        }
      }
    },
