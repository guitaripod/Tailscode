    "This server didn't offer a command catalog. Typed slashes still go through as messages.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server hat keinen Befehlskatalog angeboten. Eingetippte Schrägstrichbefehle werden weiterhin als Nachrichten gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server didn't offer a command catalog. Typed slashes still go through as messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no ofreció un catálogo de comandos. Las barras escritas siguen enviándose como mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur n’a pas proposé de catalogue de commandes. Les barres obliques tapées continuent d’être envoyées comme des messages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server non ha offerto un catalogo di comandi. Gli slash digitati vengono comunque inviati come messaggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバはコマンドカタログを提供しませんでした。入力したスラッシュコマンドは、そのままメッセージとして送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 명령어 카탈로그를 제공하지 않았습니다. 입력한 슬래시는 그대로 메시지로 전송됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor não ofereceu um catálogo de comandos. As barras digitadas continuam sendo enviadas como mensagens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器没有提供命令目录。输入的斜杠命令仍会作为消息发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器沒有提供指令目錄。輸入的斜線指令仍會作為訊息傳送。"
