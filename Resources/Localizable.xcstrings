        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag mir Bescheid, wenn ein Nutzungsfenster vor dem Zurücksetzen auszulaufen droht. Nur kontoweite Fenster; einmal pro Fenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avísame cuando una ventana de uso vaya a agotarse antes de reiniciarse. Solo ventanas de toda la cuenta; una vez por ventana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévenez-moi quand une fenêtre d’usage risque de s’épuiser avant sa réinitialisation. Fenêtres du compte uniquement ; une fois par fenêtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisami quando una finestra di utilizzo sta per esaurirsi prima del ripristino. Solo finestre dell’intero account; una volta per finestra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用量の枠がリセット前に上限に達しそうなときに知らせます。アカウント全体の枠のみ。枠ごとに 1 回。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용량 기간이 초기화 전에 소진될 것으로 보이면 알려 줍니다. 계정 전체 기간만 해당하며, 기간마다 한 번입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadom mnie, gdy okno użycia wyczerpie się przed resetem. Tylko okna dla całego konta; raz na okno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Me avise quando uma janela de uso estiver prestes a acabar antes de ser redefinida. Somente janelas da conta; uma vez por janela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当某个用量窗口会在重置前用完时通知我。仅限账户级窗口；每个窗口提醒一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當某個用量視窗會在重設前用完時通知我。僅限帳戶級視窗；每個視窗提醒一次。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv mig besked, når et brugsvindue er på vej til at løbe tør, før det nulstilles. Kun vinduer for hele kontoen; én gang pr. vindue"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro, kun käyttöjakso on uhkaamassa loppua ennen nollautumistaan. Vain tilikohtaiset jaksot; kerran jaksoa kohden."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Láttu mig vita þegar notkunarglugga stefnir í að klárast áður en hann endurstillist. Aðeins gluggar fyrir allan aðganginn; einu sinni fyrir hvern glugga."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si fra når et bruksvindu er på vei til å gå tom før det tilbakestilles. Bare kontovindu; én gang per vindu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säg till mig när ett användningsfönster håller på att ta slut innan det återställs. Endast kontoomfattande fönster, en gång per fönster"
          }
        }
      }
    },
