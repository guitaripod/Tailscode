    "Each time a turn ends, even with work still running.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each time a turn ends, even with work still running."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal, wenn ein Durchgang endet, auch wenn noch Arbeit läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vez que termina un turno, incluso si aún hay trabajo en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À chaque fin de tour, même si du travail est encore en cours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni volta che un turno finisce, anche con lavoro ancora in corso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業が続いていても、やりとりが終わるたびに通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 아직 진행 중이어도 턴이 끝날 때마다 알립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za każdym razem, gdy tura się kończy, nawet gdy praca jeszcze trwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre que um turno termina, mesmo com trabalho ainda em andamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次一轮结束时通知，即使仍有工作在进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次一輪結束時通知，即使仍有工作在進行。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver gang en tur slutter, også når der stadig er arbejde i gang."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aina kun vuoro päättyy, vaikka työ on vielä käynnissä."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í hvert sinn sem umferð lýkur, jafnvel þótt vinna sé enn í gangi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver gang en tur avsluttes, selv om arbeid fortsatt kjører."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje gång en tur tar slut, även när arbete fortfarande körs."
          }
        }
      }
    },
