    "Draw a few alternatives for a surface, pick one, then have it built": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne ein paar Alternativen für eine Oberfläche, wähle eine aus und lass sie bauen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a few alternatives for a surface, pick one, then have it built"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja varias alternativas para una interfaz, elige una y hazla construir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquissez plusieurs variantes d’une interface, choisissez-en une, puis faites-la construire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna alcune alternative per un’interfaccia, scegline una, poi falla costruire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面のバリエーションをいくつか描いて、ひとつを選び、それを実装させましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면의 여러 대안을 그려보고, 하나를 골라 구현하게 하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe algumas alternativas para uma interface, escolha uma e mande construir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为一个界面画出几种备选方案，选一个，然后让它被实现出来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為一個介面畫出幾種備選方案，選一個，然後讓它被實作出來"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naszkicuj kilka alternatyw dla interfejsu, wybierz jedną, a potem zleć jej zbudowanie"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn et par alternativer til en overflade, vælg ét, og få det bygget"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piirrä muutama vaihtoehto pinnalle, valitse yksi ja anna rakentaa se"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Teiknaðu nokkra valkosti fyrir yfirborð, veldu einn og láttu smíða hann"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegn noen alternativer for en flate, velg ett, og få det bygget"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rita några alternativ för en yta, välj ett och låt det byggas"
          }
        }
      }
    },
