    "Start one rung lower and ask before the top": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Stufe tiefer starten und vor der Spitze nachfragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start one rung lower and ask before the top"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar un nivel más abajo y preguntar antes de llegar arriba del todo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer un niveau plus bas et demander avant le sommet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parti un livello più in basso e chiedi prima della cima"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1段低く開始し、頂点の前で確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 단 낮게 시작하고 정상 전에 확인"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar um nível abaixo e perguntar antes do topo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从低一级开始，到顶层前先询问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從低一級開始，到頂層前先詢問"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij o jeden szczebel niżej i pytaj przed szczytem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Start ét trin lavere, og spørg før toppen"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita yhtä tasoa alempaa ja kysy ennen ylintä tasoa"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Byrja einu þrepi neðar og spyrja áður en efsta þrepið er náð"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start ett trinn lavere og spør før toppen"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta ett steg lägre och fråga innan toppen"
