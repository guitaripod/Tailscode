        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao vivo de %@. As porcentagens são o consumo real da conta, não uma estimativa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 %@ 的实时数据。百分比是账户的实际消耗量，而非估算值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
