    "It mishears now and then, and the agent gets what it heard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It mishears now and then, and the agent gets what it heard"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es hört manchmal falsch, und der Agent bekommt, was es gehört hat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De vez en cuando oye mal, y el agente recibe lo que oyó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il lui arrive de mal entendre, et l'agent reçoit ce qu'il a entendu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni tanto sente male, e l'agente riceve ciò che ha sentito"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ときどき聞き間違えますが、エージェントには聞き取った内容がそのまま届きます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가끔 잘못 알아들을 수 있으며, 에이전트는 알아들은 내용을 그대로 받습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czasem się przesłyszy, a agent dostaje to, co usłyszał"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele ouve errado de vez em quando, e o agente recebe o que ele ouviu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它偶尔会听错，智能体收到的就是它听到的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它偶爾會聽錯，智能體收到的就是它聽到的內容"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den hører nogle gange forkert, og agenten får det, den hørte"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se kuulee joskus väärin, ja agentti saa sen, mitä se kuuli"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það misheyrir öðru hverju, og agentinn fær það sem það heyrði"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den hører feil nå og da, og agenten får det den hørte"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den missuppfattar ibland, och agenten får det den hörde"
          }
        }
      }
    },
    "A pause in the middle of a request can split it into two messages": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pause in the middle of a request can split it into two messages"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Pause mitten in einer Anfrage kann sie in zwei Nachrichten teilen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pausa en medio de una petición puede dividirla en dos mensajes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pause au milieu d'une demande peut la scinder en deux messages"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pausa nel mezzo di una richiesta può dividerla in due messaggi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼の途中で間が空くと、2つのメッセージに分かれることがあります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 도중에 잠깐 멈추면 요청이 메시지 두 개로 나뉠 수 있습니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauza w środku prośby może rozdzielić ją na dwie wiadomości"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pausa no meio de um pedido pode dividi-lo em duas mensagens"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求说到一半停顿，可能会被拆分成两条消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求說到一半停頓，可能會被拆成兩則訊息"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause midt i en anmodning kan dele den op i to beskeder"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tauko pyynnön keskellä voi jakaa sen kahdeksi viestiksi"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlé í miðri beiðni getur skipt henni í tvö skilaboð"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause midt i en forespørsel kan dele den i to meldinger"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En paus mitt i en begäran kan dela upp den i två meddelanden"
          }
        }
      }
    },
    "It does not talk back and cannot stop the agent; use the chat for that": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It does not talk back and cannot stop the agent; use the chat for that"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es antwortet nicht und kann den Agenten nicht stoppen; dafür den Chat verwenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No responde y no puede detener al agente; para eso usa el chat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne répond pas et ne peut pas arrêter l'agent ; utilisez le chat pour cela"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non risponde e non può fermare l'agente; per questo usa la chat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話し返すことも、エージェントを止めることもできません。停止はチャットで行ってください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말로 응답하지 않으며 에이전트를 멈출 수도 없습니다. 그럴 때는 채팅을 사용하세요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie odpowiada głosem i nie może zatrzymać agenta; do tego służy czat"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele não responde nem pode parar o agente; para isso, use o chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它不会回话，也无法停止智能体；要做到这些，请使用聊天界面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它不會回話，也無法停止智能體；要做到這些，請使用聊天介面"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den svarer ikke tilbage og kan ikke stoppe agenten; brug chatten til det"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ei vastaa takaisin eikä voi pysäyttää agenttia; siihen käytä keskustelua"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Það svarar ekki og getur ekki stöðvað agentinn; notaðu spjallið til þess"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den svarer ikke tilbake og kan ikke stoppe agenten; bruk chatten til det"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den svarar inte och kan inte stoppa agenten; använd chatten för det"
          }
        }
      }
    },
