    "Hidden and rewritten ones come back; yours stay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden and rewritten ones come back; yours stay"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgeblendete und umgeschriebene kommen zurück; deine bleiben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ocultos y reescritos vuelven; los tuyos se quedan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les masquées et réécrites reviennent ; les vôtres restent"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelli nascosti e riscritti tornano; i tuoi restano"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示や書き換えたものは戻り、自分のものは残ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨긴 것과 다시 쓴 것은 돌아오고, 직접 만든 것은 유지됩니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryte i przepisane wracają; twoje zostają"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ocultos e reescritos voltam; os seus ficam"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏和改写过的会恢复；你自己的会保留"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏和改寫過的會恢復；你自己的會保留"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjulte og omskrevne kommer tilbage; dine forbliver"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilotetut ja uudelleen kirjoitetut palautuvat, omat jäävät"
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Faldar og endurskrifaðar koma aftur; þínar verða áfram"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjulte og omskrevne kommer tilbake; dine forblir"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolda och omskrivna kommer tillbaka; dina stannar"
          }
        }
      }
    },
