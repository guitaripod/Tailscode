    "That chapter began before what this chat has loaded.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That chapter began before what this chat has loaded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Kapitel begann, bevor die geladenen Inhalte dieses Chats beginnen."
          }
        },
        "es": {
