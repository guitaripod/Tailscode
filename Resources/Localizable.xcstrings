    "A machine is the computer that runs your coding agent, on your Tailscale network.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A machine is the computer that runs your coding agent, on your Tailscale network."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Rechner ist der Computer, auf dem der Coding-Agent im Tailscale-Netzwerk läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un equipo es aquel en el que se ejecuta el agente de programación, dentro de la red de Tailscale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une machine est l'ordinateur qui fait tourner l'agent de code, sur le réseau Tailscale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un computer è quello che esegue l'agente di coding, sulla rete Tailscale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンとは、Tailscale ネットワーク上でコーディングエージェントを実行しているマシンのことです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터는 Tailscale 네트워크 안에서 코딩 에이전트를 실행하는 컴퓨터예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komputer to urządzenie, na którym działa agent kodowania, w sieci Tailscale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um computador é o que roda o agente de programação, na sua rede Tailscale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑是指在你的 Tailscale 网络中运行编程代理的那台电脑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電腦是指在你的 Tailscale 網路中執行程式設計代理的那台電腦。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En computer er den, der kører din coding-agent, på dit Tailscale-netværk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietokone on se, jolla koodausagentti käy tailnetissäsi."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Tölva er sú tölva sem keyrir kóðaagentinn þinn, á Tailscale-netinu þínu."
          }
        },
        "nb": {
