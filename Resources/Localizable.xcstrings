    "Speak a task and it is sent to the agent as an ordinary message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speak a task and it is sent to the agent as an ordinary message"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich eine Aufgabe, und sie geht als normale Nachricht an den Agenten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di una tarea en voz alta y se envía al agente como un mensaje normal"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictez une tâche et elle part vers l’agent comme un message ordinaire"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dì un compito a voce e viene inviato all’agente come un normale messaggio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを声で伝えると、通常のメッセージとしてエージェントに送られます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 말하면 일반 메시지로 에이전트에게 전달됩니다"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz zadanie, a trafi ono do agenta jako zwykła wiadomość"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga uma tarefa e ela é enviada ao agente como uma mensagem comum"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说出任务，它就会作为普通消息发送给智能体"
