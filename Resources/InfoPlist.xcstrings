{
  "sourceLanguage": "en",
  "strings": {
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode connects to coding-agent servers you run on your own machines, including ones on your local network."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode verbindet sich mit Coding-Agent-Servern, die du auf deinen eigenen Rechnern betreibst — auch mit denen in deinem lokalen Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode se conecta a los servidores de agentes de programación que ejecutas en tus propias máquinas, incluidos los de tu red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode se connecte aux serveurs d’agents de programmation que vous exécutez sur vos propres machines, y compris ceux de votre réseau local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode si connette ai server di agenti di programmazione che esegui sulle tue macchine, compresi quelli sulla tua rete locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode は、自分のマシンで動かしているコーディングエージェントのサーバー（ローカルネットワーク上のものを含む）に接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode는 사용자의 컴퓨터에서 직접 실행하는 코딩 에이전트 서버에 연결하며, 여기에는 로컬 네트워크의 서버도 포함됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscode se conecta aos servidores de agentes de programação que você executa nas suas próprias máquinas, inclusive os da sua rede local."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 会连接到你在自己机器上运行的编程代理服务器，包括本地网络中的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscode 會連線到你在自己電腦上執行的編碼代理伺服器，包含區域網路上的伺服器。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Bilder aus einer Unterhaltung in deiner Fotomediathek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save pictures from a conversation to your photo library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda imágenes de una conversación en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez les images d’une conversation dans votre photothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva le immagini di una conversazione nella tua libreria foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話内の画像を写真ライブラリに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화의 사진을 사진 보관함에 저장합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve imagens de uma conversa na sua fototeca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将对话中的图片存储到你的照片图库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將對話中的圖片儲存至你的照片圖庫。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach images from your library to a prompt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder aus deiner Mediathek an einen Prompt anhängen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjunta imágenes de tu fototeca a un prompt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joindre des images de votre photothèque à une requête."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allega immagini dalla tua libreria a un prompt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリの画像をプロンプトに添付します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관함의 이미지를 프롬프트에 첨부합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe imagens da sua biblioteca a um prompt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将图库中的图片附加到提示词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將照片圖庫中的圖片附加到提示。"
          }
        }
      }
    },
